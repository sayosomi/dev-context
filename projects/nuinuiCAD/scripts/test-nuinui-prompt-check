#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
helper=$script_dir/nuinui-prompt-check
canonical_nuinui=/Users/yosomi/Code/dev-context/projects/nuinuiCAD/scripts/nuinui
ticket=h1-0123456789abcdef01234567
other_ticket=h1-fedcba9876543210fedcba98
canonical_command="$canonical_nuinui handoff $ticket"
other_command="$canonical_nuinui handoff $other_ticket"
base_sha=df3d37d5b63d0cfae472044b3c0405121c2a45f8
claim=issue216promptclaim
branch=sayosomi/issue-216-prompt-preflight
OUTPUT_REQUIREMENT='Final success and BLOCKED/stopped reports must include a fresh Output time in the form Output time: YYYY-MM-DD HH:MM JST; do not reuse Prompt time.'
ISOLATION_CLAUSE='Do not inspect, modify, merge, rebase, cherry-pick, or otherwise manipulate another active implementation lane.'

fail() {
  echo "PROMPT CHECK TEST FAIL: $*" >&2
  exit 1
}

assert_contains() {
  printf '%s\n' "$1" | grep -Fq -- "$2" || fail "$3"
}

assert_pass() {
  prompt_check_output=$($helper "$1" "$2" 2>&1) || {
    printf '%s\n' "$prompt_check_output"
    fail "$3"
  }
  assert_contains "$prompt_check_output" 'PROMPT PREFLIGHT PASS' "$3 did not pass"
}

assert_blocked() {
  prompt_check_output=''
  if prompt_check_output=$($helper "$1" "$2" 2>&1); then
    printf '%s\n' "$prompt_check_output"
    fail "$3 unexpectedly passed"
  fi
  assert_contains "$prompt_check_output" 'PROMPT PREFLIGHT BLOCKED' "$3 did not block"
}

replace_exact_line() {
  replace_old=$1
  replace_new=$2
  replace_input=$3
  replace_output=$4
  awk -v old="$replace_old" -v new="$replace_new" \
    '$0 == old {$0 = new} {print}' "$replace_input" > "$replace_output"
}

root=$(mktemp -d "${TMPDIR:-/tmp}/nuinui-prompt-check.XXXXXX") || exit 1
cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  rm -rf "$root"
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

prompt=$root/prompt.txt
context=$root/context.txt
oracle=$root/verification.txt

write_oracle() {
  printf '%s\n' \
    'cd /Users/yosomi/Code/dev-context-dev' \
    'set -euo pipefail' \
    'test "$(git branch --show-current)" = "sayosomi/issue-216-prompt-preflight"' \
    'test "$(git rev-parse --verify origin/main)" = "df3d37d5b63d0cfae472044b3c0405121c2a45f8"' \
    'sh -n projects/nuinuiCAD/scripts/generate-nuinui-prompt-check' \
    'sh -n projects/nuinuiCAD/scripts/test-nuinui-prompt-check' \
    'projects/nuinuiCAD/scripts/test-nuinui-prompt-check' \
    'projects/nuinuiCAD/scripts/test-nuinui-generation' \
    'projects/nuinuiCAD/scripts/test-nuinui-handoff' \
    'projects/nuinuiCAD/scripts/nuinui self-test' \
    'projects/nuinuiCAD/scripts/nuinui context-check' \
    'git diff --check' > "$oracle"
}

write_prompt() {
  printf '%s\n' \
    'Prompt time: 2026-09-08 14:56 JST' \
    'Role: implementation' \
    'Phase: implementation' \
    'Slice: Issue #216 prompt preflight' \
    "Handoff ticket: $ticket" \
    "$canonical_command" \
    'Lane: main' \
    'Issue: SAY-216' \
    "Branch: $branch" \
    "Base: $base_sha" \
    "Claim: $claim" \
    "Checkpoint: $base_sha" \
    'Topic remote mode: absent' \
    "$OUTPUT_REQUIREMENT" \
    'Do not inspect, modify, merge, rebase, cherry-pick, or otherwise manipulate another active implementation lane.' \
    'Verification block: begin' > "$prompt"
  cat "$oracle" >> "$prompt"
  printf '%s\n' 'Verification block: end' >> "$prompt"
}

write_context() {
  printf '%s\n' \
    'prompt-preflight-context-v1' \
    'repository=sayosomi/nuinuiCAD' \
    'role=implementation' \
    'phase=implementation' \
    "ticket=$ticket" \
    'ticket_state=valid' \
    "command=$canonical_command" \
    'lane=main' \
    'issue=SAY-216' \
    "branch=$branch" \
    "base=$base_sha" \
    "claim=$claim" \
    "checkpoint=$base_sha" \
    'topic=absent' \
    'active_implementation_lanes=main,sub' \
    "verification_oracle=$oracle" > "$context"
}

[ -x "$helper" ] || fail 'prompt checker is missing or not executable'
write_oracle
write_prompt
write_context

# 1. Canonical valid implementation prompt.
assert_pass "$prompt" "$context" 'canonical valid implementation prompt'

# 2-3. Historical missing-scripts path and nonexistent/noncanonical wrapper path.
replace_exact_line "$canonical_command" \
  "/Users/yosomi/Code/dev-context/projects/nuinui-handoff-once $ticket" \
  "$prompt" "$root/wrong-path-prompt"
sed "s#^command=.*#command=/Users/yosomi/Code/dev-context/projects/nuinui-handoff-once $ticket#" \
  "$context" > "$root/wrong-path-context"
assert_blocked "$root/wrong-path-prompt" "$root/wrong-path-context" 'historical wrong or missing scripts path'
replace_exact_line "$canonical_command" \
  "/Users/yosomi/Code/dev-context/projects/nuinuiCAD/scripts/nonexistent-wrapper $ticket" \
  "$prompt" "$root/nonexistent-prompt"
sed "s#^command=.*#command=/Users/yosomi/Code/dev-context/projects/nuinuiCAD/scripts/nonexistent-wrapper $ticket#" \
  "$context" > "$root/nonexistent-context"
assert_blocked "$root/nonexistent-prompt" "$root/nonexistent-context" 'nonexistent noncanonical wrapper path'

# 4. The declared ticket and command ticket must agree.
replace_exact_line "$canonical_command" "$other_command" "$prompt" "$root/mismatch-prompt"
sed "s#^command=.*#command=$other_command#" "$context" > "$root/mismatch-context"
assert_blocked "$root/mismatch-prompt" "$root/mismatch-context" 'declared ticket and command ticket mismatch'

# 5. Invalid syntax and fixture-only reserved/expired states never enter handoff.
sed 's/^ticket=.*/ticket=h1-invalid/' "$context" > "$root/invalid-ticket-context"
assert_blocked "$prompt" "$root/invalid-ticket-context" 'invalid ticket syntax'
for ticket_state_fixture in malformed reserved expired; do
  sed "s/^ticket_state=.*/ticket_state=$ticket_state_fixture/" "$context" > "$root/$ticket_state_fixture-context"
  assert_blocked "$prompt" "$root/$ticket_state_fixture-context" \
    "fixture ticket state $ticket_state_fixture"
done

# 6-7. Timestamp requirements.
sed '/^Prompt time:/d' "$prompt" > "$root/missing-prompt-time"
assert_blocked "$root/missing-prompt-time" "$context" 'missing Prompt time'
awk -v output_requirement="$OUTPUT_REQUIREMENT" \
  '$0 != output_requirement {print}' "$prompt" > "$root/missing-output-time"
assert_blocked "$root/missing-output-time" "$context" 'missing fresh Output time requirement'

# 8. The supplied verification oracle is exact and cannot drift.
sed 's/^git diff --check$/git diff --stat/' "$prompt" > "$root/altered-verification"
assert_blocked "$root/altered-verification" "$context" 'altered required verification block'
sed '/^Verification block: begin$/,/^Verification block: end$/d' "$prompt" > "$root/missing-verification"
assert_blocked "$root/missing-verification" "$context" 'missing required verification block'

# 9. Implementation prompts reject cross-lane merge/rebase instructions.
awk '/^Verification block: begin$/ {print "Merge another implementation lane into the current branch."} {print}' \
  "$prompt" > "$root/forbidden-merge"
assert_blocked "$root/forbidden-merge" "$context" 'forbidden cross-lane merge instruction'

# 10. An active parallel lane requires the exact isolation clause.
awk -v isolation="$ISOLATION_CLAUSE" '$0 != isolation {print}' \
  "$prompt" > "$root/missing-isolation"
assert_blocked "$root/missing-isolation" "$context" 'missing mandatory parallel-lane isolation clause'

# 11. The producer's stable command field is the command consumed by the checker.
producer_output=$root/producer-output
printf '%s\n' 'HANDOFF TICKET READY' "ticket=$ticket" "command=$canonical_command" > "$producer_output"
producer_ticket=$(awk -F= '$1 == "ticket" {print substr($0, index($0, "=") + 1)}' "$producer_output")
producer_command=$(awk -F= '$1 == "command" {print substr($0, index($0, "=") + 1)}' "$producer_output")
[ "$producer_ticket" = "$ticket" ] || fail 'producer ticket field changed'
[ "$producer_command" = "$canonical_command" ] || fail 'producer command field is not canonical'
assert_pass "$prompt" "$context" 'producer command field contract'

# 12. Prompt checking is pure validation and does not invoke Git or consume a ticket.
fake_bin=$root/fake-bin
mkdir "$fake_bin"
marker=$root/git-invoked
printf '%s\n' '#!/bin/sh' ': > "$PROMPT_CHECK_GIT_MARKER"' 'exit 99' > "$fake_bin/git"
chmod 755 "$fake_bin/git"
PROMPT_CHECK_GIT_MARKER=$marker PATH="$fake_bin:$PATH" \
  assert_pass "$prompt" "$context" 'non-consuming prompt validation'
[ ! -e "$marker" ] || fail 'prompt checker invoked Git and may have entered the handoff path'

echo 'PROMPT CHECK PASS'
