#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd -P)
CANDIDATE=$SCRIPT_DIR/nuinui-context
ROOT=$(mktemp -d "${TMPDIR:-/tmp}/nuinui-context-candidate.XXXXXX")
cleanup() { rm -rf "$ROOT"; }
trap cleanup EXIT HUP INT TERM

fail() { echo "CONTEXT CANDIDATE TEST FAIL: $*" >&2; exit 1; }
assert_contains() { case "$1" in *"$2"*) ;; *) fail "$3 missing=$2 output=$1" ;; esac; }

generated_candidate=$ROOT/generated-nuinui-context
"$SCRIPT_DIR/generate-nuinui-context" "$generated_candidate"
cmp -s "$CANDIDATE" "$generated_candidate" || fail 'generated candidate differs from checked-in artifact'
candidate_mode=$(stat -f '%Lp' "$CANDIDATE")
generated_mode=$(stat -f '%Lp' "$generated_candidate")
[ "$candidate_mode" = 755 ] && [ "$generated_mode" = "$candidate_mode" ] || \
  fail "generated executable mode mismatch expected=755 actual=$candidate_mode generated=$generated_mode"

runtime_source=$SCRIPT_DIR/nuinui-context-src/runtime.sh
normal_paths=$(NUINUI_SELFTEST=0 NUINUI_DEV_CONTEXT_WT="$ROOT/not-the-standard-clone" \
  NUINUI_DEV_CONTEXT_DEV_WT="$ROOT/not-the-dev-worktree" \
  sh -c '. "$1"; printf "%s\n%s\n" "$C" "$CD"' sh "$runtime_source")
[ "$normal_paths" = "/Users/yosomi/Code/dev-context
/Users/yosomi/Code/dev-context-dev" ] || \
  fail "normal runtime accepted path overrides: $normal_paths"

make_fixture() {
  name=$1
  kind=$2
  bare=$ROOT/$name.git
  seed=$ROOT/$name-seed
  prod=$ROOT/$name-prod
  dev=$ROOT/$name-dev
  git init --bare -q "$bare"
  git init -q -b main "$seed"
  git -C "$seed" config user.name Fixture
  git -C "$seed" config user.email fixture@example.invalid
  mkdir -p "$seed/projects/nuinuiCAD"
  awk '/^### Inactive context CLI candidate$/ { print; found=1; next } found && NF==0 && content { exit } found { print; if (NF>0) content=1 }' \
    "$REPO_ROOT/projects/nuinuiCAD/LOCAL-TOOLS.md" >"$seed/projects/nuinuiCAD/LOCAL-TOOLS.md"
  [ -s "$seed/projects/nuinuiCAD/LOCAL-TOOLS.md" ] || fail 'inactive candidate docs were not copied into fixture'
  case "$kind" in
    broken-link) printf '\n[Broken](MISSING.md)\n' >>"$seed/projects/nuinuiCAD/LOCAL-TOOLS.md" ;;
    missing-command) sed 's/nuinui-context context-dev-next/other-cli context-dev-next/' "$seed/projects/nuinuiCAD/LOCAL-TOOLS.md" >"$seed/projects/nuinuiCAD/LOCAL-TOOLS.tmp"; mv "$seed/projects/nuinuiCAD/LOCAL-TOOLS.tmp" "$seed/projects/nuinuiCAD/LOCAL-TOOLS.md" ;;
  esac
  printf '%s\n' 'Guide fixture.' >"$seed/projects/nuinuiCAD/GUIDE.md"
  printf '%s\n' '[guide](projects/nuinuiCAD/GUIDE.md)' >"$seed/README.md"
  git -C "$seed" add README.md projects
  git -C "$seed" commit -qm 'fixture base'
  git -C "$seed" remote add origin "$bare"
  git -C "$seed" push -q -u origin main
  git clone -q "$bare" "$prod"
  git -C "$prod" worktree add -q -b fixture/dev "$dev" main
  export NUINUI_SELFTEST=1
  export NUINUI_DEV_CONTEXT_WT=$prod
  export NUINUI_DEV_CONTEXT_DEV_WT=$dev
  export NUINUI_SELFTEST_EXPECTED_ORIGIN=$bare
  export NUINUI_SELFTEST_RESULT_REPO=$prod
  export TEST_PROD=$prod TEST_DEV=$dev TEST_BARE=$bare
}

make_fixture valid valid
output=$($CANDIDATE context-check 2>&1) || fail "valid copied docs rejected: $output"
assert_contains "$output" 'CONTEXT CHECK PASS' 'valid context-check'
result_gitdir=$(git -C "$TEST_PROD" rev-parse --absolute-git-dir)
mkdir "$result_gitdir/nuinui-context-command-result-v1"
cat >"$result_gitdir/nuinui-context-command-result-v1/state" <<'EOF'
version=1
operation_id=0123456789012345678901234567890123456789
timestamp=2026-10-13T00:00:00Z
command=context-dev-transition
phase=STARTED
result=INCOMPLETE
lane=dev-context
issue=-
claim=-
request_sha256=0123456789012345678901234567890123456789012345678901234567890123
mutation=unknown
exit=-
output_sha256=-
EOF
if output=$($CANDIDATE last-result 2>&1); then fail 'interrupted command result was presented as complete'; fi
assert_contains "$output" 'result=INCOMPLETE' 'interrupted result evidence'
assert_contains "$output" 'recovery=BLOCKED' 'interrupted result recovery'
assert_contains "$output" 'tracked mutation did not reach terminal finalization' 'interrupted result diagnostic'

make_fixture identities valid
result_gitdir=$(git -C "$TEST_PROD" rev-parse --absolute-git-dir)
identity_main=$(git -C "$TEST_PROD" rev-parse HEAD)
identity_head=$(git -C "$TEST_DEV" rev-parse HEAD)
output=$($CANDIDATE context-dev-next --old-branch fixture/dev --old-head "$identity_head" \
  --main "$identity_main" --new-branch fixture/next 2>&1) || fail "initial identity transition failed: $output"
identity_state=$result_gitdir/nuinui-context-command-result-v1/state
identity_output=$result_gitdir/nuinui-context-command-result-v1/output
first_request_sha=$(awk -F= '$1=="request_sha256" {print $2}' "$identity_state")
output=$($CANDIDATE context-dev-next --new-branch fixture/next --main "$identity_main" \
  --old-head "$identity_head" --old-branch fixture/dev 2>&1) || fail "reordered duplicate identity request failed: $output"
second_request_sha=$(awk -F= '$1=="request_sha256" {print $2}' "$identity_state")
[ "$first_request_sha" != "$second_request_sha" ] || fail 'reordered context-dev-next options shared a request identity'
assert_contains "$output" 'DEV-CONTEXT ALREADY TRANSITIONED' 'reordered duplicate transition'
output=$($CANDIDATE last-result 2>&1) || fail "canonical last-result was not recoverable: $output"
assert_contains "$output" 'command=context-dev-transition' 'canonical tracked command identity'
assert_contains "$output" "request_sha256=$second_request_sha" 'canonical request recovery'

collision_main=$(git -C "$TEST_PROD" rev-parse HEAD)
if collision_one=$($CANDIDATE context-dev-transition 'alpha
beta' gamma "$collision_main" fixture/invalid 2>&1); then fail 'newline collision request one unexpectedly succeeded'; fi
collision_sha_one=$(awk -F= '$1=="request_sha256" {print $2}' "$identity_state")
if collision_two=$($CANDIDATE context-dev-transition alpha 'beta
gamma' "$collision_main" fixture/invalid 2>&1); then fail 'newline collision request two unexpectedly succeeded'; fi
collision_sha_two=$(awk -F= '$1=="request_sha256" {print $2}' "$identity_state")
[ "$collision_sha_one" != "$collision_sha_two" ] || fail 'argument-boundary collision shared a request identity'

assert_allocation_failure_preserves_state() {
  allocation_case=$1
  allocation_variable=$2
  allocation_value=$3
  allocation_head=$(git -C "$TEST_DEV" rev-parse HEAD)
  allocation_branch=$(git -C "$TEST_DEV" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  cp "$identity_state" "$ROOT/state.before"
  cp "$identity_output" "$ROOT/output.before"
  if allocation_output=$(env "$allocation_variable=$allocation_value" "$CANDIDATE" \
    context-dev-transition fixture/next "$allocation_head" "$identity_main" fixture/should-not-exist 2>&1); then
    fail "$allocation_case unexpectedly succeeded"
  fi
  assert_contains "$allocation_output" 'mutation was not started' "$allocation_case diagnostic"
  case "$allocation_output" in *'⭕ result=SUCCESS'*) fail "$allocation_case emitted success result" ;; esac
  [ "$(git -C "$TEST_DEV" rev-parse HEAD)" = "$allocation_head" ] || fail "$allocation_case changed dev HEAD"
  [ "$(git -C "$TEST_DEV" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" = "$allocation_branch" ] || fail "$allocation_case changed dev branch"
  cmp -s "$ROOT/state.before" "$identity_state" || fail "$allocation_case changed prior recovery state"
  cmp -s "$ROOT/output.before" "$identity_output" || fail "$allocation_case changed prior recovery output"
}
assert_allocation_failure_preserves_state request-hash-failure NUINUI_SELFTEST_REQUEST_HASH_FAILURE fail
assert_allocation_failure_preserves_state request-hash-malformed NUINUI_SELFTEST_REQUEST_HASH_FAILURE malformed
assert_allocation_failure_preserves_state request-hash-multiline NUINUI_SELFTEST_REQUEST_HASH_FAILURE multiline
assert_allocation_failure_preserves_state operation-id-failure NUINUI_SELFTEST_OPERATION_ID_FAILURE fail
assert_allocation_failure_preserves_state operation-id-malformed NUINUI_SELFTEST_OPERATION_ID_FAILURE malformed
assert_allocation_failure_preserves_state operation-id-multiline NUINUI_SELFTEST_OPERATION_ID_FAILURE multiline
assert_allocation_failure_preserves_state timestamp-failure NUINUI_SELFTEST_TIMESTAMP_FAILURE fail
assert_allocation_failure_preserves_state timestamp-malformed NUINUI_SELFTEST_TIMESTAMP_FAILURE malformed
assert_allocation_failure_preserves_state timestamp-multiline NUINUI_SELFTEST_TIMESTAMP_FAILURE multiline

make_fixture partial-transition partial-transition
wrapper_dir=$ROOT/wrappers
mkdir -p "$wrapper_dir"
real_git=$(command -v git)
cat >"$wrapper_dir/git" <<'EOF'
#!/bin/sh
if [ "${1:-}" = -C ] && [ "${3:-}" = switch ] && [ "${4:-}" = -c ]; then
  exit 73
fi
exec "$REAL_GIT" "$@"
EOF
chmod 700 "$wrapper_dir/git"
transition_main=$(git -C "$TEST_PROD" rev-parse HEAD)
if output=$(env REAL_GIT="$real_git" PATH="$wrapper_dir:$PATH" "$CANDIDATE" context-dev-transition \
  fixture/dev "$transition_main" "$transition_main" fixture/next 2>&1); then
  fail 'injected branch creation failure unexpectedly succeeded'
fi
assert_contains "$output" 'ERROR: ordinary create/switch of new branch failed: fixture/next' 'post-detach transition error'
assert_contains "$output" 'mutation=unknown' 'post-detach mutation classification'
[ -z "$(git -C "$TEST_DEV" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" ] || fail 'injected transition did not remain detached after first switch'
if output=$(env REAL_GIT="$real_git" PATH="$wrapper_dir:$PATH" "$CANDIDATE" last-result 2>&1); then :; else fail "terminal error result was not recoverable: $output"; fi
assert_contains "$output" 'result=ERROR' 'terminal transition result'
assert_contains "$output" 'mutation=unknown' 'recovered post-detach mutation classification'
assert_contains "$output" 'ERROR: ordinary create/switch of new branch failed: fixture/next' 'recovered terminal error output'

make_fixture broken broken-link
if output=$($CANDIDATE context-check 2>&1); then fail 'broken Markdown link was accepted'; fi
assert_contains "$output" 'MISSING.md' 'broken-link diagnostic'

make_fixture missing missing-command
if output=$($CANDIDATE context-check 2>&1); then fail 'missing candidate command documentation was accepted'; fi
assert_contains "$output" 'context-dev-next' 'missing-command diagnostic'

make_fixture extra extra
git -C "$TEST_PROD" worktree add -q -b fixture/unexpected "$ROOT/extra-worktree" main
if output=$($CANDIDATE context-check 2>&1); then fail 'unexpected third registered worktree was accepted'; fi
assert_contains "$output" 'worktree inventory is invalid or unexpected' 'unexpected-worktree diagnostic'
if output=$($CANDIDATE context-dev-audit fixture/dev "$(git -C "$TEST_DEV" rev-parse HEAD)" 2>&1); then fail 'dev audit accepted unexpected worktree registration'; fi
assert_contains "$output" 'worktree registration' 'unexpected-worktree dev diagnostic'

# The established disposable-repository oracle covers terminal recovery,
# exact duplicate transitions, ambiguous states, and race-sensitive failures.
/bin/sh "$SCRIPT_DIR/test-nuinui-context-sync" "$CANDIDATE"
echo 'CONTEXT CANDIDATE FIXTURE TEST PASS'
