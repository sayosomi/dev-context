  fail 'unexpected-exit test child no longer owns its recorded listener'
kill -TERM "$abnormal_child" 2>/dev/null || fail 'failed to stop the disposable test child'
abnormal_child_attempt=0
while [ -n "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port")" ] &&
  [ "$abnormal_child_attempt" -lt 50 ]; do
  abnormal_child_attempt=$((abnormal_child_attempt + 1))
  sleep 0.1
done
[ -z "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port")" ] ||
  fail 'disposable unexpected-exit child did not release its listener'
fingerprint_before_denial
abnormal_group_attempt=0
while ! invoke_host host-status "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha"; do
  abnormal_group_attempt=$((abnormal_group_attempt + 1))
  [ "$abnormal_group_attempt" -lt 20 ] || {
    cat "$output" >&2
    fail 'unexpected-exit process group did not become empty after the child stopped'
  }
  sleep 0.1
done
contains 'process_state=ABNORMAL-EXIT-RECOVERY-SAFE'
assert_no_mutation
start_test_listener plain "$fixture_port"
fingerprint_before_denial
blocked host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
assert_no_mutation
fingerprint_before_denial
blocked host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
assert_no_mutation
kill -TERM "$foreign_pid" 2>/dev/null || true
wait "$foreign_pid" 2>/dev/null || true
foreign_pid=
fingerprint_before_denial
ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'process_state=ABNORMAL-EXIT-RECOVERY-SAFE'
contains 'recovery=explicit-host-recover-required'
assert_no_mutation
ok host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION RECOVERED FROM READY'
fake_pid=
[ ! -e "$abnormal_root" ] || fail 'abnormal-exit recovery left the isolated generation root'
ok host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'mutation=no-op'
ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"

# A PREPARING host that exits unexpectedly remains blocked until its exact
# generation process group and listener are proven empty.
advance_default vscode-abnormal-preparing-exit
fixture_generation=vscode-abnormal-preparing-0008
prepare_generation "$fixture_generation"
setup_vscode_artifacts
fixture_port=$(choose_port)
rm -f "$fixture_direct_pid_file"
if ( NUINUI_E2E_TEST_FAILPOINT=after-vscode-process-record \
  invoke_host host-prepare "$fixture_issue" "$fixture_generation" human \
    "$fixture_tested_sha" "$fixture_file" "$fixture_port" default vscode-isolated ); then
  fail 'PREPARING direct-host process-record interruption did not interrupt'
fi
contains 'interruption after verified VS Code process'
preparing_root=$(host_root_path "$fixture_generation")
preparing_pid=$(sed -n 's/^pid=//p' "$preparing_root/process-owner-v1")
preparing_group=$(sed -n 's/^process_group=//p' "$preparing_root/process-owner-v1")
preparing_child_attempt=0
while [ ! -f "$fixture_direct_pid_file" ] &&
  [ "$preparing_child_attempt" -lt 100 ]; do
  kill -0 "$preparing_pid" 2>/dev/null || fail 'PREPARING host exited before its test child listener was recorded'
  preparing_child_attempt=$((preparing_child_attempt + 1))
  sleep 0.05
done
[ -f "$fixture_direct_pid_file" ] || fail 'PREPARING test child listener identity was not recorded'
preparing_child=$(cat "$fixture_direct_pid_file")
[ "$preparing_pid" = "$preparing_group" ] || fail 'PREPARING host process group is not generation-bound'
[ "$preparing_child" != "$preparing_pid" ] || fail 'PREPARING child listener did not use a distinct process'
[ "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port")" = "$preparing_child" ] ||
  fail 'PREPARING child listener is not the recorded port owner'
grep -q '^record_state=PREPARING$' "$(host_path intent "$fixture_generation")" ||
  fail 'direct-host interruption did not leave the durable PREPARING intent intact'
[ ! -e "$(host_path ready "$fixture_generation")" ] ||
  fail 'direct-host interruption unexpectedly created the READY record'

kill -TERM "$preparing_pid" 2>/dev/null || fail 'failed to stop the disposable PREPARING host'
fingerprint_before_denial
blocked host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
assert_no_mutation
[ "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port")" = "$preparing_child" ] ||
  fail 'blocked PREPARING status changed the child listener owner'
fingerprint_before_denial
blocked host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
assert_no_mutation
[ "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port")" = "$preparing_child" ] ||
  fail 'blocked PREPARING recovery changed the child listener owner'

kill -TERM "$preparing_child" 2>/dev/null || fail 'failed to stop the disposable PREPARING child through the test harness'
preparing_exit_attempt=0
while { [ -n "$(nuinui_e2e_host_vscode__process_group_pids "$preparing_group" 2>/dev/null || true)" ] ||
    [ -n "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port" 2>/dev/null || true)" ]; } &&
  [ "$preparing_exit_attempt" -lt 50 ]; do
  preparing_exit_attempt=$((preparing_exit_attempt + 1))
  sleep 0.1
done
preparing_group_members=$(nuinui_e2e_host_vscode__process_group_pids "$preparing_group") ||
  fail 'PREPARING process group could not be inspected after child shutdown'
[ -z "$preparing_group_members" ] || fail 'PREPARING process group remained occupied after child shutdown'
[ -z "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port")" ] ||
  fail 'PREPARING CDP port remained occupied after child shutdown'

fingerprint_before_denial
preparing_status_attempt=0
while ! invoke_host host-status "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha"; do
  preparing_status_attempt=$((preparing_status_attempt + 1))
  [ "$preparing_status_attempt" -lt 20 ] || {
    cat "$output" >&2
    fail 'PREPARING abnormal-exit status did not become safe after process-group and port shutdown'
  }
  sleep 0.1
done
contains 'HOST SESSION PREPARING'
contains 'process_state=ABNORMAL-EXIT-RECOVERY-SAFE'
contains 'recovery=explicit-host-recover-required'
assert_no_mutation
ok host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION RECOVERED FROM PREPARING'
[ ! -e "$preparing_root" ] || fail 'PREPARING abnormal-exit recovery left the isolated generation root'
ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST AND NATIVE CLOSURE VERIFIED'
contains 'clean=yes'
contains 'detached=yes'

fixture_app_mode=launcher
fixture_direct_child=no
fixture_cdp_kind=fake

# Historical released records remain valid while a later generation is admitted.
advance_default vscode-generation-3
fixture_generation=vscode-recovery-gen-0003
prepare_generation "$fixture_generation"
setup_vscode_artifacts
fixture_port=$(choose_port)
if ( NUINUI_E2E_TEST_FAILPOINT=after-host-resources \
  invoke_host host-prepare "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha" \
    "$fixture_file" "$fixture_port" default vscode-isolated ); then
  fail 'preparation interruption failpoint did not interrupt'
fi
contains 'interruption'
fingerprint_before_denial
blocked admit "$fixture_issue" vscode-next-generation-0004 human "$fixture_tested_sha"
assert_no_mutation
ok host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"

# The isolated VS Code adapter uses a private HOME-backed production-root
# layout in fixture mode, and its normal closure/recovery lifecycle is intact.
new_fixture one
host_test_root_mode=production
host_test_home=$fixture_root/private-home
mkdir -m 0700 "$host_test_home" || fail 'production-root VS Code test HOME'
fixture_generation=vscode-production-root-0007
prepare_generation "$fixture_generation"
setup_vscode_artifacts
fixture_port=$(choose_port)
ok host-check "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha" \
  "$fixture_file" "$fixture_port" default vscode-isolated
ok host-prepare "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha" \
  "$fixture_file" "$fixture_port" default vscode-isolated
contains 'HOST SESSION READY (adapter=vscode-isolated'
production_root=$(host_root_path "$fixture_generation")
production_parent=$host_test_home/.nuinuicad/e2e-hosts
[ "$(stat -f '%Lp' "$production_parent")" = 700 ] ||
  fail 'VS Code production host parent mode is not 0700'
[ "$(stat -f '%Lp' "$production_root")" = 700 ] ||
  fail 'VS Code production generation root mode is not 0700'
[ "$(stat -f '%u' "$production_root")" = "$(command id -u)" ] ||
  fail 'VS Code production generation root is not owned by the current user'
ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST AND NATIVE CLOSURE VERIFIED'
[ ! -e "$production_root" ] && [ ! -L "$production_root" ] ||
  fail 'VS Code production-root closure left its generation directory'

# Convert this disposable, fully released VS Code generation to the previous
# implementation's /.nuinui-e2e-host-<hash> metadata. Rebind cleanup hashes to
# the exact fixture records, then prove a later admission reads those records
# without changing them. No legacy filesystem root is created.
legacy_root=$(printf '/.nuinui-e2e-host-%s\n' \
  "$(printf '%s\n' "$fixture_generation" | shasum -a 256 | awk 'NR == 1 {print $1}')")
[ ! -e "$legacy_root" ] && [ ! -L "$legacy_root" ] ||
  fail 'legacy production root unexpectedly exists before history fixture setup'
for history_kind in intent handoff ready cleanup-pending cleanup; do
  history_record=$(host_path "$history_kind" "$fixture_generation")
  [ -f "$history_record" ] || continue
  history_tmp=$history_record.legacy-fixture
  awk -F= -v root="$legacy_root" \
    '$1 == "root" {print "root=" root; next} {print}' \
    "$history_record" > "$history_tmp" || fail 'legacy VS Code history root rewrite'
  chmod 600 "$history_tmp"
  mv "$history_tmp" "$history_record"
done
history_handoff_sha=$(shasum -a 256 "$(host_path handoff "$fixture_generation")" |
  awk 'NR == 1 {print $1}')
history_cleanup_record=$(host_path cleanup "$fixture_generation")
history_cleanup_tmp=$history_cleanup_record.legacy-fixture
awk -F= -v sha="$history_handoff_sha" \
  '$1 == "cleanup_handoff_sha256" {print "cleanup_handoff_sha256=" sha; next} {print}' \
  "$history_cleanup_record" > "$history_cleanup_tmp" || fail 'legacy VS Code handoff proof rebinding'
chmod 600 "$history_cleanup_tmp"
mv "$history_cleanup_tmp" "$history_cleanup_record"
history_native_cleanup=$(native_path cleanup "$fixture_generation")
history_host_cleanup_sha=$(shasum -a 256 "$history_cleanup_record" |
  awk 'NR == 1 {print $1}')
history_native_cleanup_tmp=$history_native_cleanup.legacy-fixture
awk -F= -v sha="$history_host_cleanup_sha" \
  '$1 == "host_cleanup_sha256" {print "host_cleanup_sha256=" sha; next} {print}' \
  "$history_native_cleanup" > "$history_native_cleanup_tmp" || fail 'legacy VS Code native cleanup proof rebinding'
chmod 600 "$history_native_cleanup_tmp"
mv "$history_native_cleanup_tmp" "$history_native_cleanup"
legacy_history_records=$(released_history_fingerprint "$fixture_generation")

advance_default vscode-production-after-legacy-history
fixture_generation=vscode-production-after-legacy-0008
prepare_generation "$fixture_generation"
contains 'NATIVE E2E FIXTURE STARTED'
[ "$(released_history_fingerprint vscode-production-root-0007)" = \
  "$legacy_history_records" ] || fail 'legacy VS Code history changed during later admission'
ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION ABSENT'

# Continue the still-active generation through the interrupted production-root
# preparation so its native lifecycle can be closed with exact evidence.
setup_vscode_artifacts
fixture_port=$(choose_port)
host_failpoint after-host-intent host-prepare "$fixture_issue" \
  "$fixture_generation" human "$fixture_tested_sha" "$fixture_file" \
  "$fixture_port" default vscode-isolated
contains 'interruption after PREPARING intent'
ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION PREPARING'
ok host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION RECOVERED FROM PREPARING'
ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST AND NATIVE CLOSURE VERIFIED'
[ ! -e "$(host_root_path "$fixture_generation")" ] ||
  fail 'recovered VS Code production root remains'

test_zero_human_lanes
echo 'VSCODE HOST SELFTEST PASS (fixture-only; no Visual Studio Code application launched)'
