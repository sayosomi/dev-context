fixture_generation=vscode-isolated-cleanup-0001
prepare_generation "$fixture_generation"
setup_vscode_artifacts
fixture_port=$(choose_port)

echo 'VSCODE HOST SELFTEST: direct launch, HTTP CDP, status and isolated cleanup'
# Preserve immutable artifact admission without repeating the shared identity matrix.
