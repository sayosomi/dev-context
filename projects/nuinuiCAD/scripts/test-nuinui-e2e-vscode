fixture_trace_prepare=yes
fixture_prepare_time=$(python3 -c 'import time; print(time.monotonic())')
ok host-prepare "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha" \
  "$fixture_file" "$fixture_port" default vscode-isolated
fixture_trace_prepare=no
python3 - "$fixture_prepare_time" <<'PYTHON'
import sys,time
print(f"HOST PREPARE SECONDS: {time.monotonic()-float(sys.argv[1]):.3f}")
PYTHON
contains 'HOST SESSION READY (adapter=vscode-isolated'
validation_calls=$(awk '$1 ~ /^\++$/ && $2 == "nuinui_e2e_host_vscode__validate_artifacts" {n++} END {print n+0}' "$output")
snapshot_calls=$(awk '$1 ~ /^\++$/ && $2 == "nuinui_e2e_host_vscode__snapshot_info" {n++} END {print n+0}' "$output")
echo "STARTUP VALIDATION CALLS: $validation_calls; SNAPSHOT HASH PASSES: $snapshot_calls"
[ "$validation_calls" = 1 ] && [ "$snapshot_calls" = 1 ] || fail 'startup must validate artifacts exactly once'
if [ "${NUINUI_E2E_VSCODE_TEST_CASE:-all}" = startup ]; then
  echo 'VSCODE STARTUP SELFTEST PASS'
  exit 0
fi
direct_root=$(host_root_path "$fixture_generation")
direct_pid=$(sed -n 's/^pid=//p' "$direct_root/process-owner-v1")
kill -0 "$direct_pid" 2>/dev/null || fail 'direct application exited before status'
[ "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port")" = "$direct_pid" ] ||
  fail 'direct application does not own its CDP listener'
curl --noproxy '*' --max-time 1 -fsS "http://127.0.0.1:$fixture_port/json/version" \
  >/dev/null || fail 'HTTP CDP endpoint is not ready'
fingerprint_before_denial
ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION READY'
contains 'mutation=no'
assert_no_mutation

# VS Code profile contents may include sockets and links; cleanup must preserve link targets.
profile_target=$fixture_root/foreign-profile-target
printf 'preserve me\n' > "$profile_target"
profile_link=$direct_root/user-data/User/globalStorage/unowned-link
ln -s "$profile_target" "$profile_link"
python3 - "$direct_root/user-data/fixture.sock" <<'PYTHON'
import os, socket, sys
os.chdir(os.path.dirname(sys.argv[1]))
with socket.socket(socket.AF_UNIX) as ipc:
    ipc.bind(os.path.basename(sys.argv[1]))
PYTHON
fingerprint_before_denial
ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
assert_no_mutation
[ -L "$profile_link" ] && [ -f "$profile_target" ] || fail 'foreign link target changed'

foreign_vscode_port=$(choose_port)
NUINUICAD_RUST_EVALUATION_BINARY="$fixture_snapshot/bin/evaluation_stdio" \
  "$fixture_app/Contents/MacOS/Code" \
    "--user-data-dir=$fixture_root/unrelated-vscode/user-data" \
    "--extensions-dir=$fixture_root/unrelated-vscode/extensions" \
    "--extensionDevelopmentPath=$fixture_snapshot/extension" \
    "--remote-debugging-port=$foreign_vscode_port" "$fixture_file" \
    >/dev/null 2>&1 &
foreign_vscode_pid=$!
foreign_vscode_attempt=0
while [ -z "$(nuinui_e2e_host_vscode__listener_pids "$foreign_vscode_port")" ] &&
  [ "$foreign_vscode_attempt" -lt 50 ]; do
  kill -0 "$foreign_vscode_pid" 2>/dev/null || fail 'unrelated disposable host exited'
  foreign_vscode_attempt=$((foreign_vscode_attempt + 1))
  sleep 0.1
done
[ "$(nuinui_e2e_host_vscode__listener_pids "$foreign_vscode_port")" = "$foreign_vscode_pid" ] ||
  fail 'unrelated host did not acquire its separate CDP listener'
host_failpoint after-host-cleanup-pending host-cleanup \
  "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
ok host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
[ ! -e "$direct_root" ] || fail 'isolated cleanup left its generation root'
[ -z "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port")" ] ||
  fail 'isolated cleanup left its CDP listener'
kill -0 "$foreign_vscode_pid" 2>/dev/null || fail 'cleanup stopped an unrelated host'
[ "$(nuinui_e2e_host_vscode__listener_pids "$foreign_vscode_port")" = "$foreign_vscode_pid" ] ||
  fail 'cleanup changed an unrelated host listener'
[ -f "$profile_target" ] || fail 'cleanup removed an unrelated file'
kill -TERM "$foreign_vscode_pid" 2>/dev/null || true
wait "$foreign_vscode_pid" 2>/dev/null || true
foreign_vscode_pid=
ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST AND NATIVE CLOSURE VERIFIED'
contains 'clean=yes'
contains 'detached=yes'

echo 'VSCODE HOST SELFTEST: interrupted direct launch recovery and native closure'
advance_default vscode-interrupted-launch
fixture_generation=vscode-interrupted-launch-0002
prepare_generation "$fixture_generation"
setup_vscode_artifacts
fixture_port=$(choose_port)
host_failpoint after-vscode-process-record host-prepare \
  "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha" \
  "$fixture_file" "$fixture_port" default vscode-isolated
direct_root=$(host_root_path "$fixture_generation")
direct_pid=$(sed -n 's/^pid=//p' "$direct_root/process-owner-v1")
kill -0 "$direct_pid" 2>/dev/null || fail 'interrupted preparation did not leave the host running'
ok host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION RECOVERED FROM PREPARING'
[ ! -e "$direct_root" ] || fail 'interrupted preparation recovery left its root'
[ -z "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port")" ] ||
  fail 'interrupted preparation recovery left its listener'
ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST AND NATIVE CLOSURE VERIFIED'

echo 'VSCODE HOST SELFTEST: abnormal exit status and explicit recovery'
advance_default vscode-abnormal-exit
fixture_generation=vscode-abnormal-exit-0003
prepare_generation "$fixture_generation"
setup_vscode_artifacts
fixture_port=$(choose_port)
ok host-prepare "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha" \
  "$fixture_file" "$fixture_port" default vscode-isolated
direct_root=$(host_root_path "$fixture_generation")
direct_pid=$(sed -n 's/^pid=//p' "$direct_root/process-owner-v1")
# Simulate device drift in this disposable generation's durable evidence.
python3 - "$(git -C "$fixture_human" rev-parse --absolute-git-dir)" "$direct_root" "$fixture_generation" <<'PYTHON'
import pathlib, sys
git_dir, root = map(pathlib.Path, sys.argv[1:3])
generation = sys.argv[3]
for path in list(git_dir.glob('nuinui-github-e2e-host-*')) + list(root.iterdir()):
    if not path.is_file() or path.is_symlink(): continue
    text = path.read_text()
    if f'generation={generation}\n' not in text: continue
    rows = []
    for row in text.splitlines(keepends=True):
        if row.startswith(('root_identity=', 'vscode_artifact_identity=')):
            key, value = row.rstrip('\n').split('=', 1)
            if ':' in value: row = key + '=999999:' + value.split(':', 1)[1] + '\n'
        rows.append(row)
    path.write_text(''.join(rows))
PYTHON
fingerprint_before_denial
blocked host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
assert_no_mutation
kill -TERM "$direct_pid" 2>/dev/null || fail 'failed to stop disposable host for abnormal-exit test'
exit_attempt=0
while [ -n "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port")" ] &&
  [ "$exit_attempt" -lt 50 ]; do
  exit_attempt=$((exit_attempt + 1))
  sleep 0.1
done
[ -z "$(nuinui_e2e_host_vscode__listener_pids "$fixture_port")" ] ||
  fail 'abnormally exited host retained its listener'
# Ordinary cleanup and a changed inode still fail without mutating evidence.
fingerprint_before_denial
blocked host-cleanup "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
assert_no_mutation
cp "$direct_root/.nuinui-vscode-host-owner-v1" "$fixture_root/owner.saved"
sed 's/^root_identity=.*/root_identity=999999:1/' "$fixture_root/owner.saved" > "$direct_root/.nuinui-vscode-host-owner-v1"
fingerprint_before_denial
blocked host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
assert_no_mutation
cp "$fixture_root/owner.saved" "$direct_root/.nuinui-vscode-host-owner-v1"
fingerprint_before_denial
ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'process_state=ABNORMAL-EXIT-RECOVERY-SAFE'
contains 'recovery=explicit-host-recover-required'
assert_no_mutation
ok host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION RECOVERED FROM READY'
[ ! -e "$direct_root" ] || fail 'abnormal-exit recovery left its root'
ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST AND NATIVE CLOSURE VERIFIED'

echo 'VSCODE HOST SELFTEST PASS (fixture-only; no Visual Studio Code application launched)'
