#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
helper=$script_dir/nuinui-e2e
fixture_root=
fixture_impl=
fixture_human=
fixture_manifest=
fixture_remote=
fixture_file=
fixture_dogfood=
fixture_snapshot=
fixture_app=
fixture_tested_sha=
fixture_issue=sayosomi/nuinuiCAD#268
fixture_generation=
fixture_port=
fixture_cdp_kind=fake
fixture_app_mode=launcher
fixture_app_sha=
fixture_direct_child=no
fixture_direct_pid_file=
fixture_direct_external_helper=no
fixture_direct_external_pid_file=
fixture_proc_list_zeroes=0
output=
foreign_pid=
fake_pid=
host_test_root_mode=fixture
host_test_home=

cleanup() {
  cleanup_status=$?
  trap - EXIT HUP INT TERM
  cleanup_preserve_fixture=no
  if [ -n "$foreign_pid" ]; then
    kill -TERM "$foreign_pid" 2>/dev/null || true
    wait "$foreign_pid" 2>/dev/null || true
  fi
  if [ -n "$fixture_direct_pid_file" ] && [ -f "$fixture_direct_pid_file" ] &&
    [ -n "$fixture_port" ]; then
    cleanup_direct_child=$(cat "$fixture_direct_pid_file" 2>/dev/null || true)
    cleanup_direct_listener=$(nuinui_e2e_host_vscode__listener_pids \
      "$fixture_port" 2>/dev/null || true)
    if [ -n "$cleanup_direct_child" ] &&
      [ "$cleanup_direct_listener" = "$cleanup_direct_child" ] &&
      kill -0 "$cleanup_direct_child" 2>/dev/null; then
      kill -TERM "$cleanup_direct_child" 2>/dev/null || true
    fi
  fi
  if [ -n "$fixture_root" ] && [ -d "$fixture_root" ]; then
    if [ -n "$fixture_generation" ] && [ -f "$fixture_manifest" ] &&
      command -v invoke_host >/dev/null 2>&1; then
      cleanup_host_root=$(host_root_path "$fixture_generation") || cleanup_host_root=
      if [ -n "$cleanup_host_root" ] &&
        { [ -e "$cleanup_host_root" ] || [ -L "$cleanup_host_root" ]; }; then
        if invoke_host host-cleanup "$fixture_issue" "$fixture_generation" human \
          "$fixture_tested_sha" ||
          invoke_host host-recover "$fixture_issue" "$fixture_generation" human \
            "$fixture_tested_sha"; then
          fake_pid=
        else
          echo 'VSCODE HOST SELFTEST CLEANUP BLOCKED: preserving fixture because exact host recovery failed' >&2
          [ -z "$output" ] || { [ ! -f "$output" ] || cat "$output" >&2; }
          cleanup_preserve_fixture=yes
        fi
      fi
    fi
    if [ -n "$fake_pid" ] && kill -0 "$fake_pid" 2>/dev/null; then
      echo 'VSCODE HOST SELFTEST CLEANUP BLOCKED: preserving fixture because a fake process may remain' >&2
      cleanup_preserve_fixture=yes
    fi
    if [ "$cleanup_preserve_fixture" = no ]; then
      find "$fixture_root" -type d -name '.nuinui-e2e-host-*' -print |
        while IFS= read -r cleanup_host_root; do
          chmod -R u+rwx "$cleanup_host_root" 2>/dev/null || true
        done
      rm -rf "$fixture_root"
    else
      echo "VSCODE HOST SELFTEST: retained fixture root $fixture_root for safe recovery" >&2
      cleanup_status=1
    fi
  fi
  exit "$cleanup_status"
}
trap cleanup EXIT HUP INT TERM

fail() {
  echo "VSCODE HOST SELFTEST FAIL: $*" >&2
  [ -z "$output" ] || { [ ! -f "$output" ] || cat "$output" >&2; }
  exit 1
}

contains() { grep -Fq -- "$1" "$output" || fail "expected output to contain: $1"; }

new_fixture() {
  mode=$1
  host_test_root_mode=fixture
  host_test_home=
  if [ -n "$fake_pid" ]; then
    fail 'previous fake process is still recorded; refusing to signal it outside adapter cleanup'
  fi
  [ -z "$fixture_root" ] || rm -rf "$fixture_root"
  fixture_root=$(mktemp -d "${TMPDIR:-/tmp}/nuinui-e2e-fixture.XXXXXX") || fail 'temporary root'
  fixture_root=$(realpath "$fixture_root") || fail 'canonical temporary root'
  fixture_impl=$fixture_root/implementation
  fixture_human=$fixture_root/human
  fixture_remote=$fixture_root/remote/sayosomi/nuinuiCAD.git
  fixture_manifest=$fixture_root/LANES.conf
  fixture_file=$fixture_root/host-fixture.html
  fixture_dogfood=$fixture_root/dogfood
  fixture_app=$fixture_root/fake-vscode/'Visual Studio Code.app'
  fixture_app_mode=launcher
  fixture_app_sha=
  fixture_direct_child=no
  fixture_direct_external_helper=no
  fixture_proc_list_zeroes=0
  fixture_direct_pid_file=$fixture_root/direct-child.pid
  fixture_direct_external_pid_file=$fixture_root/direct-external-helper.pid
  output=$fixture_root/command.out
  mkdir -p "$fixture_root/remote/sayosomi" || fail 'fixture remote directory'
  printf 'schema_version=1\n' > "$fixture_root/.nuinui-e2e-fixture"
  printf '<!doctype html><title>disposable fixture</title>\n' > "$fixture_file"
  git init --bare --initial-branch=main -q "$fixture_remote" || fail 'bare fixture repository'
  git init -b main -q "$fixture_impl" || fail 'implementation repository'
  git -C "$fixture_impl" config user.name 'nuinui-e2e VS Code fixture'
  git -C "$fixture_impl" config user.email 'nuinui-e2e-vscode-fixture@example.invalid'
  printf 'base\n' > "$fixture_impl/fixture.txt"
  git -C "$fixture_impl" add fixture.txt
  git -C "$fixture_impl" commit -q -m 'fixture base' || fail 'fixture commit'
  git -C "$fixture_impl" remote add origin "$fixture_remote"
  git -C "$fixture_impl" push -q origin main || fail 'fixture push'
  fixture_tested_sha=$(git -C "$fixture_impl" rev-parse HEAD)
  printf 'version=1\n' > "$(git -C "$fixture_impl" rev-parse --absolute-git-dir)/nuinui-implementation-v1"
  if [ "$mode" = one ]; then
    git -C "$fixture_impl" worktree add --detach -q "$fixture_human" "$fixture_tested_sha" || fail 'Human-test checkout'
  fi
  {
    printf 'version=1\nrepository=sayosomi/nuinuiCAD\ndefault_branch=main\n'
    printf '\n[lane implementation]\nrole=implementation\npath=%s\nidle=branch\n' "$fixture_impl"
    if [ "$mode" = one ]; then
      printf '\n[lane human]\nrole=human-test\npath=%s\nidle=detached\n' "$fixture_human"
    fi
  } > "$fixture_manifest"
  fixture_snapshot=
}

advance_default() {
  printf 'advance %s\n' "$1" >> "$fixture_impl/fixture.txt"
  git -C "$fixture_impl" add fixture.txt
  git -C "$fixture_impl" commit -q -m "fixture advance $1" || fail 'advance default branch'
  git -C "$fixture_impl" push -q origin main || fail 'push default branch'
  fixture_tested_sha=$(git -C "$fixture_impl" rev-parse HEAD)
  fixture_snapshot=
}

setup_vscode_artifacts() {
  [ -n "$fixture_snapshot" ] && return 0
  mkdir -p "$fixture_dogfood/snapshots" \
    "$fixture_root/fake-extension/extension/dist" \
    "$fixture_root/fake-extension/extension/syntaxes" \
    "$fixture_root/fake-extension/bin" \
    "$fixture_app/Contents/MacOS"
  printf '{"main":"./dist/extension.js"}\n' > "$fixture_root/fake-extension/extension/package.json"
  printf '{"comments":[],"brackets":[]}\n' > "$fixture_root/fake-extension/extension/language-configuration.json"
  printf 'extension-stub\n' > "$fixture_root/fake-extension/extension/dist/extension.js"
  printf 'webview-stub\n' > "$fixture_root/fake-extension/extension/dist/webview.js"
  printf 'body{}\n' > "$fixture_root/fake-extension/extension/dist/webview.css"
  printf 'syntax-stub\n' > "$fixture_root/fake-extension/extension/syntaxes/nuinui.tmLanguage.json"
  printf '#!/bin/sh\nexit 0\n' > "$fixture_root/fake-extension/bin/evaluation_stdio"
  chmod 755 "$fixture_root/fake-extension/bin/evaluation_stdio"
  case "$fixture_app_mode" in
    launcher)
      nuinui_e2e_host_vscode__fake_launcher_content > "$fixture_app/Contents/MacOS/Code"
      chmod 755 "$fixture_app/Contents/MacOS/Code"
      ;;
    direct)
      cat > "$fixture_root/disposable-vscode-host.c" <<'C'
#include <arpa/inet.h>
#include <errno.h>
#include <limits.h>
#include <netinet/in.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>

static void make_dirs(const char *path) {
  char copy[PATH_MAX];
  if (strlen(path) >= sizeof(copy)) _exit(2);
  strcpy(copy, path);
  for (char *p = copy + 1; *p; p++) {
    if (*p == '/') { *p = '\0'; mkdir(copy, 0700); *p = '/'; }
  }
  if (mkdir(copy, 0700) != 0 && errno != EEXIST) _exit(2);
}

static void write_file(const char *path, const char *content) {
  FILE *stream;
  char parent[PATH_MAX];
  if (strlen(path) >= sizeof(parent)) _exit(2);
  strcpy(parent, path);
  char *slash = strrchr(parent, '/');
  if (!slash) _exit(2);
  *slash = '\0';
  make_dirs(parent);
  stream = fopen(path, "w");
  if (!stream) _exit(2);
  fputs(content, stream);
  if (fclose(stream) != 0) _exit(2);
}

static const char *arg_value(int argc, char **argv, const char *prefix) {
  size_t length = strlen(prefix);
  for (int i = 1; i < argc; i++) if (strncmp(argv[i], prefix, length) == 0) return argv[i] + length;
  return NULL;
}

static void create_profile(const char *user_data, const char *extensions) {
  char path[PATH_MAX];
  snprintf(path, sizeof(path), "%s/User/globalStorage/state.vscdb", user_data);
  write_file(path, "disposable direct host storage\n");
  snprintf(path, sizeof(path), "%s/User/workspaceStorage/direct/workspace.json", user_data);
  write_file(path, "{}\n");
  snprintf(path, sizeof(path), "%s/logs/direct/window1/exthost/extension.log", user_data);
  write_file(path, "disposable extension log\n");
  snprintf(path, sizeof(path), "%s/CachedData/direct/session.json", user_data);
  write_file(path, "{}\n");
  snprintf(path, sizeof(path), "%s/extensions.json", extensions);
  write_file(path, "[]\n");
  snprintf(path, sizeof(path), "%s/publisher.extension-1.0.0/package.json", extensions);
  write_file(path, "{}\n");
}

static int serve(int port) {
  int server = socket(AF_INET, SOCK_STREAM, 0);
  struct sockaddr_in address;
  if (server < 0) return 2;
  memset(&address, 0, sizeof(address));
  address.sin_family = AF_INET;
  address.sin_port = htons((unsigned short)port);
  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
  if (bind(server, (struct sockaddr *)&address, sizeof(address)) != 0 || listen(server, 8) != 0) return 2;
  for (;;) {
    int client = accept(server, NULL, NULL);
    if (client < 0) { if (errno == EINTR) continue; return 2; }
    char request[2048];
    (void)read(client, request, sizeof(request));
    char body[512];
    int body_size = snprintf(body, sizeof(body),
      "{\"Browser\":\"Chrome/134.0.6998.205\",\"Protocol-Version\":\"1.3\",\"User-Agent\":\"Chrome/134.0.6998.205 Electron/35.1.5\",\"webSocketDebuggerUrl\":\"ws://127.0.0.1:%d/devtools/browser/disposable-direct\"}", port);
    char response[1024];
    int response_size = snprintf(response, sizeof(response),
      "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s", body_size, body);
    (void)write(client, response, (size_t)response_size);
    close(client);
  }
}

int main(int argc, char **argv) {
  const char *port_arg = arg_value(argc, argv, "--remote-debugging-port=");
  const char *user_data = arg_value(argc, argv, "--user-data-dir=");
  const char *extensions = arg_value(argc, argv, "--extensions-dir=");
  const char *rust = getenv("NUINUICAD_RUST_EVALUATION_BINARY");
  int port = port_arg ? atoi(port_arg) : 0;
  if (!port_arg || !user_data || !extensions || !rust || access(rust, X_OK) != 0) return 2;
  create_profile(user_data, extensions);
  if (strcmp(getenv("NUINUI_E2E_TEST_DIRECT_CHILD_LISTENER") ?
      getenv("NUINUI_E2E_TEST_DIRECT_CHILD_LISTENER") : "no", "yes") == 0) {
    pid_t child = fork();
    if (child < 0) return 2;
    if (child == 0) _exit(serve(port));
    const char *pid_file = getenv("NUINUI_E2E_TEST_DIRECT_PID_FILE");
    if (!pid_file) return 2;
    FILE *stream = fopen(pid_file, "w");
    if (!stream) return 2;
    fprintf(stream, "%d\n", (int)child);
    fclose(stream);
    if (strcmp(getenv("NUINUI_E2E_TEST_DIRECT_EXTERNAL_HELPER") ?
        getenv("NUINUI_E2E_TEST_DIRECT_EXTERNAL_HELPER") : "no", "yes") == 0) {
      pid_t helper = fork();
      if (helper < 0) return 2;
      if (helper == 0) {
        execl("/bin/sleep", "sleep", "60", (char *)NULL);
        _exit(127);
      }
      const char *helper_pid_file = getenv("NUINUI_E2E_TEST_DIRECT_EXTERNAL_PID_FILE");
      if (!helper_pid_file) return 2;
      stream = fopen(helper_pid_file, "w");
      if (!stream) return 2;
      fprintf(stream, "%d\n", (int)helper);
      fclose(stream);
    }
    for (;;) pause();
  }
  return serve(port);
}
C
      /usr/bin/clang -O2 -Wall -Wextra -Werror \
        "$fixture_root/disposable-vscode-host.c" -o "$fixture_app/Contents/MacOS/Code" ||
        fail 'compile disposable direct VS Code-shaped host'
      fixture_app_sha=$(shasum -a 256 "$fixture_app/Contents/MacOS/Code" | awk 'NR == 1 {print $1}')
      ;;
    *) fail 'unsupported disposable application mode' ;;
  esac
  [ -n "$fixture_app_sha" ] || fixture_app_sha=$(shasum -a 256 "$fixture_app/Contents/MacOS/Code" | awk 'NR == 1 {print $1}')
  cat > "$fixture_app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.microsoft.VSCode</string>
<key>CFBundleExecutable</key><string>Code</string>
</dict></plist>
PLIST
  arch=$(uname -m)
  case "$arch" in x86_64) arch_name=x64 ;; aarch64|arm64) arch_name=arm64 ;; *) fail 'unsupported Mac architecture' ;; esac
  identity=$fixture_tested_sha-darwin-$arch_name
  fixture_snapshot=$fixture_dogfood/snapshots/$identity
  mkdir -p "$fixture_snapshot"
  cp -R "$fixture_root/fake-extension/extension" "$fixture_snapshot/extension"
  mkdir -p "$fixture_snapshot/bin"
  cp "$fixture_root/fake-extension/bin/evaluation_stdio" "$fixture_snapshot/bin/evaluation_stdio"
  python3 - "$fixture_snapshot" "$identity" "$fixture_tested_sha" <<'PY'
import hashlib, json, os, sys
root, identity, sha = sys.argv[1:]
files = {}
for current, dirs, names in os.walk(root):
    dirs.sort()
    for name in sorted(names):
        path = os.path.join(current, name)
        relative = os.path.relpath(path, root).replace(os.sep, "/")
        with open(path, "rb") as stream:
            files[relative] = hashlib.sha256(stream.read()).hexdigest()
meta = {
    "schemaVersion": 1,
    "identity": identity,
    "gitSha": sha,
    "platform": "darwin",
    "architecture": identity.rsplit("-", 1)[1],
    "extensionPath": "extension",
    "evaluatorPath": "bin/evaluation_stdio",
    "files": dict(sorted(files.items())),
}
with open(os.path.join(root, "snapshot.json"), "w", encoding="utf-8") as stream:
    json.dump(meta, stream, separators=(",", ":"))
    stream.write("\n")
with open(os.path.join(os.path.dirname(root), "..", "current.json"), "w", encoding="utf-8") as stream:
    json.dump({"schemaVersion": 1, "identity": identity}, stream, separators=(",", ":"))
    stream.write("\n")
PY
}

choose_port() {
  python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()'
}

invoke() {
  command_name=$1 issue=$2 generation=$3 lane=$4 tested=$5
  shift 5
  host_fixture_arg=${1-}
  host_port_arg=${2-}
  host_locale_arg=${3:-default}
  host_adapter_arg=${4:-fixture-no-process}
  set -- "$command_name" --self-test --manifest "$fixture_manifest" \
    --issue "$issue" --generation "$generation" --tested-sha "$tested"
  [ -z "$lane" ] || set -- "$@" --lane "$lane"
  if [ "$command_name" = host-check ] || [ "$command_name" = host-prepare ]; then
    set -- "$@" --fixture "$host_fixture_arg" --port "$host_port_arg" \
      --locale "$host_locale_arg" --adapter "$host_adapter_arg"
  fi
  if [ "$host_test_root_mode" = production ]; then
    env HOME="$host_test_home" NUINUI_E2E_TEST_PRODUCTION_HOST_ROOT=yes \
      NUINUI_E2E_TEST_DOGFOOD_ROOT="$fixture_dogfood" \
      NUINUI_E2E_TEST_VSCODE_APP_ROOT="$fixture_app" \
      NUINUI_E2E_TEST_VSCODE_APP_MODE="$fixture_app_mode" \
      NUINUI_E2E_TEST_VSCODE_APP_SHA256="$fixture_app_sha" \
      NUINUI_E2E_TEST_CDP_KIND="$fixture_cdp_kind" \
      NUINUI_E2E_TEST_DIRECT_CHILD_LISTENER="$fixture_direct_child" \
      NUINUI_E2E_TEST_DIRECT_PID_FILE="$fixture_direct_pid_file" \
      NUINUI_E2E_TEST_DIRECT_EXTERNAL_HELPER="$fixture_direct_external_helper" \
      NUINUI_E2E_TEST_DIRECT_EXTERNAL_PID_FILE="$fixture_direct_external_pid_file" \
      NUINUI_E2E_TEST_PROC_LISTPIDS_ZEROES="$fixture_proc_list_zeroes" \
      "$helper" "$@" > "$output" 2>&1
  else
    env NUINUI_E2E_TEST_DOGFOOD_ROOT="$fixture_dogfood" \
      NUINUI_E2E_TEST_VSCODE_APP_ROOT="$fixture_app" \
      NUINUI_E2E_TEST_VSCODE_APP_MODE="$fixture_app_mode" \
      NUINUI_E2E_TEST_VSCODE_APP_SHA256="$fixture_app_sha" \
      NUINUI_E2E_TEST_CDP_KIND="$fixture_cdp_kind" \
      NUINUI_E2E_TEST_DIRECT_CHILD_LISTENER="$fixture_direct_child" \
      NUINUI_E2E_TEST_DIRECT_PID_FILE="$fixture_direct_pid_file" \
      NUINUI_E2E_TEST_DIRECT_EXTERNAL_HELPER="$fixture_direct_external_helper" \
      NUINUI_E2E_TEST_DIRECT_EXTERNAL_PID_FILE="$fixture_direct_external_pid_file" \
      NUINUI_E2E_TEST_PROC_LISTPIDS_ZEROES="$fixture_proc_list_zeroes" \
      "$helper" "$@" > "$output" 2>&1
  fi
}

invoke_host() {
  command_name=$1 issue=$2 generation=$3 lane=$4 tested=$5
  fixture=${6-}
  port=${7-}
  locale=${8:-default}
  adapter=${9:-fixture-no-process}
  if [ "$command_name" = host-check ] || [ "$command_name" = host-prepare ]; then
    invoke "$command_name" "$issue" "$generation" "$lane" "$tested" \
      "$fixture" "$port" "$locale" "$adapter"
  else
    invoke "$command_name" "$issue" "$generation" "$lane" "$tested"
  fi
}

ok() {
  if ! invoke_host "$@"; then
    cat "$output" >&2
    fail "command failed: $1"
  fi
}

blocked() {
  echo "expect-blocked: $*" >&2
  if invoke_host "$@"; then
    fail "command unexpectedly succeeded: $1"
  fi
  grep -Eq 'BLOCKED|blocked|ERROR:' "$output" || fail "refusal was unexplained: $1"
}

host_failpoint() {
  failpoint=$1
  shift
  if ( NUINUI_E2E_TEST_FAILPOINT=$failpoint invoke_host "$@" ); then
    fail "host failpoint did not interrupt: $failpoint"
  fi
  contains 'interruption'
}

start_test_listener() {
  mode=$1
  port=$2
  listener_ready=$fixture_root/test-listener-ready-$port-$mode
  node -e 'const fs=require("node:fs"); const http=require("node:http"); const port=Number(process.argv[1]); const mode=process.argv[2]; const ready=process.argv[3]; const server=http.createServer((request,response)=>{if(mode==="plausible"){const body=JSON.stringify({Browser:"FakeVSCode/1.0","Protocol-Version":"1.3",webSocketDebuggerUrl:`ws://127.0.0.1:${port}/devtools/browser/foreign`});response.writeHead(200,{"Content-Type":"application/json","Content-Length":Buffer.byteLength(body)});response.end(body);}else{response.writeHead(200);response.end("busy");}});server.listen(port,"127.0.0.1",()=>fs.writeFileSync(ready,"ready\\n",{flag:"wx",mode:0o600}));' \
    "$port" "$mode" "$listener_ready" >"$fixture_root/test-listener.log" 2>&1 &
  foreign_pid=$!
  listener_attempt=0
  while [ ! -f "$listener_ready" ] && [ "$listener_attempt" -lt 50 ]; do
    kill -0 "$foreign_pid" 2>/dev/null || {
      [ ! -f "$fixture_root/test-listener.log" ] || cat "$fixture_root/test-listener.log" >&2
      fail 'test listener exited before the check'
    }
    listener_attempt=$((listener_attempt + 1))
    sleep 0.1
  done
  [ -f "$listener_ready" ] || fail 'test listener did not bind the requested port'
  listener_pids=$(nuinui_e2e_host_vscode__listener_pids "$port") || {
    echo "test listener lsof diagnostics (pid=$foreign_pid port=$port):" >&2
    /usr/sbin/lsof -nP -iTCP:"$port" -sTCP:LISTEN -Fp 2>&1 >&2 || true
    [ ! -f "$fixture_root/test-listener.log" ] || cat "$fixture_root/test-listener.log" >&2
    fail 'inspect test listener'
  }
  [ "$listener_pids" = "$foreign_pid" ] || fail 'test listener PID did not own its requested port'
}

native_path() {
  kind=$1 generation=$2
  printf '%s/nuinui-github-e2e-%s-v1.%s\n' \
    "$(git -C "$fixture_human" rev-parse --absolute-git-dir)" "$kind" \
    "$(printf '%s\n' "$generation" | shasum -a 256 | awk 'NR == 1 {print $1}')"
}

host_path() {
  kind=$1 generation=$2
  printf '%s/nuinui-github-e2e-host-%s-v1.%s\n' \
    "$(git -C "$fixture_human" rev-parse --absolute-git-dir)" "$kind" \
    "$(printf '%s\n' "$generation" | shasum -a 256 | awk 'NR == 1 {print $1}')"
}

released_history_fingerprint() {
  history_generation=$1
  {
    for history_kind in intent handoff ready cleanup-pending cleanup; do
      history_record=$(host_path "$history_kind" "$history_generation")
      if [ -f "$history_record" ]; then
        printf 'host:%s=' "$history_kind"
        shasum -a 256 "$history_record" | awk 'NR == 1 {print $1}'
      else
        printf 'host:%s=ABSENT\n' "$history_kind"
      fi
    done
    for history_kind in cleanup release starting releasing; do
      history_record=$(native_path "$history_kind" "$history_generation")
      if [ -f "$history_record" ]; then
        printf 'native:%s=' "$history_kind"
        shasum -a 256 "$history_record" | awk 'NR == 1 {print $1}'
      else
        printf 'native:%s=ABSENT\n' "$history_kind"
      fi
    done
  } | shasum -a 256 | awk 'NR == 1 {print $1}'
}

host_root_path() {
  if [ "$host_test_root_mode" = production ]; then
    printf '%s/.nuinuicad/e2e-hosts/.nuinui-e2e-host-%s\n' "$host_test_home" \
      "$(printf '%s\n' "$1" | shasum -a 256 | awk 'NR == 1 {print $1}')"
  else
    printf '%s/.nuinui-e2e-host-%s\n' "$fixture_root" \
      "$(printf '%s\n' "$1" | shasum -a 256 | awk 'NR == 1 {print $1}')"
  fi
}

fingerprint() {
  python3 - "$(git -C "$fixture_human" rev-parse --absolute-git-dir)" "$(host_root_path "$fixture_generation")" <<'PY'
import hashlib, os, stat, sys
h = hashlib.sha256()
for root in sys.argv[1:]:
    h.update(root.encode() + b"\0")
    if not os.path.lexists(root):
        h.update(b"ABSENT\0")
        continue
    for current, dirs, files in os.walk(root, followlinks=False):
        dirs.sort(); files.sort()
        for name in dirs + files:
            path = os.path.join(current, name)
            s = os.lstat(path)
            rel = os.path.relpath(path, root).encode()
            h.update(rel + b"\0" + str(s.st_mode).encode() + b"\0")
            if stat.S_ISLNK(s.st_mode): h.update(os.readlink(path).encode())
            elif stat.S_ISREG(s.st_mode):
                with open(path, "rb") as stream:
                    for block in iter(lambda: stream.read(65536), b""): h.update(block)
            h.update(b"\0")
print(h.hexdigest())
PY
}

fingerprint_before_denial() { before_fingerprint=$(fingerprint); }
assert_no_mutation() { [ "$(fingerprint)" = "$before_fingerprint" ] || fail 'denied or read-only operation mutated protected metadata or host resources'; }

prepare_generation() {
  fixture_generation=$1
  invoke admit "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha" || { cat "$output" >&2; fail 'native admission'; }
  invoke start "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha" || { cat "$output" >&2; fail 'native start'; }
}

