grep -q '^response_kind=electron$' "$electron_root/cdp-response-sha256" || fail 'Electron response kind was not durably recorded'
for profile_file in \
  "$electron_root/user-data/User/globalStorage/state.vscdb" \
  "$electron_root/user-data/logs/2026-10-13/window1/exthost/extension.log" \
  "$electron_root/extensions/extensions.json"; do
  [ -f "$profile_file" ] || fail 'Electron-shaped fake host profile write was not retained'
done
ok host-cleanup "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
[ ! -e "$electron_root" ] || fail 'owned VS Code profile data was not recursively cleaned'
ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
fixture_cdp_kind=fake

# Historical released records remain valid while a later generation is admitted.
