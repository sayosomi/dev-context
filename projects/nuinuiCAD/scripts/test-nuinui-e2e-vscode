  fail 'external-helper process group could not be inspected after recovery'
[ -z "$direct_remaining_group" ] || fail 'external helper remained after exact process-group recovery'
ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
fixture_direct_external_helper=no

# If a ready host exits unexpectedly, recovery is admitted only after its
# child group and port are both proven empty. The host-status operation stays read-only.
fixture_app_mode=direct
