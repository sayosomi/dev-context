#!/bin/sh
set -eu

usage() {
  echo 'Usage: generate-nuinui-handoff-check <output-path>' >&2
  exit 2
}

[ "$#" = 1 ] || usage
output=$1
[ -n "$output" ] || usage

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd -P)
ownership_source=$repo_root/shared/local-tools/lane-execution/ownership.sh
manifest_source=$repo_root/shared/local-tools/lane-execution/manifest.sh
standalone_context_source=$repo_root/shared/local-tools/lane-execution/standalone-context.sh
runtime_source=$repo_root/shared/local-tools/lane-execution/runtime.sh
profile_source=$script_dir/nuinui-src/lane-execution-profile.sh
body_source=$script_dir/nuinui-handoff-check-src/handoff-body.sh
artifact_path=$script_dir/nuinui-handoff-check

for source in "$ownership_source" "$manifest_source" "$standalone_context_source" \
  "$runtime_source" "$profile_source" "$body_source"; do
  [ -f "$source" ] || {
    echo "generate-nuinui-handoff-check: source is missing: $source" >&2
    exit 1
  }
done

output_dir=$(CDPATH= cd -- "$(dirname "$output")" && pwd -P) || {
  echo "generate-nuinui-handoff-check: output directory does not exist: $(dirname "$output")" >&2
  exit 1
}
output_path=$output_dir/$(basename "$output")

case "$output_path" in
  "$profile_source"|"$ownership_source"|"$manifest_source"|"$standalone_context_source"|"$runtime_source"|"$body_source"|"$artifact_path")
    echo 'generate-nuinui-handoff-check: refusing to overwrite a checked-in source or production artifact' >&2
    exit 1
    ;;
esac

[ ! -d "$output_path" ] || {
  echo "generate-nuinui-handoff-check: output is a directory: $output_path" >&2
  exit 1
}
[ ! -L "$output_path" ] || {
  echo "generate-nuinui-handoff-check: refusing to overwrite a symbolic link: $output_path" >&2
  exit 1
}

temporary_path=$output_path.tmp.$$
[ ! -e "$temporary_path" ] || {
  echo "generate-nuinui-handoff-check: temporary output already exists: $temporary_path" >&2
  exit 1
}

cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  rm -f "$temporary_path"
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

umask 077
{
  cat "$ownership_source"
  cat "$manifest_source"
  cat "$standalone_context_source"
  cat "$runtime_source"
  cat "$profile_source"
  cat "$body_source"
} > "$temporary_path"
chmod 755 "$temporary_path"
mv "$temporary_path" "$output_path"

trap - EXIT HUP INT TERM
