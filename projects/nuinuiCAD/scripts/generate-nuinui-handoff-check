#!/bin/sh
set -eu

usage() {
  echo 'Usage: generate-nuinui-handoff-check <output-path>' >&2
  exit 2
}

[ "$#" = 1 ] || usage
output=$1
[ -n "$output" ] || usage

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd -P)
profile_source=$script_dir/nuinui-src/project-profile.sh
ownership_source=$repo_root/shared/local-tools/fixed-2plus1/ownership-schema.sh
body_source=$script_dir/nuinui-handoff-check-src/handoff-body.sh
artifact_path=$script_dir/nuinui-handoff-check

[ -f "$profile_source" ] || {
  echo "generate-nuinui-handoff-check: project profile source is missing: $profile_source" >&2
  exit 1
}
[ -f "$ownership_source" ] || {
  echo "generate-nuinui-handoff-check: ownership source is missing: $ownership_source" >&2
  exit 1
}
[ -f "$body_source" ] || {
  echo "generate-nuinui-handoff-check: body source is missing: $body_source" >&2
  exit 1
}

output_dir=$(CDPATH= cd -- "$(dirname "$output")" && pwd -P) || {
  echo "generate-nuinui-handoff-check: output directory does not exist: $(dirname "$output")" >&2
  exit 1
}
output_path=$output_dir/$(basename "$output")

case "$output_path" in
  "$profile_source"|"$ownership_source"|"$body_source"|"$artifact_path")
    echo 'generate-nuinui-handoff-check: refusing to overwrite a checked-in source or production artifact' >&2
    exit 1
    ;;
esac

[ ! -d "$output_path" ] || {
  echo "generate-nuinui-handoff-check: output is a directory: $output_path" >&2
  exit 1
}
[ ! -L "$output_path" ] || {
  echo "generate-nuinui-handoff-check: refusing to overwrite a symbolic link: $output_path" >&2
  exit 1
}

temporary_path=$output_path.tmp.$$
[ ! -e "$temporary_path" ] || {
  echo "generate-nuinui-handoff-check: temporary output already exists: $temporary_path" >&2
  exit 1
}

cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  rm -f "$temporary_path"
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

umask 077
cat "$profile_source" "$ownership_source" "$body_source" > "$temporary_path"
chmod 755 "$temporary_path"
mv "$temporary_path" "$output_path"

trap - EXIT HUP INT TERM
