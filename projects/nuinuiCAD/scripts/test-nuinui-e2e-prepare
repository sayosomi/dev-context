echo "TEST: stale same-Issue cleanup cannot mutate a newer root generation"
old_root="$root"
env "${common_env[@]}" zsh "$PREPARE_SCRIPT" prepare SAY-999 "$tested_ref" "$fixture" 9555 >/dev/null || fail "newer same-Issue prepare"
new_root="$(sed -n 's/^root=//p' "$session")"
new_handoff="$temp_parent/nuinui-SAY-999-human-e2e.env"
new_session_before="$(cat "$session")"
if env "${common_env[@]}" zsh "$PREPARE_SCRIPT" cleanup SAY-999 "$tested_ref" "$old_root" >/dev/null 2>&1; then
  fail "stale same-Issue cleanup unexpectedly succeeded"
fi
[[ "$(cat "$session")" == "$new_session_before" && -d "$new_root" && -f "$new_handoff" ]] || fail "stale same-Issue cleanup mutated newer session"
env "${common_env[@]}" zsh "$PREPARE_SCRIPT" cleanup SAY-999 "$tested_ref" "$new_root" >/dev/null || fail "newer same-Issue cleanup"

echo "TEST: stale different-Issue/ref cleanup cannot mutate a newer session"
other_ref="$(git -C "$repo" commit-tree "$(git -C "$repo" rev-parse HEAD^{tree})" -p "$tested_ref" -m other-ref)"
git -C "$repo" update-ref refs/heads/tested-other "$other_ref"
git -C "$repo" switch --detach -q "$other_ref"
printf 'issue=SAY-998\nref=%s\n' "$other_ref" > "$marker"
env "${common_env[@]}" zsh "$PREPARE_SCRIPT" prepare SAY-998 "$other_ref" "$fixture" 9555 >/dev/null || fail "different-Issue prepare"
different_root="$(sed -n 's/^root=//p' "$session")"
different_session_before="$(cat "$session")"
if env "${common_env[@]}" zsh "$PREPARE_SCRIPT" cleanup SAY-999 "$tested_ref" "$new_root" >/dev/null 2>&1; then
  fail "stale different-Issue cleanup unexpectedly succeeded"
fi
[[ "$(cat "$session")" == "$different_session_before" && -d "$different_root" ]] || fail "stale different-Issue cleanup mutated newer session"
env "${common_env[@]}" zsh "$PREPARE_SCRIPT" cleanup SAY-998 "$other_ref" "$different_root" >/dev/null || fail "different-Issue cleanup"

receipt_content="$(cat "$cleanup_receipt")"
printf 'version=1\nissue=SAY-998\n' > "$cleanup_receipt"
if env "${common_env[@]}" zsh "$PREPARE_SCRIPT" cleanup SAY-998 "$other_ref" "$different_root" >/dev/null 2>&1; then
  fail "malformed cleanup receipt unexpectedly succeeded"
fi
printf '%s\n' "$receipt_content" > "$cleanup_receipt"

if env "${common_env[@]}" zsh "$PREPARE_SCRIPT" cleanup SAY-998 "$other_ref" "$arbitrary_root" >/dev/null 2>&1; then
  fail "wrong cleanup root unexpectedly succeeded"
fi

echo "TEST: explicit Human-test lanes remain independent in a 2+2 topology"
topology_bare="$TEST_ROOT/2plus2.git"
implementation_a="$TEST_ROOT/implementation-a"
implementation_b="$TEST_ROOT/implementation-b"
human_a="$TEST_ROOT/human-a"
human_b="$TEST_ROOT/human-b"
git clone -q --bare "$repo" "$topology_bare" || fail "2+2 bare repository"
git --git-dir="$topology_bare" config remote.origin.url https://github.com/sayosomi/nuinuiCAD.git
tested_ref_two="$(git -C "$repo" rev-parse HEAD)"
for topology_path in "$implementation_a" "$implementation_b" "$human_a" "$human_b"; do
  git --git-dir="$topology_bare" worktree add -q --detach "$topology_path" "$tested_ref_two" \
    || fail "2+2 worktree $topology_path"
done
[[ "$implementation_a" != "$implementation_b" && "$implementation_a" != "$human_a" &&
  "$implementation_a" != "$human_b" && "$implementation_b" != "$human_a" &&
  "$implementation_b" != "$human_b" && "$human_a" != "$human_b" ]] || fail "2+2 paths are not distinct"
for topology_path in "$implementation_a" "$implementation_b" "$human_a" "$human_b"; do
  git --git-dir="$topology_bare" worktree list --porcelain | sed -n 's/^worktree //p' |
    grep -Fqx -- "$topology_path" || fail "2+2 path is not a registered worktree: $topology_path"
done
human_a_gitdir="$(git -C "$human_a" rev-parse --absolute-git-dir)"
human_b_gitdir="$(git -C "$human_b" rev-parse --absolute-git-dir)"
[[ "$human_a_gitdir" != "$human_b_gitdir" ]] || fail "2+2 Human-test Git directories are not distinct"
marker_two_a="$human_a_gitdir/nuinui-slot"
marker_two_b="$human_b_gitdir/nuinui-slot"
session_two_a="$human_a_gitdir/nuinui-e2e-session"
session_two="$human_b_gitdir/nuinui-e2e-session"
receipt_two_a="$human_a_gitdir/nuinui-e2e-cleanup-receipt"
receipt_two_b="$human_b_gitdir/nuinui-e2e-cleanup-receipt"
printf 'issue=SAY-996\nref=%s\n' "$tested_ref_two" > "$marker_two_a"
printf 'issue=SAY-997\nref=%s\n' "$tested_ref_two" > "$marker_two_b"
manifest_two="$TEST_ROOT/LANES-2plus2.conf"
cat > "$manifest_two" <<MANIFEST
version=1
repository=sayosomi/nuinuiCAD
default_branch=main

[lane implementation-a]
role=implementation
path=$implementation_a
idle=detached

[lane implementation-b]
role=implementation
path=$implementation_b
idle=detached

[lane human-a]
role=human-test
path=$human_a
idle=detached

[lane human-b]
role=human-test
path=$human_b
idle=detached
MANIFEST
two_env=("${common_env[@]}")
two_env+=("NUINUI_E2E_MANIFEST=$manifest_two")
two_env+=("NUINUI_FAKE_REPO=$human_b")
two_handoff="$temp_parent/nuinui-SAY-997-human-e2e.env"

two_snapshot() {
  local topology_path metadata
  for topology_path in "$implementation_a" "$implementation_b" "$human_a" "$human_b"; do
    print -r -- "path=$topology_path"
    print -r -- "head=$(git -C "$topology_path" rev-parse HEAD)"
    print -r -- "branch=$(git -C "$topology_path" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    print -r -- "status=$(git -C "$topology_path" status --porcelain)"
    print -r -- "refs=$(git -C "$topology_path" for-each-ref --format='%(refname) %(objectname)' | sort)"
  done
  for metadata in "$session_two_a" "$session_two" "$receipt_two_a" "$receipt_two_b" "$two_handoff"; do
    if [[ -e "$metadata" || -L "$metadata" ]]; then
      print -r -- "metadata=$metadata"
      cat "$metadata"
    else
      print -r -- "metadata=$metadata:absent"
    fi
  done
}

expect_short_blocked() {
  local label="$1" env_kind="$2" out=""
  local -a selected_env
  shift 2
  if [[ "$env_kind" == two ]]; then
    selected_env=("${two_env[@]}")
  else
    selected_env=("${zero_env[@]}")
  fi
  if out="$(env "${selected_env[@]}" zsh "$PREPARE_SCRIPT" "$@" 2>&1)"; then
    print -r -- "$out"
    fail "$label unexpectedly selected a Human-test lane"
  fi
  print -r -- "$out" | grep -Fq 'BLOCKED:' || {
    print -r -- "$out"
    fail "$label did not fail closed"
  }
}

two_human_a_head_before="$(git -C "$human_a" rev-parse HEAD)"
two_human_a_status_before="$(git -C "$human_a" status --porcelain)"
two_human_a_refs_before="$(git -C "$human_a" for-each-ref --format='%(refname) %(objectname)' | sort)"
two_before="$(two_snapshot)"
expect_short_blocked "2+2 short check" two check SAY-997 "$tested_ref_two" "$fixture"
expect_short_blocked "2+2 short prepare" two prepare SAY-997 "$tested_ref_two" "$fixture" 9556
expect_short_blocked "2+2 short status before session" two status
expect_short_blocked "2+2 short cleanup before session" two cleanup SAY-997 "$tested_ref_two" "$temp_parent/nuinui-vscode-e2e.two"
expect_short_blocked "2+2 short closure-check before session" two closure-check SAY-997
if two_recover_short_output="$(env "${two_env[@]}" zsh "$PREPARE_SCRIPT" \
  recover-split SAY-998 "$tested_ref_two" SAY-997 "$tested_ref_two" \
  "$temp_parent/nuinui-vscode-e2e.two" 2>&1)"; then
  print -r -- "$two_recover_short_output"
  fail '2+2 short recover-split unexpectedly selected a lane'
fi
print -r -- "$two_recover_short_output" | grep -Fq \
  'nuinui-e2e-prepare recover-split <human-test-lane>' || {
  print -r -- "$two_recover_short_output"
  fail '2+2 short recover-split did not require an explicit lane'
}
if two_recover_preparing_short_output="$(env "${two_env[@]}" zsh "$PREPARE_SCRIPT" \
  recover-preparing SAY-997 "$tested_ref_two" "$temp_parent/nuinui-vscode-e2e.two" 2>&1)"; then
  print -r -- "$two_recover_preparing_short_output"
  fail '2+2 short recover-preparing unexpectedly selected a lane'
fi
print -r -- "$two_recover_preparing_short_output" | grep -Fq \
  'nuinui-e2e-prepare recover-preparing <human-test-lane>' || {
  print -r -- "$two_recover_preparing_short_output"
  fail '2+2 short recover-preparing did not require an explicit lane'
}
[[ "$(two_snapshot)" == "$two_before" ]] || fail "2+2 short-form rejection mutated fixture state"

two_status_a="$(env "${two_env[@]}" zsh "$PREPARE_SCRIPT" status human-a)" || fail "explicit Human-test status before prepare"
print -r -- "$two_status_a" | grep -Fq 'E2E STATUS COMPLETE' || fail "explicit Human-test status did not complete"
print -r -- "$two_status_a" | grep -Fq 'session=none' || fail "explicit Human-test status did not use its own session"

two_prepare_out="$(env "${two_env[@]}" zsh "$PREPARE_SCRIPT" prepare human-b SAY-997 "$tested_ref_two" "$fixture" 9556 2>&1)" || {
  print -r -- "$two_prepare_out"
  fail "explicit second Human-test prepare"
}
[[ -f "$session_two" ]] || fail "explicit second Human-test session missing"
[[ "$(sed -n 's/^lane=//p' "$session_two")" == human-b ]] || fail "session did not retain exact Human-test lane"
two_root="$(sed -n 's/^root=//p' "$session_two")"
two_session_before="$(cat "$session_two")"
two_marker_a_before="$(cat "$marker_two_a")"
two_marker_b_before="$(cat "$marker_two_b")"
two_handoff_before="$(cat "$two_handoff")"
two_active_before="$(two_snapshot)"
expect_short_blocked "2+2 short status with persisted session" two status
expect_short_blocked "2+2 short cleanup with persisted session" two cleanup SAY-997 "$tested_ref_two" "$two_root"
expect_short_blocked "2+2 short closure-check with persisted session" two closure-check SAY-997
[[ "$(two_snapshot)" == "$two_active_before" ]] || fail "2+2 ambiguous short form mutated active state"
[[ "$(cat "$session_two")" == "$two_session_before" && -d "$two_root" ]] || fail "2+2 short cleanup changed active session"
[[ "$(cat "$marker_two_a")" == "$two_marker_a_before" && "$(cat "$marker_two_b")" == "$two_marker_b_before" ]] \
  || fail "2+2 short rejection changed a marker"
[[ "$(cat "$two_handoff")" == "$two_handoff_before" ]] || fail "2+2 short rejection changed handoff"

two_status_b="$(env "${two_env[@]}" zsh "$PREPARE_SCRIPT" status human-b)" || fail "explicit Human-test status with persisted session"
print -r -- "$two_status_b" | grep -Fq 'session=active' || fail "explicit Human-test status did not find its exact session"
env "${two_env[@]}" zsh "$PREPARE_SCRIPT" cleanup human-b SAY-997 "$tested_ref_two" "$two_root" >/dev/null || fail "explicit second Human-test cleanup"
[[ ! -e "$session_two" && ! -e "$two_root" ]] || fail "second Human-test cleanup retained state"
[[ -f "$receipt_two_b" ]] || fail "explicit second Human-test cleanup receipt missing"
[[ "$(cat "$marker_two_a")" == "$two_marker_a_before" ]] || fail "Human-test cleanup changed the other lane marker"
[[ ! -e "$session_two_a" && ! -e "$receipt_two_a" ]] || fail "Human-test cleanup changed the other lane metadata"
[[ "$(git -C "$human_a" rev-parse HEAD)" == "$two_human_a_head_before" ]] || fail "Human-test cleanup changed the other lane HEAD"
[[ "$(git -C "$human_a" status --porcelain)" == "$two_human_a_status_before" ]] || fail "Human-test cleanup changed the other lane checkout"
[[ "$(git -C "$human_a" for-each-ref --format='%(refname) %(objectname)' | sort)" == "$two_human_a_refs_before" ]] \
  || fail "Human-test cleanup changed the other lane refs"
env "${two_env[@]}" zsh "$PREPARE_SCRIPT" closure-check human-b SAY-998 >/dev/null \
  || fail "explicit Human-test closure-check"

manifest_zero="$TEST_ROOT/LANES-zero-human.conf"
cat > "$manifest_zero" <<MANIFEST
version=1
repository=sayosomi/nuinuiCAD
default_branch=main

[lane implementation-a]
role=implementation
path=$implementation_a
idle=detached
MANIFEST
zero_env=("${common_env[@]}")
zero_env+=("NUINUI_E2E_MANIFEST=$manifest_zero")
zero_env+=("NUINUI_FAKE_REPO=$implementation_a")
zero_before="$(two_snapshot)"
expect_short_blocked "zero Human-test short check" zero check SAY-998 "$tested_ref_two" "$fixture"
expect_short_blocked "zero Human-test short prepare" zero prepare SAY-998 "$tested_ref_two" "$fixture" 9557
expect_short_blocked "zero Human-test short status" zero status
expect_short_blocked "zero Human-test short cleanup" zero cleanup SAY-998 "$tested_ref_two" "$temp_parent/nuinui-vscode-e2e.zero"
expect_short_blocked "zero Human-test short closure-check" zero closure-check SAY-998
[[ "$(two_snapshot)" == "$zero_before" ]] || fail "zero Human-test short-form rejection mutated fixture state"

echo "TEST: closure-command performs the canonical three-stage handoff through real public boundaries"
closure_remote="$TEST_ROOT/closure-remote/sayosomi/nuinuiCAD.git"
mkdir -p "$closure_remote:h" || fail "closure remote parent setup"
git clone -q --bare "$repo" "$closure_remote" || fail "closure remote setup"
git --git-dir="$closure_remote" update-ref refs/heads/main "$tested_ref" || fail "closure remote main ref"
git --git-dir="$closure_remote" symbolic-ref HEAD refs/heads/main || fail "closure remote HEAD"
git -C "$repo" remote set-url origin "$closure_remote" || fail "closure origin setup"
git -C "$repo" fetch -q origin --prune || fail "closure origin fetch"
git -C "$repo" switch --detach -q "$tested_ref" || fail "closure checkout reset"
closure_git_dir="$(git -C "$repo" rev-parse --absolute-git-dir)"
closure_release_receipt="$closure_git_dir/nuinui-e2e-release-receipt"
rm -f -- "$marker" "$session" "$closure_git_dir/nuinui-e2e-cleanup-receipt" "$closure_release_receipt"
closure_env=("${common_env[@]}")
closure_env+=(
  "NUINUI_SELFTEST=1"
  "NUINUI_SELFTEST_MANIFEST=$manifest"
  "NUINUI_SELFTEST_RESULT_REPO=$nuinui_result"
  "NUINUI_E2E_STATUS_HELPER=$PREPARE_SCRIPT"
)
closure_fixture="$TEST_ROOT/closure fixture;[x].nui"
print -r -- closure > "$closure_fixture"
printf 'issue=SAY-996\nref=%s\n' "$tested_ref" > "$marker"
closure_prepare_output="$(env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" prepare SAY-996 "$tested_ref" "$closure_fixture" 9558 2>&1)" || {
  print -r -- "$closure_prepare_output"
  fail "closure active prepare"
}
closure_root="$(sed -n 's/^root=//p' "$session")"
closure_handoff="$temp_parent/nuinui-SAY-996-human-e2e.env"
closure_output="$(env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-996)" || {
  print -r -- "$closure_output"
  fail "closure active handoff"
}
closure_cleanup_line="$(print -r -- "$closure_output" | grep -nF 'CLOSURE STAGE: cleanup' | head -n 1 | cut -d: -f1)"
closure_release_line="$(print -r -- "$closure_output" | grep -nF 'CLOSURE STAGE: e2e-release' | head -n 1 | cut -d: -f1)"
closure_check_line="$(print -r -- "$closure_output" | grep -nF 'CLOSURE STAGE: closure-check' | head -n 1 | cut -d: -f1)"
[[ -n "$closure_cleanup_line" && -n "$closure_release_line" && -n "$closure_check_line" && "$closure_cleanup_line" -lt "$closure_release_line" && "$closure_release_line" -lt "$closure_check_line" ]] || { print -r -- "$closure_output"; fail "closure stages were not ordered"; }
print -r -- "$closure_output" | grep -Fq 'E2E CLEANUP COMPLETE' || fail "closure did not invoke cleanup"
print -r -- "$closure_output" | grep -Fq 'E2E RELEASED' || fail "closure did not invoke e2e-release"
print -r -- "$closure_output" | grep -Fq 'E2E CLOSURE CLEAN' || fail "closure did not invoke closure-check"
[[ ! -e "$marker" && ! -e "$session" && ! -e "$closure_root" && ! -e "$closure_handoff" ]] || fail "successful closure retained active artifacts"
[[ "$(cat "$closure_git_dir/nuinui-e2e-cleanup-receipt")" == "$(printf 'version=1\nissue=SAY-996\nref=%s\nroot=%s' "$tested_ref" "$closure_root")" ]] || fail "closure cleanup receipt identity"
[[ "$(cat "$closure_release_receipt")" == "$(printf 'version=1\nissue=SAY-996\nref=%s' "$tested_ref")" ]] || fail "closure release receipt identity"

echo "TEST: cleanup duplicate progresses to release, and released duplicate progresses to closure"
printf 'issue=SAY-997\nref=%s\n' "$tested_ref" > "$marker"
env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" prepare SAY-997 "$tested_ref" "$closure_fixture" 9559 >/dev/null || fail "duplicate progression prepare"
duplicate_root="$(sed -n 's/^root=//p' "$session")"
env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" cleanup SAY-997 "$tested_ref" "$duplicate_root" >/dev/null || fail "duplicate progression initial cleanup"
duplicate_cleanup_output="$(env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-997)" || {
  print -r -- "$duplicate_cleanup_output"
  fail "cleanup duplicate progression"
}
print -r -- "$duplicate_cleanup_output" | grep -Fq 'E2E CLEANUP ALREADY COMPLETE' || fail "closure did not preserve cleanup duplicate envelope"
print -r -- "$duplicate_cleanup_output" | grep -Fq 'E2E RELEASED' || fail "cleanup duplicate did not continue to release"
print -r -- "$duplicate_cleanup_output" | grep -Fq 'E2E CLOSURE CLEAN' || fail "cleanup duplicate did not continue to closure"
released_duplicate_output="$(env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-997)" || {
  print -r -- "$released_duplicate_output"
  fail "released duplicate progression"
}
print -r -- "$released_duplicate_output" | grep -Fq 'cleanup=already-proven-by-exact-receipt' || fail "released duplicate did not use exact cleanup receipt proof"
print -r -- "$released_duplicate_output" | grep -Fq 'E2E ALREADY RELEASED' || fail "released duplicate did not preserve release duplicate envelope"
print -r -- "$released_duplicate_output" | grep -Fq 'E2E CLOSURE CLEAN' || fail "released duplicate did not continue to closure"
if print -r -- "$released_duplicate_output" | grep -Fq 'CLOSURE STAGE: cleanup'; then
  fail "released duplicate attempted post-release cleanup duplicate"
fi

echo "TEST: closure-command short-circuits real stages on cleanup and release failure"
short_root="$temp_parent/nuinui-vscode-e2e.closure-short"
printf 'issue=SAY-998\nref=%s\n' "$tested_ref" > "$marker"
printf 'version=1\nissue=SAY-998\nref=%s\nroot=%s\n' "$tested_ref" "$short_root" > "$closure_git_dir/nuinui-e2e-cleanup-receipt"
mkdir -p "$short_root"
if short_cleanup_output="$(env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-998 2>&1)"; then
  print -r -- "$short_cleanup_output"
  fail "cleanup failure was accepted"
fi
print -r -- "$short_cleanup_output" | grep -Fq 'CLOSURE STAGE: cleanup' || fail "cleanup failure omitted stage"
if print -r -- "$short_cleanup_output" | grep -Fq 'CLOSURE STAGE: e2e-release'; then
  fail "cleanup failure reached release"
fi
if print -r -- "$short_cleanup_output" | grep -Fq 'CLOSURE STAGE: closure-check'; then
  fail "cleanup failure reached closure-check"
fi
rm -rf -- "$short_root"
missing_remote="$TEST_ROOT/missing-remote/sayosomi/nuinuiCAD.git"
git -C "$repo" remote set-url origin "$missing_remote" || fail "stage-2 failure remote setup"
if short_release_output="$(env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-998 2>&1)"; then
  print -r -- "$short_release_output"
  fail "release failure was accepted"
fi
print -r -- "$short_release_output" | grep -Fq 'CLOSURE STAGE: e2e-release' || fail "release failure omitted stage"
if print -r -- "$short_release_output" | grep -Fq 'CLOSURE STAGE: closure-check'; then
  fail "release failure reached closure-check"
fi
git -C "$repo" remote set-url origin "$closure_remote" || fail "stage-2 failure remote restore"
env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-998 >/dev/null || fail "stage-2 recovery closure"

echo "TEST: closure-command rejects malformed and near-match receipts"
closure_cleanup_receipt="$closure_git_dir/nuinui-e2e-cleanup-receipt"
closure_cleanup_before="$(cat "$closure_cleanup_receipt")"
printf 'version=1\nissue=SAY-998\nref=%s\nroot=%s\nextra=value\n' "$tested_ref" "$short_root" > "$closure_cleanup_receipt"
if env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-998 >/dev/null 2>&1; then
  fail "malformed cleanup receipt was accepted"
fi
print -r -- "$closure_cleanup_before" > "$closure_cleanup_receipt"
closure_release_before="$(cat "$closure_release_receipt")"
printf 'version=1\nissue=SAY-998\n' > "$closure_release_receipt"
if env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-998 >/dev/null 2>&1; then
  fail "malformed release receipt was accepted"
fi
print -r -- "$closure_release_before" > "$closure_release_receipt"

echo "TEST: closure-command exposes final closure-check failure and nonzero status"
closure_failure_root="$temp_parent/nuinui-vscode-e2e.closure-final-failure"
closure_failure_process="$temp_parent/nuinui-SAY-995-e2e.final-failure"
rm -f -- "$closure_release_receipt"
printf 'issue=SAY-995\nref=%s\n' "$tested_ref" > "$marker"
printf 'version=1\nissue=SAY-995\nref=%s\nroot=%s\n' "$tested_ref" "$closure_failure_root" > "$closure_cleanup_receipt"
print -r -- '#!/bin/zsh
sleep 30' > "$closure_failure_process"
chmod +x "$closure_failure_process"
"$closure_failure_process" >/dev/null 2>&1 &
closure_failure_pid=$!
sleep 0.1
if closure_failure_output="$(env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-995 2>&1)"; then
  print -r -- "$closure_failure_output"
  fail "final closure-check failure was converted to success"
fi
print -r -- "$closure_failure_output" | grep -Fq 'CLOSURE STAGE: cleanup' || fail "final closure failure omitted cleanup stage"
print -r -- "$closure_failure_output" | grep -Fq 'E2E CLEANUP ALREADY COMPLETE' || fail "final closure failure did not prove cleanup"
print -r -- "$closure_failure_output" | grep -Fq 'CLOSURE STAGE: e2e-release' || fail "final closure failure omitted release stage"
print -r -- "$closure_failure_output" | grep -Fq 'E2E RELEASED' || fail "final closure failure did not prove release"
print -r -- "$closure_failure_output" | grep -Fq 'CLOSURE STAGE: closure-check' || fail "final closure failure omitted closure-check stage"
print -r -- "$closure_failure_output" | grep -Fq 'E2E CLOSURE CHECK' || fail "final closure failure hid closure-check evidence"
print -r -- "$closure_failure_output" | grep -Fq 'process=BLOCKING' || fail "final closure failure hid the blocking process evidence"
print -r -- "$closure_failure_output" | grep -Fq 'E2E CLOSURE BLOCKED' || fail "final closure failure hid the closure-check result"
print -r -- "$closure_failure_output" | grep -Fq 'BLOCKED: closure-command stopped after stage=closure-check' || \
  fail "final closure failure omitted closure-command stop evidence"
[[ ! -e "$marker" && ! -e "$session" ]] || fail "final closure failure retained active state after cleanup/release"
kill -TERM "$closure_failure_pid" >/dev/null 2>&1 || true
wait "$closure_failure_pid" >/dev/null 2>&1 || true
closure_failure_pid=""

echo "TEST: closure-command blocks preparing, malformed, and conflicting sessions before mutation"
closure_receipt_cleanup_before="$(cat "$closure_cleanup_receipt")"
closure_receipt_release_before="$(cat "$closure_release_receipt")"
closure_preparing_root="$temp_parent/nuinui-vscode-e2e.closure-preparing"
rm -rf -- "$closure_preparing_root"
printf 'issue=SAY-994\nref=%s\n' "$tested_ref" > "$marker"
printf 'kind=preparing\nlane=test-human\nissue=SAY-994\nref=%s\nroot=%s\nprepare_owner=nuinui-e2e-prepare\nprepare_pid=%s\n' \
  "$tested_ref" "$closure_preparing_root" "$$" > "$session"
preparing_closure_marker_before="$(cat "$marker")"
preparing_closure_session_before="$(cat "$session")"
if preparing_closure_output="$(env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-994 2>&1)"; then
  print -r -- "$preparing_closure_output"
  fail "preparing session was accepted by closure-command"
fi
print -r -- "$preparing_closure_output" | grep -Fq 'BLOCKED: E2E preparation is already in flight' || \
  fail "preparing session was not reported through closure-command"
if print -r -- "$preparing_closure_output" | grep -Fq 'CLOSURE STAGE:'; then
  fail "preparing session reached a closure stage"
fi
[[ "$(cat "$marker")" == "$preparing_closure_marker_before" && "$(cat "$session")" == "$preparing_closure_session_before" ]] || \
  fail "preparing-session closure mutated identity state"
[[ "$(cat "$closure_cleanup_receipt")" == "$closure_receipt_cleanup_before" &&
  "$(cat "$closure_release_receipt")" == "$closure_receipt_release_before" ]] || fail "preparing-session closure mutated receipts"
rm -f -- "$marker" "$session"

printf 'issue=SAY-993\nref=%s\n' "$tested_ref" > "$marker"
printf 'issue=SAY-993\nref=%s\n' "$tested_ref" > "$session"
malformed_closure_marker_before="$(cat "$marker")"
malformed_closure_session_before="$(cat "$session")"
if malformed_closure_output="$(env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-993 2>&1)"; then
  print -r -- "$malformed_closure_output"
  fail "malformed session was accepted by closure-command"
fi
print -r -- "$malformed_closure_output" | grep -Fq 'BLOCKED: invalid E2E session metadata' || \
  fail "malformed session was not reported through closure-command"
if print -r -- "$malformed_closure_output" | grep -Fq 'CLOSURE STAGE:'; then
  fail "malformed session reached a closure stage"
fi
[[ "$(cat "$marker")" == "$malformed_closure_marker_before" && "$(cat "$session")" == "$malformed_closure_session_before" ]] || \
  fail "malformed-session closure mutated identity state"
[[ "$(cat "$closure_cleanup_receipt")" == "$closure_receipt_cleanup_before" &&
  "$(cat "$closure_release_receipt")" == "$closure_receipt_release_before" ]] || fail "malformed-session closure mutated receipts"
rm -f -- "$marker" "$session"

closure_mismatch_root="$temp_parent/nuinui-vscode-e2e.closure-mismatch"
rm -rf -- "$closure_mismatch_root"
printf 'issue=SAY-992\nref=%s\n' "$tested_ref" > "$marker"
printf 'lane=test-human\nissue=SAY-991\nref=%s\nsource_fixture=%s\nroot=%s\nhandoff=%s\ncdp_port=9560\nlaunch_pid=1\nlocale=ja\n' \
  "$tested_ref" "$fixture" "$closure_mismatch_root" "$temp_parent/nuinui-SAY-991-human-e2e.env" > "$session"
mismatch_closure_marker_before="$(cat "$marker")"
mismatch_closure_session_before="$(cat "$session")"
if mismatch_closure_output="$(env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-992 2>&1)"; then
  print -r -- "$mismatch_closure_output"
  fail "marker/session mismatch was accepted by closure-command"
fi
print -r -- "$mismatch_closure_output" | grep -Fq 'BLOCKED: active session identity does not match the marker' || \
  fail "marker/session mismatch was not reported through closure-command"
if print -r -- "$mismatch_closure_output" | grep -Fq 'CLOSURE STAGE:'; then
  fail "marker/session mismatch reached a closure stage"
fi
[[ "$(cat "$marker")" == "$mismatch_closure_marker_before" && "$(cat "$session")" == "$mismatch_closure_session_before" ]] || \
  fail "marker/session mismatch closure mutated identity state"
[[ "$(cat "$closure_cleanup_receipt")" == "$closure_receipt_cleanup_before" &&
  "$(cat "$closure_release_receipt")" == "$closure_receipt_release_before" ]] || fail "marker/session mismatch closure mutated receipts"
rm -f -- "$marker" "$session"

echo "TEST: closure-command rejects zero-lane, implementation-lane, and wrong-generation requests"
zero_closure_before="$(two_snapshot)"
if zero_closure_output="$(env "${zero_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-990 2>&1)"; then
  print -r -- "$zero_closure_output"
  fail "zero Human-test topology was accepted by closure-command"
fi
print -r -- "$zero_closure_output" | grep -Fq 'BLOCKED:' || \
  fail "zero Human-test topology was not reported through closure-command"
if print -r -- "$zero_closure_output" | grep -Fq 'CLOSURE STAGE:'; then
  fail "zero Human-test topology reached a closure stage"
fi
[[ "$(two_snapshot)" == "$zero_closure_before" ]] || fail "zero-lane closure mutated topology state"

if implementation_lane_output="$(env "${zero_env[@]}" zsh "$PREPARE_SCRIPT" closure-command \
  --issue SAY-990 --lane implementation-a 2>&1)"; then
  print -r -- "$implementation_lane_output"
  fail "implementation-role lane was accepted by closure-command"
fi
print -r -- "$implementation_lane_output" | grep -Fq \
  'BLOCKED: selected lane is not a valid Human-test lane: implementation-a' || \
  fail "implementation-role lane was not reported through closure-command"
if print -r -- "$implementation_lane_output" | grep -Fq 'CLOSURE STAGE:'; then
  fail "implementation-role lane reached a closure stage"
fi
[[ "$(two_snapshot)" == "$zero_closure_before" ]] || fail "implementation-lane closure mutated topology state"

printf 'issue=SAY-989\nref=%s\n' "$tested_ref" > "$marker"
wrong_generation_marker_before="$(cat "$marker")"
if wrong_generation_output="$(env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-988 2>&1)"; then
  print -r -- "$wrong_generation_output"
  fail "wrong requested generation was accepted by closure-command"
fi
print -r -- "$wrong_generation_output" | grep -Fq \
  'BLOCKED: no unique Human-test generation is proved for Issue SAY-988' || \
  fail "wrong requested generation was not reported through closure-command"
if print -r -- "$wrong_generation_output" | grep -Fq 'CLOSURE STAGE:'; then
  fail "wrong requested generation reached a closure stage"
fi
[[ "$(cat "$marker")" == "$wrong_generation_marker_before" && ! -e "$session" ]] || \
  fail "wrong-generation closure mutated identity state"
[[ "$(cat "$closure_cleanup_receipt")" == "$closure_receipt_cleanup_before" &&
  "$(cat "$closure_release_receipt")" == "$closure_receipt_release_before" ]] || fail "wrong-generation closure mutated receipts"
rm -f -- "$marker"

echo "TEST: closure-command resolves explicit, ambiguous, and unique multi-lane generations"
git --git-dir="$closure_remote" update-ref refs/heads/main "$tested_ref_two" || fail "multi-lane remote main ref"
git --git-dir="$topology_bare" config remote.origin.url "$closure_remote" || fail "multi-lane remote setup"
two_closure_env=("${two_env[@]}")
two_closure_env+=("NUINUI_SELFTEST=1" "NUINUI_SELFTEST_MANIFEST=$manifest_two" "NUINUI_SELFTEST_RESULT_REPO=$nuinui_result" "NUINUI_E2E_STATUS_HELPER=$PREPARE_SCRIPT")
multi_root_a="$temp_parent/nuinui-vscode-e2e.multi-a"
multi_root_b="$temp_parent/nuinui-vscode-e2e.multi-b"
rm -f -- "$marker_two_a" "$marker_two_b" "$receipt_two_a" "$receipt_two_b"
printf 'issue=SAY-999\nref=%s\n' "$tested_ref_two" > "$marker_two_a"
printf 'version=1\nissue=SAY-999\nref=%s\nroot=%s\n' "$tested_ref_two" "$multi_root_a" > "$receipt_two_a"
multi_explicit_output="$(env "${two_closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-999 --lane human-a)" || {
  print -r -- "$multi_explicit_output"
  fail "explicit matching multi-lane closure"
}
print -r -- "$multi_explicit_output" | grep -Fq 'lane=human-a' || fail "explicit closure lane was not preserved"
print -r -- "$multi_explicit_output" | grep -Fq 'E2E CLOSURE CLEAN' || fail "explicit multi-lane closure did not complete"

printf 'issue=SAY-998\nref=%s\n' "$tested_ref_two" > "$marker_two_a"
printf 'issue=SAY-998\nref=%s\n' "$tested_ref_two" > "$marker_two_b"
printf 'version=1\nissue=SAY-998\nref=%s\nroot=%s\n' "$tested_ref_two" "$multi_root_a" > "$receipt_two_a"
printf 'version=1\nissue=SAY-998\nref=%s\nroot=%s\n' "$tested_ref_two" "$multi_root_b" > "$receipt_two_b"
if multi_ambiguous_output="$(env "${two_closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-998 2>&1)"; then
  print -r -- "$multi_ambiguous_output"
  fail "ambiguous multi-lane closure"
fi
print -r -- "$multi_ambiguous_output" | grep -Fq 'multiple Human-test generations match' || fail "multi-lane ambiguity was not reported"
if multi_wrong_lane_output="$(env "${two_closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-999 --lane human-b 2>&1)"; then
  print -r -- "$multi_wrong_lane_output"
  fail "wrong explicit Human-test lane"
fi
print -r -- "$multi_wrong_lane_output" | grep -Fq 'BLOCKED:' || fail "wrong explicit lane did not fail closed"
rm -f -- "$marker_two_b" "$receipt_two_b"
multi_unique_output="$(env "${two_closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue SAY-998)" || {
  print -r -- "$multi_unique_output"
  fail "unique omitted multi-lane closure"
}
print -r -- "$multi_unique_output" | grep -Fq 'lane=human-a' || fail "unique omitted closure selected the wrong lane"
print -r -- "$multi_unique_output" | grep -Fq 'E2E CLOSURE CLEAN' || fail "unique omitted multi-lane closure did not complete"

echo "TEST: closure-command named parser rejects malformed input without dispatch"
for closure_bad_args in "--issue SAY-997 --issue SAY-997" "--issue SAY-997 --lane human-a --lane human-b" "--issue SAY-997 --unknown value" "--issue SAY-997 unexpected" "--issue BAD --lane test-human"; do
  if env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command ${=closure_bad_args} >/dev/null 2>&1; then
    fail "closure parser accepted: $closure_bad_args"
  fi
done
if env "${closure_env[@]}" zsh "$PREPARE_SCRIPT" closure-command --issue >/dev/null 2>&1; then
  fail "closure parser accepted empty issue value"
fi

echo "SELFTEST PASS"
