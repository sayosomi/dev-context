  || fail "session revalidation race changed cleanup receipt identity"
[[ ! -e "$race_root" && ! -e "$race_handoff" ]] || fail "session revalidation race retained cleaned artifacts"
[[ "$(cat "$marker")" == "$race_marker_before" ]] || fail "session revalidation race changed marker"
[[ "$(git -C "$repo" rev-parse HEAD)" == "$race_head_before" ]] || fail "session revalidation race changed checkout HEAD"
[[ "$(git -C "$repo" status --porcelain)" == "$race_status_before" ]] || fail "session revalidation race changed checkout state"
