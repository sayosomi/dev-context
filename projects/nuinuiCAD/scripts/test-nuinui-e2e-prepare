#!/bin/zsh

set -u

SCRIPT_DIR="${0:A:h}"
PREPARE_SCRIPT="${1:-$SCRIPT_DIR/nuinui-e2e-prepare}"
TEST_ROOT="$(mktemp -d "${TMPDIR:-/private/tmp}/nuinui-e2e-prepare-test.XXXXXX")" || exit 1
TEST_ROOT="${TEST_ROOT:A}"

cleanup_test_root() {
  if [[ -n "${race_prepare_pid:-}" ]]; then
    kill -TERM "$race_prepare_pid" >/dev/null 2>&1 || true
  fi
  if [[ -n "${drift_prepare_pid:-}" ]]; then
    kill -TERM "$drift_prepare_pid" >/dev/null 2>&1 || true
  fi
  if [[ -n "${recovery_unrelated_pid:-}" ]]; then
    kill -TERM "$recovery_unrelated_pid" >/dev/null 2>&1 || true
  fi
  if [[ -n "${recovery_wrong_pid:-}" ]]; then
    kill -TERM "$recovery_wrong_pid" >/dev/null 2>&1 || true
  fi
  if [[ -n "${preparing_recovery_pid:-}" ]]; then
    kill -TERM "$preparing_recovery_pid" >/dev/null 2>&1 || true
  fi
  if [[ -n "${closure_failure_pid:-}" ]]; then
    kill -TERM "$closure_failure_pid" >/dev/null 2>&1 || true
    wait "$closure_failure_pid" >/dev/null 2>&1 || true
  fi
  [[ -d "$TEST_ROOT" ]] && rm -rf -- "$TEST_ROOT"
}
trap cleanup_test_root EXIT

fail() {
  echo "SELFTEST FAIL: $*"
  exit 1
}

repo="$TEST_ROOT/repo"
fixture="$TEST_ROOT/fixture.nui"
temp_parent="$TEST_ROOT/temp"
closure_parent="$TEST_ROOT/closure"
fake_bin="$TEST_ROOT/bin"
fake_app="$TEST_ROOT/Visual Studio Code.app"
marker=""
session=""
tested_ref=""
handoff=""
root=""
cleanup_receipt=""
status_out=""
marker_contents=""
manifest="$TEST_ROOT/LANES.conf"
language_pack='MS-CEINTL.vscode-language-pack-ja'
race_prepare_pid=""
drift_prepare_pid=""
recovery_unrelated_pid=""
recovery_wrong_pid=""
preparing_recovery_pid=""
closure_failure_pid=""

mkdir -p "$temp_parent" "$closure_parent" "$fake_bin" "$fake_app/Contents/Resources/app/bin" "$fake_app/Contents/MacOS" || fail "setup directories"
git init -q -b main "$repo" || fail "git init"
git -C "$repo" config user.name "nuinui e2e prepare selftest"
git -C "$repo" config user.email "nuinui-e2e-prepare-selftest@example.invalid"
mkdir -p "$repo/rust-evaluator" "$repo/vscode-extension"
print -r -- "fixture" > "$fixture"
print -r -- "source" > "$repo/source.txt"
cat > "$repo/.gitignore" <<'EOF'
node_modules/
vscode-extension/dist/
rust-evaluator/target/
EOF
git -C "$repo" add .gitignore source.txt
git -C "$repo" commit -q -m base || fail "base commit"
git -C "$repo" remote add origin https://github.com/sayosomi/nuinuiCAD.git
git -C "$repo" switch --detach -q HEAD || fail "detach checkout"
tested_ref="$(git -C "$repo" rev-parse HEAD)"
marker="$(git -C "$repo" rev-parse --absolute-git-dir)/nuinui-slot"
session="$(git -C "$repo" rev-parse --absolute-git-dir)/nuinui-e2e-session"
printf 'issue=SAY-999\nref=%s\n' "$tested_ref" > "$marker"
cat > "$manifest" <<MANIFEST
version=1
repository=sayosomi/nuinuiCAD
default_branch=main

[lane test-human]
role=human-test
path=$repo
idle=detached
MANIFEST

cat > "$fake_bin/lsof" <<'EOF'
#!/bin/zsh
exit 1
EOF
cat > "$fake_bin/npm" <<'EOF'
#!/bin/zsh
repo=""
if [[ "${1:-}" == "-C" ]]; then
  repo="$2"
  shift 2
fi
if [[ "${NUINUI_FAKE_NPM_FAIL:-0}" == "1" ]]; then
  exit 1
fi
if [[ "${1:-}" == "ci" ]]; then
  if [[ -n "${NUINUI_TEST_PREPARE_READY_FILE:-}" ]]; then
    print -r -- ready > "$NUINUI_TEST_PREPARE_READY_FILE"
    while [[ -e "${NUINUI_TEST_PREPARE_PAUSE_FILE:-}" ]]; do
      sleep 0.05
    done
  fi
  mkdir -p "$repo/node_modules/.bin"
  print -r -- '#!/bin/zsh' > "$repo/node_modules/.bin/esbuild"
  chmod +x "$repo/node_modules/.bin/esbuild"
  exit 0
fi
if [[ "${1:-}" == "run" && "${2:-}" == "build:vscode" ]]; then
  mkdir -p "$repo/vscode-extension/dist"
  print -r -- 'export {}' > "$repo/vscode-extension/dist/extension.js"
  exit 0
fi
exit 1
EOF
cat > "$fake_bin/cargo" <<'EOF'
#!/bin/zsh
mkdir -p "$NUINUI_FAKE_REPO/rust-evaluator/target/debug"
print -r -- '#!/bin/zsh' > "$NUINUI_FAKE_REPO/rust-evaluator/target/debug/evaluation_stdio"
chmod +x "$NUINUI_FAKE_REPO/rust-evaluator/target/debug/evaluation_stdio"
EOF
cat > "$fake_bin/curl" <<'EOF'
#!/bin/zsh
print -r -- '{}'
EOF
cat > "$fake_bin/fake-vscode" <<'EOF'
#!/bin/zsh
user_data=""
extensions_dir=""
install_extension=""
list_extensions=0
next_is_extension=0
for arg in "$@"; do
  if [[ "$next_is_extension" == 1 ]]; then
    install_extension="$arg"
    next_is_extension=0
    continue
  fi
  case "$arg" in
    --user-data-dir=*) user_data="${arg#--user-data-dir=}" ;;
    --extensions-dir=*) extensions_dir="${arg#--extensions-dir=}" ;;
    --install-extension) next_is_extension=1 ;;
    --list-extensions) list_extensions=1 ;;
  esac
done
root="${user_data:h}"
if [[ "$list_extensions" == 1 ]]; then
  print -r -- "$*" > "$extensions_dir/list-args"
  if [[ "${NUINUI_FAKE_EXTENSION_LIST_MODE:-present}" != missing &&
    -d "$extensions_dir/MS-CEINTL.vscode-language-pack-ja" ]]; then
    print -r -- 'ms-ceintl.vscode-language-pack-ja@1.136.0'
  fi
  exit 0
fi
if [[ -n "$install_extension" ]]; then
  print -r -- "$*" > "$extensions_dir/install-args"
  translation_file="$extensions_dir/$install_extension/translations/main.i18n.json"
  if [[ "${NUINUI_FAKE_EXTENSION_INSTALL_PRESENT:-1}" == 1 ]]; then
    mkdir -p "$extensions_dir/$install_extension"
    mkdir -p "$translation_file:h"
    print -r -- '{"messages":{"fake":"Japanese"}}' > "$translation_file"
  fi
  [[ -e "$user_data/languagepacks.json" ]] || \
    print -r -- missing > "$root/evidence/fake-install-languagepacks-state"
  exit 0
fi
[[ -n "$user_data" ]] && {
  print -r -- "executable=$0" > "${user_data:h}/launch-args"
  print -r -- "args=$*" >> "${user_data:h}/launch-args"
}
root="${user_data:h}"
if [[ -n "${NUINUI_FAKE_LAUNCH_MARKER:-}" ]]; then
  print -r -- launch >> "$NUINUI_FAKE_LAUNCH_MARKER"
fi
launch_count_file="$root/evidence/fake-vscode-launch-count"
launch_count=0
if [[ -f "$launch_count_file" ]]; then
  launch_count="$(<"$launch_count_file")"
fi
(( launch_count++ ))
print -r -- "$launch_count" > "$launch_count_file"
print -r -- "$$" >> "$root/evidence/fake-vscode-launch-pids"
translation_file="$root/extensions/MS-CEINTL.vscode-language-pack-ja/translations/main.i18n.json"
case "${NUINUI_FAKE_LANGUAGE_PACK_STATE:-valid}" in
  missing) ;;
  malformed) print -r -- '{' > "$user_data/languagepacks.json" ;;
  missing-ja) print -r -- '{}' > "$user_data/languagepacks.json" ;;
  missing-hash) print -r -- "{\"ja\":{\"translations\":{\"vscode\":\"$translation_file\"}}}" > "$user_data/languagepacks.json" ;;
  relative) print -r -- '{"ja":{"hash":"fake-hash","translations":{"vscode":"relative.json"}}}' > "$user_data/languagepacks.json" ;;
  outside)
    outside_translation="$root/user-data/outside-translation.json"
    print -r -- '{"messages":{"fake":"outside"}}' > "$outside_translation"
    print -r -- "{\"ja\":{\"hash\":\"fake-hash\",\"translations\":{\"vscode\":\"$outside_translation\"}}}" > "$user_data/languagepacks.json"
    ;;
  *)
    print -r -- "{\"ja\":{\"hash\":\"fake-hash\",\"translations\":{\"vscode\":\"$translation_file\"}}}" > "$user_data/languagepacks.json"
    ;;
esac
delayed_nls=0
nls_config_json() {
  local clp_dir="$1"
  print -r -- '{"userLocale":"ja","resolvedLanguage":"ja","_languagePackId":"fake-hash.ja","_languagePackSupport":true,"defaultMessagesFile":"/Applications/Visual Studio Code.app/Contents/Resources/app/out/nls.messages.json","escaped":"quote \" and slash \\ with brace } and { still text","_translationsConfigFile":"'"$clp_dir"'/tcf.json","languagePack":{"messagesFile":"'"$clp_dir"'/messages.json"}}'
}
clp_dir="$root/user-data/clp/fake hash.ja"
case "${NUINUI_FAKE_LOCALE_MODE:-ja}" in
  en)
    print -u2 -- 'fake VS Code NLS resolved en'
    nls_config='{"userLocale":"ja","resolvedLanguage":"en"}'
    ;;
  delayed-nls)
    delayed_nls=1
    nls_config="$(nls_config_json "$clp_dir")"
    ;;
  flip)
    if [[ "$launch_count" == 1 ]]; then
      nls_config='{"userLocale":"ja","resolvedLanguage":"en"}'
    else
      nls_config="$(nls_config_json "$clp_dir")"
    fi
    ;;
  *)
    nls_config="$(nls_config_json "$clp_dir")"
    ;;
esac
if [[ "${NUINUI_FAKE_LOCALE_MODE:-ja}" != missing-nls ]]; then
  mkdir -p "$clp_dir"
  print -r -- '{"messages":{"fake":"Japanese"}}' > "$clp_dir/messages.json"
  print -r -- '{}' > "$clp_dir/tcf.json"
  if [[ "$delayed_nls" == 1 ]]; then
    ( sleep 0.5; print -r -- "$nls_config" > "$root/evidence/fake-vscode-nls-config" ) &
  else
    print -r -- "$nls_config" > "$root/evidence/fake-vscode-nls-config"
  fi
  export VSCODE_NLS_CONFIG="$nls_config"
fi
[[ "$*" == *"--child-only"* ]] && { sleep 30; exit 0; }
sleep 30
EOF
cp "$fake_bin/fake-vscode" "$fake_app/Contents/Resources/app/bin/code" || fail "fake CLI setup"
cp "$fake_bin/fake-vscode" "$fake_app/Contents/MacOS/Fake VS Code" || fail "fake application setup"
cat > "$fake_app/Contents/Info.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>Fake VS Code</string>
</dict>
</plist>
EOF
chmod +x "$fake_bin/lsof" "$fake_bin/npm" "$fake_bin/cargo" "$fake_bin/curl" \
  "$fake_bin/fake-vscode" "$fake_app/Contents/Resources/app/bin/code" "$fake_app/Contents/MacOS/Fake VS Code"
real_mv="$(command -v mv)"
real_rm="$(command -v rm)"
real_ps="$(command -v ps)"
cat > "$fake_bin/mv" <<'EOF'
#!/bin/zsh
if [[ "${1:-}" == -- ]]; then
  target="${3:-}"
else
  target="${2:-}"
fi
"$NUINUI_TEST_REAL_MV" "$@"
if [[ "${NUINUI_TEST_MUTATE_SESSION_ON_RECEIPT:-0}" == 1 &&
  "$target" == "${NUINUI_TEST_CLEANUP_RECEIPT:-}" ]]; then
  sed 's/^cdp_port=9555$/cdp_port=9556/' "$NUINUI_TEST_SESSION" > "$NUINUI_TEST_SESSION.tmp"
  "$NUINUI_TEST_REAL_MV" "$NUINUI_TEST_SESSION.tmp" "$NUINUI_TEST_SESSION"
fi
EOF
chmod +x "$fake_bin/mv"
cat > "$fake_bin/rm" <<'EOF'
#!/bin/zsh
"$NUINUI_TEST_REAL_RM" "$@"
if [[ "${NUINUI_TEST_MUTATE_SPLIT_SESSION_ON_HANDOFF:-0}" == 1 &&
  "$*" == *"${NUINUI_TEST_SPLIT_HANDOFF:-}"* ]]; then
  sed 's/^ref=.*/ref=0000000000000000000000000000000000000001/' \
    "$NUINUI_TEST_SPLIT_SESSION" > "$NUINUI_TEST_SPLIT_SESSION.tmp"
  "$NUINUI_TEST_REAL_MV" "$NUINUI_TEST_SPLIT_SESSION.tmp" "$NUINUI_TEST_SPLIT_SESSION"
fi
if [[ "${NUINUI_TEST_MUTATE_PREPARING_SESSION_ON_HANDOFF:-0}" == 1 &&
  "$*" == *"${NUINUI_TEST_PREPARING_HANDOFF:-}"* ]]; then
  sed 's/^ref=.*/ref=0000000000000000000000000000000000000001/' \
    "$NUINUI_TEST_PREPARING_SESSION" > "$NUINUI_TEST_PREPARING_SESSION.tmp"
  "$NUINUI_TEST_REAL_MV" "$NUINUI_TEST_PREPARING_SESSION.tmp" "$NUINUI_TEST_PREPARING_SESSION"
fi
EOF
chmod +x "$fake_bin/rm"
cat > "$fake_bin/ps" <<'EOF'
#!/bin/zsh
if [[ -n "${NUINUI_TEST_EMPTY_PS_PID:-}" ]]; then
  for arg in "$@"; do
    [[ "$arg" == "$NUINUI_TEST_EMPTY_PS_PID" ]] && exit 0
  done
fi
show_environment=0
pid=""
expect_pid=0
for arg in "$@"; do
  [[ "$arg" == -*E* ]] && show_environment=1
  if [[ "$expect_pid" == 1 ]]; then
    pid="$arg"
    expect_pid=0
  elif [[ "$arg" == -p ]]; then
    expect_pid=1
  fi
done
if [[ "$show_environment" == 1 && -n "$pid" ]]; then
  command_line="$("$NUINUI_TEST_REAL_PS" -ww -p "$pid" -o command= 2>/dev/null || true)"
  root_user_data="$(print -r -- "$command_line" | sed -n 's/.*--user-data-dir=\([^ ]*\).*/\1/p')"
  nls_file="${root_user_data:h}/evidence/fake-vscode-nls-config"
  if [[ -n "$command_line" && -f "$nls_file" ]]; then
    print -r -- "$command_line VSCODE_NLS_CONFIG=$(<"$nls_file") OTHER_FAKE_ENV=after-nls"
  else
    print -r -- "$command_line"
  fi
  exit 0
fi
"$NUINUI_TEST_REAL_PS" "$@"
EOF
chmod +x "$fake_bin/ps"

common_env=(
  "NUINUI_E2E_SELFTEST=1"
  "NUINUI_E2E_MANIFEST=$manifest"
  "NUINUI_E2E_TEMP_PARENT=$temp_parent"
  "TMPDIR=$closure_parent/"
  "NUINUI_E2E_VSCODE_APP=$fake_app"
  "NUINUI_FAKE_REPO=$repo"
  "NUINUI_TEST_REAL_MV=$real_mv"
  "NUINUI_TEST_REAL_RM=$real_rm"
  "NUINUI_TEST_REAL_PS=$real_ps"
  "PATH=$fake_bin:$PATH"
)

self_path_project="$TEST_ROOT/self-path-project"
self_path_helper="$self_path_project/scripts/nuinui-e2e-prepare"
self_path_invalid_helper="$TEST_ROOT/invalid-helper/nuinui-e2e-prepare"
self_path_cwd_a="$TEST_ROOT/cwd-a"
self_path_cwd_b="$TEST_ROOT/cwd-b"
self_path_root=""
self_path_env=(
  "NUINUI_E2E_TEMP_PARENT=$temp_parent"
  "TMPDIR=$closure_parent/"
  "NUINUI_E2E_VSCODE_APP=$fake_app"
  "NUINUI_FAKE_REPO=$repo"
  "NUINUI_TEST_REAL_MV=$real_mv"
  "NUINUI_TEST_REAL_RM=$real_rm"
  "NUINUI_TEST_REAL_PS=$real_ps"
  "PATH=$fake_bin:$PATH"
)

mkdir -p "$self_path_project/scripts" "$self_path_invalid_helper:h" \
  "$self_path_cwd_a" "$self_path_cwd_b" || fail "self-path setup directories"
cp "$PREPARE_SCRIPT" "$self_path_helper" || fail "copy self-path helper"
cp "$PREPARE_SCRIPT" "$self_path_invalid_helper" || fail "copy invalid-placement helper"
chmod +x "$self_path_helper" "$self_path_invalid_helper"
cat > "$self_path_project/LANES.conf" <<MANIFEST
version=1
repository=sayosomi/nuinuiCAD
default_branch=main

[lane self-human]
role=human-test
path=$repo
idle=detached
MANIFEST

run_self_path_helper() {
  local helper="$1" cwd="$2"
  shift 2
  (
    cd "$cwd" || exit 1
    env -u NUINUI_E2E_SELFTEST -u NUINUI_E2E_MANIFEST \
      "${self_path_env[@]}" zsh "$helper" "$@"
  )
}

echo "TEST: standalone helper resolves its own project context under default zsh options"
zsh -fc '[[ -o functionargzero ]]' || fail "default zsh options do not enable FUNCTION_ARGZERO"
self_path_status_out="$(run_self_path_helper "$self_path_helper" "$self_path_cwd_a" status)" || {
  print -r -- "$self_path_status_out"
  fail "self-path status"
}
print -r -- "$self_path_status_out" | grep -Fq 'session=none' || fail "self-path status did not use its project manifest"
print -r -- "$self_path_status_out" | grep -Fq 'E2E STATUS COMPLETE' || fail "self-path status did not complete"
self_path_check_out="$(run_self_path_helper "$self_path_helper" "$self_path_cwd_b" \
  check SAY-999 "$tested_ref" "$fixture")" || {
  print -r -- "$self_path_check_out"
  fail "self-path check"
}
print -r -- "$self_path_check_out" | grep -Fq 'E2E CHECKOUT VERIFIED' || fail "self-path check did not complete"
self_path_prepare_out="$(run_self_path_helper "$self_path_helper" "$self_path_cwd_a" \
  prepare SAY-999 "$tested_ref" "$fixture" 9558)" || {
  print -r -- "$self_path_prepare_out"
  fail "self-path prepare"
}
print -r -- "$self_path_prepare_out" | grep -Fq 'lane=self-human' || fail "self-path prepare did not use project manifest lane"
self_path_root="$(sed -n 's/^root=//p' "$session")"
[[ -d "$self_path_root" && -f "$session" ]] || fail "self-path prepare did not record session"
self_path_status_out="$(run_self_path_helper "$self_path_helper" "$self_path_cwd_b" status)" || {
  print -r -- "$self_path_status_out"
  fail "self-path active status"
}
print -r -- "$self_path_status_out" | grep -Fq 'session=active' || fail "self-path active status did not complete"
self_path_cleanup_out="$(run_self_path_helper "$self_path_helper" "$self_path_cwd_b" \
  cleanup SAY-999 "$tested_ref" "$self_path_root")" || {
  print -r -- "$self_path_cleanup_out"
  fail "self-path cleanup"
}
print -r -- "$self_path_cleanup_out" | grep -Fq 'E2E CLEANUP COMPLETE' || fail "self-path cleanup did not complete"
[[ ! -e "$session" && ! -e "$self_path_root" ]] || fail "self-path cleanup retained state"
self_path_closure_out="$(run_self_path_helper "$self_path_helper" "$self_path_cwd_a" \
  closure-check SAY-998)" || {
  print -r -- "$self_path_closure_out"
  fail "self-path closure-check"
}
print -r -- "$self_path_closure_out" | grep -Fq 'E2E CLOSURE CLEAN' || fail "self-path closure-check did not complete"
self_path_invalid_out="$(run_self_path_helper "$self_path_invalid_helper" "$self_path_cwd_a" \
  status 2>&1)" && {
  print -r -- "$self_path_invalid_out"
  fail "invalid standalone helper placement was accepted"
}
print -r -- "$self_path_invalid_out" | grep -Fq \
  'BLOCKED: standalone helper is not in its versioned project scripts directory' \
  || { print -r -- "$self_path_invalid_out"; fail "invalid standalone helper placement did not fail closed"; }

echo "TEST: preparing reservation blocks E2E release and another start"
nuinui_result="$TEST_ROOT/nuinui-result"
git init -q "$nuinui_result" || fail "nuinui result repository setup"
nuinui_env=(
  "NUINUI_SELFTEST=1"
  "NUINUI_SELFTEST_MANIFEST=$manifest"
  "NUINUI_SELFTEST_RESULT_REPO=$nuinui_result"
  "NUINUI_E2E_STATUS_HELPER=$PREPARE_SCRIPT"
  "NUINUI_TEST_REAL_MV=$real_mv"
  "NUINUI_TEST_REAL_PS=$real_ps"
  "PATH=$fake_bin:$PATH"
)
race_gate="$TEST_ROOT/race-gate"
race_ready="$TEST_ROOT/race-ready"
race_log="$TEST_ROOT/race-prepare.log"
: > "$race_gate"
env "${common_env[@]}" \
  "NUINUI_TEST_PREPARE_PAUSE_FILE=$race_gate" \
  "NUINUI_TEST_PREPARE_READY_FILE=$race_ready" \
  zsh "$PREPARE_SCRIPT" prepare SAY-999 "$tested_ref" "$fixture" 9555 > "$race_log" 2>&1 &
race_prepare_pid=$!
for _ in $(seq 1 100); do
  if [[ -f "$race_ready" && -f "$session" ]] && grep -Fq 'kind=preparing' "$session"; then
    break
  fi
  sleep 0.05
done
[[ -f "$race_ready" && -f "$session" ]] || fail "prepare did not publish a durable preparing reservation"
grep -Fq 'kind=preparing' "$session" || fail "prepare reservation schema was not strict preparing"

if race_release_out="$(env "${nuinui_env[@]}" "$SCRIPT_DIR/nuinui" \
  e2e-release test-human SAY-999 "$tested_ref" 2>&1)"; then
  print -r -- "$race_release_out"
  fail "e2e-release passed while prepare was paused"
fi
print -r -- "$race_release_out" | grep -Fq 'BLOCKED' || {
  print -r -- "$race_release_out"
  fail "e2e-release did not fail closed on preparing reservation"
}

if race_closure_out="$(env "${common_env[@]}" zsh "$PREPARE_SCRIPT" \
  closure-check SAY-999 2>&1)"; then
  print -r -- "$race_closure_out"
  fail "closure-check passed while prepare was paused"
fi
print -r -- "$race_closure_out" | grep -Fq 'BLOCKING-SAME-ISSUE' || {
  print -r -- "$race_closure_out"
  fail "closure-check did not block on the preparing same-Issue session"
}

if race_status_out="$(env "${common_env[@]}" zsh "$PREPARE_SCRIPT" status 2>&1)"; then
  print -r -- "$race_status_out"
  fail "status passed while prepare was paused"
fi
print -r -- "$race_status_out" | grep -Fq 'session=preparing' || {
  print -r -- "$race_status_out"
  fail "status did not report preparing state"
}
print -r -- "$race_status_out" | grep -Fq 'preparation=in-flight' || {
  print -r -- "$race_status_out"
  fail "status did not report in-flight preparation"
}
! print -r -- "$race_status_out" | grep -Fq 'session=active' || \
  fail "status misclassified preparing state as active"

if race_start_out="$(env "${nuinui_env[@]}" "$SCRIPT_DIR/nuinui" \
  e2e-start test-human SAY-998 "$tested_ref" 2>&1)"; then
  print -r -- "$race_start_out"
  fail "another e2e-start passed while prepare was paused"
fi
print -r -- "$race_start_out" | grep -Fq 'BLOCKED' || {
  print -r -- "$race_start_out"
  fail "another e2e-start did not fail closed on preparing reservation"
}
grep -Fq 'kind=preparing' "$session" || fail "guard attempts changed preparing reservation"
rm -f -- "$race_gate"
wait "$race_prepare_pid" || {
  cat "$race_log"
  fail "paused prepare did not complete after resumption"
}
race_prepare_pid=""
grep -Fq 'E2E SETUP READY' "$race_log" || fail "resumed prepare did not publish the active session"
grep -Fq 'issue=SAY-999' "$session" || fail "resumed prepare did not retain Issue A"
! grep -Fq 'kind=preparing' "$session" || fail "resumed prepare left preparing session metadata"
grep -Fq "ref=$tested_ref" "$session" || fail "resumed prepare did not retain ref A"
grep -Fq 'issue=SAY-999' "$marker" || fail "race preparation changed marker Issue"
grep -Fq "ref=$tested_ref" "$marker" || fail "race preparation changed marker ref"
race_root="$(sed -n 's/^root=//p' "$session")"
env "${common_env[@]}" zsh "$PREPARE_SCRIPT" cleanup SAY-999 "$tested_ref" \
  "$race_root" >/dev/null || fail "race session cleanup"
cleanup_receipt="$(git -C "$repo" rev-parse --absolute-git-dir)/nuinui-e2e-cleanup-receipt"
rm -f -- "$marker" "$cleanup_receipt"
echo "PASS: preparing reservation closed the release/start race"

echo "TEST: final generation revalidation rejects stale active publication"
drift_ref="$(git -C "$repo" commit-tree "$(git -C "$repo" rev-parse "$tested_ref^{tree}")" \
  -p "$tested_ref" -m generation-drift)" || fail "generation drift commit"
git -C "$repo" switch --detach -q "$tested_ref" || fail "generation drift baseline checkout"
printf 'issue=SAY-999\nref=%s\n' "$tested_ref" > "$marker"
drift_gate="$TEST_ROOT/drift-gate"
drift_ready="$TEST_ROOT/drift-ready"
drift_log="$TEST_ROOT/drift-prepare.log"
: > "$drift_gate"
env "${common_env[@]}" \
  "NUINUI_TEST_PREPARE_PAUSE_FILE=$drift_gate" \
  "NUINUI_TEST_PREPARE_READY_FILE=$drift_ready" \
  zsh "$PREPARE_SCRIPT" prepare SAY-999 "$tested_ref" "$fixture" 9555 > "$drift_log" 2>&1 &
drift_prepare_pid=$!
for _ in $(seq 1 100); do
  if [[ -f "$drift_ready" && -f "$session" ]] && grep -Fq 'kind=preparing' "$session"; then
    break
  fi
  sleep 0.05
done
[[ -f "$drift_ready" && -f "$session" ]] || fail "generation-drift prepare did not publish reservation"
drift_root="$(sed -n 's/^root=//p' "$session")"
git -C "$repo" switch --detach -q "$drift_ref" || fail "generation drift checkout mutation"
printf 'issue=SAY-998\nref=%s\n' "$drift_ref" > "$marker"
rm -f -- "$drift_gate"
if wait "$drift_prepare_pid"; then
  cat "$drift_log"
  fail "stale generation prepare unexpectedly succeeded"
fi
drift_prepare_pid=""
grep -Fq 'generation drift detected before active publication' "$drift_log" || {
  cat "$drift_log"
  fail "generation drift was not reported before active publication"
}
[[ ! -e "$session" && ! -e "$drift_root" && \
  ! -e "$temp_parent/nuinui-SAY-999-human-e2e.env" ]] || \
  fail "generation drift retained owned session/root/handoff"
[[ "$(sed -n 's/^issue=//p' "$marker")" == SAY-998 && \
  "$(sed -n 's/^ref=//p' "$marker")" == "$drift_ref" ]] || \
  fail "generation drift changed the newer marker"
[[ "$(git -C "$repo" rev-parse HEAD)" == "$drift_ref" ]] || fail "generation drift changed newer checkout"
[[ -z "$(git -C "$repo" status --porcelain)" ]] || fail "generation drift dirtied newer checkout"
git -C "$repo" switch --detach -q "$tested_ref" || fail "generation drift reset checkout"
printf 'issue=SAY-999\nref=%s\n' "$tested_ref" > "$marker"
echo "PASS: final generation revalidation prevented stale session publication"

echo "TEST: recover-preparing repairs only an exact stale preparing reservation"
write_preparing_fixture() {
  local fixture_root="$1" fixture_issue="$2" fixture_ref="$3" fixture_pid="$4" fixture_lane="${5:-test-human}"
  printf 'kind=preparing\nlane=%s\nissue=%s\nref=%s\nroot=%s\nprepare_owner=nuinui-e2e-prepare\nprepare_pid=%s\n' \
    "$fixture_lane" "$fixture_issue" "$fixture_ref" "$fixture_root" "$fixture_pid" > "$session"
}

stale_gate="$TEST_ROOT/stale-preparing-gate"
stale_ready="$TEST_ROOT/stale-preparing-ready"
stale_log="$TEST_ROOT/stale-preparing.log"
: > "$stale_gate"
env "${common_env[@]}" \
  "NUINUI_TEST_PREPARE_PAUSE_FILE=$stale_gate" \
  "NUINUI_TEST_PREPARE_READY_FILE=$stale_ready" \
  zsh "$PREPARE_SCRIPT" prepare SAY-999 "$tested_ref" "$fixture" 9559 > "$stale_log" 2>&1 &
preparing_recovery_pid=$!
for _ in $(seq 1 100); do
  if [[ -f "$stale_ready" && -f "$session" ]] && grep -Fq 'kind=preparing' "$session"; then
    break
  fi
  sleep 0.05
done
[[ -f "$stale_ready" && -f "$session" ]] || fail "stale-owner prepare did not publish reservation"
stale_root="$(sed -n 's/^root=//p' "$session")"
stale_marker_before="$(cat "$marker")"
stale_head_before="$(git -C "$repo" rev-parse HEAD)"
kill -KILL "$preparing_recovery_pid" >/dev/null 2>&1 || true
rm -f -- "$stale_gate"
wait "$preparing_recovery_pid" >/dev/null 2>&1 || true
kill -0 "$preparing_recovery_pid" >/dev/null 2>&1 && fail "stale-owner prepare is still running"
preparing_recovery_pid=""
stale_recovery_output="$(env "${common_env[@]}" zsh "$PREPARE_SCRIPT" recover-preparing \
  test-human SAY-999 "$tested_ref" "$stale_root" 2>&1)" || {
  print -r -- "$stale_recovery_output"
  fail "stale preparing recovery failed"
}
print -r -- "$stale_recovery_output" | grep -Fq 'E2E PREPARATION RECOVERED' || fail "stale preparing recovery omitted success evidence"
print -r -- "$stale_recovery_output" | grep -Fq 'lane=test-human' || fail "stale preparing recovery omitted lane evidence"
print -r -- "$stale_recovery_output" | grep -Fq 'issue=SAY-999' || fail "stale preparing recovery omitted Issue evidence"
print -r -- "$stale_recovery_output" | grep -Fq "ref=$tested_ref" || fail "stale preparing recovery omitted ref evidence"
print -r -- "$stale_recovery_output" | grep -Fq "e2e_root=$stale_root" || fail "stale preparing recovery omitted root evidence"
print -r -- "$stale_recovery_output" | grep -Fq 'mutation=yes' || fail "stale preparing recovery omitted mutation evidence"
[[ ! -e "$session" && ! -e "$stale_root" && ! -e "$temp_parent/nuinui-SAY-999-human-e2e.env" ]] || \
  fail "stale preparing recovery retained owned state"
[[ "$(cat "$marker")" == "$stale_marker_before" ]] || fail "stale preparing recovery changed marker"
[[ "$(git -C "$repo" rev-parse HEAD)" == "$stale_head_before" ]] || fail "stale preparing recovery changed checkout"
env "${common_env[@]}" zsh "$PREPARE_SCRIPT" prepare SAY-999 "$tested_ref" "$fixture" 9559 >/dev/null \
  || fail "preparation did not continue after stale recovery"
stale_continue_root="$(sed -n 's/^root=//p' "$session")"
env "${common_env[@]}" zsh "$PREPARE_SCRIPT" cleanup SAY-999 "$tested_ref" "$stale_continue_root" >/dev/null \
  || fail "cleanup after stale recovery continuation"
rm -f -- "$(git -C "$repo" rev-parse --absolute-git-dir)/nuinui-e2e-cleanup-receipt"
echo "PASS: exited preparing owner can be recovered without hand deletion"

echo "TEST: recover-preparing rejects a live owner and leaves the reservation untouched"
