  || fail "missing post-first-launch cache triggered a relaunch"
[[ ! -e "$session" ]] || fail "missing post-first-launch cache left session metadata"
[[ -z "$(find "$temp_parent" -maxdepth 1 -type d -name 'nuinui-vscode-e2e.*' -print -quit)" ]] \
  || fail "missing post-first-launch cache left an E2E root"

echo "TEST: invalid post-first-launch language-pack cache blocks relaunch"
invalid_cache_port=9560
for locale_state in malformed missing-ja missing-hash relative outside; do
  invalid_cache_marker="$TEST_ROOT/invalid-cache-$locale_state"
  rm -f -- "$invalid_cache_marker"
  if invalid_cache_out="$(env "${common_env[@]}" NUINUI_E2E_JAPANESE_LANGUAGE_PACK_TIMEOUT=1 NUINUI_FAKE_LANGUAGE_PACK_STATE="$locale_state" NUINUI_FAKE_LOCALE_MODE=en NUINUI_FAKE_LAUNCH_MARKER="$invalid_cache_marker" zsh "$PREPARE_SCRIPT" prepare SAY-999 "$tested_ref" "$fixture" "$invalid_cache_port" --locale ja 2>&1)"; then
    print -r -- "$invalid_cache_out"
    fail "invalid post-first-launch cache was accepted: $locale_state"
  fi
  print -r -- "$invalid_cache_out" | grep -Fq 'post-first-launch Japanese language-pack cache was not ready' \
    || { print -r -- "$invalid_cache_out"; fail "invalid cache failure was not actionable: $locale_state"; }
  [[ "$(wc -l < "$invalid_cache_marker" | tr -d '[:space:]')" == 1 ]] \
    || fail "invalid cache triggered a relaunch: $locale_state"
  [[ ! -e "$session" ]] || fail "invalid cache left session metadata: $locale_state"
  [[ -z "$(find "$temp_parent" -maxdepth 1 -type d -name 'nuinui-vscode-e2e.*' -print -quit)" ]] \
    || fail "invalid cache left an E2E root: $locale_state"
  (( invalid_cache_port++ ))
done

