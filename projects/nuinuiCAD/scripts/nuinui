#!/bin/zsh

VERSION="1.4.0"
SCRIPT_PATH="${ZSH_SCRIPT:-$0}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
LEGACY_SCRIPT="${NUINUI_LEGACY_SCRIPT:-$SCRIPT_DIR/nuinui-legacy-1.3.5}"

if [[ "${NUINUI_SELFTEST:-0}" == "1" ]]; then
  MAIN_WT="${NUINUI_MAIN_WT}"
  SUB_WT="${NUINUI_SUB_WT}"
  E2E_WT="${NUINUI_E2E_WT}"
  TARGET_REPO_TOKEN=""
else
  MAIN_WT="/Users/yosomi/Code/nuinuiCAD"
  SUB_WT="/Users/yosomi/Code/nuinuiCAD-sub"
  E2E_WT="/Users/yosomi/Code/nuinuiCAD-e2e"
  TARGET_REPO_TOKEN="sayosomi/nuinuiCAD"
fi

lane_repo() {
  case "$1" in
    main) printf '%s\n' "$MAIN_WT" ;;
    sub) printf '%s\n' "$SUB_WT" ;;
    e2e) printf '%s\n' "$E2E_WT" ;;
    *) return 2 ;;
  esac
}

issue_from_branch() {
  local branch="$1"
  if [[ "$branch" =~ '(SAY|say)-([0-9]+)' ]]; then printf 'SAY-%s\n' "${match[2]}"; else printf '%s\n' '-'; fi
}

assert_impl_lane() { case "$1" in main|sub) return 0 ;; *) echo "ERROR: lane must be main or sub"; return 2 ;; esac; }
assert_git_repo() { [[ -d "$1" ]] && git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "BLOCKED: path is not a Git worktree: $1"; return 1; }; }
assert_origin() {
  local url=""
  [[ -z "$2" ]] && return 0
  url="$(git -C "$1" remote get-url origin 2>/dev/null)" || { echo "BLOCKED: origin remote is missing"; return 1; }
  [[ "$url" == *"$2"* ]] || { echo "BLOCKED: unexpected repository origin"; echo "ACTUAL: $url"; return 1; }
}

git_dir() { git -C "$1" rev-parse --absolute-git-dir 2>/dev/null; }
init_path() { printf '%s/nuinui-implementation-v1\n' "$(git_dir "$1")"; }
slot_path() { printf '%s/nuinui-implementation-slot\n' "$(git_dir "$1")"; }
lock_path() { printf '%s/nuinui-implementation-lock\n' "$(git_dir "$1")"; }
releasing_path() { printf '%s/nuinui-implementation-slot.releasing.%s\n' "$(git_dir "$1")" "$2"; }
releasing_dirs() { find "$(git_dir "$1")" -maxdepth 1 -type d -name 'nuinui-implementation-slot.releasing.*' -print 2>/dev/null | sort; }

state_value() {
  awk -v wanted="$2" 'index($0,"=")>1 { k=substr($0,1,index($0,"=")-1); if(k==wanted){print substr($0,index($0,"=")+1); n++} } END{if(n!=1)exit 1}' "$1"
}
validate_exact_state() {
  [[ -f "$1" ]] || return 1
  awk -v required="$2" 'BEGIN{n=split(required,a,",");for(i=1;i<=n;i++)need[a[i]]=1} {p=index($0,"=");if(p<=1)bad=1;else{k=substr($0,1,p-1);v=substr($0,p+1);if(!(k in need)||v==""||seen[k]++)bad=1}} END{for(k in need)if(seen[k]!=1)bad=1;exit bad?1:0}' "$1"
}
valid_sha() { [[ "$1" =~ ^[0-9a-fA-F]{40}$ ]]; }
valid_issue() { [[ "$1" =~ ^SAY-[0-9]+$ ]]; }
valid_claim() { [[ "$1" =~ ^[0-9A-Za-z][0-9A-Za-z._-]{7,127}$ ]]; }
validate_init() { validate_exact_state "$1" version && [[ "$(state_value "$1" version)" == 1 ]]; }
validate_slot() {
  local f="$1" issue="" branch=""
  validate_exact_state "$f" version,issue,branch,base,claim || return 1
  [[ "$(state_value "$f" version)" == 1 ]] || return 1
  issue="$(state_value "$f" issue)"; branch="$(state_value "$f" branch)"
  valid_issue "$issue" || return 1
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || return 1
  [[ "$(issue_from_branch "$branch")" == "$issue" ]] || return 1
  valid_sha "$(state_value "$f" base)" || return 1
  valid_claim "$(state_value "$f" claim)"
}
validate_lock() {
  local f="$1" op="" issue="" branch=""
  validate_exact_state "$f" version,operation,issue,branch,base,checkpoint,claim || return 1
  [[ "$(state_value "$f" version)" == 1 ]] || return 1
  op="$(state_value "$f" operation)"; case "$op" in start|resume|release|init|adopt) ;; *) return 1 ;; esac
  valid_claim "$(state_value "$f" claim)" || return 1
  issue="$(state_value "$f" issue)"; branch="$(state_value "$f" branch)"
  [[ "$issue" == - ]] || valid_issue "$issue" || return 1
  [[ "$branch" == - ]] || git check-ref-format --branch "$branch" >/dev/null 2>&1 || return 1
  if [[ "$issue" != - || "$branch" != - ]]; then [[ "$issue" != - && "$branch" != - && "$(issue_from_branch "$branch")" == "$issue" ]] || return 1; fi
  [[ "$(state_value "$f" base)" == - ]] || valid_sha "$(state_value "$f" base)" || return 1
  [[ "$(state_value "$f" checkpoint)" == - ]] || valid_sha "$(state_value "$f" checkpoint)"
}
validate_releasing() {
  local dir="$1" cp="" claim="" name=""
  validate_slot "$dir/state" || return 1
  [[ -f "$dir/checkpoint" ]] || return 1
  cp="$(cat "$dir/checkpoint")"; valid_sha "$cp" || return 1
  claim="$(state_value "$dir/state" claim)"; name="${dir##*/}"
  [[ "$name" == "nuinui-implementation-slot.releasing.$claim" ]]
}
release_state_matches() {
  local dir="$1" issue="$2" branch="$3" base="$4" claim="$5" cp="$6"
  validate_releasing "$dir" || return 1
  [[ "$(state_value "$dir/state" issue)" == "$issue" && "$(state_value "$dir/state" branch)" == "$branch" && "$(state_value "$dir/state" base)" == "$base" && "$(state_value "$dir/state" claim)" == "$claim" && "$(cat "$dir/checkpoint")" == "$cp" ]]
}

write_atomic() { local tmp="${1}.tmp.$$"; (umask 077; printf '%b' "$2" > "$tmp") || return 1; mv "$tmp" "$1"; }
generate_claim() {
  if command -v uuidgen >/dev/null 2>&1; then uuidgen | tr '[:upper:]' '[:lower:]'; else printf '%s:%s:%s:%s\n' "$$" "$(date +%s)" "${RANDOM:-0}" "${PPID:-0}" | git hash-object --stdin; fi
}
acquire_lock() {
  local lock="$(lock_path "$1")"
  mkdir "$lock" 2>/dev/null || { echo "BLOCKED: implementation lane mutation lock already exists"; return 1; }
  write_atomic "$lock/state" "version=1\noperation=$2\nissue=$4\nbranch=$5\nbase=$6\ncheckpoint=$7\nclaim=$3\n" || { rm -f "$lock/state"; rmdir "$lock" 2>/dev/null || true; return 1; }
}
remove_owned_lock() {
  local lock="$(lock_path "$1")"
  validate_lock "$lock/state" || return 1
  [[ "$(state_value "$lock/state" claim)" == "$2" ]] || return 1
  rm "$lock/state" && rmdir "$lock"
}

slot_matches() {
  validate_slot "$1/state" || return 1
  [[ "$(state_value "$1/state" issue)" == "$2" && "$(state_value "$1/state" branch)" == "$3" && "$(state_value "$1/state" base)" == "$4" && "$(state_value "$1/state" claim)" == "$5" ]]
}

authoritative_main() { git -C "$1" ls-remote origin refs/heads/main 2>/dev/null | awk 'NR==1{print $1}'; }
assert_exact_idle() {
  local lane="$1" repo="$2" remote="$3" branch="" head=""
  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"; head="$(git -C "$repo" rev-parse HEAD)"
  [[ -z "$(git -C "$repo" status --porcelain)" ]] || return 1
  if [[ "$lane" == main ]]; then [[ "$branch" == main ]] || return 1; else [[ -z "$branch" ]] || return 1; fi
  [[ "$head" == "$remote" ]]
}
assert_no_release_state() { [[ -z "$(releasing_dirs "$1")" ]] || { echo "BLOCKED: incomplete release state exists"; return 1; }; }

classify_lane() {
  local lane="$1" repo="$2" init="" slot="" lock="" branch="" head="" dirty="" rels="" count=0 rel="" remote="" base=""
  init="$(init_path "$repo")"; slot="$(slot_path "$repo")"; lock="$(lock_path "$repo")"
  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"; head="$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)"; dirty="$(git -C "$repo" status --porcelain 2>/dev/null)"
  echo "$lane path=$repo"; echo "  branch=${branch:-DETACHED}"; echo "  head=$head"; echo "  clean=$([[ -z "$dirty" ]] && echo yes || echo no)"
  if [[ -e "$lock" ]]; then
    if validate_lock "$lock/state"; then echo "  state=BLOCKED reason=mutation-in-progress operation=$(state_value "$lock/state" operation) claim=$(state_value "$lock/state" claim)"; else echo "  state=BLOCKED reason=invalid-mutation-lock"; fi
    return 1
  fi
  rels="$(releasing_dirs "$repo")"; count="$(printf '%s\n' "$rels" | grep -c . || true)"
  if [[ -e "$slot" ]]; then
    [[ "$count" == 0 ]] || { echo "  state=BLOCKED reason=active-and-releasing-state-coexist"; return 1; }
    validate_slot "$slot/state" || { echo "  state=BLOCKED reason=invalid-active-slot"; return 1; }
    echo "  owner_issue=$(state_value "$slot/state" issue) owner_branch=$(state_value "$slot/state" branch) base=$(state_value "$slot/state" base) claim=$(state_value "$slot/state" claim)"
    [[ -z "$dirty" ]] || { echo "  state=BLOCKED reason=claimed-lane-dirty"; return 1; }
    [[ "$branch" == "$(state_value "$slot/state" branch)" ]] || { echo "  state=BLOCKED reason=claim-checkout-mismatch"; return 1; }
    base="$(state_value "$slot/state" base)"; git -C "$repo" merge-base --is-ancestor "$base" "$head" 2>/dev/null || { echo "  state=BLOCKED reason=base-history-mismatch"; return 1; }
    echo "  state=BUSY"; return 0
  fi
  if [[ "$count" != 0 ]]; then
    [[ "$count" == 1 ]] || { echo "  state=BLOCKED reason=multiple-release-states count=$count"; return 1; }
    rel="$rels"; validate_releasing "$rel" || { echo "  state=BLOCKED reason=invalid-release-state"; return 1; }
    echo "  state=RELEASE-PENDING claim=$(state_value "$rel/state" claim) checkpoint=$(cat "$rel/checkpoint")"; return 0
  fi
  validate_init "$init" || { echo "  state=BLOCKED reason=durable-claim-migration-required"; return 1; }
  remote="$(authoritative_main "$repo")"; valid_sha "$remote" || { echo "  state=BLOCKED reason=authoritative-main-unavailable"; return 1; }
  if assert_exact_idle "$lane" "$repo" "$remote"; then echo "  state=FREE origin_main=$remote"; return 0; fi
  [[ -z "$dirty" ]] || { echo "  state=BLOCKED reason=idle-lane-dirty"; return 1; }
  [[ -n "$branch" && "$branch" != main ]] && { echo "  state=BLOCKED reason=implementation-branch-has-no-lane-claim"; return 1; }
  echo "  state=BLOCKED reason=invalid-idle-state origin_main=$remote"; return 1
}

legacy_capture() { "$LEGACY_SCRIPT" "$@" 2>&1; }
preflight() {
  local out="" rc=0 result=0
  [[ -x "$LEGACY_SCRIPT" ]] || { echo "BLOCKED: legacy compatibility helper is unavailable"; return 1; }
  out="$(legacy_capture preflight)"; rc=$?; printf '%s\n' "$out" | sed '/^PREFLIGHT \(PASS\|BLOCKED\)$/d'; (( rc == 0 )) || result=1
  assert_git_repo "$MAIN_WT" >/dev/null 2>&1 && classify_lane main "$MAIN_WT" || result=1
  assert_git_repo "$SUB_WT" >/dev/null 2>&1 && classify_lane sub "$SUB_WT" || result=1
  if (( result == 0 )); then echo "PREFLIGHT PASS"; else echo "PREFLIGHT BLOCKED"; return 1; fi
}

lane_init() {
  local lane="$1" repo="" init="" claim="" remote=""
  assert_impl_lane "$lane" || return $?; repo="$(lane_repo "$lane")"; assert_git_repo "$repo" || return 1; assert_origin "$repo" "$TARGET_REPO_TOKEN" || return 1
  init="$(init_path "$repo")"; if [[ -e "$init" ]]; then validate_init "$init" || { echo "BLOCKED: migration marker is invalid"; return 1; }; echo "ALREADY INITIALIZED"; return 0; fi
  [[ ! -e "$(slot_path "$repo")" && ! -e "$(lock_path "$repo")" ]] || { echo "BLOCKED: implementation metadata already exists"; return 1; }; assert_no_release_state "$repo" || return 1
  claim="$(generate_claim)"; acquire_lock "$repo" init "$claim" - - - - || return 1
  git -C "$repo" fetch origin main >/dev/null 2>&1 || { remove_owned_lock "$repo" "$claim" >/dev/null 2>&1 || true; echo "ERROR: git fetch failed"; return 1; }
  remote="$(git -C "$repo" rev-parse origin/main)"; assert_exact_idle "$lane" "$repo" "$remote" || { echo "BLOCKED: lane is not exact safe idle; initialization lock retained"; return 1; }
  write_atomic "$init" 'version=1\n' || { echo "ERROR: migration marker write failed; lock retained"; return 1; }
  remove_owned_lock "$repo" "$claim" || return 1
  echo "LANE INITIALIZED"; echo "  lane=$lane"; echo "  head=$remote"
}

lane_adopt() {
  local lane="$1" issue="$2" base="$3" cp="$4" branch="$5" repo="" claim="" slot="" init="" remote_branch=""
  assert_impl_lane "$lane" || return $?; valid_issue "$issue" || return 2; valid_sha "$base" || return 2; valid_sha "$cp" || return 2; git check-ref-format --branch "$branch" >/dev/null 2>&1 || return 2
  [[ "$(issue_from_branch "$branch")" == "$issue" ]] || { echo "BLOCKED: branch name does not match Issue"; return 1; }
  repo="$(lane_repo "$lane")"; assert_git_repo "$repo" || return 1; assert_origin "$repo" "$TARGET_REPO_TOKEN" || return 1
  [[ ! -e "$(slot_path "$repo")" && ! -e "$(lock_path "$repo")" ]] || { echo "BLOCKED: implementation metadata already exists"; return 1; }; assert_no_release_state "$repo" || return 1
  claim="$(generate_claim)"; acquire_lock "$repo" adopt "$claim" "$issue" "$branch" "$base" "$cp" || return 1
  [[ -z "$(git -C "$repo" status --porcelain)" && "$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" == "$branch" && "$(git -C "$repo" rev-parse HEAD)" == "$cp" ]] || { echo "BLOCKED: checkout does not match adoption identity; lock retained"; return 1; }
  git -C "$repo" merge-base --is-ancestor "$base" "$cp" || { echo "BLOCKED: Base is not an ancestor of adoption checkpoint; lock retained"; return 1; }
  remote_branch="$(git -C "$repo" ls-remote --heads origin "refs/heads/$branch" | awk 'NR==1{print $1}')"; [[ "$remote_branch" == "$cp" ]] || { echo "BLOCKED: remote adoption branch mismatch; lock retained"; return 1; }
  init="$(init_path "$repo")"; [[ ! -e "$init" ]] && write_atomic "$init" 'version=1\n'; validate_init "$init" || return 1
  slot="$(slot_path "$repo")"; mkdir "$slot" || { echo "BLOCKED: atomic slot claim failed; lock retained"; return 1; }
  write_atomic "$slot/state" "version=1\nissue=$issue\nbranch=$branch\nbase=$base\nclaim=$claim\n" || { echo "ERROR: slot write failed; lock retained"; return 1; }
  remove_owned_lock "$repo" "$claim" || return 1
  echo "LANE ADOPTED"; echo "  lane=$lane"; echo "  issue=$issue"; echo "  branch=$branch"; echo "  base=$base"; echo "  head=$cp"; echo "  claim=$claim"
}

verify_lane() {
  local lane="$1" repo=""
  assert_impl_lane "$lane" || return $?; repo="$(lane_repo "$lane")"; validate_init "$(init_path "$repo")" || { echo "BLOCKED: implementation lane has not been migrated to durable claims"; return 1; }
  [[ ! -e "$(slot_path "$repo")" && ! -e "$(lock_path "$repo")" ]] || { echo "BLOCKED: implementation lane is not FREE"; return 1; }; assert_no_release_state "$repo" || return 1
  "$LEGACY_SCRIPT" verify "$@"
}

rollback_failed_start_if_safe() {
  local lane="$1" repo="$2" base="$3" branch="$4" claim="$5" current_branch="" head=""
  current_branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"; head="$(git -C "$repo" rev-parse HEAD)"
  [[ -z "$(git -C "$repo" status --porcelain)" && "$head" == "$base" ]] || return 1
  if [[ "$lane" == main ]]; then [[ "$current_branch" == main ]] || return 1; else [[ -z "$current_branch" ]] || return 1; fi
  git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" && return 1
  rm "$(slot_path "$repo")/state" && rmdir "$(slot_path "$repo")" && remove_owned_lock "$repo" "$claim"
}

start_lane() {
  local lane="$1" issue="$2" base="$3" branch="$4" repo="" claim="" slot="" out="" rc=0
  assert_impl_lane "$lane" || return $?; valid_issue "$issue" || return 2; valid_sha "$base" || return 2; git check-ref-format --branch "$branch" >/dev/null 2>&1 || return 2
  [[ "$(issue_from_branch "$branch")" == "$issue" ]] || { echo "BLOCKED: branch name does not match Issue"; return 1; }
  repo="$(lane_repo "$lane")"; validate_init "$(init_path "$repo")" || { echo "BLOCKED: implementation lane has not been migrated to durable claims"; return 1; }
  [[ ! -e "$(slot_path "$repo")" && ! -e "$(lock_path "$repo")" ]] || { echo "BLOCKED: implementation lane is not FREE"; return 1; }; assert_no_release_state "$repo" || return 1
  claim="$(generate_claim)"; acquire_lock "$repo" start "$claim" "$issue" "$branch" "$base" - || return 1
  slot="$(slot_path "$repo")"; mkdir "$slot" || { remove_owned_lock "$repo" "$claim" >/dev/null 2>&1 || true; echo "BLOCKED: atomic slot claim failed"; return 1; }
  write_atomic "$slot/state" "version=1\nissue=$issue\nbranch=$branch\nbase=$base\nclaim=$claim\n" || { echo "ERROR: slot write failed; lock retained"; return 1; }
  [[ "${NUINUI_SELFTEST_CRASH_AT:-}" == start-after-slot ]] && { echo "SELFTEST CRASH: start-after-slot"; return 97; }
  out="$(legacy_capture start "$lane" "$issue" "$base" "$branch")"; rc=$?; printf '%s\n' "$out"
  if (( rc != 0 )); then rollback_failed_start_if_safe "$lane" "$repo" "$base" "$branch" "$claim" >/dev/null 2>&1 || true; return "$rc"; fi
  [[ "$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" == "$branch" && "$(git -C "$repo" rev-parse HEAD)" == "$base" && -z "$(git -C "$repo" status --porcelain)" ]] || { echo "BLOCKED: post-start verification failed; slot and lock retained"; return 1; }
  remove_owned_lock "$repo" "$claim" || { echo "BLOCKED: start succeeded but lock cleanup failed"; return 1; }
  echo "  claim=$claim"
}

resume_lane() {
  local lane="$1" issue="$2" base="$3" cp="$4" branch="$5" claim="$6" repo="" slot="" before_branch="" before_head="" out="" rc=0
  assert_impl_lane "$lane" || return $?; valid_issue "$issue" || return 2; valid_sha "$base" || return 2; valid_sha "$cp" || return 2; valid_claim "$claim" || return 2; git check-ref-format --branch "$branch" >/dev/null 2>&1 || return 2
  [[ "$(issue_from_branch "$branch")" == "$issue" ]] || { echo "BLOCKED: branch name does not match Issue"; return 1; }
  repo="$(lane_repo "$lane")"; slot="$(slot_path "$repo")"; slot_matches "$slot" "$issue" "$branch" "$base" "$claim" || { echo "BLOCKED: lane claim does not match resume identity"; return 1; }
  [[ ! -e "$(lock_path "$repo")" ]] || { echo "BLOCKED: implementation lane mutation lock already exists"; return 1; }; assert_no_release_state "$repo" || return 1
  before_branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"; before_head="$(git -C "$repo" rev-parse HEAD)"
  acquire_lock "$repo" resume "$claim" "$issue" "$branch" "$base" "$cp" || return 1
  out="$(legacy_capture resume "$lane" "$issue" "$cp" "$branch")"; rc=$?; printf '%s\n' "$out"
  if (( rc != 0 )); then
    if [[ "$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" == "$before_branch" && "$(git -C "$repo" rev-parse HEAD)" == "$before_head" ]]; then remove_owned_lock "$repo" "$claim" >/dev/null 2>&1 || true; fi
    return "$rc"
  fi
  [[ "$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" == "$branch" && "$(git -C "$repo" rev-parse HEAD)" == "$cp" && -z "$(git -C "$repo" status --porcelain)" ]] || { echo "BLOCKED: post-resume verification failed; lock retained"; return 1; }
  remove_owned_lock "$repo" "$claim" || return 1
  echo "  base=$base"; echo "  claim=$claim"
}

release_lane() {
  local lane="$1" cp="$2" claim="$3" repo="" slot="" issue="" branch="" base="" rel="" out="" rc=0
  assert_impl_lane "$lane" || return $?; valid_sha "$cp" || return 2; valid_claim "$claim" || return 2
  repo="$(lane_repo "$lane")"; slot="$(slot_path "$repo")"; validate_slot "$slot/state" || { echo "BLOCKED: valid active implementation slot is required for release"; return 1; }
  [[ "$(state_value "$slot/state" claim)" == "$claim" ]] || { echo "BLOCKED: lane belongs to another claim generation"; return 1; }
  [[ ! -e "$(lock_path "$repo")" ]] || { echo "BLOCKED: implementation lane mutation lock already exists"; return 1; }; assert_no_release_state "$repo" || return 1
  issue="$(state_value "$slot/state" issue)"; branch="$(state_value "$slot/state" branch)"; base="$(state_value "$slot/state" base)"
  [[ "$(git -C "$repo" rev-parse --verify "refs/heads/$branch^{commit}" 2>/dev/null || true)" == "$cp" ]] || { echo "BLOCKED: claimed topic branch is not at release checkpoint"; return 1; }
  acquire_lock "$repo" release "$claim" "$issue" "$branch" "$base" "$cp" || return 1
  git -C "$repo" fetch origin --prune >/dev/null 2>&1 || { remove_owned_lock "$repo" "$claim" >/dev/null 2>&1 || true; echo "ERROR: git fetch failed"; return 1; }
  git -C "$repo" merge-base --is-ancestor "$cp" origin/main || { remove_owned_lock "$repo" "$claim" >/dev/null 2>&1 || true; echo "BLOCKED: checkpoint is not contained in origin/main"; return 1; }
  write_atomic "$slot/checkpoint" "$cp\n" || { echo "ERROR: could not persist release checkpoint; lock retained"; return 1; }
  rel="$(releasing_path "$repo" "$claim")"; mv "$slot" "$rel" || { echo "ERROR: could not atomically enter release state; lock retained"; return 1; }
  [[ "${NUINUI_SELFTEST_CRASH_AT:-}" == release-after-rename ]] && { echo "SELFTEST CRASH: release-after-rename"; return 97; }
  out="$(legacy_capture release "$lane" "$cp")"; rc=$?; printf '%s\n' "$out"; (( rc == 0 )) || return "$rc"
  rm "$rel/checkpoint" "$rel/state" && rmdir "$rel" || { echo "BLOCKED: release succeeded but tombstone cleanup failed; lock retained"; return 1; }
  remove_owned_lock "$repo" "$claim" || { echo "BLOCKED: release succeeded but lock cleanup failed"; return 1; }
  echo "  claim=$claim"
}

recover_lane() {
  local lane="$1" expected="$2" repo="" lock="" rels="" count=0 rel="" op="" claim="" issue="" branch="" base="" cp="" slot="" out="" rc=0
  assert_impl_lane "$lane" || return $?; valid_claim "$expected" || return 2; repo="$(lane_repo "$lane")"; lock="$(lock_path "$repo")"; slot="$(slot_path "$repo")"; rels="$(releasing_dirs "$repo")"; count="$(printf '%s\n' "$rels" | grep -c . || true)"
  if [[ ! -e "$lock" ]]; then
    [[ "$count" == 1 ]] || { echo "BLOCKED: no unique recoverable release state exists"; return 1; }
    rel="$rels"; validate_releasing "$rel" || { echo "BLOCKED: release tombstone is invalid"; return 1; }; claim="$(state_value "$rel/state" claim)"; [[ "$claim" == "$expected" ]] || { echo "BLOCKED: releasing slot belongs to another claim"; return 1; }
    issue="$(state_value "$rel/state" issue)"; branch="$(state_value "$rel/state" branch)"; base="$(state_value "$rel/state" base)"; cp="$(cat "$rel/checkpoint")"
    acquire_lock "$repo" release "$claim" "$issue" "$branch" "$base" "$cp" || return 1
  fi
  validate_lock "$lock/state" || { echo "BLOCKED: implementation lane mutation lock is invalid"; return 1; }; claim="$(state_value "$lock/state" claim)"; [[ "$claim" == "$expected" ]] || { echo "BLOCKED: mutation lock belongs to another claim"; return 1; }
  op="$(state_value "$lock/state" operation)"; issue="$(state_value "$lock/state" issue)"; branch="$(state_value "$lock/state" branch)"; base="$(state_value "$lock/state" base)"; cp="$(state_value "$lock/state" checkpoint)"
  case "$op" in
    init)
      [[ ! -e "$slot" && "$count" == 0 ]] || { echo "BLOCKED: init recovery found ownership state"; return 1; }
      git -C "$repo" fetch origin main >/dev/null 2>&1 || return 1; assert_exact_idle "$lane" "$repo" "$(git -C "$repo" rev-parse origin/main)" || return 1
      [[ -e "$(init_path "$repo")" ]] || write_atomic "$(init_path "$repo")" 'version=1\n'; validate_init "$(init_path "$repo")" || return 1; remove_owned_lock "$repo" "$claim" || return 1; echo "RECOVERED operation=init" ;;
    start)
      slot_matches "$slot" "$issue" "$branch" "$base" "$claim" || { echo "BLOCKED: start lock and slot disagree"; return 1; }
      if [[ "$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" == "$branch" && "$(git -C "$repo" rev-parse HEAD)" == "$base" && -z "$(git -C "$repo" status --porcelain)" ]]; then remove_owned_lock "$repo" "$claim" || return 1; echo "RECOVERED operation=start-complete"; return 0; fi
      out="$(legacy_capture start "$lane" "$issue" "$base" "$branch")"; rc=$?; printf '%s\n' "$out"; (( rc == 0 )) || return "$rc"; remove_owned_lock "$repo" "$claim" || return 1; echo "RECOVERED operation=start" ;;
    resume)
      slot_matches "$slot" "$issue" "$branch" "$base" "$claim" || { echo "BLOCKED: resume lock and slot disagree"; return 1; }
      if [[ "$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" == "$branch" && "$(git -C "$repo" rev-parse HEAD)" == "$cp" && -z "$(git -C "$repo" status --porcelain)" ]]; then remove_owned_lock "$repo" "$claim" || return 1; echo "RECOVERED operation=resume-complete"; return 0; fi
      out="$(legacy_capture resume "$lane" "$issue" "$cp" "$branch")"; rc=$?; printf '%s\n' "$out"; (( rc == 0 )) || return "$rc"; remove_owned_lock "$repo" "$claim" || return 1; echo "RECOVERED operation=resume" ;;
    release)
      if [[ "$count" == 0 && -e "$slot" ]]; then
        slot_matches "$slot" "$issue" "$branch" "$base" "$claim" || { echo "BLOCKED: release lock and active slot disagree"; return 1; }
        if [[ -f "$slot/checkpoint" ]]; then [[ "$(cat "$slot/checkpoint")" == "$cp" ]] || { echo "BLOCKED: release checkpoint metadata disagrees with lock"; return 1; }; else write_atomic "$slot/checkpoint" "$cp\n" || return 1; fi
        rel="$(releasing_path "$repo" "$claim")"; mv "$slot" "$rel" || return 1
      elif [[ "$count" == 1 && ! -e "$slot" ]]; then
        rel="$rels"; release_state_matches "$rel" "$issue" "$branch" "$base" "$claim" "$cp" || { echo "BLOCKED: release lock and tombstone disagree"; return 1; }
      else echo "BLOCKED: release recovery state is ambiguous"; return 1; fi
      release_state_matches "$rel" "$issue" "$branch" "$base" "$claim" "$cp" || { echo "BLOCKED: release recovery identity is inconsistent"; return 1; }
      out="$(legacy_capture release "$lane" "$cp")"; rc=$?; printf '%s\n' "$out"; (( rc == 0 )) || return "$rc"
      rm "$rel/checkpoint" "$rel/state" && rmdir "$rel" || return 1; remove_owned_lock "$repo" "$claim" || return 1; echo "RECOVERED operation=release" ;;
    adopt) echo "BLOCKED: interrupted adoption requires explicit inspection"; return 1 ;;
  esac
}


durable_self_test() (
  local root="" remote="" seed="" main="" sub="" e2e="" base="" out="" claim="" cp="" slot="" lock="" rel="" latest="" gitdir=""
  root="$(mktemp -d "${TMPDIR:-/tmp}/nuinui-durable-wrapper.XXXXXX")" || return 1
  trap 'rm -rf "$root"' EXIT
  remote="$root/remote.git"; seed="$root/seed"; main="$root/main"; sub="$root/sub"; e2e="$root/e2e"
  git init -q --bare "$remote" || return 1; git -C "$remote" symbolic-ref HEAD refs/heads/main || return 1
  git init -q -b main "$seed" || return 1; git -C "$seed" config user.name test; git -C "$seed" config user.email test@example.invalid
  echo base > "$seed/a"; git -C "$seed" add a; git -C "$seed" commit -q -m base; git -C "$seed" remote add origin "$remote"; git -C "$seed" push -q -u origin main || return 1
  git clone -q "$remote" "$main" || return 1; git -C "$main" config user.name test; git -C "$main" config user.email test@example.invalid
  git -C "$main" worktree add -q --detach "$sub" origin/main || return 1; git -C "$main" worktree add -q --detach "$e2e" origin/main || return 1
  export NUINUI_SELFTEST=1 NUINUI_MAIN_WT="$main" NUINUI_SUB_WT="$sub" NUINUI_E2E_WT="$e2e"
  base="$(git -C "$main" rev-parse origin/main)"

  echo "TEST: durable migration gate"
  if "$SCRIPT_PATH" preflight >/dev/null 2>&1; then echo "SELFTEST FAIL: unmigrated implementation lanes accepted"; return 1; fi
  "$SCRIPT_PATH" lane-init main >/dev/null || return 1; "$SCRIPT_PATH" lane-init sub >/dev/null || return 1
  "$SCRIPT_PATH" preflight >/dev/null || return 1

  echo "TEST: adoption blocks Issue/branch mismatch"
  git -C "$sub" switch -c test/say-997-adopt "$base" >/dev/null || return 1; git -C "$sub" push -q -u origin test/say-997-adopt || return 1
  if "$SCRIPT_PATH" lane-adopt sub SAY-998 "$base" "$base" test/say-997-adopt >/dev/null 2>&1; then echo "SELFTEST FAIL: adoption accepted wrong Issue identity"; return 1; fi
  git -C "$sub" switch --detach "$base" >/dev/null || return 1

  echo "TEST: release classification rejects tombstone suffix mismatch"
  gitdir="$(git_dir "$sub")"; rel="$gitdir/nuinui-implementation-slot.releasing.claim-A"
  mkdir "$rel" || return 1; printf 'version=1\nissue=SAY-997\nbranch=test/say-997-adopt\nbase=%s\nclaim=claim-B\n' "$base" > "$rel/state"; printf '%s\n' "$base" > "$rel/checkpoint"
  if classify_lane sub "$sub" >/dev/null 2>&1; then echo "SELFTEST FAIL: suffix-mismatched tombstone accepted"; return 1; fi
  rm -rf "$rel"

  echo "TEST: release recovery rejects lock/tombstone claim mismatch"
  rel="$gitdir/nuinui-implementation-slot.releasing.claim-B"; mkdir "$rel" || return 1; printf 'version=1\nissue=SAY-997\nbranch=test/say-997-adopt\nbase=%s\nclaim=claim-B\n' "$base" > "$rel/state"; printf '%s\n' "$base" > "$rel/checkpoint"
  acquire_lock "$sub" release claim-A SAY-997 test/say-997-adopt "$base" "$base" || return 1
  if "$SCRIPT_PATH" recover sub claim-A >/dev/null 2>&1; then echo "SELFTEST FAIL: recovery accepted mismatched tombstone generation"; return 1; fi
  rm -rf "$(lock_path "$sub")" "$rel"

  echo "TEST: durable claim survives external wrong switch"
  out="$("$SCRIPT_PATH" start main SAY-999 "$base" test/say-999-active 2>&1)" || { printf '%s\n' "$out"; return 1; }
  claim="$(printf '%s\n' "$out" | sed -n 's/^  claim=//p' | tail -n 1)"; valid_claim "$claim" || return 1
  slot="$(slot_path "$main")"; [[ -f "$slot/state" ]] || return 1
  git -C "$main" switch main >/dev/null || return 1
  if "$SCRIPT_PATH" preflight >/dev/null 2>&1; then echo "SELFTEST FAIL: wrong switch was classified FREE"; return 1; fi

  echo "TEST: resume requires Base and claim identity"
  git -C "$main" switch test/say-999-active >/dev/null || return 1; echo work >> "$main/a"; git -C "$main" add a; git -C "$main" commit -q -m work
  cp="$(git -C "$main" rev-parse HEAD)"; git -C "$main" push -q -u origin test/say-999-active || return 1; git -C "$main" switch main >/dev/null || return 1
  if "$SCRIPT_PATH" resume main SAY-999 "$base" "$cp" test/say-999-active wrong-claim >/dev/null 2>&1; then echo "SELFTEST FAIL: wrong resume claim accepted"; return 1; fi
  "$SCRIPT_PATH" resume main SAY-999 "$base" "$cp" test/say-999-active "$claim" >/dev/null || return 1

  echo "TEST: failed release retains slot and rolls back own lock"
  if "$SCRIPT_PATH" release main "$cp" "$claim" >/dev/null 2>&1; then echo "SELFTEST FAIL: unmerged release accepted"; return 1; fi
  [[ -f "$slot/state" && ! -e "$(lock_path "$main")" ]] || return 1

  echo "TEST: release requires claim generation"
  if "$SCRIPT_PATH" release main "$cp" wrong-claim >/dev/null 2>&1; then echo "SELFTEST FAIL: wrong release claim accepted"; return 1; fi

  echo "TEST: merged release may advance to newer origin/main"
  git -C "$main" push -q origin HEAD:main || return 1
  git -C "$seed" fetch -q origin main; git -C "$seed" reset -q --hard origin/main; echo newer > "$seed/newer"; git -C "$seed" add newer; git -C "$seed" commit -q -m newer; git -C "$seed" push -q origin main || return 1
  latest="$(git -C "$seed" rev-parse HEAD)"; "$SCRIPT_PATH" release main "$cp" "$claim" >/dev/null || return 1
  [[ ! -e "$slot" && "$(git -C "$main" branch --show-current)" == main && "$(git -C "$main" rev-parse HEAD)" == "$latest" ]] || return 1

  echo "TEST: start crash after durable slot is recoverable"
  base="$latest"
  NUINUI_SELFTEST_CRASH_AT=start-after-slot "$SCRIPT_PATH" start main SAY-998 "$base" test/say-998-active >/dev/null 2>&1; [[ $? -eq 97 ]] || return 1
  lock="$(lock_path "$main")"; slot="$(slot_path "$main")"; claim="$(state_value "$lock/state" claim)"; [[ -f "$slot/state" ]] || return 1
  "$SCRIPT_PATH" recover main "$claim" >/dev/null || return 1; [[ "$(git -C "$main" branch --show-current)" == test/say-998-active ]] || return 1
  echo x >> "$main/a"; git -C "$main" add a; git -C "$main" commit -q -m x; cp="$(git -C "$main" rev-parse HEAD)"; git -C "$main" push -q origin HEAD:main || return 1

  echo "TEST: release crash after atomic rename is recoverable"
  NUINUI_SELFTEST_CRASH_AT=release-after-rename "$SCRIPT_PATH" release main "$cp" "$claim" >/dev/null 2>&1; [[ $? -eq 97 ]] || return 1
  rel="$(releasing_dirs "$main")"; [[ -d "$rel" && -f "$rel/checkpoint" && -d "$(lock_path "$main")" ]] || return 1
  "$SCRIPT_PATH" recover main "$claim" >/dev/null || return 1; [[ -z "$(releasing_dirs "$main")" && ! -e "$(lock_path "$main")" ]] || return 1

  echo "TEST: stale clean main is not FREE"
  git -C "$seed" fetch -q origin main; git -C "$seed" reset -q --hard origin/main; echo advance > "$seed/advance"; git -C "$seed" add advance; git -C "$seed" commit -q -m advance; git -C "$seed" push -q origin main || return 1
  if "$SCRIPT_PATH" preflight >/dev/null 2>&1; then echo "SELFTEST FAIL: stale clean main accepted"; return 1; fi

  echo "DURABLE WRAPPER SELFTEST PASS"
)

run_self_test() {
  [[ -x "$LEGACY_SCRIPT" ]] || { echo "SELFTEST FAIL: legacy helper missing"; return 1; }
  "$LEGACY_SCRIPT" self-test || return 1
  durable_self_test || return 1
  echo "SELFTEST PASS"
}

doctor_wrapper() { local r=0; preflight || r=1; echo; "$LEGACY_SCRIPT" doctor "$@" || r=1; return "$r"; }
delegate() { [[ -x "$LEGACY_SCRIPT" ]] || { echo "BLOCKED: legacy compatibility helper is unavailable"; return 1; }; exec "$LEGACY_SCRIPT" "$@"; }

case "${1:-}" in
  version) echo "$VERSION" ;;
  preflight) preflight ;;
  verify) [[ $# -eq 5 ]] || { echo "Usage: $0 verify <main|sub> <SAY-123> <expected-base-sha> <branch>"; exit 2; }; verify_lane "$2" "$3" "$4" "$5" ;;
  lane-init) [[ $# -eq 2 ]] || { echo "Usage: $0 lane-init <main|sub>"; exit 2; }; lane_init "$2" ;;
  lane-adopt) [[ $# -eq 6 ]] || { echo "Usage: $0 lane-adopt <main|sub> <SAY-123> <expected-base-sha> <expected-checkpoint-sha> <branch>"; exit 2; }; lane_adopt "$2" "$3" "$4" "$5" "$6" ;;
  start) [[ $# -eq 5 ]] || { echo "Usage: $0 start <main|sub> <SAY-123> <expected-base-sha> <branch>"; exit 2; }; start_lane "$2" "$3" "$4" "$5" ;;
  resume) [[ $# -eq 7 ]] || { echo "Usage: $0 resume <main|sub> <SAY-123> <expected-base-sha> <expected-checkpoint-sha> <branch> <expected-claim>"; exit 2; }; resume_lane "$2" "$3" "$4" "$5" "$6" "$7" ;;
  release) [[ $# -eq 4 ]] || { echo "Usage: $0 release <main|sub> <merged-checkpoint-sha> <expected-claim>"; exit 2; }; release_lane "$2" "$3" "$4" ;;
  recover) [[ $# -eq 3 ]] || { echo "Usage: $0 recover <main|sub> <expected-claim>"; exit 2; }; recover_lane "$2" "$3" ;;
  doctor) shift; doctor_wrapper "$@" ;;
  self-test) run_self_test ;;
  pr-auto-merge|e2e-start|e2e-start-local-main|e2e-release|context-sync|transition-audit|context-check) delegate "$@" ;;
  *)
    echo "nuinui $VERSION"; echo "Commands:"; echo "  preflight"; echo "  verify <main|sub> <SAY-123> <expected-base-sha> <branch>"; echo "  lane-init <main|sub>"; echo "  lane-adopt <main|sub> <SAY-123> <expected-base-sha> <expected-checkpoint-sha> <branch>"; echo "  start <main|sub> <SAY-123> <expected-base-sha> <branch>"; echo "  resume <main|sub> <SAY-123> <expected-base-sha> <expected-checkpoint-sha> <branch> <expected-claim>"; echo "  release <main|sub> <merged-checkpoint-sha> <expected-claim>"; echo "  recover <main|sub> <expected-claim>"; echo "  pr-auto-merge <pr-number> <expected-head-sha> <expected-main-sha>"; echo "  e2e-start <SAY-123> <tested-ref>"; echo "  e2e-start-local-main <SAY-123> <tested-ref>"; echo "  e2e-release"; echo "  context-sync"; echo "  doctor [--full]"; echo "  transition-audit"; echo "  context-check"; echo "  self-test"; exit 2 ;;
esac
