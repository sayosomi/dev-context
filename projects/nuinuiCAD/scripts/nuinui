  C=${NUINUI_DEV_CONTEXT_WT:-}
else
  C=/Users/yosomi/Code/dev-context
fi
if [ "${NUINUI_SELFTEST:-0}" = 1 ]; then
  CD=${NUINUI_DEV_CONTEXT_DEV_WT:-}
  [ -z "${NUINUI_SELFTEST_EXPECTED_ORIGIN:-}" ] || CT=$NUINUI_SELFTEST_EXPECTED_ORIGIN
