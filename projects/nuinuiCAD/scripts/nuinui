#!/bin/zsh

VERSION="1.3.3"
SCRIPT_PATH="${ZSH_SCRIPT:-$0}"
E2E_STATUS_HELPER="${NUINUI_E2E_STATUS_HELPER-${SCRIPT_PATH:A:h}/nuinui-e2e-prepare}"
GH_BIN="${NUINUI_GH_BIN:-gh}"
PR_TARGET_REPO="sayosomi/nuinuiCAD"

if [[ "${NUINUI_SELFTEST:-0}" == "1" ]]; then
  MAIN_WT="${NUINUI_MAIN_WT}"
  SUB_WT="${NUINUI_SUB_WT}"
  E2E_WT="${NUINUI_E2E_WT}"
  DEV_CONTEXT_WT="${NUINUI_DEV_CONTEXT_WT}"
  TARGET_REPO_TOKEN=""
  DEV_CONTEXT_TOKEN=""
else
  MAIN_WT="/Users/yosomi/Code/nuinuiCAD"
  SUB_WT="/Users/yosomi/Code/nuinuiCAD-sub"
  E2E_WT="/Users/yosomi/Code/nuinuiCAD-e2e"
  DEV_CONTEXT_WT="/Users/yosomi/Code/dev-context"
  TARGET_REPO_TOKEN="sayosomi/nuinuiCAD"
  DEV_CONTEXT_TOKEN="sayosomi/dev-context"
fi

issue_from_branch() {
  local branch="$1"
  if [[ "$branch" =~ '(SAY|say)-([0-9]+)' ]]; then
    echo "SAY-${match[2]}"
  else
    printf '%s\n' '-'
  fi
}

assert_git_repo() {
  local repo="$1"
  if [[ ! -d "$repo" ]]; then
    echo "BLOCKED: checkout path does not exist"
    echo "PATH: $repo"
    return 1
  fi
  if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "BLOCKED: path is not a Git worktree"
    echo "PATH: $repo"
    return 1
  fi
}

assert_origin() {
  local repo="$1"
  local token="$2"
  local origin_url=""
  [[ -z "$token" ]] && return 0
  origin_url="$(git -C "$repo" remote get-url origin 2>/dev/null)" || {
    echo "BLOCKED: origin remote is missing"
    echo "PATH: $repo"
    return 1
  }
  if [[ "$origin_url" != *"$token"* ]]; then
    echo "BLOCKED: unexpected repository origin"
    echo "PATH:     $repo"
    echo "EXPECTED: $token"
    echo "ACTUAL:   $origin_url"
    return 1
  fi
}

marker_path() {
  local repo="$1"
  local git_dir=""
  git_dir="$(git -C "$repo" rev-parse --absolute-git-dir 2>/dev/null)" || return 1
  echo "$git_dir/nuinui-slot"
}

session_path() {
  local repo="$1"
  local git_dir=""
  git_dir="$(git -C "$repo" rev-parse --absolute-git-dir 2>/dev/null)" || return 1
  echo "$git_dir/nuinui-e2e-session"
}

canonical_path() {
  local path="$1"
  (cd "$path" 2>/dev/null && pwd -P) || return 1
}

lane_repo() {
  case "$1" in
    main) echo "$MAIN_WT" ;;
    sub) echo "$SUB_WT" ;;
    e2e) echo "$E2E_WT" ;;
    *) return 2 ;;
  esac
}

show_lane() {
  local lane="$1"
  local repo="$2"
  local branch=""
  local head=""
  local dirty=""
  local issue="-"
  local marker_info="-"
  local marker=""

  if [[ ! -d "$repo" ]]; then
    echo "$lane path=missing"
    return
  fi
  if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "$lane path=$repo git=no"
    return
  fi

  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  head="$(git -C "$repo" rev-parse HEAD 2>/dev/null)"
  dirty="$(git -C "$repo" status --porcelain 2>/dev/null)"

  if [[ -n "$branch" ]]; then
    issue="$(issue_from_branch "$branch")"
  else
    branch="DETACHED"
  fi

  if [[ "$lane" == "e2e" ]]; then
    marker="$(marker_path "$repo")"
    if [[ -f "$marker" ]]; then marker_info="present"; else marker_info="none"; fi
  fi

  echo "$lane path=$repo"
  echo "  branch=$branch"
  echo "  head=$head"
  echo "  clean=$([[ -z "$dirty" ]] && echo yes || echo no) issue=$issue marker=$marker_info"

  if [[ -n "$dirty" ]]; then
    echo "  changes:"
    printf '%s\n' "$dirty" | sed 's/^/    /'
  fi

  if [[ "$lane" == "e2e" && "$marker_info" == "present" ]]; then
    echo "  marker:"
    sed 's/^/    /' "$marker"
  fi
}

preflight() {
  local lane=""
  local repo=""
  local source_repo=""
  local worktree=""
  local canonical=""
  local result=0
  local found_source=0
  local -a expected_worktrees
  local -a actual_worktrees

  expected_worktrees=()
  for worktree in "$MAIN_WT" "$SUB_WT" "$E2E_WT"; do
    canonical="$(canonical_path "$worktree")" || {
      echo "BLOCKED: expected lane path cannot be resolved"
      echo "PATH: $worktree"
      result=1
      canonical="$worktree"
    }
    expected_worktrees+=("$canonical")
  done

  for lane in main sub e2e; do
    repo="$(lane_repo "$lane")"
    show_lane "$lane" "$repo"
    if ! assert_git_repo "$repo" >/dev/null 2>&1; then
      echo "BLOCKED: $lane lane is unavailable"
      result=1
    fi
  done

  echo "worktrees:"
  for source_repo in "${expected_worktrees[@]}"; do
    if git -C "$source_repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      actual_worktrees=("${(@f)$(git -C "$source_repo" worktree list --porcelain | sed -n 's/^worktree //p')}")
      git -C "$source_repo" worktree list | sed 's/^/  /'
      found_source=1
      break
    fi
  done

  if (( found_source == 0 )); then
    echo "BLOCKED: no usable worktree found"
    return 1
  fi

  for worktree in "${expected_worktrees[@]}"; do
    if (( ${actual_worktrees[(Ie)$worktree]} == 0 )); then
      echo "BLOCKED: expected lane worktree is not registered"
      echo "PATH: $worktree"
      result=1
    fi
  done

  for worktree in "${actual_worktrees[@]}"; do
    if (( ${expected_worktrees[(Ie)$worktree]} == 0 )); then
      echo "BLOCKED: unexpected worktree is registered"
      echo "PATH: $worktree"
      result=1
    fi
  done

  if (( result == 0 )); then
    echo "PREFLIGHT PASS"
    return 0
  fi

  echo "PREFLIGHT BLOCKED"
  return 1
}

verify_lane() {
  local lane="$1"
  local issue="$2"
  local expected_base="$3"
  local branch="$4"
  local repo=""
  local current_branch=""
  local dirty=""
  local current_head=""
  local remote_main=""
  local branch_lc=""
  local issue_num=""
  local action=""

  case "$lane" in
    main) repo="$MAIN_WT" ;;
    sub) repo="$SUB_WT" ;;
    *) echo "ERROR: lane must be main or sub"; return 2 ;;
  esac

  if [[ ! "$issue" =~ '^SAY-[0-9]+$' ]]; then
    echo "ERROR: Issue must look like SAY-123"
    return 2
  fi
  if [[ ! "$expected_base" =~ '^[0-9a-fA-F]{40}$' ]]; then
    echo "ERROR: expected base must be a full 40-character commit SHA"
    return 2
  fi

  issue_num="${issue#SAY-}"
  branch_lc="$(printf '%s' "$branch" | tr '[:upper:]' '[:lower:]')"
  if [[ "$branch_lc" != *"say-$issue_num"* ]]; then
    echo "BLOCKED: branch name does not match Issue"
    echo "ISSUE:  $issue"
    echo "BRANCH: $branch"
    return 1
  fi

  assert_git_repo "$repo" || return 1
  assert_origin "$repo" "$TARGET_REPO_TOKEN" || return 1

  dirty="$(git -C "$repo" status --porcelain)"
  if [[ -n "$dirty" ]]; then
    echo "BLOCKED: $lane lane has uncommitted changes"
    git -C "$repo" status --short
    return 1
  fi

  current_branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ "$lane" == "main" && "$current_branch" != "main" ]]; then
    echo "BLOCKED: main lane is not on idle branch main"
    echo "ACTUAL: ${current_branch:-DETACHED}"
    return 1
  fi
  if [[ "$lane" == "sub" && -n "$current_branch" ]]; then
    echo "BLOCKED: sub lane is not at idle detached HEAD"
    echo "ACTUAL: $current_branch"
    return 1
  fi

  git -C "$repo" fetch origin --prune >/dev/null 2>&1 || {
    echo "ERROR: git fetch failed"
    return 1
  }
  remote_main="$(git -C "$repo" rev-parse origin/main)" || return 1
  current_head="$(git -C "$repo" rev-parse HEAD)" || return 1

  if [[ "$remote_main" != "$expected_base" ]]; then
    echo "BLOCKED: expected base is stale"
    echo "EXPECTED: $expected_base"
    echo "ACTUAL:   $remote_main"
    return 1
  fi

  if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    echo "BLOCKED: local branch already exists"
    echo "BRANCH: $branch"
    return 1
  fi
  if git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    echo "BLOCKED: remote branch already exists"
    echo "BRANCH: origin/$branch"
    return 1
  fi

  if [[ "$current_head" == "$expected_base" ]]; then
    action="STARTABLE"
  elif git -C "$repo" merge-base --is-ancestor "$current_head" "$expected_base"; then
    action="STARTABLE_AFTER_SAFE_NORMALIZATION"
  else
    echo "BLOCKED: idle lane HEAD is not an ancestor of expected Base"
    echo "HEAD: $current_head"
    echo "Base: $expected_base"
    return 1
  fi

  echo "VERIFIED"
  echo "  lane=$lane"
  echo "  issue=$issue"
  echo "  branch=$branch"
  echo "  current_head=$current_head"
  echo "  expected_base=$expected_base"
  echo "  origin_main=$remote_main"
  echo "  action=$action"
}


verify_lane_for_start() {
  local verify_output=""
  local verify_rc=0

  verify_output="$(verify_lane "$@")"
  verify_rc=$?
  if (( verify_rc != 0 )); then
    [[ -n "$verify_output" ]] && printf '%s\n' "$verify_output"
    return "$verify_rc"
  fi
  return 0
}

start_lane() {
  local lane="$1"
  local issue="$2"
  local expected_base="$3"
  local branch="$4"
  local repo=""

  repo="$(lane_repo "$lane")" || {
    echo "ERROR: lane must be main or sub"
    return 2
  }

  echo "CHECKING"
  echo "  lane=$lane"
  echo "  issue=$issue"

  verify_lane_for_start "$lane" "$issue" "$expected_base" "$branch" || return $?

  local current_head="$(git -C "$repo" rev-parse HEAD)"
  if [[ "$current_head" != "$expected_base" ]]; then
    if [[ "$lane" == "main" ]]; then
      git -C "$repo" merge --ff-only origin/main || {
        echo "ERROR: safe fast-forward failed"
        return 1
      }
    else
      git -C "$repo" switch --detach "$expected_base" || {
        echo "ERROR: safe detached normalization failed"
        return 1
      }
    fi
  fi

  local normalized_head="$(git -C "$repo" rev-parse HEAD)"
  if [[ "$normalized_head" != "$expected_base" ]]; then
    echo "ERROR: normalization did not reach expected Base"
    echo "ACTUAL: $normalized_head"
    echo "EXPECTED: $expected_base"
    return 1
  fi

  verify_lane_for_start "$lane" "$issue" "$expected_base" "$branch" || return $?

  git -C "$repo" switch -c "$branch" "$expected_base" || {
    echo "ERROR: branch creation failed"
    return 1
  }

  echo "STARTED"
  echo "  lane=$lane"
  echo "  issue=$issue"
  echo "  branch=$branch"
  echo "  base=$expected_base"
}


resume_lane() {
  local lane="$1"
  local issue="$2"
  local expected_checkpoint="$3"
  local branch="$4"
  local repo=""
  local wt_status=""
  local current_branch=""
  local current_head=""
  local remote_main=""
  local local_branch_head=""
  local authoritative_branch=""
  local authoritative_main=""
  local canonical_repo=""
  local occupied_path=""
  local pre_switch_branch=""
  local pre_switch_head=""
  local restored_branch=""
  local restored_head=""
  local restored_status=""

  case "$lane" in
    main) repo="$MAIN_WT" ;;
    sub) repo="$SUB_WT" ;;
    *) echo "ERROR: lane must be main or sub"; return 2 ;;
  esac

  if [[ ! "$issue" =~ '^SAY-[0-9]+$' ]]; then
    echo "ERROR: Issue must look like SAY-123"
    return 2
  fi
  if [[ ! "$expected_checkpoint" =~ '^[0-9a-fA-F]{40}$' ]]; then
    echo "ERROR: expected checkpoint must be a full 40-character commit SHA"
    return 2
  fi
  if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
    echo "ERROR: invalid branch name"
    echo "BRANCH: $branch"
    return 2
  fi

  if [[ "$(issue_from_branch "$branch")" != "$issue" ]]; then
    echo "BLOCKED: branch name does not match Issue"
    echo "ISSUE:  $issue"
    echo "BRANCH: $branch"
    return 1
  fi

  assert_git_repo "$repo" || return 1
  assert_origin "$repo" "$TARGET_REPO_TOKEN" || return 1

  wt_status="$(git -C "$repo" status --porcelain)"
  if [[ -n "$wt_status" ]]; then
    echo "BLOCKED: $lane lane is dirty"
    git -C "$repo" status --short
    echo "No branch switch was performed."
    return 1
  fi

  local_branch_head="$(git -C "$repo" rev-parse "refs/heads/${branch}^{commit}" 2>/dev/null)" || {
    echo "BLOCKED: local resume branch does not exist"
    echo "BRANCH: $branch"
    echo "No branch switch was performed."
    return 1
  }
  if [[ "$local_branch_head" != "$expected_checkpoint" ]]; then
    echo "BLOCKED: local resume branch is not at expected checkpoint"
    echo "EXPECTED: $expected_checkpoint"
    echo "ACTUAL:   $local_branch_head"
    echo "No branch switch was performed."
    return 1
  fi

  authoritative_branch="$(git -C "$repo" ls-remote --heads origin "refs/heads/$branch" 2>/dev/null | awk 'NR == 1 { print $1 }')"
  if [[ ! "$authoritative_branch" =~ '^[0-9a-fA-F]{40}$' ]]; then
    echo "BLOCKED: remote resume branch does not exist"
    echo "BRANCH: origin/$branch"
    echo "No branch switch was performed."
    return 1
  fi
  if [[ "$authoritative_branch" != "$expected_checkpoint" ]]; then
    echo "BLOCKED: remote resume branch is not at expected checkpoint"
    echo "EXPECTED: $expected_checkpoint"
    echo "ACTUAL:   $authoritative_branch"
    echo "No branch switch was performed."
    return 1
  fi

  git -C "$repo" fetch origin main >/dev/null 2>&1 || {
    echo "ERROR: git fetch failed"
    echo "No branch switch was performed."
    return 1
  }
  remote_main="$(git -C "$repo" rev-parse origin/main)" || return 1

  canonical_repo="$(canonical_path "$repo")" || {
    echo "BLOCKED: lane path cannot be resolved"
    echo "PATH: $repo"
    return 1
  }
  occupied_path="$(git -C "$repo" worktree list --porcelain | awk -v target="refs/heads/$branch" -v current="$canonical_repo" '
    /^worktree / { path=substr($0, 10) }
    /^branch / {
      ref=substr($0, 8)
      if (ref == target && path != current) {
        print path
        exit
      }
    }
  ')"
  if [[ -n "$occupied_path" ]]; then
    echo "BLOCKED: resume branch is checked out in another worktree"
    echo "BRANCH:   $branch"
    echo "WORKTREE: $occupied_path"
    echo "No branch switch was performed."
    return 1
  fi

  current_branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  current_head="$(git -C "$repo" rev-parse HEAD)" || return 1

  if [[ "$current_branch" == "$branch" ]]; then
    if [[ "$current_head" != "$expected_checkpoint" ]]; then
      echo "BLOCKED: current resume branch HEAD does not match expected checkpoint"
      echo "EXPECTED: $expected_checkpoint"
      echo "ACTUAL:   $current_head"
      return 1
    fi
    echo "ALREADY RESUMED"
    echo "  lane=$lane"
    echo "  issue=$issue"
    echo "  branch=$branch"
    echo "  head=$current_head"
    echo "  clean=yes"
    return 0
  fi

  if [[ "$lane" == "main" ]]; then
    if [[ "$current_branch" != "main" ]]; then
      echo "BLOCKED: main lane is not in safe idle state"
      echo "EXPECTED: main"
      echo "ACTUAL:   ${current_branch:-DETACHED}"
      echo "No branch switch was performed."
      return 1
    fi
  else
    if [[ -n "$current_branch" ]]; then
      echo "BLOCKED: sub lane is not in safe idle detached state"
      echo "ACTUAL: $current_branch"
      echo "No branch switch was performed."
      return 1
    fi
  fi

  if ! git -C "$repo" merge-base --is-ancestor "$current_head" "$remote_main"; then
    echo "BLOCKED: idle lane HEAD is not safely contained in origin/main"
    echo "HEAD:        $current_head"
    echo "ORIGIN_MAIN: $remote_main"
    echo "No branch switch was performed."
    return 1
  fi

  pre_switch_branch="$current_branch"
  pre_switch_head="$current_head"

  wt_status="$(git -C "$repo" status --porcelain)"
  if [[ -n "$wt_status" ]]; then
    echo "BLOCKED: lane became dirty before resume"
    echo "No branch switch was performed."
    return 1
  fi

  current_branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  current_head="$(git -C "$repo" rev-parse HEAD)" || return 1
  if [[ "$current_branch" != "$pre_switch_branch" || "$current_head" != "$pre_switch_head" ]]; then
    echo "BLOCKED: lane state changed during resume verification"
    echo "No branch switch was performed."
    return 1
  fi

  local_branch_head="$(git -C "$repo" rev-parse "refs/heads/${branch}^{commit}" 2>/dev/null)" || return 1
  if [[ "$local_branch_head" != "$expected_checkpoint" ]]; then
    echo "BLOCKED: local resume branch changed during verification"
    echo "EXPECTED: $expected_checkpoint"
    echo "ACTUAL:   $local_branch_head"
    echo "No branch switch was performed."
    return 1
  fi

  authoritative_branch="$(git -C "$repo" ls-remote --heads origin "refs/heads/$branch" 2>/dev/null | awk 'NR == 1 { print $1 }')"
  if [[ "$authoritative_branch" != "$expected_checkpoint" ]]; then
    echo "BLOCKED: remote resume branch changed during verification"
    echo "EXPECTED: $expected_checkpoint"
    echo "ACTUAL:   ${authoritative_branch:-missing}"
    echo "No branch switch was performed."
    return 1
  fi

  authoritative_main="$(git -C "$repo" ls-remote origin refs/heads/main 2>/dev/null | awk 'NR == 1 { print $1 }')"
  if [[ "$authoritative_main" != "$remote_main" ]]; then
    echo "BLOCKED: origin/main changed during resume verification"
    echo "EXPECTED: $remote_main"
    echo "ACTUAL:   ${authoritative_main:-unavailable}"
    echo "No branch switch was performed."
    return 1
  fi

  occupied_path="$(git -C "$repo" worktree list --porcelain | awk -v target="refs/heads/$branch" -v current="$canonical_repo" '
    /^worktree / { path=substr($0, 10) }
    /^branch / {
      ref=substr($0, 8)
      if (ref == target && path != current) {
        print path
        exit
      }
    }
  ')"
  if [[ -n "$occupied_path" ]]; then
    echo "BLOCKED: resume branch became occupied by another worktree"
    echo "BRANCH:   $branch"
    echo "WORKTREE: $occupied_path"
    echo "No branch switch was performed."
    return 1
  fi

  if ! git -C "$repo" switch "$branch"; then
    echo "ERROR: git switch failed"
    echo "No reset, stash, merge, rebase, or force-switch was attempted."
    return 1
  fi

  restored_branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  restored_head="$(git -C "$repo" rev-parse HEAD)"
  restored_status="$(git -C "$repo" status --porcelain)"

  if [[ "$restored_branch" != "$branch" || "$restored_head" != "$expected_checkpoint" || -n "$restored_status" ]]; then
    echo "BLOCKED: post-resume verification failed"
    echo "BRANCH: ${restored_branch:-DETACHED}"
    echo "HEAD:   $restored_head"
    echo "No further mutation was performed."
    return 1
  fi

  echo "RESUMED"
  echo "  lane=$lane"
  echo "  issue=$issue"
  echo "  branch=$restored_branch"
  echo "  head=$restored_head"
  echo "  clean=yes"
}

release_lane() {
  local lane="$1"
  local checkpoint="$2"
  local repo=""
  local dirty=""
  local current_head=""
  local current_branch=""
  local remote_main=""
  local local_main=""

  case "$lane" in
    main) repo="$MAIN_WT" ;;
    sub) repo="$SUB_WT" ;;
    *) echo "ERROR: lane must be main or sub"; return 2 ;;
  esac

  assert_git_repo "$repo" || return 1
  assert_origin "$repo" "$TARGET_REPO_TOKEN" || return 1

  dirty="$(git -C "$repo" status --porcelain)"
  if [[ -n "$dirty" ]]; then
    echo "BLOCKED: $lane lane is dirty"
    echo "No release mutation was performed."
    return 1
  fi

  if ! git -C "$repo" cat-file -e "${checkpoint}^{commit}" 2>/dev/null; then
    echo "BLOCKED: checkpoint commit is unknown locally"
    echo "CHECKPOINT: $checkpoint"
    return 1
  fi

  current_head="$(git -C "$repo" rev-parse HEAD)"
  current_branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ "$current_head" != "$checkpoint" ]]; then
    if [[ "$lane" == "main" && "$current_branch" != "main" ]]; then
      echo "BLOCKED: main lane is neither at checkpoint nor on idle branch main"
      echo "BRANCH:     ${current_branch:-DETACHED}"
      echo "HEAD:       $current_head"
      echo "CHECKPOINT: $checkpoint"
      echo "No release mutation was performed."
      return 1
    fi
    if [[ "$lane" == "sub" && -n "$current_branch" ]]; then
      echo "BLOCKED: sub lane is neither at checkpoint nor at idle detached HEAD"
      echo "BRANCH:     $current_branch"
      echo "HEAD:       $current_head"
      echo "CHECKPOINT: $checkpoint"
      echo "No release mutation was performed."
      return 1
    fi
  fi

  git -C "$repo" fetch origin --prune >/dev/null 2>&1 || { echo "ERROR: git fetch failed"; return 1; }
  remote_main="$(git -C "$repo" rev-parse origin/main)" || return 1

  if ! git -C "$repo" merge-base --is-ancestor "$checkpoint" "$remote_main"; then
    echo "BLOCKED: checkpoint is not contained in origin/main"
    echo "CHECKPOINT:  $checkpoint"
    echo "ORIGIN_MAIN: $remote_main"
    return 1
  fi

  if [[ "$lane" == "main" ]]; then
    local_main="$(git -C "$repo" rev-parse refs/heads/main 2>/dev/null)" || {
      echo "BLOCKED: local main branch is missing"
      return 1
    }
    if ! git -C "$repo" merge-base --is-ancestor "$local_main" "$remote_main"; then
      echo "BLOCKED: local main cannot fast-forward to origin/main"
      echo "LOCAL_MAIN:  $local_main"
      echo "ORIGIN_MAIN: $remote_main"
      return 1
    fi
    git -C "$repo" switch main || { echo "ERROR: could not switch to main"; return 1; }
    git -C "$repo" merge --ff-only origin/main || { echo "ERROR: fast-forward to origin/main failed"; return 1; }
  else
    if [[ "$current_head" != "$checkpoint" ]] && ! git -C "$repo" merge-base --is-ancestor "$current_head" "$remote_main"; then
      echo "BLOCKED: detached sub HEAD cannot safely advance to origin/main"
      echo "HEAD:        $current_head"
      echo "ORIGIN_MAIN: $remote_main"
      return 1
    fi
    git -C "$repo" switch --detach origin/main || { echo "ERROR: could not detach sub lane at origin/main"; return 1; }
  fi

  echo "RELEASED"
  echo "  lane=$lane"
  echo "  head=$(git -C "$repo" rev-parse HEAD)"
  echo "  branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || echo DETACHED)"
  echo "  checkpoint=$checkpoint"
}

read_pr_auto_merge_snapshot() {
  local pr="$1"
  "$GH_BIN" pr view "$pr" -R "$PR_TARGET_REPO" \
    --json id,state,isDraft,baseRefName,baseRefOid,headRefOid,mergeable,autoMergeRequest,url \
    --jq '[.id, .state, (.isDraft|tostring), .baseRefName, .baseRefOid, .headRefOid, .mergeable, (if .autoMergeRequest == null then "none" else (.autoMergeRequest.mergeMethod // "present") end), .url] | @tsv' || {
      echo "BLOCKED: could not read PR state from GitHub" >&2
      return 1
    }
}

validate_pr_auto_merge_preconditions() {
  local pr="$1"
  local expected_head="$2"
  local expected_main="$3"
  local snapshot=""
  local pr_id=""
  local state=""
  local draft=""
  local base=""
  local base_oid=""
  local head=""
  local mergeable=""
  local auto_merge=""
  local url=""
  local checks=""
  local check_status=0
  local check_name=""
  local bucket=""
  local check_count=0
  local pending_count=0
  local blocked_count=0

  snapshot="$(read_pr_auto_merge_snapshot "$pr")" || return 1
  IFS=$'\t' read -r pr_id state draft base base_oid head mergeable auto_merge url <<< "$snapshot"

  if [[ -z "$pr_id" ]]; then
    echo "BLOCKED: PR GraphQL node id is missing"
    return 1
  fi
  if [[ "$state" != "OPEN" ]]; then
    echo "BLOCKED: PR is not open"
    echo "STATE: $state"
    return 1
  fi
  if [[ "$draft" != "false" ]]; then
    echo "BLOCKED: PR is draft"
    return 1
  fi
  if [[ "$base" != "main" ]]; then
    echo "BLOCKED: PR base is not main"
    echo "BASE: $base"
    return 1
  fi
  if [[ "$base_oid" != "$expected_main" ]]; then
    echo "BLOCKED: main has drifted from expected integration base"
    echo "EXPECTED: $expected_main"
    echo "ACTUAL:   $base_oid"
    return 1
  fi
  if [[ "$head" != "$expected_head" ]]; then
    echo "BLOCKED: PR head does not match reviewed exact head"
    echo "EXPECTED: $expected_head"
    echo "ACTUAL:   $head"
    return 1
  fi
  if [[ "$mergeable" != "MERGEABLE" ]]; then
    echo "BLOCKED: PR mergeability is not unambiguous"
    echo "MERGEABLE: $mergeable"
    return 1
  fi
  if [[ "$auto_merge" != "none" ]]; then
    echo "BLOCKED: PR already has an Auto-merge request"
    echo "METHOD: $auto_merge"
    return 1
  fi

  checks="$("$GH_BIN" pr checks "$pr" -R "$PR_TARGET_REPO" --required --json name,bucket --jq '.[] | [.name, .bucket] | @tsv' 2>/dev/null)"
  check_status=$?
  if (( check_status != 0 && check_status != 1 && check_status != 8 )); then
    echo "BLOCKED: could not read required PR checks"
    return 1
  fi
  if [[ -z "$checks" ]]; then
    echo "BLOCKED: no required PR checks were found"
    return 1
  fi

  while IFS=$'\t' read -r check_name bucket; do
    if [[ -z "$check_name" || -z "$bucket" ]]; then
      echo "BLOCKED: invalid required check data"
      return 1
    fi
    (( check_count += 1 ))
    case "$bucket" in
      pending)
        (( pending_count += 1 ))
        ;;
      pass)
        ;;
      fail|cancel|skipping)
        echo "BLOCKED: required check is not pending/pass"
        echo "CHECK: $check_name"
        echo "STATE: $bucket"
        (( blocked_count += 1 ))
        ;;
      *)
        echo "BLOCKED: required check returned an unknown state"
        echo "CHECK: $check_name"
        echo "STATE: $bucket"
        (( blocked_count += 1 ))
        ;;
    esac
  done <<< "$checks"

  if (( check_count == 0 )); then
    echo "BLOCKED: no required PR checks were found"
    return 1
  fi
  (( blocked_count == 0 )) || return 1
  if (( pending_count == 0 )); then
    echo "BLOCKED: all required checks are already complete; reservation-only helper will not merge immediately"
    return 1
  fi

  print -r -- "$snapshot"
}

pr_auto_merge() {
  local pr="$1"
  local expected_head="$2"
  local expected_main="$3"
  local validation_output=""
  local validation_status=0
  local mutation_output=""
  local snapshot=""
  local pr_id=""
  local readback_pr_id=""
  local state=""
  local draft=""
  local base=""
  local base_oid=""
  local head=""
  local mergeable=""
  local auto_merge=""
  local url=""

  if [[ ! "$pr" =~ '^[1-9][0-9]*$' ]]; then
    echo "ERROR: PR number must be a positive integer"
    return 2
  fi
  if [[ ! "$expected_head" =~ '^[0-9a-fA-F]{40}$' ]]; then
    echo "ERROR: expected head must be a full 40-character commit SHA"
    return 2
  fi
  if [[ ! "$expected_main" =~ '^[0-9a-fA-F]{40}$' ]]; then
    echo "ERROR: expected main must be a full 40-character commit SHA"
    return 2
  fi

  validation_output="$(validate_pr_auto_merge_preconditions "$pr" "$expected_head" "$expected_main" 2>&1)"
  validation_status=$?
  if (( validation_status != 0 )); then
    print -r -- "$validation_output"
    return 1
  fi

  validation_output="$(validate_pr_auto_merge_preconditions "$pr" "$expected_head" "$expected_main" 2>&1)"
  validation_status=$?
  if (( validation_status != 0 )); then
    print -r -- "$validation_output"
    return 1
  fi
  snapshot="$validation_output"
  IFS=$'\t' read -r pr_id state draft base base_oid head mergeable auto_merge url <<< "$snapshot"

  mutation_output="$("$GH_BIN" api graphql \
    -f query='mutation EnableAutoMerge($pullRequestId: ID!, $expectedHeadOid: GitObjectID!) { enablePullRequestAutoMerge(input: {pullRequestId: $pullRequestId, mergeMethod: MERGE, expectedHeadOid: $expectedHeadOid}) { clientMutationId } }' \
    -f pullRequestId="$pr_id" \
    -f expectedHeadOid="$expected_head" 2>&1)" || {
      if [[ "$mutation_output" == *"clean status"* ]]; then
        echo "BLOCKED: required checks completed before reservation; reservation-only helper will not merge"
      else
        echo "BLOCKED: GitHub rejected the Auto-merge reservation"
      fi
      [[ -n "$mutation_output" ]] && print -r -- "$mutation_output"
      return 1
    }

  snapshot="$(read_pr_auto_merge_snapshot "$pr")" || {
    echo "BLOCKED: Auto-merge mutation returned but read-back failed"
    return 1
  }
  IFS=$'\t' read -r readback_pr_id state draft base base_oid head mergeable auto_merge url <<< "$snapshot"

  if [[ "$readback_pr_id" != "$pr_id" ]]; then
    echo "BLOCKED: PR identity changed during Auto-merge reservation"
    echo "No automatic cancellation or repair was performed."
    return 1
  fi
  if [[ "$state" != "OPEN" ]]; then
    echo "BLOCKED: PR state changed during Auto-merge reservation"
    echo "STATE: $state"
    echo "No automatic cancellation or repair was performed."
    return 1
  fi
  if [[ "$draft" != "false" || "$base" != "main" || "$head" != "$expected_head" ]]; then
    echo "BLOCKED: PR identity changed during Auto-merge reservation"
    echo "No automatic cancellation or repair was performed."
    return 1
  fi
  if [[ "$base_oid" != "$expected_main" ]]; then
    echo "BLOCKED: main changed during Auto-merge reservation"
    echo "EXPECTED: $expected_main"
    echo "ACTUAL:   $base_oid"
    echo "Auto-merge may already be active; no automatic cancellation was performed."
    return 1
  fi
  if [[ "$auto_merge" != "MERGE" ]]; then
    echo "BLOCKED: Auto-merge reservation was not confirmed by read-back"
    echo "No automatic repair was performed."
    return 1
  fi

  echo "AUTO-MERGE RESERVED"
  echo "PR:   $url"
  echo "HEAD: $head"
  echo "MAIN: $base_oid"
}

e2e_start() {
  local issue="$1"
  local ref="$2"
  local repo="$E2E_WT"
  local dirty=""
  local branch=""
  local marker=""
  local old_head=""
  local idle_head=""
  local remote_main=""
  local target_head=""
  local session=""

  if [[ ! "$issue" =~ '^SAY-[0-9]+$' ]]; then
    echo "ERROR: Issue must look like SAY-123"
    return 2
  fi

  assert_git_repo "$repo" || return 1
  assert_origin "$repo" "$TARGET_REPO_TOKEN" || return 1

  dirty="$(git -C "$repo" status --porcelain)"
  if [[ -n "$dirty" ]]; then echo "BLOCKED: e2e lane is dirty"; return 1; fi

  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ -n "$branch" ]]; then
    echo "BLOCKED: e2e lane is not detached"
    echo "BRANCH: $branch"
    return 1
  fi

  marker="$(marker_path "$repo")" || { echo "ERROR: cannot resolve marker path"; return 1; }
  if [[ -e "$marker" ]]; then
    echo "BLOCKED: E2E marker already exists"
    echo "MARKER: $marker"
    return 1
  fi
  session="$(session_path "$repo")" || { echo "ERROR: cannot resolve E2E session path"; return 1; }
  if [[ -e "$session" ]]; then
    echo "BLOCKED: E2E session metadata already exists"
    echo "SESSION: $session"
    return 1
  fi

  old_head="$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" fetch origin --prune >/dev/null 2>&1 || { echo "ERROR: git fetch failed"; return 1; }
  remote_main="$(git -C "$repo" rev-parse origin/main)" || return 1

  idle_head="$old_head"
  if [[ "$idle_head" != "$remote_main" ]]; then
    if ! git -C "$repo" merge-base --is-ancestor "$idle_head" "$remote_main"; then
      echo "BLOCKED: e2e lane cannot safely advance to current origin/main"
      echo "HEAD:        $idle_head"
      echo "ORIGIN_MAIN: $remote_main"
      return 1
    fi
    git -C "$repo" switch --detach "$remote_main" || {
      echo "ERROR: safe e2e normalization failed"
      return 1
    }
    idle_head="$remote_main"
  fi

  target_head="$(git -C "$repo" rev-parse "${ref}^{commit}" 2>/dev/null)" || {
    echo "BLOCKED: tested ref cannot be resolved"
    echo "REF: $ref"
    return 1
  }

  git -C "$repo" switch --detach "$target_head" || { echo "ERROR: detached checkout failed"; return 1; }
  if ! printf 'issue=%s\nref=%s\n' "$issue" "$target_head" > "$marker"; then
    echo "ERROR: marker write failed; restoring previous idle HEAD"
    git -C "$repo" switch --detach "$idle_head" >/dev/null 2>&1 || true
    return 1
  fi

  echo "E2E STARTED"
  echo "  issue=$issue"
  echo "  ref=$target_head"
}

e2e_start_local_main() {
  local issue="$1"
  local ref="$2"
  local repo="$E2E_WT"
  local main_repo="$MAIN_WT"
  local dirty=""
  local branch=""
  local marker=""
  local old_head=""
  local idle_head=""
  local remote_main=""
  local main_head=""
  local target_head=""
  local session=""

  if [[ ! "$issue" =~ '^SAY-[0-9]+$' ]]; then
    echo "ERROR: Issue must look like SAY-123"
    return 2
  fi
  if [[ ! "$ref" =~ '^[0-9a-fA-F]{40}$' ]]; then
    echo "ERROR: tested-ref must be a full 40-character commit SHA"
    return 2
  fi

  assert_git_repo "$main_repo" || return 1
  assert_origin "$main_repo" "$TARGET_REPO_TOKEN" || return 1
  branch="$(git -C "$main_repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ "$branch" != "codex/interim-sequential" ]]; then
    echo "BLOCKED: main lane is not on the active interim branch"
    echo "EXPECTED: codex/interim-sequential"
    echo "ACTUAL:   ${branch:-DETACHED}"
    return 1
  fi
  dirty="$(git -C "$main_repo" status --porcelain)"
  if [[ -n "$dirty" ]]; then
    echo "BLOCKED: main interim lane is dirty"
    git -C "$main_repo" status --short
    return 1
  fi
  main_head="$(git -C "$main_repo" rev-parse HEAD)" || return 1
  target_head="$(git -C "$main_repo" rev-parse "${ref}^{commit}" 2>/dev/null)" || {
    echo "BLOCKED: tested local commit cannot be resolved"
    echo "REF: $ref"
    return 1
  }
  if [[ "$main_head" != "$target_head" ]]; then
    echo "BLOCKED: main interim HEAD does not match tested-ref"
    echo "HEAD:       $main_head"
    echo "TESTED_REF: $target_head"
    return 1
  fi

  assert_git_repo "$repo" || return 1
  assert_origin "$repo" "$TARGET_REPO_TOKEN" || return 1
  dirty="$(git -C "$repo" status --porcelain)"
  if [[ -n "$dirty" ]]; then
    echo "BLOCKED: e2e lane is dirty"
    return 1
  fi
  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ -n "$branch" ]]; then
    echo "BLOCKED: e2e lane is not detached"
    echo "BRANCH: $branch"
    return 1
  fi
  marker="$(marker_path "$repo")" || { echo "ERROR: cannot resolve marker path"; return 1; }
  if [[ -e "$marker" ]]; then
    echo "BLOCKED: E2E marker already exists"
    echo "MARKER: $marker"
    return 1
  fi
  session="$(session_path "$repo")" || { echo "ERROR: cannot resolve E2E session path"; return 1; }
  if [[ -e "$session" ]]; then
    echo "BLOCKED: E2E session metadata already exists"
    echo "SESSION: $session"
    return 1
  fi

  old_head="$(git -C "$repo" rev-parse HEAD)"
  git -C "$repo" fetch origin --prune >/dev/null 2>&1 || { echo "ERROR: git fetch failed"; return 1; }
  remote_main="$(git -C "$repo" rev-parse origin/main)" || return 1
  if ! git -C "$main_repo" merge-base --is-ancestor "$remote_main" "$target_head"; then
    echo "BLOCKED: tested local commit is not based on current origin/main"
    echo "TESTED_REF:  $target_head"
    echo "ORIGIN_MAIN: $remote_main"
    return 1
  fi
  if [[ "$old_head" != "$remote_main" ]]; then
    if ! git -C "$repo" merge-base --is-ancestor "$old_head" "$remote_main"; then
      echo "BLOCKED: e2e lane cannot safely advance to current origin/main"
      echo "HEAD:        $old_head"
      echo "ORIGIN_MAIN: $remote_main"
      return 1
    fi
    git -C "$repo" switch --detach "$remote_main" || {
      echo "ERROR: safe e2e normalization failed"
      return 1
    }
  fi
  idle_head="$remote_main"

  git -C "$repo" switch --detach "$target_head" || { echo "ERROR: detached checkout failed"; return 1; }
  if ! printf 'issue=%s\nref=%s\n' "$issue" "$target_head" > "$marker"; then
    echo "ERROR: marker write failed; restoring previous idle HEAD"
    git -C "$repo" switch --detach "$idle_head" >/dev/null 2>&1 || true
    return 1
  fi

  echo "E2E STARTED LOCAL MAIN"
  echo "  issue=$issue"
  echo "  ref=$target_head"
}

e2e_release() {
  local repo="$E2E_WT"
  local marker=""
  local dirty=""
  local branch=""
  local marker_issue=""
  local marker_ref=""
  local current_head=""
  local remote_main=""
  local session=""

  assert_git_repo "$repo" || return 1
  assert_origin "$repo" "$TARGET_REPO_TOKEN" || return 1

  dirty="$(git -C "$repo" status --porcelain)"
  if [[ -n "$dirty" ]]; then
    echo "BLOCKED: e2e lane is dirty"
    echo "Marker was retained."
    return 1
  fi

  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ -n "$branch" ]]; then
    echo "BLOCKED: e2e lane is not detached"
    echo "Marker was retained."
    return 1
  fi

  marker="$(marker_path "$repo")" || return 1
  if [[ ! -f "$marker" ]]; then
    echo "BLOCKED: E2E marker does not exist"
    return 1
  fi
  session="$(session_path "$repo")" || return 1
  if [[ -e "$session" ]]; then
    echo "BLOCKED: E2E session cleanup is still required"
    echo "SESSION: $session"
    echo "Run nuinui-e2e-prepare cleanup before releasing the e2e lane."
    return 1
  fi

  marker_issue="$(sed -n 's/^issue=//p' "$marker")"
  marker_ref="$(sed -n 's/^ref=//p' "$marker")"
  if [[ ! "$marker_issue" =~ '^SAY-[0-9]+$' || -z "$marker_ref" ]]; then
    echo "BLOCKED: invalid E2E marker content"
    echo "Marker was retained."
    return 1
  fi

  current_head="$(git -C "$repo" rev-parse HEAD)"
  if [[ "$current_head" != "$marker_ref" ]]; then
    echo "BLOCKED: current E2E HEAD does not match marker"
    echo "HEAD:   $current_head"
    echo "MARKER: $marker_ref"
    echo "Marker was retained."
    return 1
  fi

  git -C "$repo" fetch origin --prune >/dev/null 2>&1 || {
    echo "ERROR: git fetch failed"
    echo "Marker was retained."
    return 1
  }
  remote_main="$(git -C "$repo" rev-parse origin/main)" || return 1

  git -C "$repo" switch --detach "$remote_main" || {
    echo "ERROR: could not return e2e lane to origin/main"
    echo "Marker was retained."
    return 1
  }

  rm -- "$marker" || {
    echo "ERROR: returned to idle HEAD but marker removal failed"
    return 1
  }

  echo "E2E RELEASED"
  echo "  head=$remote_main"
  echo "  marker=none"
}

context_sync_repo() {
  local repo="$1"
  local token="$2"
  local dirty=""
  local branch=""
  local local_head=""
  local remote_head=""

  assert_git_repo "$repo" || return 1
  assert_origin "$repo" "$token" || return 1

  dirty="$(git -C "$repo" status --porcelain)"
  if [[ -n "$dirty" ]]; then
    echo "BLOCKED: dev-context checkout is dirty"
    echo "PATH: $repo"
    return 1
  fi

  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ "$branch" != "main" ]]; then
    echo "BLOCKED: dev-context checkout is not on main"
    echo "ACTUAL: ${branch:-DETACHED}"
    return 1
  fi

  git -C "$repo" fetch origin --prune >/dev/null 2>&1 || { echo "ERROR: dev-context fetch failed"; return 1; }
  local_head="$(git -C "$repo" rev-parse HEAD)"
  remote_head="$(git -C "$repo" rev-parse origin/main)"

  if ! git -C "$repo" merge-base --is-ancestor "$local_head" "$remote_head"; then
    echo "BLOCKED: local dev-context main cannot fast-forward"
    echo "LOCAL:  $local_head"
    echo "REMOTE: $remote_head"
    return 1
  fi

  git -C "$repo" merge --ff-only origin/main >/dev/null || { echo "ERROR: dev-context fast-forward failed"; return 1; }
  echo "CONTEXT SYNCED"
  echo "  head=$(git -C "$repo" rev-parse HEAD)"
}

show_dev_context_state() {
  local repo="$DEV_CONTEXT_WT"
  local branch=""
  local head=""
  local dirty=""

  if [[ ! -d "$repo" ]]; then
    echo "dev-context=not-installed"
    return 0
  fi
  if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "dev-context=$repo git=no"
    return 1
  fi

  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  head="$(git -C "$repo" rev-parse HEAD)"
  dirty="$(git -C "$repo" status --porcelain)"
  echo "dev-context=$repo"
  echo "  branch=${branch:-DETACHED}"
  echo "  head=$head"
  echo "  clean=$([[ -z "$dirty" ]] && echo yes || echo no)"
  [[ -z "$dirty" ]]
}

doctor_full() {
  local result=0
  local lane=""
  local repo=""
  local dirty=""

  echo "nuinui $VERSION"
  echo "DOCTOR FULL (read-only)"
  echo
  preflight || result=1
  for lane in main sub e2e; do
    repo="$(lane_repo "$lane")"
    if git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      dirty="$(git -C "$repo" status --porcelain)"
      if [[ -n "$dirty" ]]; then
        echo "BLOCKED: $lane lane is dirty"
        result=1
      fi
    fi
  done
  echo
  if [[ ! -x "$E2E_STATUS_HELPER" ]]; then
    echo "BLOCKED: E2E status helper is unavailable"
    echo "PATH: $E2E_STATUS_HELPER"
    result=1
  else
    NUINUI_E2E_PREPARE_WT="$E2E_WT" "$E2E_STATUS_HELPER" status || result=1
  fi
  echo
  show_dev_context_state || result=1

  if (( result != 0 )); then
    echo "DOCTOR FULL BLOCKED"
    return 1
  fi

  echo "DOCTOR FULL PASS"
}

context_check() (
  local result=0
  local markdown_file=""
  local link=""
  local target=""
  local local_tools=""
  local help_output=""
  local command=""
  local interim=""
  local readme=""
  local -a markdown_files

  echo "nuinui $VERSION"
  echo "CONTEXT CHECK (read-only)"

  if [[ ! -d "$DEV_CONTEXT_WT" ]]; then
    echo "BLOCKED: dev-context checkout is unavailable"
    echo "PATH: $DEV_CONTEXT_WT"
    return 1
  fi

  markdown_files=("$DEV_CONTEXT_WT"/**/*.md(.N))
  if (( ${#markdown_files} == 0 )); then
    echo "BLOCKED: no Markdown files found"
    return 1
  fi

  for markdown_file in "${markdown_files[@]}"; do
    while IFS= read -r link; do
      [[ -z "$link" || "$link" == \#* || "$link" == http://* || "$link" == https://* || "$link" == mailto:* ]] && continue
      link="${link%%#*}"
      [[ -z "$link" ]] && continue
      if [[ "$link" == /* ]]; then
        target="$link"
      else
        target="${markdown_file:h}/$link"
      fi
      if [[ ! -e "$target" ]]; then
        echo "BLOCKED: missing Markdown link target"
        echo "SOURCE: $markdown_file"
        echo "TARGET: $link"
        result=1
      fi
    done < <(grep -oE '\]\([^)#]+(#[^)]+)?\)' "$markdown_file" 2>/dev/null | sed -E 's/^\]\(([^)#]+).*$/\1/')

    if grep -n 'ONLY-CHATGPT\.md' "$markdown_file" >/dev/null 2>&1; then
      echo "BLOCKED: deprecated ONLY-CHATGPT.md reference"
      echo "SOURCE: $markdown_file"
      result=1
    fi
  done

  interim="$DEV_CONTEXT_WT/projects/nuinuiCAD/CODEX-ONLY-INTERIM.md"
  readme="$DEV_CONTEXT_WT/projects/nuinuiCAD/README.md"
  if [[ -f "$interim" && -f "$readme" ]] && grep -q 'Status: \*\*Active\*\*' "$interim"; then
    if ! grep -q 'CODEX-ONLY-INTERIM\.md' "$readme"; then
      echo "BLOCKED: Active interim is not routed by README"
      echo "SOURCE: $readme"
      result=1
    fi
  fi

  local_tools="$DEV_CONTEXT_WT/projects/nuinuiCAD/LOCAL-TOOLS.md"
  help_output="$($SCRIPT_PATH --help 2>&1 || true)"
  while IFS= read -r command; do
    [[ -z "$command" ]] && continue
    if ! grep -q "\`nuinui $command" "$local_tools" 2>/dev/null; then
      echo "BLOCKED: nuinui command is missing from LOCAL-TOOLS.md"
      echo "COMMAND: $command"
      result=1
    fi
  done < <(print -r -- "$help_output" | sed -nE 's/^  ([a-z][a-z-]*)( .*)?$/\1/p')

  if (( result == 0 )); then
    echo "CONTEXT CHECK PASS"
    return 0
  fi
  echo "CONTEXT CHECK BLOCKED"
  return 1
)

transition_audit() (
  local result=0
  local lane=""
  local repo=""
  local branch=""
  local head=""
  local remote_main=""
  local local_remote_main=""
  local marker=""
  local session=""
  local interim_policy=""
  local source_repo=""
  local worktree=""
  local relation=""
  local branch_ref=""
  local cherry_line=""
  local extra_result=0
  local expected_match=0
  local -a expected_worktrees
  local -a actual_worktrees
  local -a cherry_lines

  echo "nuinui $VERSION"
  echo "TRANSITION AUDIT (read-only)"
  echo "policy=CODEX-ONLY-INTERIM Active; no deactivation or route change"

  interim_policy="$DEV_CONTEXT_WT/projects/nuinuiCAD/CODEX-ONLY-INTERIM.md"
  if [[ ! -f "$interim_policy" ]] || ! grep -q 'Status: \*\*Active\*\*' "$interim_policy"; then
    echo "BLOCKED: CODEX-ONLY-INTERIM.md is not confirmed Active"
    echo "PATH: $interim_policy"
    result=1
  fi

  assert_git_repo "$MAIN_WT" || result=1
  assert_origin "$MAIN_WT" "$TARGET_REPO_TOKEN" || result=1
  if (( result != 0 )); then
    echo "TRANSITION AUDIT BLOCKED"
    return 1
  fi

  remote_main="$(git -C "$MAIN_WT" ls-remote origin refs/heads/main 2>/dev/null | awk 'NR == 1 { print $1 }')"
  if [[ ! "$remote_main" =~ '^[0-9a-fA-F]{40}$' ]]; then
    echo "BLOCKED: cannot read authoritative remote main"
    result=1
  else
    local_remote_main="$(git -C "$MAIN_WT" rev-parse origin/main 2>/dev/null || true)"
    echo "remote_main=$remote_main"
    if [[ "$local_remote_main" != "$remote_main" ]]; then
      echo "BLOCKED: local origin/main tracking ref is stale"
      echo "LOCAL:  ${local_remote_main:-missing}"
      echo "REMOTE: $remote_main"
      result=1
    fi
  fi

  branch="$(git -C "$MAIN_WT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  head="$(git -C "$MAIN_WT" rev-parse HEAD 2>/dev/null || true)"
  if [[ "$branch" != "codex/interim-sequential" ]]; then
    echo "BLOCKED: main lane is not on codex/interim-sequential"
    echo "BRANCH: ${branch:-DETACHED}"
    result=1
  fi
  if [[ -n "$(git -C "$MAIN_WT" status --porcelain 2>/dev/null)" ]]; then
    echo "BLOCKED: interim main lane is dirty"
    result=1
  fi
  if [[ -n "$head" && "$head" != "$remote_main" ]]; then
    cherry_lines=("${(@f)$(git -C "$MAIN_WT" cherry -v "$remote_main" "$head" 2>/dev/null)}")
    relation="patch-equivalent"
    for cherry_line in "${cherry_lines[@]}"; do
      [[ "$cherry_line" == +\ * ]] && relation="divergent"
    done
    echo "interim_main_relation=$relation"
    [[ "$relation" == "patch-equivalent" ]] || result=1
  else
    echo "interim_main_relation=contained"
  fi

  expected_worktrees=()
  for repo in "$MAIN_WT" "$SUB_WT" "$E2E_WT"; do
    expected_worktrees+=("$(canonical_path "$repo" 2>/dev/null || echo "$repo")")
  done
  actual_worktrees=()
  source_repo=""
  for repo in "$MAIN_WT" "$SUB_WT" "$E2E_WT"; do
    if git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      source_repo="$repo"
      actual_worktrees=("${(@f)$(git -C "$repo" worktree list --porcelain | sed -n 's/^worktree //p')}")
      break
    fi
  done
  if [[ -z "$source_repo" ]]; then
    echo "BLOCKED: no usable worktree registry"
    result=1
  else
    for worktree in "${expected_worktrees[@]}"; do
      expected_match=0
      for source_repo in "${actual_worktrees[@]}"; do
        [[ "$source_repo" == "$worktree" ]] && expected_match=1
      done
      (( expected_match == 0 )) && { echo "BLOCKED: fixed lane worktree is not registered: $worktree"; result=1; }
    done
    for worktree in "${actual_worktrees[@]}"; do
      expected_match=0
      for source_repo in "${expected_worktrees[@]}"; do
        [[ "$source_repo" == "$worktree" ]] && expected_match=1
      done
      (( expected_match != 0 )) && continue
      extra_result=0
      branch="$(git -C "$worktree" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
      head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
      echo "extra_worktree=$worktree branch=${branch:-DETACHED} head=$head"
      [[ -n "$(git -C "$worktree" status --porcelain 2>/dev/null)" ]] && { echo "  extra_clean=no"; extra_result=1; } || echo "  extra_clean=yes"
      if [[ -n "$branch" && -n "$(git -C "$MAIN_WT" ls-remote --heads origin "$branch" 2>/dev/null)" ]]; then
        echo "  remote_branch=present"; extra_result=1
      else
        echo "  remote_branch=gone"
      fi
      if git -C "$MAIN_WT" merge-base --is-ancestor "$head" "$remote_main" 2>/dev/null; then
        relation="contained"
      else
        cherry_lines=("${(@f)$(git -C "$MAIN_WT" cherry -v "$remote_main" "$head" 2>/dev/null)}")
        relation="patch-equivalent"
        for cherry_line in "${cherry_lines[@]}"; do [[ "$cherry_line" == +\ * ]] && relation="divergent"; done
      fi
      echo "  relation=$relation"
      [[ "$relation" == "divergent" ]] && extra_result=1
      (( extra_result == 0 )) || result=1
    done
  fi

  marker="$(marker_path "$E2E_WT" 2>/dev/null || true)"
  session="$(session_path "$E2E_WT" 2>/dev/null || true)"
  if [[ -e "$marker" || -e "$session" ]]; then
    echo "BLOCKED: E2E marker/session is present"
    echo "MARKER: ${marker:-unknown}"
    echo "SESSION: ${session:-unknown}"
    result=1
  else
    echo "e2e_marker=none e2e_session=none"
  fi
  if [[ ! -x "$E2E_STATUS_HELPER" ]]; then
    echo "BLOCKED: E2E status helper is unavailable"
    echo "PATH: $E2E_STATUS_HELPER"
    result=1
  else
    NUINUI_E2E_PREPARE_WT="$E2E_WT" "$E2E_STATUS_HELPER" status || result=1
  fi

  if (( result == 0 )); then
    echo "TRANSITION AUDIT PREPARED"
    echo "No mutation was performed; Human approval is still required for any later transition."
    return 0
  fi
  echo "TRANSITION AUDIT BLOCKED"
  return 1
)

self_test() (
  local root=""
  local remote=""
  local seed=""
  local main_repo=""
  local sub_repo=""
  local e2e_repo=""
  local context_repo=""
  local admin_repo=""
  local base=""
  local advanced_base=""
  local checkpoint=""
  local wrong_base=""
  local out=""
  local divergent_head=""
  local session=""
  local e2e_temp=""
  local e2e_marker=""
  local e2e_session=""
  local e2e_ref=""
  local e2e_root=""
  local e2e_handoff=""
  local fake_gh=""
  local fake_gh_state=""
  local fake_head="1111111111111111111111111111111111111111"
  local fake_main="2222222222222222222222222222222222222222"
  local scenario=""

  root="$(mktemp -d "${TMPDIR:-/private/tmp}/nuinui-local-tools.XXXXXX")" || {
    echo "SELFTEST FAIL: mktemp"
    return 1
  }

  cleanup() { [[ -n "$root" && -d "$root" ]] && rm -rf -- "$root"; }
  trap cleanup EXIT

  remote="$root/remote.git"
  seed="$root/seed"
  main_repo="$root/main"
  sub_repo="$root/sub"
  e2e_repo="$root/e2e"
  context_repo="$root/context"
  admin_repo="$root/admin"
  fake_gh="$root/fake-gh"
  fake_gh_state="$root/fake-gh-state"

  echo "SELFTEST: setup"
  git init --bare -q "$remote" || return 1
  git -C "$remote" symbolic-ref HEAD refs/heads/main || return 1

  git init -q -b main "$seed" || return 1
  git -C "$seed" config user.name "nuinui selftest"
  git -C "$seed" config user.email "nuinui-selftest@example.invalid"
  echo base > "$seed/file.txt"
  git -C "$seed" add file.txt
  git -C "$seed" commit -q -m base
  git -C "$seed" remote add origin "$remote"
  git -C "$seed" push -q -u origin main || return 1

  git clone -q "$remote" "$main_repo" || return 1
  git -C "$main_repo" config user.name "nuinui selftest"
  git -C "$main_repo" config user.email "nuinui-selftest@example.invalid"
  git -C "$main_repo" worktree add -q --detach "$sub_repo" origin/main || return 1
  git -C "$main_repo" worktree add -q --detach "$e2e_repo" origin/main || return 1

  export NUINUI_SELFTEST=1
  export NUINUI_MAIN_WT="$main_repo"
  export NUINUI_SUB_WT="$sub_repo"
  export NUINUI_E2E_WT="$e2e_repo"
  export NUINUI_DEV_CONTEXT_WT="$context_repo"
  e2e_temp="$root/e2e-temp"
  mkdir -p "$e2e_temp" || return 1
  export NUINUI_E2E_TEMP_PARENT="$e2e_temp"

  base="$(git -C "$main_repo" rev-parse origin/main)"
  wrong_base="${base%?}0"
  [[ "$wrong_base" == "$base" ]] && wrong_base="${base%?}1"

  cat > "$fake_gh" <<'FAKE_GH'
#!/bin/zsh
scenario="${NUINUI_FAKE_GH_SCENARIO:-pending-success}"
state_dir="${NUINUI_FAKE_GH_STATE:?}"
expected_head="${NUINUI_FAKE_EXPECTED_HEAD:?}"
expected_main="${NUINUI_FAKE_EXPECTED_MAIN:?}"
wrong_head="3333333333333333333333333333333333333333"
wrong_main="4444444444444444444444444444444444444444"
mkdir -p "$state_dir"
cmd="${1:-}"
shift || true
if [[ "$cmd" == "pr" && "${1:-}" == "view" ]]; then
  count_file="$state_dir/view-count"
  count=0
  [[ -f "$count_file" ]] && count="$(cat "$count_file")"
  (( count += 1 ))
  printf '%s' "$count" > "$count_file"
  pr_id="PR_kwDOFAKE"
  state="OPEN"
  draft="false"
  base="main"
  base_oid="$expected_main"
  head="$expected_head"
  mergeable="MERGEABLE"
  auto_merge="none"
  url="https://github.com/sayosomi/nuinuiCAD/pull/999"
  (( count >= 3 )) && auto_merge="MERGE"
  case "$scenario" in
    head-mismatch) head="$wrong_head" ;;
    main-drift) base_oid="$wrong_main" ;;
    wrong-base) base="develop" ;;
    closed) state="CLOSED" ;;
    draft) draft="true" ;;
    readback-missing) (( count >= 3 )) && auto_merge="none" ;;
    readback-mismatch) (( count >= 3 )) && auto_merge="SQUASH" ;;
    head-drift-before-mutation) (( count >= 2 )) && head="$wrong_head" ;;
    main-drift-before-mutation) (( count >= 2 )) && base_oid="$wrong_main" ;;
  esac
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$pr_id" "$state" "$draft" "$base" "$base_oid" "$head" "$mergeable" "$auto_merge" "$url"
  exit 0
fi
if [[ "$cmd" == "pr" && "${1:-}" == "checks" ]]; then
  case "$scenario" in
    checks-missing) exit 0 ;;
    ci-failure) printf 'CI\tfail\n'; exit 1 ;;
    ci-cancelled) printf 'CI\tcancel\n'; exit 1 ;;
    all-success) printf 'CI\tpass\n'; exit 0 ;;
    *) printf 'CI\tpending\n'; exit 8 ;;
  esac
fi
if [[ "$cmd" == "api" && "${1:-}" == "graphql" ]]; then
  print -r -- "$*" > "$state_dir/mutation-args"
  : > "$state_dir/mutation-attempted"
  case "$scenario" in
    mutation-failure)
      echo "mutation failed" >&2
      exit 1
      ;;
    clean-at-mutation)
      echo 'GraphQL: Pull request Pull request is in clean status (enablePullRequestAutoMerge)' >&2
      exit 1
      ;;
  esac
  : > "$state_dir/mutation-called"
  exit 0
fi
if [[ "$cmd" == "pr" && "${1:-}" == "merge" ]]; then
  : > "$state_dir/forbidden-merge-command"
  echo "direct merge command is forbidden in reservation helper" >&2
  exit 99
fi
echo "unexpected fake gh invocation: $cmd $*" >&2
exit 2
FAKE_GH
  chmod +x "$fake_gh" || return 1
  export NUINUI_GH_BIN="$fake_gh"
  export NUINUI_FAKE_GH_STATE="$fake_gh_state"
  export NUINUI_FAKE_EXPECTED_HEAD="$fake_head"
  export NUINUI_FAKE_EXPECTED_MAIN="$fake_main"

  run_fake_auto_merge_case() {
    local selected="$1"
    rm -rf -- "$fake_gh_state"
    mkdir -p "$fake_gh_state" || return 1
    NUINUI_FAKE_GH_SCENARIO="$selected" "$SCRIPT_PATH" pr-auto-merge 999 "$fake_head" "$fake_main"
  }

  echo "TEST: pr-auto-merge pending reservation"
  out="$(run_fake_auto_merge_case pending-success 2>&1)" || {
    print -r -- "$out"
    return 1
  }
  print -r -- "$out" | grep -q 'AUTO-MERGE RESERVED' || {
    echo "SELFTEST FAIL: pending Auto-merge reservation did not report success"
    return 1
  }
  [[ -f "$fake_gh_state/mutation-called" ]] || {
    echo "SELFTEST FAIL: pending Auto-merge reservation did not invoke enable mutation"
    return 1
  }
  [[ ! -e "$fake_gh_state/forbidden-merge-command" ]] || {
    echo "SELFTEST FAIL: pending Auto-merge reservation invoked a direct merge command"
    return 1
  }
  grep -q -- 'enablePullRequestAutoMerge' "$fake_gh_state/mutation-args" || return 1
  grep -q -- 'mergeMethod: MERGE' "$fake_gh_state/mutation-args" || return 1
  grep -q -- 'pullRequestId=PR_kwDOFAKE' "$fake_gh_state/mutation-args" || return 1
  grep -q -- "expectedHeadOid=$fake_head" "$fake_gh_state/mutation-args" || return 1

  for scenario in head-mismatch main-drift wrong-base closed draft checks-missing ci-failure ci-cancelled all-success head-drift-before-mutation main-drift-before-mutation; do
    echo "TEST: pr-auto-merge blocks $scenario"
    out="$(run_fake_auto_merge_case "$scenario" 2>&1)"
    if [[ "$?" -eq 0 ]]; then
      print -r -- "$out"
      echo "SELFTEST FAIL: $scenario was accepted"
      return 1
    fi
    print -r -- "$out" | grep -q 'BLOCKED:' || {
      echo "SELFTEST FAIL: $scenario did not report BLOCKED"
      return 1
    }
    if [[ -e "$fake_gh_state/mutation-attempted" ]]; then
      echo "SELFTEST FAIL: $scenario reached the Auto-merge mutation"
      return 1
    fi
    if [[ -e "$fake_gh_state/forbidden-merge-command" ]]; then
      echo "SELFTEST FAIL: $scenario invoked a direct merge command"
      return 1
    fi
  done

  for scenario in mutation-failure readback-missing readback-mismatch clean-at-mutation; do
    echo "TEST: pr-auto-merge safe-stops $scenario"
    out="$(run_fake_auto_merge_case "$scenario" 2>&1)"
    if [[ "$?" -eq 0 ]]; then
      print -r -- "$out"
      echo "SELFTEST FAIL: $scenario was accepted"
      return 1
    fi
    print -r -- "$out" | grep -q 'BLOCKED:' || {
      echo "SELFTEST FAIL: $scenario did not report BLOCKED"
      return 1
    }
    if [[ -e "$fake_gh_state/forbidden-merge-command" ]]; then
      echo "SELFTEST FAIL: $scenario invoked a direct merge command"
      return 1
    fi
  done

  echo "TEST: preflight"
  "$SCRIPT_PATH" preflight || return 1

  echo "TEST: preflight blocks unexpected worktree"
  git -C "$main_repo" worktree add -q --detach "$root/extra" origin/main || return 1
  if "$SCRIPT_PATH" preflight >/dev/null 2>&1; then
    echo "SELFTEST FAIL: unexpected worktree accepted"
    return 1
  fi
  git -C "$main_repo" worktree remove "$root/extra" || return 1
  "$SCRIPT_PATH" preflight >/dev/null || return 1

  echo "TEST: verify exact base"
  "$SCRIPT_PATH" verify main SAY-999 "$base" test/say-999-main >/dev/null || return 1

  echo "TEST: verify stale base blocked"
  if "$SCRIPT_PATH" verify main SAY-999 "$wrong_base" test/say-999-main >/dev/null 2>&1; then
    echo "SELFTEST FAIL: stale base accepted"
    return 1
  fi

  echo "TEST: behind ancestor verify + normalized start"
  echo remote-advance >> "$seed/file.txt"
  git -C "$seed" add file.txt
  git -C "$seed" commit -q -m remote-advance
  git -C "$seed" push -q origin main
  advanced_base="$(git -C "$seed" rev-parse HEAD)"
  git -C "$main_repo" fetch origin --prune >/dev/null 2>&1 || return 1

  out="$("$SCRIPT_PATH" verify main SAY-998 "$advanced_base" test/say-998-main 2>&1)" || {
    echo "$out"
    return 1
  }
  print -r -- "$out" | grep -q 'action=STARTABLE_AFTER_SAFE_NORMALIZATION' || {
    echo "SELFTEST FAIL: ancestor verify did not expose safe normalization"
    return 1
  }

  "$SCRIPT_PATH" start main SAY-998 "$advanced_base" test/say-998-main >/dev/null || return 1
  [[ "$(git -C "$main_repo" rev-parse HEAD)" == "$advanced_base" ]] || {
    echo "SELFTEST FAIL: main normalization did not reach expected Base"
    return 1
  }

  echo "TEST: local branch already exists blocked"
  git -C "$main_repo" switch main >/dev/null 2>&1 || return 1
  git -C "$main_repo" branch test/say-997-local "$advanced_base"
  if "$SCRIPT_PATH" verify main SAY-997 "$advanced_base" test/say-997-local >/dev/null 2>&1; then
    echo "SELFTEST FAIL: local branch accepted"
    return 1
  fi

  echo "TEST: start surfaces local branch blocker"
  local start_output=""
  local start_rc=0
  start_output="$("$SCRIPT_PATH" start main SAY-997 "$advanced_base" test/say-997-local 2>&1)"
  start_rc=$?

  if (( start_rc == 0 )); then
    echo "SELFTEST FAIL: start accepted an existing local branch"
    return 1
  fi
  if [[ "$start_output" != *"CHECKING"* ]]; then
    echo "SELFTEST FAIL: start did not emit progress before verification"
    printf '%s\n' "$start_output" | sed 's/^/  /'
    return 1
  fi
  if [[ "$start_output" != *"BLOCKED: local branch already exists"* ]]; then
    echo "SELFTEST FAIL: start hid the local branch blocker"
    printf '%s\n' "$start_output" | sed 's/^/  /'
    return 1
  fi

  echo "TEST: main resume + idempotence"
  git -C "$main_repo" switch -c test/say-985-resume-main "$advanced_base" >/dev/null 2>&1 || return 1
  echo resume-main >> "$main_repo/file.txt"
  git -C "$main_repo" add file.txt
  git -C "$main_repo" commit -q -m resume-main
  checkpoint="$(git -C "$main_repo" rev-parse HEAD)"
  git -C "$main_repo" push -q origin HEAD:refs/heads/test/say-985-resume-main || return 1
  git -C "$main_repo" switch main >/dev/null 2>&1 || return 1

  out="$("$SCRIPT_PATH" resume main SAY-985 "$checkpoint" test/say-985-resume-main 2>&1)" || {
    print -r -- "$out"
    return 1
  }
  print -r -- "$out" | grep -q '^RESUMED$' || {
    echo "SELFTEST FAIL: main resume did not report RESUMED"
    return 1
  }
  [[ "$(git -C "$main_repo" branch --show-current)" == "test/say-985-resume-main" ]] || {
    echo "SELFTEST FAIL: main resume did not select target branch"
    return 1
  }
  [[ "$(git -C "$main_repo" rev-parse HEAD)" == "$checkpoint" ]] || {
    echo "SELFTEST FAIL: main resume did not reach expected checkpoint"
    return 1
  }

  out="$("$SCRIPT_PATH" resume main SAY-985 "$checkpoint" test/say-985-resume-main 2>&1)" || {
    print -r -- "$out"
    return 1
  }
  print -r -- "$out" | grep -q '^ALREADY RESUMED$' || {
    echo "SELFTEST FAIL: idempotent main resume did not report ALREADY RESUMED"
    return 1
  }
  git -C "$main_repo" switch main >/dev/null 2>&1 || return 1

  echo "TEST: resume does not prune unrelated remote-tracking refs"
  git -C "$main_repo" branch test/stale-resume-tracking "$advanced_base" || return 1
  git -C "$main_repo" push -q origin test/stale-resume-tracking:refs/heads/test/stale-resume-tracking || return 1
  git -C "$main_repo" fetch origin >/dev/null 2>&1 || return 1
  git -C "$main_repo" show-ref --verify --quiet refs/remotes/origin/test/stale-resume-tracking || {
    echo "SELFTEST FAIL: stale tracking setup missing"
    return 1
  }
  git -C "$remote" update-ref -d refs/heads/test/stale-resume-tracking || return 1

  out="$("$SCRIPT_PATH" resume main SAY-985 "$checkpoint" test/say-985-resume-main 2>&1)" || {
    print -r -- "$out"
    return 1
  }
  git -C "$main_repo" show-ref --verify --quiet refs/remotes/origin/test/stale-resume-tracking || {
    echo "SELFTEST FAIL: resume pruned unrelated remote-tracking ref"
    return 1
  }
  git -C "$main_repo" switch main >/dev/null 2>&1 || return 1

  echo "TEST: resume blocks false-positive Issue token"
  out="$("$SCRIPT_PATH" resume main SAY-985 "$checkpoint" test/say-9850-wrong-issue 2>&1)"
  if [[ "$?" -eq 0 ]]; then
    print -r -- "$out"
    echo "SELFTEST FAIL: resume accepted a branch for a different Issue"
    return 1
  fi
  print -r -- "$out" | grep -q 'BLOCKED: branch name does not match Issue' || {
    echo "SELFTEST FAIL: false-positive Issue token was not rejected"
    return 1
  }

  echo "TEST: resume blocks dirty lane"
  echo dirty-resume >> "$main_repo/file.txt"
  out="$("$SCRIPT_PATH" resume main SAY-985 "$checkpoint" test/say-985-resume-main 2>&1)"
  if [[ "$?" -eq 0 ]]; then
    print -r -- "$out"
    echo "SELFTEST FAIL: resume accepted dirty lane"
    return 1
  fi
  print -r -- "$out" | grep -q 'BLOCKED:' || {
    echo "SELFTEST FAIL: dirty resume did not report BLOCKED"
    return 1
  }
  [[ "$(git -C "$main_repo" branch --show-current)" == "main" ]] || {
    echo "SELFTEST FAIL: dirty resume changed branch"
    return 1
  }
  git -C "$main_repo" restore -- file.txt

  echo "TEST: resume blocks mismatched local branch checkpoint"
  git -C "$main_repo" branch -f test/say-985-resume-main "$advanced_base" >/dev/null || return 1
  out="$("$SCRIPT_PATH" resume main SAY-985 "$checkpoint" test/say-985-resume-main 2>&1)"
  if [[ "$?" -eq 0 ]]; then
    print -r -- "$out"
    echo "SELFTEST FAIL: resume accepted mismatched local branch checkpoint"
    return 1
  fi
  print -r -- "$out" | grep -q 'BLOCKED: local resume branch is not at expected checkpoint' || {
    echo "SELFTEST FAIL: local checkpoint mismatch was not identified"
    return 1
  }
  [[ "$(git -C "$main_repo" branch --show-current)" == "main" ]] || {
    echo "SELFTEST FAIL: mismatched resume changed branch"
    return 1
  }
  git -C "$main_repo" branch -f test/say-985-resume-main "$checkpoint" >/dev/null || return 1

  echo "TEST: resume blocks branch occupied by another worktree"
  git -C "$main_repo" worktree add -q "$root/resume-other" test/say-985-resume-main || return 1
  out="$("$SCRIPT_PATH" resume main SAY-985 "$checkpoint" test/say-985-resume-main 2>&1)"
  if [[ "$?" -eq 0 ]]; then
    print -r -- "$out"
    echo "SELFTEST FAIL: resume accepted branch occupied by another worktree"
    return 1
  fi
  print -r -- "$out" | grep -q 'BLOCKED: resume branch is checked out in another worktree' || {
    echo "SELFTEST FAIL: occupied resume branch was not identified"
    return 1
  }
  [[ "$(git -C "$main_repo" branch --show-current)" == "main" ]] || {
    echo "SELFTEST FAIL: occupied resume changed branch"
    return 1
  }
  git -C "$main_repo" worktree remove "$root/resume-other" || return 1

  echo "TEST: remote branch already exists blocked"
  git -C "$main_repo" branch test/say-996-remote "$advanced_base"
  git -C "$main_repo" push -q origin test/say-996-remote:refs/heads/test/say-996-remote || return 1
  git -C "$main_repo" branch -D test/say-996-remote >/dev/null
  git -C "$main_repo" fetch origin --prune >/dev/null 2>&1 || return 1
  if "$SCRIPT_PATH" verify main SAY-996 "$advanced_base" test/say-996-remote >/dev/null 2>&1; then
    echo "SELFTEST FAIL: remote branch accepted"
    return 1
  fi

  echo "TEST: dirty verify blocked"
  echo dirty >> "$main_repo/file.txt"
  if "$SCRIPT_PATH" verify main SAY-995 "$advanced_base" test/say-995-dirty >/dev/null 2>&1; then
    echo "SELFTEST FAIL: dirty lane accepted"
    return 1
  fi
  git -C "$main_repo" restore -- file.txt

  echo "TEST: divergent HEAD blocked"
  git -C "$main_repo" switch -c selftest-divergent "$base" >/dev/null 2>&1 || return 1
  echo divergent > "$main_repo/divergent.txt"
  git -C "$main_repo" add divergent.txt
  git -C "$main_repo" commit -q -m divergent
  divergent_head="$(git -C "$main_repo" rev-parse HEAD)"
  git -C "$main_repo" switch main >/dev/null 2>&1 || return 1
  git -C "$main_repo" reset --hard "$divergent_head" >/dev/null || return 1
  if "$SCRIPT_PATH" verify main SAY-994 "$advanced_base" test/say-994-divergent >/dev/null 2>&1; then
    echo "SELFTEST FAIL: divergent HEAD accepted"
    return 1
  fi

  echo "TEST: main start/release"
  git -C "$main_repo" reset --hard "$advanced_base" >/dev/null
  git -C "$main_repo" switch main >/dev/null 2>&1
  "$SCRIPT_PATH" start main SAY-993 "$advanced_base" test/say-993-main >/dev/null || return 1
  echo main >> "$main_repo/file.txt"
  git -C "$main_repo" add file.txt
  git -C "$main_repo" commit -q -m main
  checkpoint="$(git -C "$main_repo" rev-parse HEAD)"
  git -C "$main_repo" push -q origin HEAD:refs/heads/test/say-993-main || return 1
  if "$SCRIPT_PATH" release main "$checkpoint" >/dev/null 2>&1; then
    echo "SELFTEST FAIL: unmerged release accepted"
    return 1
  fi
  git -C "$main_repo" push -q origin HEAD:main || return 1
  "$SCRIPT_PATH" release main "$checkpoint" >/dev/null || return 1

  echo "TEST: main stale idle post-merge release"
  git -C "$main_repo" switch -c selftest-stale-main >/dev/null 2>&1 || return 1
  echo stale-main >> "$main_repo/file.txt"
  git -C "$main_repo" add file.txt
  git -C "$main_repo" commit -q -m stale-main
  checkpoint="$(git -C "$main_repo" rev-parse HEAD)"
  git -C "$main_repo" push -q origin HEAD:main || return 1
  git -C "$main_repo" switch main >/dev/null 2>&1 || return 1
  "$SCRIPT_PATH" release main "$checkpoint" >/dev/null || return 1
  [[ "$(git -C "$main_repo" rev-parse HEAD)" == "$checkpoint" ]] || {
    echo "SELFTEST FAIL: stale idle main release did not reach merged checkpoint"
    return 1
  }

  echo "TEST: main unrelated branch release blocked"
  git -C "$main_repo" switch -c selftest-unrelated-main "$advanced_base" >/dev/null 2>&1 || return 1
  if "$SCRIPT_PATH" release main "$checkpoint" >/dev/null 2>&1; then
    echo "SELFTEST FAIL: unrelated main branch was released"
    return 1
  fi
  git -C "$main_repo" switch main >/dev/null 2>&1 || return 1

  echo "TEST: e2e marker/start/release"
  git -C "$e2e_repo" fetch origin --prune >/dev/null 2>&1 || return 1
  git -C "$e2e_repo" switch --detach origin/main >/dev/null 2>&1 || return 1
  base="$(git -C "$e2e_repo" rev-parse HEAD)"
  "$SCRIPT_PATH" e2e-start SAY-992 "$base" >/dev/null || return 1
  if "$SCRIPT_PATH" e2e-start SAY-992 "$base" >/dev/null 2>&1; then
    echo "SELFTEST FAIL: duplicate E2E start accepted"
    return 1
  fi
  session="$(session_path "$e2e_repo")" || return 1
  printf 'issue=SAY-992\n' > "$session" || return 1
  if "$SCRIPT_PATH" e2e-release >/dev/null 2>&1; then
    echo "SELFTEST FAIL: E2E release accepted an active session"
    return 1
  fi
  rm -- "$session" || return 1
  "$SCRIPT_PATH" e2e-release >/dev/null || return 1

  echo "TEST: E2E stale idle normalization"
  base="$(git -C "$e2e_repo" rev-parse origin/main~1)" || return 1
  advanced_base="$(git -C "$e2e_repo" rev-parse origin/main)" || return 1
  git -C "$e2e_repo" switch --detach "$base" >/dev/null 2>&1 || return 1
  "$SCRIPT_PATH" e2e-start SAY-989 "$advanced_base" >/dev/null || return 1
  [[ "$(git -C "$e2e_repo" rev-parse HEAD)" == "$advanced_base" ]] || {
    echo "SELFTEST FAIL: stale E2E normalization did not reach tested ref"
    return 1
  }
  "$SCRIPT_PATH" e2e-release >/dev/null || return 1

  echo "TEST: local-main E2E marker/start/release"
  git -C "$main_repo" switch -c codex/interim-sequential >/dev/null 2>&1 || return 1
  echo local-e2e >> "$main_repo/file.txt"
  git -C "$main_repo" add file.txt
  git -C "$main_repo" commit -q -m local-e2e
  checkpoint="$(git -C "$main_repo" rev-parse HEAD)"
  "$SCRIPT_PATH" e2e-start-local-main SAY-990 "$checkpoint" >/dev/null || return 1
  if [[ "$(git -C "$e2e_repo" rev-parse HEAD)" != "$checkpoint" ]]; then
    echo "SELFTEST FAIL: local-main E2E did not select the tested checkpoint"
    return 1
  fi
  "$SCRIPT_PATH" e2e-release >/dev/null || return 1
  git -C "$main_repo" switch main >/dev/null 2>&1 || return 1

  echo "TEST: sub resume + idempotence"
  git -C "$sub_repo" fetch origin --prune >/dev/null 2>&1 || return 1
  git -C "$sub_repo" switch --detach origin/main >/dev/null 2>&1 || return 1
  base="$(git -C "$sub_repo" rev-parse HEAD)"
  git -C "$sub_repo" switch -c test/say-986-resume-sub "$base" >/dev/null 2>&1 || return 1
  echo resume-sub >> "$sub_repo/file.txt"
  git -C "$sub_repo" add file.txt
  git -C "$sub_repo" commit -q -m resume-sub
  checkpoint="$(git -C "$sub_repo" rev-parse HEAD)"
  git -C "$sub_repo" push -q origin HEAD:refs/heads/test/say-986-resume-sub || return 1
  git -C "$sub_repo" switch --detach origin/main >/dev/null 2>&1 || return 1

  out="$("$SCRIPT_PATH" resume sub SAY-986 "$checkpoint" test/say-986-resume-sub 2>&1)" || {
    print -r -- "$out"
    return 1
  }
  print -r -- "$out" | grep -q '^RESUMED$' || {
    echo "SELFTEST FAIL: sub resume did not report RESUMED"
    return 1
  }
  [[ "$(git -C "$sub_repo" branch --show-current)" == "test/say-986-resume-sub" ]] || {
    echo "SELFTEST FAIL: sub resume did not select target branch"
    return 1
  }
  [[ "$(git -C "$sub_repo" rev-parse HEAD)" == "$checkpoint" ]] || {
    echo "SELFTEST FAIL: sub resume did not reach expected checkpoint"
    return 1
  }

  out="$("$SCRIPT_PATH" resume sub SAY-986 "$checkpoint" test/say-986-resume-sub 2>&1)" || {
    print -r -- "$out"
    return 1
  }
  print -r -- "$out" | grep -q '^ALREADY RESUMED$' || {
    echo "SELFTEST FAIL: idempotent sub resume did not report ALREADY RESUMED"
    return 1
  }
  git -C "$sub_repo" switch --detach origin/main >/dev/null 2>&1 || return 1

  echo "TEST: sub start/dirty release/clean release"
  git -C "$sub_repo" fetch origin --prune >/dev/null 2>&1 || return 1
  git -C "$sub_repo" switch --detach origin/main >/dev/null 2>&1 || return 1
  base="$(git -C "$sub_repo" rev-parse HEAD)"
  "$SCRIPT_PATH" start sub SAY-991 "$base" test/say-991-sub >/dev/null || return 1
  echo sub >> "$sub_repo/file.txt"
  git -C "$sub_repo" add file.txt
  git -C "$sub_repo" commit -q -m sub
  checkpoint="$(git -C "$sub_repo" rev-parse HEAD)"
  git -C "$sub_repo" push -q origin HEAD:main || return 1
  echo dirty >> "$sub_repo/file.txt"
  if "$SCRIPT_PATH" release sub "$checkpoint" >/dev/null 2>&1; then
    echo "SELFTEST FAIL: dirty release accepted"
    return 1
  fi
  git -C "$sub_repo" restore -- file.txt
  "$SCRIPT_PATH" release sub "$checkpoint" >/dev/null || return 1

  echo "TEST: sub stale detached post-merge release"
  base="$(git -C "$sub_repo" rev-parse HEAD)"
  git -C "$sub_repo" switch -c selftest-stale-sub >/dev/null 2>&1 || return 1
  echo stale-sub >> "$sub_repo/file.txt"
  git -C "$sub_repo" add file.txt
  git -C "$sub_repo" commit -q -m stale-sub
  checkpoint="$(git -C "$sub_repo" rev-parse HEAD)"
  git -C "$sub_repo" push -q origin HEAD:main || return 1
  git -C "$sub_repo" switch --detach "$base" >/dev/null 2>&1 || return 1
  "$SCRIPT_PATH" release sub "$checkpoint" >/dev/null || return 1
  [[ "$(git -C "$sub_repo" rev-parse HEAD)" == "$checkpoint" ]] || {
    echo "SELFTEST FAIL: stale detached sub release did not reach merged checkpoint"
    return 1
  }

  echo "TEST: context-sync"
  git clone -q "$remote" "$context_repo" || return 1
  git clone -q "$remote" "$admin_repo" || return 1
  git -C "$admin_repo" config user.name "nuinui selftest"
  git -C "$admin_repo" config user.email "nuinui-selftest@example.invalid"
  echo context >> "$admin_repo/context.txt"
  git -C "$admin_repo" add context.txt
  git -C "$admin_repo" commit -q -m context
  git -C "$admin_repo" push -q origin main || return 1
  "$SCRIPT_PATH" context-sync >/dev/null || return 1
  [[ "$(git -C "$context_repo" rev-parse HEAD)" == "$(git -C "$context_repo" rev-parse origin/main)" ]] || {
    echo "SELFTEST FAIL: context-sync did not reach origin/main"
    return 1
  }

  echo "TEST: context-check normal state"
  mkdir -p "$context_repo/projects/nuinuiCAD" "$context_repo/shared" || return 1
  print -r -- '# README

[interim](./CODEX-ONLY-INTERIM.md)
' > "$context_repo/projects/nuinuiCAD/README.md"
  print -r -- 'Status: **Active**' > "$context_repo/projects/nuinuiCAD/CODEX-ONLY-INTERIM.md"
  print -r -- '# Local tools

| `nuinui preflight` | check |
| `nuinui verify` | check |
| `nuinui start` | check |
| `nuinui resume` | check |
| `nuinui release` | check |
| `nuinui pr-auto-merge` | check |
| `nuinui e2e-start` | check |
| `nuinui e2e-start-local-main` | check |
| `nuinui e2e-release` | check |
| `nuinui context-sync` | check |
| `nuinui doctor` | check |
| `nuinui transition-audit` | check |
| `nuinui context-check` | check |
| `nuinui self-test` | check |
' > "$context_repo/projects/nuinuiCAD/LOCAL-TOOLS.md"
  NUINUI_DEV_CONTEXT_WT="$context_repo" "$SCRIPT_PATH" context-check >/dev/null || return 1

  echo "TEST: context-check blocks missing target"
  rm -- "$context_repo/projects/nuinuiCAD/CODEX-ONLY-INTERIM.md" || return 1
  if NUINUI_DEV_CONTEXT_WT="$context_repo" "$SCRIPT_PATH" context-check >/dev/null 2>&1; then
    echo "SELFTEST FAIL: context-check accepted missing target"
    return 1
  fi
  print -r -- 'Status: **Active**' > "$context_repo/projects/nuinuiCAD/CODEX-ONLY-INTERIM.md"

  echo "TEST: transition-audit normal state"
  git -C "$main_repo" fetch origin --prune >/dev/null 2>&1 || return 1
  git -C "$main_repo" switch codex/interim-sequential >/dev/null 2>&1 || return 1
  git -C "$main_repo" reset --hard "$(git -C "$main_repo" rev-parse origin/main)" >/dev/null || return 1
  NUINUI_DEV_CONTEXT_WT="$context_repo" "$SCRIPT_PATH" transition-audit >/dev/null || return 1

  echo "TEST: transition-audit blocks extra worktree"
  git -C "$main_repo" worktree add -q --detach "$root/transition-extra" origin/main || return 1
  git -C "$root/transition-extra" switch -c transition-audit-divergent >/dev/null 2>&1 || return 1
  print -r -- divergent > "$root/transition-extra/transition-audit-divergent.txt" || return 1
  git -C "$root/transition-extra" add transition-audit-divergent.txt || return 1
  git -C "$root/transition-extra" commit -q -m transition-audit-divergent || return 1
  out="$(NUINUI_DEV_CONTEXT_WT="$context_repo" "$SCRIPT_PATH" transition-audit 2>&1)"
  if [[ "$?" -eq 0 ]]; then
    print -r -- "$out"
    echo "SELFTEST FAIL: transition-audit accepted extra worktree"
    return 1
  fi
  git -C "$main_repo" worktree remove "$root/transition-extra" || return 1
  git -C "$main_repo" switch main >/dev/null 2>&1 || return 1
  git -C "$context_repo" add projects shared || return 1
  git -C "$context_repo" commit -q -m context-check-fixture || return 1

  echo "TEST: doctor --full normal state"
  out="$("$SCRIPT_PATH" doctor --full 2>&1)" || {
    echo "$out"
    return 1
  }
  print -r -- "$out" | grep -q 'DOCTOR FULL PASS' || {
    echo "SELFTEST FAIL: doctor --full did not pass a normal state"
    return 1
  }

  echo "TEST: doctor --full blocks dirty lane"
  echo dirty >> "$main_repo/file.txt"
  if "$SCRIPT_PATH" doctor --full >/dev/null 2>&1; then
    echo "SELFTEST FAIL: doctor --full accepted dirty lane"
    return 1
  fi
  git -C "$main_repo" restore -- file.txt

  echo "TEST: doctor --full blocks missing lane"
  if NUINUI_SUB_WT="$root/missing-sub" "$SCRIPT_PATH" doctor --full >/dev/null 2>&1; then
    echo "SELFTEST FAIL: doctor --full accepted missing lane"
    return 1
  fi

  echo "TEST: doctor --full blocks extra lane"
  git -C "$main_repo" worktree add -q --detach "$root/doctor-extra" origin/main || return 1
  if "$SCRIPT_PATH" doctor --full >/dev/null 2>&1; then
    echo "SELFTEST FAIL: doctor --full accepted extra lane"
    return 1
  fi
  git -C "$main_repo" worktree remove "$root/doctor-extra" || return 1

  e2e_marker="$(marker_path "$e2e_repo")" || return 1
  e2e_session="$(session_path "$e2e_repo")" || return 1
  e2e_ref="$(git -C "$e2e_repo" rev-parse HEAD)" || return 1
  e2e_root="$e2e_temp/nuinui-vscode-e2e.active"
  e2e_handoff="$e2e_temp/nuinui-SAY-988-human-e2e.env"
  mkdir -p "$e2e_root" || return 1
  : > "$e2e_handoff"
  printf 'issue=SAY-988\nref=%s\n' "$e2e_ref" > "$e2e_marker"
  printf 'issue=SAY-988\nref=%s\nroot=%s\nhandoff=%s\ncdp_port=9555\nlaunch_pid=999999\n' \
    "$e2e_ref" "$e2e_root" "$e2e_handoff" > "$e2e_session"

  echo "TEST: doctor --full reports active E2E session"
  out="$("$SCRIPT_PATH" doctor --full 2>&1)" || {
    echo "$out"
    return 1
  }
  print -r -- "$out" | grep -q 'session=active' || {
    echo "SELFTEST FAIL: doctor --full did not report active session"
    return 1
  }

  echo "TEST: doctor --full blocks invalid E2E session"
  printf 'issue=SAY-988\nref=%s\nroot=%s\nhandoff=%s\ncdp_port=9555\nlaunch_pid=999999\n' \
    "$e2e_ref" "$root/not-owned" "$e2e_handoff" > "$e2e_session"
  if "$SCRIPT_PATH" doctor --full >/dev/null 2>&1; then
    echo "SELFTEST FAIL: doctor --full accepted invalid E2E session"
    return 1
  fi
  rm -f -- "$e2e_session" "$e2e_marker" "$e2e_handoff"
  rm -rf -- "$e2e_root"

  echo "TEST: doctor --full blocks missing E2E helper"
  if NUINUI_E2E_STATUS_HELPER="$root/missing-e2e-helper" "$SCRIPT_PATH" doctor --full >/dev/null 2>&1; then
    echo "SELFTEST FAIL: doctor --full accepted missing E2E helper"
    return 1
  fi

  echo "SELFTEST PASS"
)

case "${1:-}" in
  version) echo "$VERSION" ;;
  preflight) preflight ;;
  verify)
    [[ $# -eq 5 ]] || { echo "Usage: $0 verify <main|sub> <SAY-123> <expected-base-sha> <branch>"; exit 2; }
    verify_lane "$2" "$3" "$4" "$5"
    ;;
  start)
    [[ $# -eq 5 ]] || { echo "Usage: $0 start <main|sub> <SAY-123> <expected-base-sha> <branch>"; exit 2; }
    start_lane "$2" "$3" "$4" "$5"
    ;;
  resume)
    [[ $# -eq 5 ]] || { echo "Usage: $0 resume <main|sub> <SAY-123> <expected-checkpoint-sha> <branch>"; exit 2; }
    resume_lane "$2" "$3" "$4" "$5"
    ;;
  release)
    [[ $# -eq 3 ]] || { echo "Usage: $0 release <main|sub> <merged-checkpoint-sha>"; exit 2; }
    release_lane "$2" "$3"
    ;;
  pr-auto-merge)
    [[ $# -eq 4 ]] || { echo "Usage: $0 pr-auto-merge <pr-number> <expected-head-sha> <expected-main-sha>"; exit 2; }
    pr_auto_merge "$2" "$3" "$4"
    ;;
  e2e-start)
    [[ $# -eq 3 ]] || { echo "Usage: $0 e2e-start <SAY-123> <tested-ref>"; exit 2; }
    e2e_start "$2" "$3"
    ;;
  e2e-start-local-main)
    [[ $# -eq 3 ]] || { echo "Usage: $0 e2e-start-local-main <SAY-123> <tested-ref>"; exit 2; }
    e2e_start_local_main "$2" "$3"
    ;;
  e2e-release) e2e_release ;;
  context-sync) context_sync_repo "$DEV_CONTEXT_WT" "$DEV_CONTEXT_TOKEN" ;;
  doctor)
    if [[ "$#" -eq 2 && "$2" == "--full" ]]; then
      doctor_full
      exit $?
    fi
    [[ "$#" -eq 1 ]] || { echo "Usage: $0 doctor [--full]"; exit 2; }
    echo "nuinui $VERSION"
    echo
    preflight
    echo
    if [[ -d "$DEV_CONTEXT_WT" ]]; then
      echo "dev-context=$DEV_CONTEXT_WT"
    else
      echo "dev-context=not-installed"
    fi
    ;;
  transition-audit) [[ "$#" -eq 1 ]] || { echo "Usage: $0 transition-audit"; exit 2; }; transition_audit ;;
  context-check) [[ "$#" -eq 1 ]] || { echo "Usage: $0 context-check"; exit 2; }; context_check ;;
  self-test) self_test ;;
  *)
    echo "nuinui $VERSION"
    echo
    echo "Commands:"
    echo "  preflight"
    echo "  verify <main|sub> <SAY-123> <expected-base-sha> <branch>"
    echo "  start <main|sub> <SAY-123> <expected-base-sha> <branch>"
    echo "  resume <main|sub> <SAY-123> <expected-checkpoint-sha> <branch>"
    echo "  release <main|sub> <merged-checkpoint-sha>"
    echo "  pr-auto-merge <pr-number> <expected-head-sha> <expected-main-sha>"
    echo "  e2e-start <SAY-123> <tested-ref>"
    echo "  e2e-start-local-main <SAY-123> <tested-ref>"
    echo "  e2e-release"
    echo "  context-sync"
    echo "  doctor [--full]"
    echo "  transition-audit"
    echo "  context-check"
    echo "  self-test"
    exit 2
    ;;
esac
