#!/bin/sh
set -eu

fake_gh() {
  scenario=${FAKE_GH_SCENARIO:?FAKE_GH_SCENARIO is required}
  root=${FAKE_GH_ROOT:?FAKE_GH_ROOT is required}
  log=$root/ops
  printf '%s\n' "$*" >> "$log"

  next_count() {
    name=$1
    file=$root/$name.count
    n=0
    [ -f "$file" ] && n=$(sed -n '1p' "$file")
    n=$((n + 1))
    printf '%s\n' "$n" > "$file"
    printf '%s\n' "$n"
  }

  if [ "$1" = pr ] && [ "$2" = view ]; then
    n=$(next_count view)
    url_pr=$PR_NUMBER
    case "$scenario" in
      api-error)
        echo 'fake gh: pull request API unavailable' >&2
        return 41
        ;;
      head-mismatch)
        actual_head=9999999999999999999999999999999999999999
        actual_main=$MAIN
        state=OPEN
        draft=false
        base=main
        mergeability=MERGEABLE
        auto=none
        ;;
      main-mismatch)
        actual_head=$HEAD
        actual_main=$BASE_EVIDENCE
        state=OPEN
        draft=false
        base=main
        mergeability=MERGEABLE
        auto=none
        ;;
      pr-behind-current-main|up-to-date-pending|main-advances-before-mutation)
        actual_head=$HEAD
        actual_main=$BASE_EVIDENCE
        state=OPEN
        draft=false
        base=main
        mergeability=MERGEABLE
        auto=none
        ;;
      complete-start)
        actual_head=$HEAD
        actual_main=$MAIN
        state=OPEN
        draft=false
        base=main
        mergeability=MERGEABLE
        auto=none
        ;;
      toctou-complete)
        actual_head=$HEAD
        actual_main=$MAIN
        state=OPEN
        draft=false
        base=main
        mergeability=MERGEABLE
        auto=none
        ;;
      mutation-race)
        actual_head=$HEAD
        actual_main=$MAIN
        state=OPEN
        draft=false
        base=main
        mergeability=MERGEABLE
        auto=none
        ;;
      mutation-error|readback-fails|success|up-to-date-pending)
        actual_head=$HEAD
        actual_main=$MAIN
        state=OPEN
        draft=false
        base=main
        mergeability=MERGEABLE
        auto=none
        ;;
      duplicate|duplicate-checks-pass|reserved-integration-mismatch|reserved-wrong-main|reserved-wrong-head|reserved-wrong-pr|auto-squash|closed|merged|draft|non-main-base)
        actual_head=$HEAD
        actual_main=$MAIN
        state=OPEN
        draft=false
        base=main
        mergeability=MERGEABLE
        auto=none
        ;;
      failure-*|checks-api-error|empty-actions-pending|empty-actions-complete|empty-none-required|empty-unresolved)
        actual_head=$HEAD
        actual_main=$MAIN
        state=OPEN
        draft=false
        base=main
        mergeability=MERGEABLE
        auto=none
        ;;
      *)
        echo "fake gh: unknown view scenario $scenario" >&2
        return 42
        ;;
    esac
    case "$scenario" in
      auto-squash) auto=SQUASH ;;
      closed) state=CLOSED;auto=MERGE ;;
      merged) state=MERGED;auto=MERGE ;;
      draft) draft=true;auto=MERGE ;;
      non-main-base) base=develop;auto=MERGE ;;
      reserved-integration-mismatch|reserved-wrong-main|reserved-wrong-head) auto=MERGE ;;
      reserved-wrong-pr) url_pr=418;auto=MERGE ;;
      *) ;;
    esac
    if [ "$scenario" = toctou-complete ] && [ "$n" -ge 2 ]; then
      :
    elif [ "$scenario" = mutation-race ] && [ -f "$root/mutation-complete" ]; then
      :
    elif { [ "$scenario" = success ] || [ "$scenario" = up-to-date-pending ] || [ "$scenario" = empty-actions-pending ] || [ "$scenario" = duplicate ] || [ "$scenario" = duplicate-checks-pass ]; } && [ "$n" -ge 3 ]; then
      auto=MERGE
    elif [ "$scenario" = readback-fails ] && [ "$n" -ge 3 ]; then
      echo 'fake gh: read-back API unavailable' >&2
      return 43
    fi
    printf 'PR_ID\t%s\t%s\t%s\t%s\t%s\t%s\t%s\thttps://github.example/pull/%s\n' \
      "$state" "$draft" "$base" "$actual_main" "$actual_head" "$mergeability" "$auto" "$url_pr"
    return 0
  fi

  if [ "$1" = pr ] && [ "$2" = checks ]; then
    case "$scenario" in
      complete-start)
        printf 'CI\tpass\n'
        ;;
      toctou-complete)
        if [ "$(sed -n '1p' "$root/view.count")" -ge 2 ]; then
          printf 'CI\tpass\n'
        else
          printf 'CI\tpending\n'
        fi
        ;;
      mutation-race)
        if [ -f "$root/mutation-complete" ]; then
          printf 'CI\tpass\n'
        else
          printf 'CI\tpending\n'
        fi
        ;;
      duplicate-checks-pass)
        checks_count=$(next_count checks)
        if [ "$checks_count" -le 2 ]; then
          printf 'CI\tpending\n'
        else
          printf 'CI\tpass\n'
        fi
        ;;
      mutation-error|success|up-to-date-pending|main-advances-before-mutation|readback-fails|duplicate)
        printf 'CI\tpending\n'
        ;;
      failure-failure|failure-cancelled|failure-skipped|failure-unknown)
        printf 'CI\t%s\n' "${scenario#failure-}"
        ;;
      checks-api-error)
        echo 'fake gh: required checks API unavailable' >&2
        return 45
        ;;
      empty-actions-pending|empty-actions-complete|empty-none-required|empty-unresolved)
        echo "no required checks reported on the 'feature' branch" >&2
        return 1
        ;;
      *)
        echo "fake gh: unexpected checks scenario $scenario" >&2
        return 46
        ;;
    esac
    return 0
  fi

  if [ "$1" = api ]; then
    api_endpoint=$2
    case "$api_endpoint" in
      repos/sayosomi/nuinuiCAD/commits/main)
        n=$(next_count current-main)
        case "$scenario" in
          main-mismatch) printf '8888888888888888888888888888888888888888\n' ;;
          main-advances-before-mutation)
            if [ "$n" = 1 ]; then
              printf '%s\n' "$MAIN"
            else
              printf '%s\n' "$ADVANCED_MAIN"
            fi
            ;;
          *) printf '%s\n' "$MAIN" ;;
        esac
        return 0
        ;;
      repos/sayosomi/nuinuiCAD/compare/*)
        case "$scenario" in
          pr-behind-current-main|reserved-integration-mismatch)
            printf 'behind\t%s\t%s\t0\t1\n' "$MAIN" "$BASE_EVIDENCE"
            ;;
          *)
            printf 'ahead\t%s\t%s\t1\t0\n' "$MAIN" "$MAIN"
            ;;
        esac
        return 0
        ;;
    esac
  fi

  if [ "$1" = api ]; then
    api_endpoint=$2
    if [ "$api_endpoint" = -X ]; then
      api_endpoint=$4
    fi
    case "$scenario:$api_endpoint" in
      empty-actions-pending:repos/sayosomi/nuinuiCAD/branches/main|empty-actions-complete:repos/sayosomi/nuinuiCAD/branches/main|empty-none-required:repos/sayosomi/nuinuiCAD/branches/main|empty-unresolved:repos/sayosomi/nuinuiCAD/branches/main)
        printf 'none\n'
        return 0
        ;;
      empty-actions-pending:repos/sayosomi/nuinuiCAD/rules/branches/main|empty-actions-complete:repos/sayosomi/nuinuiCAD/rules/branches/main|empty-none-required:repos/sayosomi/nuinuiCAD/rules/branches/main)
        printf 'none\n'
        return 0
        ;;
      empty-unresolved:repos/sayosomi/nuinuiCAD/rules/branches/main)
        printf 'none\n'
        return 0
        ;;
      empty-actions-pending:repos/sayosomi/nuinuiCAD/actions/runs)
        printf '9001\tCI\tin_progress\tnone\t6001\t%s\tpull_request\n' "$HEAD"
        return 0
        ;;
      empty-actions-complete:repos/sayosomi/nuinuiCAD/actions/runs)
        printf '9001\tCI\tcompleted\tsuccess\t6001\t%s\tpull_request\n' "$HEAD"
        return 0
        ;;
      empty-none-required:repos/sayosomi/nuinuiCAD/actions/runs)
        printf 'none\n'
        return 0
        ;;
      empty-unresolved:repos/sayosomi/nuinuiCAD/actions/runs)
        printf '9001\tOTHER\tcompleted\tsuccess\t6001\t%s\tpull_request\n' "$HEAD"
        return 0
        ;;
      empty-actions-pending:repos/sayosomi/nuinuiCAD/check-suites/6001)
        printf '%s\t123\tin_progress\tnone\n' "$HEAD"
        return 0
        ;;
      empty-unresolved:repos/sayosomi/nuinuiCAD/check-suites/6001)
        printf '9999999999999999999999999999999999999999\t123\tcompleted\tsuccess\n'
        return 0
        ;;
      empty-actions-complete:repos/sayosomi/nuinuiCAD/check-suites/6001)
        printf '%s\t123\tcompleted\tsuccess\n' "$HEAD"
        return 0
        ;;
      empty-actions-pending:repos/sayosomi/nuinuiCAD/commits/$HEAD/check-runs)
        printf 'CI\t123\tin_progress\tnone\t%s\n' "$HEAD"
        return 0
        ;;
      empty-actions-complete:repos/sayosomi/nuinuiCAD/commits/$HEAD/check-runs)
        printf 'CI\t123\tcompleted\tsuccess\t%s\n' "$HEAD"
        return 0
        ;;
      empty-none-required:repos/sayosomi/nuinuiCAD/commits/$HEAD/check-runs|empty-unresolved:repos/sayosomi/nuinuiCAD/commits/$HEAD/check-runs)
        printf 'none\n'
        return 0
        ;;
    esac
  fi

  if [ "$1" = api ] && [ "$2" = graphql ]; then
    case "$scenario" in
      mutation-race)
        printf '%s\n' complete > "$root/mutation-complete"
        echo 'fake gh: reservation rejected because required checks completed' >&2
        return 47
        ;;
      mutation-error)
        echo 'fake gh: reservation mutation unavailable' >&2
        return 48
        ;;
      success|up-to-date-pending|readback-fails|empty-actions-pending|duplicate|duplicate-checks-pass)
        printf '{"data":{"enablePullRequestAutoMerge":{"clientMutationId":"fake"}}}\n'
        return 0
        ;;
      *)
        echo "fake gh: unexpected GraphQL operation for $scenario" >&2
        return 48
        ;;
    esac
  fi

  echo "fake gh: unexpected operation $*" >&2
  return 49
}

if [ "${NUINUI_FAKE_GH:-0}" = 1 ]; then
  fake_gh "$@"
  exit $?
fi

if [ "$#" -gt 0 ]; then
  case "$1" in
    /*) HELPER=$1 ;;
    *) HELPER=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd -P)/$(basename -- "$1") ;;
  esac
else
  HELPER=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/nuinui
fi
FAKE_GH=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")
ROOT=$(mktemp -d "${TMPDIR:-/tmp}/nuinui-pr-auto-merge.XXXXXX")
trap 'rm -rf "$ROOT"' EXIT HUP INT TERM

PR_NUMBER=417
HEAD=1111111111111111111111111111111111111111
MAIN=2222222222222222222222222222222222222222
ADVANCED_MAIN=3333333333333333333333333333333333333333
BASE_EVIDENCE=4444444444444444444444444444444444444444
OTHER_HEAD=5555555555555555555555555555555555555555
OTHER_MAIN=6666666666666666666666666666666666666666

fail() { echo "SELFTEST FAIL: $*" >&2; exit 1; }
assert_contains() {
  printf '%s\n' "$1" | grep -Fq -- "$2" || fail "$3"
}
without_command_result_footer() {
  printf '%s\n' "$1" | sed '/^===== NUINUI COMMAND RESULT =====$/,$d'
}
assert_success_envelope() {
  name=$1
  actual=$2
  expected=$(printf 'AUTO-MERGE RESERVED\npr=%s\nhead=%s\nmain=%s\nmerge_method=MERGE' \
    "$PR_NUMBER" "$HEAD" "$MAIN")
  if [ "$(without_command_result_footer "$actual")" != "$expected" ]; then
    printf '%s\n' "$actual"
    fail "$name success envelope mismatch"
  fi
}
assert_first_line_classified() {
  first=$(printf '%s\n' "$1" | sed -n '1p')
  case "$first" in
    BLOCKED:*|ERROR:*) ;;
    *) fail "$2: first line was not classified: $first" ;;
  esac
}
assert_no_direct_merge() {
  if grep -Eq '^pr merge([[:space:]]|$)' "$1"; then
    fail "$2 attempted a direct merge"
  fi
}
assert_no_graphql() {
  if grep -Eq '^api graphql([[:space:]]|$)' "$1"; then
    fail "$2 attempted a GraphQL mutation"
  fi
}
graphql_count() { grep -Ec '^api graphql([[:space:]]|$)' "$1" || true; }

prepare_case() {
  scenario=$1
  CASE_ROOT=$ROOT/$scenario
  rm -rf "$CASE_ROOT"
  mkdir -p "$CASE_ROOT"
  mkdir -p "$CASE_ROOT/context"
  : > "$CASE_ROOT/ops"
}

last_result_for_case() {
  case_name=$1
  NUINUI_SELFTEST=1 NUINUI_MAIN_WT="$ROOT" NUINUI_SUB_WT="$ROOT" NUINUI_E2E_WT="$ROOT" \
    NUINUI_SELFTEST_RESULT_REPO="$ROOT/$case_name/context" \
    "$HELPER" last-result
}

run_failure() {
  name=$1
  scenario=$2
  expected=$3
  prepare_case "$scenario"
  if output=$(NUINUI_SELFTEST=1 NUINUI_MAIN_WT="$ROOT" NUINUI_SUB_WT="$ROOT" NUINUI_E2E_WT="$ROOT" \
    NUINUI_SELFTEST_RESULT_REPO="$CASE_ROOT/context" NUINUI_GH_BIN="$FAKE_GH" NUINUI_FAKE_GH=1 FAKE_GH_ROOT="$CASE_ROOT" \
    FAKE_GH_SCENARIO="$scenario" PR_NUMBER="$PR_NUMBER" HEAD="$HEAD" MAIN="$MAIN" \
    ADVANCED_MAIN="$ADVANCED_MAIN" BASE_EVIDENCE="$BASE_EVIDENCE" \
    "$HELPER" pr-auto-merge "$PR_NUMBER" "$HEAD" "$MAIN" 2>&1); then
    printf '%s\n' "$output"
    fail "$name unexpectedly succeeded"
  else
    rc=$?
  fi
  [ "$rc" -ne 0 ] || fail "$name returned zero"
  [ -n "$output" ] || fail "$name produced no diagnostic"
  assert_first_line_classified "$output" "$name"
  assert_contains "$output" "$expected" "$name did not include expected diagnostic"
  if printf '%s\n' "$output" | grep -Fq 'AUTO-MERGE RESERVED'; then
    fail "$name reported reservation despite a nonzero exit"
  fi
  assert_no_direct_merge "$CASE_ROOT/ops" "$name"
  printf '%s\n' "--- $name (exit=$rc) ---"
  printf '%s\n' "$output"
  printf '%s\n' 'operations:'
  cat "$CASE_ROOT/ops"
}

run_failure_with_args() {
  name=$1
  scenario=$2
  expected=$3
  expected_head=$4
  expected_main=$5
  prepare_case "$scenario"
  if output=$(NUINUI_SELFTEST=1 NUINUI_MAIN_WT="$ROOT" NUINUI_SUB_WT="$ROOT" NUINUI_E2E_WT="$ROOT" \
    NUINUI_SELFTEST_RESULT_REPO="$CASE_ROOT/context" NUINUI_GH_BIN="$FAKE_GH" NUINUI_FAKE_GH=1 FAKE_GH_ROOT="$CASE_ROOT" \
    FAKE_GH_SCENARIO="$scenario" PR_NUMBER="$PR_NUMBER" HEAD="$HEAD" MAIN="$MAIN" \
    ADVANCED_MAIN="$ADVANCED_MAIN" BASE_EVIDENCE="$BASE_EVIDENCE" \
    "$HELPER" pr-auto-merge "$PR_NUMBER" "$expected_head" "$expected_main" 2>&1); then
    printf '%s\n' "$output"
    fail "$name unexpectedly succeeded"
  else
    rc=$?
  fi
  [ "$rc" -ne 0 ] || fail "$name returned zero"
  [ -n "$output" ] || fail "$name produced no diagnostic"
  assert_first_line_classified "$output" "$name"
  assert_contains "$output" "$expected" "$name did not include expected diagnostic"
  if printf '%s\n' "$output" | grep -Fq 'AUTO-MERGE ALREADY RESERVED'; then
    fail "$name reported already-reserved success despite a nonzero exit"
  fi
  assert_no_direct_merge "$CASE_ROOT/ops" "$name"
  assert_no_graphql "$CASE_ROOT/ops" "$name"
}

run_duplicate() {
  name=$1
  scenario=$2
  prepare_case "$scenario"
  if output=$(NUINUI_SELFTEST=1 NUINUI_MAIN_WT="$ROOT" NUINUI_SUB_WT="$ROOT" NUINUI_E2E_WT="$ROOT" \
    NUINUI_SELFTEST_RESULT_REPO="$CASE_ROOT/context" NUINUI_GH_BIN="$FAKE_GH" NUINUI_FAKE_GH=1 FAKE_GH_ROOT="$CASE_ROOT" \
    FAKE_GH_SCENARIO="$scenario" PR_NUMBER="$PR_NUMBER" HEAD="$HEAD" MAIN="$MAIN" \
    ADVANCED_MAIN="$ADVANCED_MAIN" BASE_EVIDENCE="$BASE_EVIDENCE" \
    "$HELPER" pr-auto-merge "$PR_NUMBER" "$HEAD" "$MAIN" 2>&1); then
    :
  else
    printf '%s\n' "$output"
    fail "$name initial reservation failed"
  fi
  assert_success_envelope "$name initial reservation" "$output"
  [ "$(graphql_count "$CASE_ROOT/ops")" = 1 ] || fail "$name initial reservation did not invoke GraphQL exactly once"
  checks_before=$(grep -Ec '^pr checks([[:space:]]|$)' "$CASE_ROOT/ops" || true)
  if output=$(NUINUI_SELFTEST=1 NUINUI_MAIN_WT="$ROOT" NUINUI_SUB_WT="$ROOT" NUINUI_E2E_WT="$ROOT" \
    NUINUI_SELFTEST_RESULT_REPO="$CASE_ROOT/context" NUINUI_GH_BIN="$FAKE_GH" NUINUI_FAKE_GH=1 FAKE_GH_ROOT="$CASE_ROOT" \
    FAKE_GH_SCENARIO="$scenario" PR_NUMBER="$PR_NUMBER" HEAD="$HEAD" MAIN="$MAIN" \
    ADVANCED_MAIN="$ADVANCED_MAIN" BASE_EVIDENCE="$BASE_EVIDENCE" \
    "$HELPER" pr-auto-merge "$PR_NUMBER" "$HEAD" "$MAIN" 2>&1); then
    :
  else
    printf '%s\n' "$output"
    fail "$name duplicate unexpectedly failed"
  fi
  expected=$(printf 'AUTO-MERGE ALREADY RESERVED\npr=%s\nhead=%s\nmain=%s\nmerge_method=MERGE\nmutation=no-op' \
    "$PR_NUMBER" "$HEAD" "$MAIN")
  [ "$(without_command_result_footer "$output")" = "$expected" ] || fail "$name duplicate envelope mismatch"
  [ "$(graphql_count "$CASE_ROOT/ops")" = 1 ] || fail "$name duplicate invoked GraphQL"
  checks_after=$(grep -Ec '^pr checks([[:space:]]|$)' "$CASE_ROOT/ops" || true)
  [ "$checks_after" = "$checks_before" ] || fail "$name duplicate invoked required-check discovery"
  assert_no_direct_merge "$CASE_ROOT/ops" "$name duplicate"
  duplicate_last_result=$(last_result_for_case "$scenario")
  assert_contains "$duplicate_last_result" 'mutation=no' "$name duplicate durable result was not classified as no mutation"
}

run_success() {
  name=$1
  scenario=$2
  prepare_case "$scenario"
  if output=$(NUINUI_SELFTEST=1 NUINUI_MAIN_WT="$ROOT" NUINUI_SUB_WT="$ROOT" NUINUI_E2E_WT="$ROOT" \
    NUINUI_SELFTEST_RESULT_REPO="$CASE_ROOT/context" NUINUI_GH_BIN="$FAKE_GH" NUINUI_FAKE_GH=1 FAKE_GH_ROOT="$CASE_ROOT" \
    FAKE_GH_SCENARIO="$scenario" PR_NUMBER="$PR_NUMBER" HEAD="$HEAD" MAIN="$MAIN" \
    ADVANCED_MAIN="$ADVANCED_MAIN" BASE_EVIDENCE="$BASE_EVIDENCE" \
    "$HELPER" pr-auto-merge "$PR_NUMBER" "$HEAD" "$MAIN" 2>&1); then
    rc=0
  else
    rc=$?
    printf '%s\n' "$output"
    fail "$name unexpectedly failed with exit $rc"
  fi
  [ "$rc" -eq 0 ] || fail "$name did not return zero"
  assert_success_envelope "$name" "$output"
  assert_contains "$output" 'AUTO-MERGE RESERVED' "$name did not report reservation"
  assert_no_direct_merge "$CASE_ROOT/ops" "$name"
  [ "$(graphql_count "$CASE_ROOT/ops")" = 1 ] || fail "$name did not invoke exactly one GraphQL mutation"
  operations=$(cat "$CASE_ROOT/ops")
  assert_contains "$operations" 'enablePullRequestAutoMerge' "$name did not use enablePullRequestAutoMerge"
  assert_contains "$operations" 'mergeMethod:MERGE' "$name did not pin MERGE"
  assert_contains "$operations" "-f h=$HEAD" "$name did not pass expectedHeadOid"
  printf '%s\n' "--- $name (exit=0) ---"
  printf '%s\n' "$output"
  printf '%s\n' 'operations:'
  printf '%s\n' "$operations"
}

run_fallback_pending() {
  name=$1
  scenario=$2
  prepare_case "$scenario"
  if output=$(NUINUI_SELFTEST=1 NUINUI_MAIN_WT="$ROOT" NUINUI_SUB_WT="$ROOT" NUINUI_E2E_WT="$ROOT" \
    NUINUI_SELFTEST_RESULT_REPO="$CASE_ROOT/context" NUINUI_GH_BIN="$FAKE_GH" NUINUI_FAKE_GH=1 FAKE_GH_ROOT="$CASE_ROOT" \
    FAKE_GH_SCENARIO="$scenario" PR_NUMBER="$PR_NUMBER" HEAD="$HEAD" MAIN="$MAIN" \
    ADVANCED_MAIN="$ADVANCED_MAIN" BASE_EVIDENCE="$BASE_EVIDENCE" \
    "$HELPER" pr-auto-merge "$PR_NUMBER" "$HEAD" "$MAIN" 2>&1); then
    rc=0
  else
    rc=$?
    printf '%s\n' "$output"
    fail "$name unexpectedly failed with exit $rc"
  fi
  [ "$rc" -eq 0 ] || fail "$name did not return zero"
  assert_success_envelope "$name" "$output"
  assert_contains "$output" 'AUTO-MERGE RESERVED' "$name did not report reservation"
  assert_no_direct_merge "$CASE_ROOT/ops" "$name"
  [ "$(graphql_count "$CASE_ROOT/ops")" = 1 ] || fail "$name did not invoke exactly one GraphQL mutation"
  printf '%s\n' "--- $name (exit=0) ---"
  printf '%s\n' "$output"
  printf '%s\n' 'operations:'
  cat "$CASE_ROOT/ops"
}

run_failure 'already complete at command start' complete-start \
  'BLOCKED: all required checks are already complete'
assert_no_graphql "$ROOT/complete-start/ops" 'already complete at command start'

run_duplicate 'exact duplicate reservation' duplicate
run_duplicate 'duplicate after required checks progress' duplicate-checks-pass

run_failure 'TOCTOU pending to complete' toctou-complete \
  'BLOCKED: Auto-merge reservation precondition changed before mutation'
assert_contains "$output" 'BLOCKED: all required checks are already complete' 'TOCTOU output did not identify completion'
assert_contains "$(cat "$ROOT/toctou-complete/ops")" 'pr checks' 'TOCTOU case did not inspect checks'
assert_contains "$(cat "$ROOT/toctou-complete/ops")" 'pr view' 'TOCTOU case did not perform precondition reads'
assert_no_graphql "$ROOT/toctou-complete/ops" 'TOCTOU pending to complete'

run_failure 'reservation mutation race' mutation-race \
  'BLOCKED: all required checks are already complete'
assert_contains "$output" '===== NUINUI COMMAND RESULT =====' 'mutation race did not emit command-result footer'
assert_contains "$output" 'mutation=unknown' 'mutation race was classified as no mutation'
mutation_race_last_result=$(last_result_for_case mutation-race)
assert_contains "$mutation_race_last_result" 'recovery=READY' 'mutation race last-result was not READY'
assert_contains "$mutation_race_last_result" 'result=BLOCKED' 'mutation race last-result result is wrong'
assert_contains "$mutation_race_last_result" 'mutation=unknown' 'mutation race last-result mutation is wrong'
assert_contains "$(cat "$ROOT/mutation-race/ops")" 'pr checks' 'mutation race did not perform fresh diagnosis'
[ "$(graphql_count "$ROOT/mutation-race/ops")" = 1 ] || fail 'mutation race retried GraphQL mutation'
assert_contains "$(cat "$ROOT/mutation-race/ops")" 'pr view' 'mutation race did not read current PR state'
assert_contains "$(cat "$ROOT/mutation-race/ops")" 'pr checks' 'mutation race did not read current checks'

run_failure 'reservation mutation failure' mutation-error \
  'ERROR: Auto-merge reservation mutation failed'
[ "$(graphql_count "$ROOT/mutation-error/ops")" = 1 ] || fail 'mutation failure retried GraphQL mutation'

for bucket in failure cancelled skipped unknown; do
  run_failure "initial required check $bucket" "failure-$bucket" \
    'BLOCKED: required check is not pass or pending'
done

run_failure 'reviewed head mismatch' head-mismatch \
  "expected_head=$HEAD"
assert_contains "$output" 'actual_head=9999999999999999999999999999999999999999' 'head mismatch did not expose actual head'
assert_contains "$(cat "$ROOT/head-mismatch/ops")" 'pr view' 'head mismatch did not inspect the PR'

run_failure 'existing non-MERGE reservation' auto-squash \
  'BLOCKED: Auto-merge already configured'

run_failure 'already-reserved wrong PR number' reserved-wrong-pr \
  'BLOCKED: PR number mismatch'

run_failure_with_args 'already-reserved wrong expected head' reserved-wrong-head \
  "expected_head=$OTHER_HEAD" "$OTHER_HEAD" "$MAIN"

run_failure_with_args 'already-reserved wrong expected main' reserved-wrong-main \
  "expected_main=$OTHER_MAIN" "$HEAD" "$OTHER_MAIN"

run_failure 'already-reserved closed PR' closed \
  'BLOCKED: PR is not OPEN'

run_failure 'already-reserved merged PR' merged \
  'BLOCKED: PR is not OPEN'

run_failure 'already-reserved draft PR' draft \
  'BLOCKED: PR is a draft'

run_failure 'already-reserved non-main base' non-main-base \
  'BLOCKED: PR base branch mismatch'

run_failure 'already-reserved integration mismatch' reserved-integration-mismatch \
  'BLOCKED: PR is behind current main; integration required'

run_failure 'expected main mismatch' main-mismatch \
  "expected_main=$MAIN"
assert_contains "$output" 'actual_main=8888888888888888888888888888888888888888' 'main mismatch did not expose authoritative current main'
assert_contains "$(cat "$ROOT/main-mismatch/ops")" 'pr view' 'main mismatch did not inspect the PR'
assert_contains "$(cat "$ROOT/main-mismatch/ops")" 'repos/sayosomi/nuinuiCAD/commits/main' 'main mismatch did not fetch authoritative current main'
assert_no_graphql "$ROOT/main-mismatch/ops" 'expected main mismatch'

run_failure 'PR behind current main' pr-behind-current-main \
  'BLOCKED: PR is behind current main; integration required'
assert_contains "$output" "expected_main=$MAIN" 'behind PR did not expose expected main'
assert_contains "$output" "reviewed_head=$HEAD" 'behind PR did not expose reviewed head'
assert_contains "$output" "integrated_base=$BASE_EVIDENCE" 'behind PR did not expose integrated base evidence'
assert_contains "$(cat "$ROOT/pr-behind-current-main/ops")" 'repos/sayosomi/nuinuiCAD/compare/' 'behind PR did not inspect integration'
assert_no_graphql "$ROOT/pr-behind-current-main/ops" 'PR behind current main'

run_success 'up-to-date PR with pending required checks' up-to-date-pending

run_failure 'main advances before mutation' main-advances-before-mutation \
  'BLOCKED: Auto-merge reservation precondition changed before mutation'
assert_contains "$output" "actual_main=$ADVANCED_MAIN" 'main advance did not expose fresh main'
assert_contains "$(cat "$ROOT/main-advances-before-mutation/ops")" 'repos/sayosomi/nuinuiCAD/commits/main' 'main advance did not refetch authoritative current main'
assert_no_graphql "$ROOT/main-advances-before-mutation/ops" 'main advances before mutation'

run_failure 'GitHub PR lookup failure' api-error \
  'ERROR: PR lookup/API failure'

run_failure 'required-check API failure' checks-api-error \
  'ERROR: required-check lookup/API failure'

run_fallback_pending 'empty required view with exact-head pending Actions' empty-actions-pending
run_failure 'empty required view with exact-head complete Actions' empty-actions-complete \
  'BLOCKED: all required checks are already complete'
assert_contains "$output" 'check_state=pass' 'complete exact-head Actions case did not classify pass'
assert_no_graphql "$ROOT/empty-actions-complete/ops" 'empty required view with complete Actions'
run_failure 'no required checks and no PR CI' empty-none-required \
  'check_state=none-required'
run_failure 'unresolvable required-check evidence' empty-unresolved \
  'check_state=required-checks-unresolved'

run_success 'successful reservation' success

run_failure 'mutation succeeds but read-back fails' readback-fails \
  'ERROR: Auto-merge reservation state could not be verified'
[ "$(graphql_count "$ROOT/readback-fails/ops")" = 1 ] || fail 'read-back failure retried GraphQL mutation'
assert_contains "$(cat "$ROOT/readback-fails/ops")" 'pr view' 'read-back failure did not inspect the PR'

echo 'NUINUI PR AUTO-MERGE SELFTEST PASS'
