#!/bin/sh
set -eu

usage() {
  echo 'Usage: generate-nuinui <output-path>' >&2
  exit 2
}

[ "$#" = 1 ] || usage
output=$1
[ -n "$output" ] || usage

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd -P)
project_policy_source=$script_dir/nuinui-src/lane-execution-profile.sh
e2e_policy_source=$script_dir/nuinui-src/lane-execution-e2e-policy.sh
ownership_source=$repo_root/shared/local-tools/lane-execution/ownership.sh
manifest_source=$repo_root/shared/local-tools/lane-execution/manifest.sh
standalone_context_source=$repo_root/shared/local-tools/lane-execution/standalone-context.sh
runtime_source=$repo_root/shared/local-tools/lane-execution/runtime.sh
preflight_source=$repo_root/shared/local-tools/lane-execution/preflight.sh
inventory_source=$repo_root/shared/local-tools/lane-execution/inventory.sh
lifecycle_source=$repo_root/shared/local-tools/lane-execution/lifecycle.sh
human_test_source=$repo_root/shared/local-tools/lane-execution/human-test.sh
cli_source=$repo_root/shared/local-tools/lane-execution/cli.sh
render_source=$repo_root/shared/local-tools/lane-execution/render.sh
implementation_operations_source=$repo_root/shared/local-tools/lane-execution/implementation-operations.sh
release_safety_source=$repo_root/shared/local-tools/lane-execution/release-safety.sh
body_source=$script_dir/nuinui-src/nuinui-body.sh
github_pr_source=$script_dir/nuinui-src/github-pr.sh
required_checks_source=$script_dir/nuinui-src/required-checks.sh
pr_auto_merge_source=$script_dir/nuinui-src/pr-auto-merge.sh
integration_clean_source=$script_dir/nuinui-src/integration-clean.sh
e2e_source=$script_dir/nuinui-src/e2e.sh
e2e_start_command_source=$script_dir/nuinui-src/e2e-start-command.sh
context_sync_source=$script_dir/nuinui-src/context-sync.sh
diagnostics_source=$script_dir/nuinui-src/diagnostics.sh
command_result_source=$script_dir/nuinui-src/command-result.sh
self_test_source=$script_dir/nuinui-src/self-test.sh
dispatch_source=$script_dir/nuinui-src/cli-dispatch.sh
artifact_path=$script_dir/nuinui

[ -f "$project_policy_source" ] || { echo "generate-nuinui: project policy source is missing: $project_policy_source" >&2; exit 1; }
[ -f "$e2e_policy_source" ] || { echo "generate-nuinui: E2E policy source is missing: $e2e_policy_source" >&2; exit 1; }
for generic_source in "$ownership_source" "$manifest_source" "$standalone_context_source" "$runtime_source" \
  "$preflight_source" "$inventory_source" "$lifecycle_source" "$human_test_source" \
  "$cli_source" "$render_source" "$implementation_operations_source" "$release_safety_source"; do
  [ -f "$generic_source" ] || { echo "generate-nuinui: generic runtime source is missing: $generic_source" >&2; exit 1; }
done
[ -f "$body_source" ] || {
  echo "generate-nuinui: body source is missing: $body_source" >&2
  exit 1
}
[ -f "$github_pr_source" ] || {
  echo "generate-nuinui: GitHub PR source is missing: $github_pr_source" >&2
  exit 1
}
[ -f "$required_checks_source" ] || {
  echo "generate-nuinui: required-checks source is missing: $required_checks_source" >&2
  exit 1
}
[ -f "$pr_auto_merge_source" ] || {
  echo "generate-nuinui: pr-auto-merge source is missing: $pr_auto_merge_source" >&2
  exit 1
}
[ -f "$integration_clean_source" ] || {
  echo "generate-nuinui: integration-clean source is missing: $integration_clean_source" >&2
  exit 1
}
[ -f "$e2e_source" ] || {
  echo "generate-nuinui: E2E source is missing: $e2e_source" >&2
  exit 1
}
[ -f "$e2e_start_command_source" ] || {
  echo "generate-nuinui: E2E start-command source is missing: $e2e_start_command_source" >&2
  exit 1
}
[ -f "$context_sync_source" ] || {
  echo "generate-nuinui: context-sync source is missing: $context_sync_source" >&2
  exit 1
}
[ -f "$diagnostics_source" ] || {
  echo "generate-nuinui: diagnostics source is missing: $diagnostics_source" >&2
  exit 1
}
[ -f "$command_result_source" ] || {
  echo "generate-nuinui: command-result source is missing: $command_result_source" >&2
  exit 1
}
[ -f "$self_test_source" ] || {
  echo "generate-nuinui: self-test source is missing: $self_test_source" >&2
  exit 1
}
[ -f "$dispatch_source" ] || {
  echo "generate-nuinui: CLI dispatch source is missing: $dispatch_source" >&2
  exit 1
}

output_dir=$(CDPATH= cd -- "$(dirname "$output")" && pwd -P) || {
  echo "generate-nuinui: output directory does not exist: $(dirname "$output")" >&2
  exit 1
}
output_path=$output_dir/$(basename "$output")

case "$output_path" in
  "$project_policy_source"|"$e2e_policy_source"|"$ownership_source"|"$manifest_source"|"$standalone_context_source"|"$runtime_source"|"$preflight_source"|"$inventory_source"|"$lifecycle_source"|"$human_test_source"|"$cli_source"|"$render_source"|"$implementation_operations_source"|"$release_safety_source"|"$body_source"|"$github_pr_source"|"$required_checks_source"|"$pr_auto_merge_source"|"$integration_clean_source"|"$e2e_source"|"$e2e_start_command_source"|"$context_sync_source"|"$diagnostics_source"|"$command_result_source"|"$self_test_source"|"$dispatch_source"|"$artifact_path")
    echo 'generate-nuinui: refusing to overwrite a checked-in source or production artifact' >&2
    exit 1
    ;;
esac

[ ! -d "$output_path" ] || {
  echo "generate-nuinui: output is a directory: $output_path" >&2
  exit 1
}
[ ! -L "$output_path" ] || {
  echo "generate-nuinui: refusing to overwrite a symbolic link: $output_path" >&2
  exit 1
}

temporary_path=$output_path.tmp.$$
[ ! -e "$temporary_path" ] || {
  echo "generate-nuinui: temporary output already exists: $temporary_path" >&2
  exit 1
}

cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  rm -f "$temporary_path"
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

# The source order is explicit and deterministic. Data parsing and generic
# durable/runtime primitives precede project policy, adapters, and commands.
# Development-only source-loading bootstrap blocks remain available when a
# staged source is executed directly, but are not production runtime code.
assemble_source() {
  sed '/^# BEGIN DEVELOPMENT-ONLY SOURCE LOADING$/,/^# END DEVELOPMENT-ONLY SOURCE LOADING$/d' "$1"
}

umask 077
{
assemble_source "$ownership_source"
assemble_source "$manifest_source"
assemble_source "$standalone_context_source"
assemble_source "$runtime_source"
assemble_source "$preflight_source"
assemble_source "$inventory_source"
assemble_source "$lifecycle_source"
assemble_source "$human_test_source"
assemble_source "$cli_source"
assemble_source "$render_source"
assemble_source "$project_policy_source"
assemble_source "$e2e_policy_source"
assemble_source "$e2e_start_command_source"
assemble_source "$release_safety_source"
assemble_source "$implementation_operations_source"
assemble_source "$body_source"
assemble_source "$github_pr_source"
assemble_source "$required_checks_source"
assemble_source "$pr_auto_merge_source"
assemble_source "$integration_clean_source"
assemble_source "$e2e_source"
assemble_source "$context_sync_source"
assemble_source "$diagnostics_source"
assemble_source "$command_result_source"
assemble_source "$self_test_source"
assemble_source "$dispatch_source"
} > "$temporary_path"
chmod 755 "$temporary_path"
mv "$temporary_path" "$output_path"

trap - EXIT HUP INT TERM
