#!/bin/sh
set -eu

usage() {
  echo 'Usage: generate-nuinui <output-path>' >&2
  exit 2
}

[ "$#" = 1 ] || usage
output=$1
[ -n "$output" ] || usage

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
source_path=$script_dir/nuinui-src/nuinui.sh
artifact_path=$script_dir/nuinui

[ -f "$source_path" ] || {
  echo "generate-nuinui: canonical source is missing: $source_path" >&2
  exit 1
}

output_dir=$(CDPATH= cd -- "$(dirname "$output")" && pwd -P) || {
  echo "generate-nuinui: output directory does not exist: $(dirname "$output")" >&2
  exit 1
}
output_path=$output_dir/$(basename "$output")

case "$output_path" in
  "$source_path"|"$artifact_path")
    echo 'generate-nuinui: refusing to overwrite a checked-in source or production artifact' >&2
    exit 1
    ;;
esac

[ ! -d "$output_path" ] || {
  echo "generate-nuinui: output is a directory: $output_path" >&2
  exit 1
}
[ ! -L "$output_path" ] || {
  echo "generate-nuinui: refusing to overwrite a symbolic link: $output_path" >&2
  exit 1
}

temporary_path=$output_path.tmp.$$
[ ! -e "$temporary_path" ] || {
  echo "generate-nuinui: temporary output already exists: $temporary_path" >&2
  exit 1
}

cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  rm -f "$temporary_path"
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

# The source order is explicit. This single canonical source is the complete
# runtime for this zero-semantic-change assembly leaf.
umask 077
cp "$source_path" "$temporary_path"
chmod 755 "$temporary_path"
mv "$temporary_path" "$output_path"

trap - EXIT HUP INT TERM
