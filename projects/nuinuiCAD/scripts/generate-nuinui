#!/bin/sh
set -eu

usage() {
  echo 'Usage: generate-nuinui <output-path>' >&2
  exit 2
}

[ "$#" = 1 ] || usage
output=$1
[ -n "$output" ] || usage

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
ownership_source=$script_dir/nuinui-src/ownership-schema.sh
body_source=$script_dir/nuinui-src/nuinui-body.sh
facade_source=$script_dir/nuinui-src/lifecycle-facade.sh
dispatch_source=$script_dir/nuinui-src/cli-dispatch.sh
artifact_path=$script_dir/nuinui

[ -f "$ownership_source" ] || {
  echo "generate-nuinui: ownership source is missing: $ownership_source" >&2
  exit 1
}
[ -f "$body_source" ] || {
  echo "generate-nuinui: body source is missing: $body_source" >&2
  exit 1
}
[ -f "$facade_source" ] || {
  echo "generate-nuinui: lifecycle façade source is missing: $facade_source" >&2
  exit 1
}
[ -f "$dispatch_source" ] || {
  echo "generate-nuinui: CLI dispatch source is missing: $dispatch_source" >&2
  exit 1
}

output_dir=$(CDPATH= cd -- "$(dirname "$output")" && pwd -P) || {
  echo "generate-nuinui: output directory does not exist: $(dirname "$output")" >&2
  exit 1
}
output_path=$output_dir/$(basename "$output")

case "$output_path" in
  "$ownership_source"|"$body_source"|"$facade_source"|"$dispatch_source"|"$artifact_path")
    echo 'generate-nuinui: refusing to overwrite a checked-in source or production artifact' >&2
    exit 1
    ;;
esac

[ ! -d "$output_path" ] || {
  echo "generate-nuinui: output is a directory: $output_path" >&2
  exit 1
}
[ ! -L "$output_path" ] || {
  echo "generate-nuinui: refusing to overwrite a symbolic link: $output_path" >&2
  exit 1
}

temporary_path=$output_path.tmp.$$
[ ! -e "$temporary_path" ] || {
  echo "generate-nuinui: temporary output already exists: $temporary_path" >&2
  exit 1
}

cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  rm -f "$temporary_path"
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

# The source order is explicit and deterministic. The ownership schema must
# precede every consumer that invokes it.
umask 077
cat "$ownership_source" "$body_source" "$facade_source" "$dispatch_source" > "$temporary_path"
chmod 755 "$temporary_path"
mv "$temporary_path" "$output_path"

trap - EXIT HUP INT TERM
