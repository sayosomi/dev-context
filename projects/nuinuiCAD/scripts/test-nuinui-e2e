assert_contains 'HOST FIXTURE CHECK READY'
if ! invoke_host host-prepare "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$host_fixture" 43123 ja; then
  cat "$output" >&2
  fail 'fixture-only host preparation failed'
fi
assert_contains 'fixture-no-process'
assert_contains 'no Human Manual E2E was run'
expect_block cleanup-proof "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
expect_ok host-cleanup "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
assert_contains 'HOST FIXTURE CLEANUP VERIFIED'
expect_ok release "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
expect_ok closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"

# Generator is deterministic, the checked-in candidate is current, and unsafe artifact links are rejected.
"$script_dir/generate-nuinui-e2e" --check > "$output" 2>&1 || {
  cat "$output" >&2
  fail 'deterministic generation check'
}
assert_contains 'generation check PASS'
unsafe_root=$fixture_root/generator-safety
unsafe_script_dir=$unsafe_root/projects/nuinuiCAD/scripts
mkdir -p "$unsafe_script_dir/nuinui-e2e-src" "$unsafe_root/shared/local-tools/lane-execution"
cp "$script_dir/generate-nuinui-e2e" "$unsafe_script_dir/"
cp "$script_dir/nuinui-e2e-src/identity.sh" "$script_dir/nuinui-e2e-src/lifecycle.sh" \
  "$script_dir/nuinui-e2e-src/host-fixture.sh" \
  "$script_dir/nuinui-e2e-src/host-session.sh" \
  "$script_dir/nuinui-e2e-src/host-closure.sh" \
  "$script_dir/nuinui-e2e-src/cli.sh" "$unsafe_script_dir/nuinui-e2e-src/"
cp "$repo_root/shared/local-tools/lane-execution/manifest.sh" \
  "$repo_root/shared/local-tools/lane-execution/ownership.sh" \
  "$repo_root/shared/local-tools/lane-execution/runtime.sh" \
  "$repo_root/shared/local-tools/lane-execution/preflight.sh" \
  "$unsafe_root/shared/local-tools/lane-execution/"
printf 'keep\n' > "$unsafe_root/keep"
ln -s "$unsafe_root/keep" "$unsafe_script_dir/nuinui-e2e"
if "$unsafe_script_dir/generate-nuinui-e2e" > "$output" 2>&1; then
  fail 'generator followed or replaced an unsafe artifact symlink'
fi
[ -L "$unsafe_script_dir/nuinui-e2e" ] &&
  [ "$(cat "$unsafe_script_dir/nuinui-e2e")" = keep ] || fail 'unsafe artifact symlink target changed'

# Legacy production-facing generated artifacts remain byte-identical to base.
# The standalone context candidate is updated by this migration and is checked
# independently by its own generation and context-sync regressions.
for preserved_path in \
  projects/nuinuiCAD/scripts/nuinui \
  projects/nuinuiCAD/scripts/nuinui-e2e-prepare; do
  git -C "$repo_root" diff --quiet HEAD -- "$preserved_path" ||
    fail "legacy artifact changed: $preserved_path"
  current_blob=$(git -C "$repo_root" hash-object "$repo_root/$preserved_path")
  base_blob=$(git -C "$repo_root" rev-parse "HEAD:$preserved_path")
  [ "$current_blob" = "$base_blob" ] || fail "legacy artifact blob changed: $preserved_path"
done

echo 'SELFTEST PASS'
