blocked host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
[ -f "$orphan_root/foreign.txt" ] || fail 'unsafe recovery removed foreign root contents'
[ "$(fingerprint)" = "$before" ] || fail 'unsafe recovery mutated host evidence'

# Production host roots use the private HOME parent; PREPARING recovery and
# completed history must preserve exact generation evidence.
new_production_root_fixture
fixture_generation=host-production-root-0001
ok start "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
production_parent=$host_test_home/.nuinuicad/e2e-hosts
production_root=$(host_root_path "$fixture_generation")
host_ok host-prepare "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43123
contains "root=$production_root"
[ "$(stat -f '%Lp' "$production_parent")" = 700 ] ||
  fail 'production host parent mode is not 0700'
[ "$(stat -f '%Lp' "$production_root")" = 700 ] ||
  fail 'production generation root mode is not 0700'
[ "$(stat -f '%u' "$production_root")" = "$(id -u)" ] ||
  fail 'production generation root is not owned by the current user'
if ! invoke host-closure "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha"; then
  cat "$output" >&2
  fail 'production-root host closure failed'
fi
contains 'HOST AND NATIVE CLOSURE VERIFIED'
[ ! -e "$production_root" ] && [ ! -L "$production_root" ] ||
  fail 'production-root closure left a generation directory'

advance_default after-production-root-closure
fixture_generation=host-production-preparing-0002
ok start "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
host_failpoint after-host-intent host-prepare "$fixture_issue" \
  "$fixture_generation" human "$fixture_tested_sha" "$fixture_file" 43123
production_preparing_intent=$(host_path intent "$fixture_generation")
production_preparing_root=$(host_root_path "$fixture_generation")
grep -Fqx "root=$production_preparing_root" "$production_preparing_intent" ||
  fail 'production PREPARING intent did not record the HOME host root'
[ ! -e "$production_preparing_root" ] && [ ! -L "$production_preparing_root" ] ||
  fail 'interrupted production PREPARING intent created an unowned root'
host_ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION PREPARING'
host_ok host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST FIXTURE RECOVERED FROM PREPARING'
host_ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST AND NATIVE CLOSURE VERIFIED'

# A legacy / root record without exact completed cleanup and release evidence
# is never accepted as an active or recoverable production host session.
new_production_root_fixture
fixture_generation=host-production-legacy-active-0001
ok start "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
host_failpoint after-host-intent host-prepare "$fixture_issue" \
  "$fixture_generation" human "$fixture_tested_sha" "$fixture_file" 43123
active_intent=$(host_path intent "$fixture_generation")
active_legacy_root=$(printf '/.nuinui-e2e-host-%s\n' \
  "$(printf '%s\n' "$fixture_generation" | shasum -a 256 | awk 'NR == 1 {print $1}')")
active_intent_tmp=$active_intent.legacy-fixture
awk -F= -v root="$active_legacy_root" \
  '$1 == "root" {print "root=" root; next} {print}' \
  "$active_intent" > "$active_intent_tmp" || fail 'active legacy-root fixture setup'
chmod 600 "$active_intent_tmp"
mv "$active_intent_tmp" "$active_intent"
before=$(fingerprint)
host_blocked host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
[ "$(fingerprint)" = "$before" ] || fail 'active legacy-root record was mutated during refusal'

# Parent attacks and an existing generation path fail before publishing intent.
