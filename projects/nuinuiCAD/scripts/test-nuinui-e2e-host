  host_blocked host-prepare "$fixture_issue" "$fixture_generation" human \
    "$fixture_tested_sha" "$fixture_file" 43123
  [ ! -e "$(host_path intent "$fixture_generation")" ] ||
    fail 'read-only HOME was rejected after publishing PREPARING intent'
