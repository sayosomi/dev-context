#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
helper=$script_dir/nuinui-e2e
fixture_root=
fixture_impl=
fixture_human=
fixture_manifest=
fixture_remote=
fixture_tested_sha=
fixture_issue=sayosomi/nuinuiCAD#268
fixture_generation=host-fixture-gen-0001
fixture_file=
output=
host_test_root_mode=fixture
host_test_home=

cleanup() {
  cleanup_status=$?
  trap - EXIT HUP INT TERM
  if [ -n "$fixture_root" ] && [ -d "$fixture_root" ]; then
    find "$fixture_root" -type d -name '.nuinui-e2e-host-*' -print |
      while IFS= read -r cleanup_host_root; do
        chmod u+rwx "$cleanup_host_root" 2>/dev/null || true
      done
  fi
  [ -z "$fixture_root" ] || rm -rf "$fixture_root"
  return "$cleanup_status"
}
trap cleanup EXIT HUP INT TERM

fail() {
  echo "HOST SELFTEST FAIL: $*" >&2
  [ -z "$output" ] || { [ ! -f "$output" ] || cat "$output" >&2; }
  exit 1
}

contains() { grep -Fq -- "$1" "$output" || fail "expected output to contain: $1"; }

new_fixture() {
  mode=$1
  host_test_root_mode=fixture
  host_test_home=
  [ -z "$fixture_root" ] || rm -rf "$fixture_root"
  fixture_root=$(mktemp -d "${TMPDIR:-/tmp}/nuinui-e2e-fixture.XXXXXX") || fail 'temporary root'
  fixture_root=$(realpath "$fixture_root") || fail 'canonical temporary root'
  fixture_impl=$fixture_root/implementation
  fixture_human=$fixture_root/human
  fixture_remote=$fixture_root/remote/sayosomi/nuinuiCAD.git
  fixture_manifest=$fixture_root/LANES.conf
  fixture_file=$fixture_root/host-fixture.html
  output=$fixture_root/command.out
  mkdir -p "$fixture_root/remote/sayosomi" || fail 'fixture remote directory'
  printf 'schema_version=1\n' > "$fixture_root/.nuinui-e2e-fixture"
  printf '<!doctype html><title>fixture only</title>\n' > "$fixture_file"
  git init --bare --initial-branch=main -q "$fixture_remote" || fail 'bare fixture repository'
  git init -b main -q "$fixture_impl" || fail 'implementation repository'
  git -C "$fixture_impl" config user.name 'nuinui-e2e host fixture'
  git -C "$fixture_impl" config user.email 'nuinui-e2e-host-fixture@example.invalid'
  printf 'base\n' > "$fixture_impl/fixture.txt"
  git -C "$fixture_impl" add fixture.txt
  git -C "$fixture_impl" commit -q -m 'fixture base' || fail 'fixture commit'
  git -C "$fixture_impl" remote add origin "$fixture_remote"
  git -C "$fixture_impl" push -q origin main || fail 'fixture push'
  fixture_tested_sha=$(git -C "$fixture_impl" rev-parse HEAD)
  printf 'version=1\n' > "$(git -C "$fixture_impl" rev-parse --absolute-git-dir)/nuinui-implementation-v1"
  if [ "$mode" = one ]; then
    git -C "$fixture_impl" worktree add --detach -q "$fixture_human" "$fixture_tested_sha" || fail 'Human-test worktree'
  fi
  {
    printf 'version=1\nrepository=sayosomi/nuinuiCAD\ndefault_branch=main\n'
    printf '\n[lane implementation]\nrole=implementation\npath=%s\nidle=branch\n' "$fixture_impl"
    if [ "$mode" = one ]; then
      printf '\n[lane human]\nrole=human-test\npath=%s\nidle=detached\n' "$fixture_human"
    fi
  } > "$fixture_manifest"
}

new_production_root_fixture() {
  new_fixture one
  host_test_root_mode=production
  host_test_home=$fixture_root/private-home
  mkdir -m 0700 "$host_test_home" || fail 'production-root test HOME'
}

call_helper() {
  if [ "${fixture_trace_helper:-no}" = yes ]; then
    set -- /bin/sh -x "$helper" "$@"
  else
    set -- "$helper" "$@"
  fi
  if [ "$host_test_root_mode" = production ]; then
    env HOME="$host_test_home" NUINUI_E2E_TEST_PRODUCTION_HOST_ROOT=yes \
      "$@"
  else
    "$@"
  fi
}

advance_default() {
  printf 'advance %s\n' "$1" >> "$fixture_impl/fixture.txt"
  git -C "$fixture_impl" add fixture.txt
  git -C "$fixture_impl" commit -q -m "fixture advance $1" || fail 'advance fixture default'
  git -C "$fixture_impl" push -q origin main || fail 'push fixture default'
  fixture_tested_sha=$(git -C "$fixture_impl" rev-parse HEAD)
}

invoke() {
  command_name=$1
  issue=$2
  generation=$3
  lane=$4
  tested=$5
  if [ -n "$lane" ]; then
    call_helper "$command_name" --self-test --manifest "$fixture_manifest" \
      --issue "$issue" --generation "$generation" --tested-sha "$tested" \
      --lane "$lane" >"$output" 2>&1
  else
    call_helper "$command_name" --self-test --manifest "$fixture_manifest" \
      --issue "$issue" --generation "$generation" --tested-sha "$tested" \
      >"$output" 2>&1
  fi
}

invoke_host() {
  command_name=$1
  issue=$2
  generation=$3
  lane=$4
  tested=$5
  if [ "$command_name" = host-check ] || [ "$command_name" = host-prepare ]; then
    fixture=$6
    port=$7
    locale=${8:-default}
    if [ -n "$lane" ]; then
      call_helper "$command_name" --self-test --manifest "$fixture_manifest" \
        --issue "$issue" --generation "$generation" --tested-sha "$tested" \
        --lane "$lane" --fixture "$fixture" --port "$port" --locale "$locale" \
        >"$output" 2>&1
    else
      call_helper "$command_name" --self-test --manifest "$fixture_manifest" \
        --issue "$issue" --generation "$generation" --tested-sha "$tested" \
        --fixture "$fixture" --port "$port" --locale "$locale" >"$output" 2>&1
    fi
  elif [ -n "$lane" ]; then
    call_helper "$command_name" --self-test --manifest "$fixture_manifest" \
      --issue "$issue" --generation "$generation" --tested-sha "$tested" \
      --lane "$lane" >"$output" 2>&1
  else
    call_helper "$command_name" --self-test --manifest "$fixture_manifest" \
      --issue "$issue" --generation "$generation" --tested-sha "$tested" \
      >"$output" 2>&1
  fi
}

ok() {
  if ! invoke "$@"; then
    cat "$output" >&2
    fail "command failed: $1"
  fi
}

host_ok() {
  if ! invoke_host "$@"; then
    cat "$output" >&2
    fail "host command failed: $1"
  fi
}

blocked() {
  if invoke "$@"; then
    fail "command unexpectedly succeeded: $1"
  fi
  grep -Eq 'BLOCKED|blocked|ERROR:' "$output" || fail "refusal was unexplained: $1"
}

host_blocked() {
  if invoke_host "$@"; then
    fail "host command unexpectedly succeeded: $1"
  fi
  grep -Eq 'BLOCKED|blocked|ERROR:' "$output" || fail "host refusal was unexplained: $1"
}

host_failpoint() {
  failpoint=$1
  shift
  if NUINUI_E2E_TEST_FAILPOINT=$failpoint invoke_host "$@"; then
    fail "host failpoint did not interrupt: $failpoint"
  fi
  contains 'interruption'
}

active_path() {
  printf '%s/nuinui-github-e2e-active-v1\n' \
    "$(git -C "$fixture_human" rev-parse --absolute-git-dir)"
}

host_path() {
  kind=$1
  generation=$2
  printf '%s/nuinui-github-e2e-host-%s-v1.%s\n' \
    "$(git -C "$fixture_human" rev-parse --absolute-git-dir)" "$kind" \
    "$(printf '%s\n' "$generation" | shasum -a 256 | awk 'NR == 1 {print $1}')"
}

native_path() {
  kind=$1
  generation=$2
  printf '%s/nuinui-github-e2e-%s-v1.%s\n' \
    "$(git -C "$fixture_human" rev-parse --absolute-git-dir)" "$kind" \
    "$(printf '%s\n' "$generation" | shasum -a 256 | awk 'NR == 1 {print $1}')"
}

host_root_path() {
  if [ "$host_test_root_mode" = production ]; then
    printf '%s/.nuinuicad/e2e-hosts/.nuinui-e2e-host-%.12s\n' "$host_test_home" \
      "$(printf '%s\n' "$1" | shasum -a 256 | awk 'NR == 1 {print $1}')"
  else
    printf '%s/.nuinui-e2e-host-%s\n' "$fixture_root" \
      "$(printf '%s\n' "$1" | shasum -a 256 | awk 'NR == 1 {print $1}')"
  fi
}

host_generation_fingerprint() {
  generation=$1
  for kind in intent handoff ready cleanup-pending cleanup; do
    record=$(host_path "$kind" "$generation")
    if [ -e "$record" ] || [ -L "$record" ]; then
      printf '%s ' "$kind"
      shasum -a 256 "$record"
    else
      printf '%s absent\n' "$kind"
    fi
  done
}

close_recovered_generation() {
  recovered_generation=$1
  next_generation=$2
  advance_label=$3
  host_ok host-recover "$fixture_issue" "$recovered_generation" human \
    "$fixture_tested_sha"
  contains 'HOST FIXTURE RECOVERED FROM'
  if ! invoke host-closure "$fixture_issue" "$recovered_generation" human \
    "$fixture_tested_sha"; then
    cat "$output" >&2
    fail "recovered generation did not close: $recovered_generation"
  fi
  contains 'NATIVE E2E FINAL CLOSURE VERIFIED'
  [ ! -e "$(active_path)" ] || fail 'recovered closure retained the active marker'
  [ -z "$(git -C "$fixture_human" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" ] ||
    fail 'recovered closure left the checkout on a named branch'
  [ -z "$(git -C "$fixture_human" status --porcelain)" ] ||
    fail 'recovered closure left a dirty checkout'
  recovered_records=$(host_generation_fingerprint "$recovered_generation")
  advance_default "$advance_label"
  next_tested_sha=$fixture_tested_sha
  ok start "$fixture_issue" "$next_generation" human "$next_tested_sha"
  contains 'NATIVE E2E FIXTURE STARTED'
  host_ok host-status "$fixture_issue" "$next_generation" human "$next_tested_sha"
  contains 'HOST SESSION ABSENT'
  [ "$(host_generation_fingerprint "$recovered_generation")" = \
    "$recovered_records" ] ||
    fail "next generation changed or adopted recovered generation $recovered_generation"
}

complete_recovered_generation() {
  recovered_generation=$1
  next_generation=$2
  recovery_failpoint=$3
  advance_label=$4
  host_failpoint "$recovery_failpoint" host-prepare "$fixture_issue" \
    "$recovered_generation" human "$fixture_tested_sha" "$fixture_file" 43123
  close_recovered_generation "$recovered_generation" "$next_generation" \
    "$advance_label"
}

host_root_inventory() {
  find "$fixture_root" -name '.nuinui-e2e-host-*' -print |
    LC_ALL=C sort | while IFS= read -r inventory_root; do
      [ -n "$inventory_root" ] || continue
      if [ -L "$inventory_root" ]; then
        printf 'root-symlink %s -> %s\n' "$inventory_root" "$(readlink "$inventory_root")"
        continue
      fi
      if [ -d "$inventory_root" ]; then
        printf 'root-dir %s %s\n' "$inventory_root" \
          "$(stat -f '%d:%i:%Sp' "$inventory_root")"
        find "$inventory_root" -mindepth 1 -print |
          LC_ALL=C sort | while IFS= read -r inventory_entry; do
            [ -n "$inventory_entry" ] || continue
            if [ -L "$inventory_entry" ]; then
              printf 'symlink %s -> %s\n' "$inventory_entry" "$(readlink "$inventory_entry")"
            elif [ -f "$inventory_entry" ]; then
              printf 'file %s %s %s\n' "$inventory_entry" \
                "$(stat -f '%d:%i:%Sp' "$inventory_entry")" \
                "$(shasum -a 256 "$inventory_entry" | awk 'NR == 1 {print $1}')"
            elif [ -d "$inventory_entry" ]; then
              printf 'dir %s %s\n' "$inventory_entry" \
                "$(stat -f '%d:%i:%Sp' "$inventory_entry")"
            else
              printf 'other %s %s\n' "$inventory_entry" \
                "$(stat -f '%d:%i:%Sp' "$inventory_entry")"
            fi
          done
      else
        printf 'root-other %s %s\n' "$inventory_root" \
          "$(stat -f '%d:%i:%Sp' "$inventory_root")"
      fi
    done
}

fingerprint() {
  git_dir=$(git -C "$fixture_human" rev-parse --absolute-git-dir)
  find "$git_dir" -maxdepth 1 -name 'nuinui-github-e2e-*' -print |
    LC_ALL=C sort | while IFS= read -r path; do
      if [ -L "$path" ]; then
        printf 'symlink %s -> %s\n' "$path" "$(readlink "$path")"
      elif [ -f "$path" ]; then
        printf 'file %s %s\n' "$path" \
          "$(shasum -a 256 "$path" | awk 'NR == 1 {print $1}')"
      else
        printf 'other %s\n' "$path"
      fi
    done
  host_root_inventory
}

# Focused exit-path check without running the longer host lifecycle suite.
if [ "${NUINUI_E2E_HOST_TEST_CASE:-all}" = closure ] ||
  [ "${NUINUI_E2E_HOST_TEST_CASE:-all}" = critical-path ]; then
  if [ "${NUINUI_E2E_HOST_TEST_CASE:-all}" = critical-path ]; then
    new_production_root_fixture
  else
    new_fixture one
  fi
  ok start "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
  host_ok host-prepare "$fixture_issue" "$fixture_generation" human \
    "$fixture_tested_sha" "$fixture_file" 43123 default
  host_ok host-cleanup "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
  closure_tested_sha=$fixture_tested_sha
  advance_default closure-idle
  closure_idle_sha=$fixture_tested_sha
  fixture_tested_sha=$closure_tested_sha
  fixture_trace_helper=yes
  call_helper host-closure --self-test --manifest "$fixture_manifest" \
    --issue "$fixture_issue" --generation "$fixture_generation" \
    --tested-sha "$fixture_tested_sha" --lane human >"$output" 2>&1 || fail 'closure'
  fixture_trace_helper=no
  contains 'HOST AND NATIVE CLOSURE VERIFIED'
  closure_preflights=$(awk '$1 ~ /^\++$/ && $2 == "nuinui_e2e__preflight" {n++} END {print n+0}' "$output")
  [ "$closure_preflights" = 1 ] || fail "closure repeated full preflight: $closure_preflights"
  [ ! -e "$(active_path)" ] &&
    [ ! -e "$(native_path releasing "$fixture_generation")" ] &&
    [ -f "$(native_path release "$fixture_generation")" ] &&
    [ "$(git -C "$fixture_human" rev-parse HEAD)" = "$closure_idle_sha" ] || fail 'closure release boundary'
  host_ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
  contains 'HOST AND NATIVE CLOSURE VERIFIED'

  if [ "${NUINUI_E2E_HOST_TEST_CASE:-all}" = critical-path ]; then
    completion=$(native_path release "$fixture_generation")
    cp "$completion" "$fixture_root/completion.saved"
    completion_before=$(shasum -a 256 "$completion")
    printf 'broken completion\n' > "$completion"
    blocked start "$fixture_issue" host-closure-next-0001 human "$closure_idle_sha"
    cp "$fixture_root/completion.saved" "$completion"
    mv "$completion" "$fixture_root/completion.missing"
    blocked start "$fixture_issue" host-closure-next-0001 human "$closure_idle_sha"
    mv "$fixture_root/completion.missing" "$completion"

    # A stale root is still a conflict, including the former long HOME path.
    stale_root=$(printf '%s/.nuinuicad/e2e-hosts/.nuinui-e2e-host-%s' "$host_test_home" \
      "$(printf '%s\n' "$fixture_generation" | shasum -a 256 | awk '{print $1}')")
    mkdir "$stale_root"
    blocked start "$fixture_issue" host-closure-next-0001 human "$closure_idle_sha"
    [ -d "$stale_root" ] || fail 'startup removed a conflicting old root'
    rmdir "$stale_root"

    # Completion alone is sufficient; retired preparation details are optional.
    for retired_kind in intent handoff ready cleanup-pending cleanup; do
      rm -f "$(host_path "$retired_kind" "$fixture_generation")"
    done
    rm "$(native_path cleanup "$fixture_generation")"
    blocked start "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
    [ "$(shasum -a 256 "$completion")" = "$completion_before" ] || fail 'completion record changed'
  fi

  # Start B with A retained as history, then close directly from READY.
  fixture_generation=host-closure-next-0001
  fixture_tested_sha=$closure_idle_sha
  ok start "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
  host_ok host-prepare "$fixture_issue" "$fixture_generation" human \
    "$fixture_tested_sha" "$fixture_file" 43123 default
  if [ "${NUINUI_E2E_HOST_TEST_CASE:-all}" = critical-path ]; then
    current_root=$(host_root_path "$fixture_generation")
    printf 'preserve\n' > "$current_root/foreign.txt"
    host_blocked host-cleanup "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
    [ -f "$current_root/foreign.txt" ] || fail 'cleanup removed foreign data'
    rm "$current_root/foreign.txt"
  fi
  host_ok host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
  contains 'HOST FIXTURE CLEANUP VERIFIED'
  contains 'HOST AND NATIVE CLOSURE VERIFIED'
  [ ! -e "$(active_path)" ] &&
    [ ! -e "$(host_root_path "$fixture_generation")" ] || fail 'direct closure cleanup'
  echo 'HOST CLOSURE SELFTEST PASS (one full preflight; cleaned, duplicate and ready paths)'
  exit 0
fi

# Zero Human-test lanes and strict host-specific CLI parsing.
new_fixture zero
host_blocked host-check "$fixture_issue" "$fixture_generation" '' \
  "$fixture_tested_sha" "$fixture_file" 43123
host_blocked host-prepare "$fixture_issue" "$fixture_generation" '' \
  "$fixture_tested_sha" "$fixture_file" 43123
if "$helper" host-check --self-test --manifest "$fixture_manifest" \
  --issue "$fixture_issue" --generation "$fixture_generation" \
  --tested-sha "$fixture_tested_sha" --fixture "$fixture_file" >"$output" 2>&1; then
  fail 'host-check accepted a missing explicit port'
fi
contains '--port is required'
if "$helper" host-status --self-test --manifest "$fixture_manifest" \
  --issue "$fixture_issue" --generation "$fixture_generation" \
  --tested-sha "$fixture_tested_sha" --fixture "$fixture_file" >"$output" 2>&1; then
  fail 'host-status accepted contradictory host-only options'
fi
contains 'only valid for host-check and host-prepare'

# Exact admission and read-only host-check, including fixture and port checks.
new_fixture one
stale_checkout_sha=$fixture_tested_sha
advance_default host-tested-revision
host_blocked host-check "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43123
ok start "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
ln -s "$fixture_file" "$fixture_root/fixture-link.html"
host_blocked host-check "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_root/fixture-link.html" 43123
printf '<html>inside checkout</html>\n' > "$fixture_human/inside.html"
host_blocked host-check "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_human/inside.html" 43123
rm "$fixture_human/inside.html"
for invalid_port in 0 0001 65536 999999999999999; do
  host_blocked host-check "$fixture_issue" "$fixture_generation" human \
    "$fixture_tested_sha" "$fixture_file" "$invalid_port"
done
host_blocked host-check "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43123 invalid-locale

before=$(fingerprint)
host_ok host-check "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43123
contains 'state=ABSENT'
[ "$(fingerprint)" = "$before" ] || fail 'host-check mutated metadata'
host_ok host-prepare "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43123
contains 'fixture-no-process'
contains 'no Human Manual E2E was run'
host_ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION READY'
intent=$(host_path intent "$fixture_generation")
handoff=$(host_path handoff "$fixture_generation")
ready=$(host_path ready "$fixture_generation")
for record in "$intent" "$handoff" "$ready"; do
  [ -f "$record" ] && [ ! -L "$record" ] || fail "missing strict host record: $record"
  grep -Fqx "issue=$fixture_issue" "$record" || fail 'canonical Issue binding missing'
  grep -Fqx 'local_id=GH-sayosomi-nuinuiCAD-268' "$record" || fail 'native token binding missing'
  grep -Fqx "tested_sha=$fixture_tested_sha" "$record" || fail 'tested SHA binding missing'
  grep -Fqx "generation=$fixture_generation" "$record" || fail 'generation binding missing'
  grep -Fqx 'adapter=fixture-no-process' "$record" || fail 'fixture-only adapter mode missing'
done
grep -Fqx "fixture_path=$fixture_file" "$handoff" || fail 'handoff fixture identity missing'
grep -Fqx 'port=43123' "$handoff" || fail 'handoff port missing'
grep -Fqx 'locale=default' "$handoff" || fail 'default locale was not explicit'
grep -Fqx 'record_state=READY' "$ready" || fail 'READY state missing'

# Duplicate prepare is a verified read-only no-op; mismatched identity is isolated.
before=$(fingerprint)
host_ok host-prepare "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43123
contains 'mutation=no-op'
[ "$(fingerprint)" = "$before" ] || fail 'duplicate host-prepare mutated records'
host_blocked host-prepare "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43124
host_blocked host-prepare "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43123 ja

# Read-only checks and an exact duplicate remain read-only with a non-writable root.
readonly_host_root=$(host_root_path "$fixture_generation")
[ -d "$readonly_host_root" ] || fail 'ready host root is missing for read-only proof'
chmod 555 "$readonly_host_root"
before=$(fingerprint)
host_ok host-check "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43123
contains 'state=READY'
host_ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION READY'
host_ok host-prepare "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43123
contains 'mutation=no-op'
[ "$(fingerprint)" = "$before" ] || fail 'read-only checks changed the host-root or metadata inventory'
if find "$readonly_host_root" -mindepth 1 -maxdepth 1 \
  \( -name '.owner-verify.*' -o -name '.owner-remove.*' \) -print | grep -q .; then
  fail 'read-only checks left an owner verification artifact'
fi
chmod 755 "$readonly_host_root"

# A malformed READY record is rejected read-only and cannot be repaired or adopted.
ready=$(host_path ready "$fixture_generation")
ready_backup=$fixture_root/ready.backup
cp "$ready" "$ready_backup"
before=$(fingerprint)
printf 'schema_version=foreign\n' > "$ready"
host_blocked host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
cp "$ready_backup" "$ready"
[ "$(fingerprint)" = "$before" ] || fail 'malformed metadata was changed or silently repaired'
rm "$ready_backup"
host_blocked host-status 'sayosomi/nuinuiCAD#269' "$fixture_generation" human "$fixture_tested_sha"
host_blocked host-status "$fixture_issue" 'other-generation-0001' human "$fixture_tested_sha"
before=$(fingerprint)
host_blocked host-status "$fixture_issue" 'other-generation-0001' human "$fixture_tested_sha"
[ "$(fingerprint)" = "$before" ] || fail 'unrelated generation changed host artifacts'
if invoke host-status "$fixture_issue" "$fixture_generation" human \
  '0000000000000000000000000000000000000000'; then
  fail 'wrong tested SHA matched active host generation'
fi

# Legacy ownership and unsafe checkout/resource states block without adoption or deletion.
git_dir=$(git -C "$fixture_human" rev-parse --absolute-git-dir)
printf 'issue=SAY-268\n' > "$git_dir/nuinui-slot"
host_blocked host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
[ "$(cat "$git_dir/nuinui-slot")" = 'issue=SAY-268' ] || fail 'legacy SAY metadata changed'
rm "$git_dir/nuinui-slot"
printf 'dirty\n' >> "$fixture_human/fixture.txt"
host_blocked host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
git -C "$fixture_human" checkout -- fixture.txt
git -C "$fixture_human" switch -c fixture-named-branch >/dev/null 2>&1
host_blocked host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
git -C "$fixture_human" switch --detach "$fixture_tested_sha" >/dev/null 2>&1
git -C "$fixture_human" switch --detach "$stale_checkout_sha" >/dev/null 2>&1
host_blocked host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
git -C "$fixture_human" switch --detach "$fixture_tested_sha" >/dev/null 2>&1
host_root=$(awk -F= '$1 == "root" {print substr($0, 6)}' "$ready")
printf 'foreign\n' > "$host_root/foreign.txt"
host_blocked host-cleanup "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
[ -f "$host_root/foreign.txt" ] || fail 'cleanup deleted an unexpected resource'
rm "$host_root/foreign.txt"
ln -s "$fixture_file" "$host_root/foreign-link"
host_blocked host-cleanup "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
[ -L "$host_root/foreign-link" ] || fail 'cleanup removed an unowned symlink'
rm "$host_root/foreign-link"
blocked cleanup-proof "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"

# Cleanup intent precedes deletion; its receipt is bound into native cleanup evidence.
host_ok host-cleanup "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST FIXTURE CLEANUP VERIFIED'
[ ! -e "$host_root" ] && [ ! -L "$host_root" ] || fail 'host root remains after verified cleanup'
cleanup_receipt=$(host_path cleanup "$fixture_generation")
[ -f "$cleanup_receipt" ] || fail 'durable host cleanup receipt missing'
native_cleanup=$(printf '%s/nuinui-github-e2e-cleanup-v1.%s\n' "$git_dir" \
  "$(printf '%s\n' "$fixture_generation" | shasum -a 256 | awk 'NR == 1 {print $1}')")
grep -Fqx 'proof=fixture-host-session-cleaned' "$native_cleanup" || fail 'native proof did not bind host cleanup'
host_ok host-cleanup "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'mutation=no-op'
host_ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION CLEANED'

# An already cleaned host proceeds directly to native release and final closure.
if ! invoke host-closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"; then
  cat "$output" >&2
  fail 'checked host closure failed'
fi
release_line=$(grep -n 'NATIVE E2E FIXTURE RELEASED' "$output" | cut -d: -f1)
closure_line=$(grep -n 'NATIVE E2E FINAL CLOSURE VERIFIED' "$output" | cut -d: -f1)
[ -n "$release_line" ] && [ -n "$closure_line" ] &&
  [ "$release_line" -lt "$closure_line" ] ||
  fail 'host closure stages ran out of order'
host_ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION RELEASED'
[ ! -e "$(active_path)" ] || fail 'released generation retained active marker'
[ -z "$(git -C "$fixture_human" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" ] ||
  fail 'closure left the checkout on a named branch'
[ -z "$(git -C "$fixture_human" status --porcelain)" ] || fail 'closure left a dirty checkout'
case "$(host_root_path "$fixture_generation")" in
  "$fixture_root"/.nuinui-e2e-host-*) ;;
  *) fail 'self-test host root no longer uses its disposable fixture root' ;;
esac

# A completed generation remains historical evidence while the same lane starts B.
# Its external fixture may be gone after closure; its durable cleanup/release proof remains.
historical_a_records=$(host_generation_fingerprint "$fixture_generation")
rm "$fixture_file"
advance_default after-completed-generation-a
fixture_generation_b=host-fixture-gen-0002
fixture_tested_sha_b=$fixture_tested_sha
ok start "$fixture_issue" "$fixture_generation_b" human "$fixture_tested_sha_b"
contains 'NATIVE E2E FIXTURE STARTED'
ok status "$fixture_issue" "$fixture_generation_b" human "$fixture_tested_sha_b"
contains 'NATIVE E2E ACTIVE'
host_ok host-status "$fixture_issue" "$fixture_generation_b" human "$fixture_tested_sha_b"
contains 'HOST SESSION ABSENT'
[ "$(host_generation_fingerprint "$fixture_generation")" = \
  "$historical_a_records" ] || fail 'generation B changed or adopted generation A host records'
[ ! -e "$(host_root_path "$fixture_generation")" ] &&
  [ ! -L "$(host_root_path "$fixture_generation")" ] ||
  fail 'completed generation A retained its host root'

# Incomplete historical host evidence blocks B even if the active marker is missing.
new_fixture one
incomplete_a_generation=host-fixture-incomplete-a-0001
incomplete_b_generation=host-fixture-incomplete-b-0001
ok start "$fixture_issue" "$incomplete_a_generation" human "$fixture_tested_sha"
host_ok host-prepare "$fixture_issue" "$incomplete_a_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43123
incomplete_a_records=$(host_generation_fingerprint "$incomplete_a_generation")
rm "$(active_path)" # Model ambiguous/lost native ownership in this disposable fixture only.
before=$(fingerprint)
advance_default after-incomplete-generation-a
if invoke start "$fixture_issue" "$incomplete_b_generation" human "$fixture_tested_sha"; then
  fail 'generation B started while generation A host evidence was incomplete'
fi
contains 'host-session-state-conflict'
[ "$(fingerprint)" = "$before" ] ||
  fail 'blocked generation B changed the incomplete host-root or metadata inventory'
[ "$(host_generation_fingerprint "$incomplete_a_generation")" = \
  "$incomplete_a_records" ] || fail 'blocked generation B changed generation A host records'
[ -d "$(host_root_path "$incomplete_a_generation")" ] ||
  fail 'blocked generation B removed generation A host resources'

# Safe recovery from an interrupted PREPARING state and a pending cleanup.
new_fixture one
recovered_resources=host-fixture-recovered-resources-0001
after_resources_next=host-fixture-after-resources-next-0001
after_intent_next=host-fixture-after-intent-next-0001
ok start "$fixture_issue" "$recovered_resources" human "$fixture_tested_sha"
host_failpoint after-host-resources host-prepare "$fixture_issue" \
  "$recovered_resources" human "$fixture_tested_sha" "$fixture_file" 43123
preparing_root=$(awk -F= '$1 == "root" {print substr($0, 6)}' \
  "$(host_path intent "$recovered_resources")")
chmod 555 "$preparing_root"
before=$(fingerprint)
host_ok host-status "$fixture_issue" "$recovered_resources" human "$fixture_tested_sha"
contains 'HOST SESSION PREPARING'
[ "$(fingerprint)" = "$before" ] || fail 'PREPARING status changed the host-root inventory'
if find "$preparing_root" -mindepth 1 -maxdepth 1 \
  \( -name '.owner-verify.*' -o -name '.owner-remove.*' \) -print | grep -q .; then
  fail 'PREPARING status left an owner verification artifact'
fi
chmod 755 "$preparing_root"
close_recovered_generation "$recovered_resources" "$after_resources_next" \
  after-resources-recovery

# A preparation interrupted immediately after durable intent also closes and releases.
complete_recovered_generation "$after_resources_next" "$after_intent_next" \
  after-host-intent after-intent-recovery

# Corrupt completion proof and missing native release receipt must both block B.
host_ok host-prepare "$fixture_issue" "$after_intent_next" human \
  "$fixture_tested_sha" "$fixture_file" 43123
if ! invoke host-closure "$fixture_issue" "$after_intent_next" human \
  "$fixture_tested_sha"; then
  cat "$output" >&2
  fail 'ready generation could not close before final-evidence refusals'
fi
contains 'NATIVE E2E FINAL CLOSURE VERIFIED'
recovered_native_completion=$(native_path release "$recovered_resources")
recovered_native_release=$(native_path release "$recovered_resources")
cp "$recovered_native_completion" "$fixture_root/completion.saved" ||
  fail 'could not save disposable completion receipt'
printf 'corrupt evidence\n' > "$recovered_native_completion"
advance_default after-corrupt-completion-proof
before=$(fingerprint)
if invoke start "$fixture_issue" host-fixture-block-corrupt-proof-0001 \
  human "$fixture_tested_sha"; then
  fail 'generation started with corrupted completion receipt'
fi
contains 'PREFLIGHT BLOCKED'
[ "$(fingerprint)" = "$before" ] ||
  fail 'blocked start changed metadata while completion receipt was corrupt'
cp "$fixture_root/completion.saved" "$recovered_native_completion" ||
  fail 'could not restore disposable completion receipt'
rm "$recovered_native_release"
advance_default after-missing-native-release-receipt
before=$(fingerprint)
if invoke start "$fixture_issue" host-fixture-block-missing-release-0001 \
  human "$fixture_tested_sha"; then
  fail 'generation started with missing native release receipt'
fi
contains 'PREFLIGHT BLOCKED'
[ "$(fingerprint)" = "$before" ] ||
  fail 'blocked start changed metadata while native release receipt was missing'

new_fixture one
ok start "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
host_ok host-prepare "$fixture_issue" "$fixture_generation" human \
  "$fixture_tested_sha" "$fixture_file" 43123
host_failpoint after-host-cleanup-pending host-cleanup "$fixture_issue" \
  "$fixture_generation" human "$fixture_tested_sha"
host_ok host-status "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST SESSION CLEANUP-PENDING'
host_failpoint after-host-resource-removal host-cleanup "$fixture_issue" \
  "$fixture_generation" human "$fixture_tested_sha"
host_ok host-recover "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
contains 'HOST FIXTURE RECOVERED FROM CLEANUP-PENDING'
host_ok release "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
host_ok closure "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
pending_a_records=$(host_generation_fingerprint "$fixture_generation")
advance_default after-recovered-cleanup-pending
after_pending_next=host-fixture-after-pending-next-0001
ok start "$fixture_issue" "$after_pending_next" human "$fixture_tested_sha"
contains 'NATIVE E2E FIXTURE STARTED'
[ "$(host_generation_fingerprint "$fixture_generation")" = \
  "$pending_a_records" ] ||
  fail 'next generation changed or adopted cleanup-pending generation A records'
handoff_next=host-fixture-after-handoff-next-0001
complete_recovered_generation "$after_pending_next" "$handoff_next" \
  after-host-handoff after-handoff-recovery

# A foreign root at the deterministic path is never adopted or removed.
new_fixture one
ok start "$fixture_issue" "$fixture_generation" human "$fixture_tested_sha"
host_failpoint after-host-intent host-prepare "$fixture_issue" \
  "$fixture_generation" human "$fixture_tested_sha" "$fixture_file" 43123
orphan_root=$fixture_root/.nuinui-e2e-host-$(printf '%s\n' "$fixture_generation" |
  shasum -a 256 | awk 'NR == 1 {print $1}')
mkdir "$orphan_root"
printf 'foreign\n' > "$orphan_root/foreign.txt"
