#!/bin/sh
set -eu

SOURCE_HELPER=${1:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/nuinui}
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
SOURCE_HANDOFF_CHECK=$SCRIPT_DIR/nuinui-handoff-check
ROOT=$(CDPATH= cd -- "$(mktemp -d /tmp/nuinui-handoff.XXXXXX)" && pwd -P)
trap 'rm -rf "$ROOT"' EXIT HUP INT TERM

fail() { echo "HANDOFF TEST FAIL: $*" >&2; exit 1; }
assert_contains() { printf '%s\n' "$1" | grep -Fq -- "$2" || fail "$3"; }
assert_not_contains() { if printf '%s\n' "$1" | grep -Fq -- "$2"; then fail "$3"; fi; }

PROJECT=$ROOT/project
HELPER=$PROJECT/scripts/nuinui
HANDOFF_CHECK=$PROJECT/scripts/nuinui-handoff-check
REMOTE=$ROOT/sayosomi/nuinuiCAD.git
SEED=$ROOT/seed
MAIN=$ROOT/main
OTHER=$ROOT/other
CONTEXT=$ROOT/context
MANIFEST=$PROJECT/LANES.conf
CHECK_WRAPPER=$ROOT/handoff-check-wrapper
CHECK_COUNT=$ROOT/handoff-check-count
HANDOFF_ARGS=$ROOT/handoff-args
SECOND_DRIFT=$ROOT/second-drift

mkdir -p "$PROJECT/scripts" "$ROOT/cwd" "$ROOT/fake"
cp "$SOURCE_HELPER" "$HELPER"
cp "$SOURCE_HANDOFF_CHECK" "$HANDOFF_CHECK"
chmod 755 "$HELPER" "$HANDOFF_CHECK"

git init -q --bare "$REMOTE"
git init -q -b main "$SEED"
git -C "$SEED" config user.name test
git -C "$SEED" config user.email test@example.invalid
printf '%s\n' base >"$SEED/base.txt"
git -C "$SEED" add base.txt
git -C "$SEED" commit -qm base
git -C "$SEED" remote add origin "$REMOTE"
git -C "$SEED" push -qu origin main
git clone -q "$REMOTE" "$MAIN"
git -C "$MAIN" config user.name test
git -C "$MAIN" config user.email test@example.invalid
git -C "$MAIN" worktree add -q --detach "$OTHER" origin/main
git -C "$MAIN" switch -q --detach origin/main
git init -q "$CONTEXT"

printf '%s\n' \
  'version=1' \
  'repository=sayosomi/nuinuiCAD' \
  'default_branch=main' \
  '' \
  '[lane alpha]' \
  'role=implementation' \
  "path=$MAIN" \
  'idle=detached' \
  '' \
  '[lane beta]' \
  'role=implementation' \
  "path=$OTHER" \
  'idle=detached' >"$MANIFEST"

cat >"$CHECK_WRAPPER" <<'EOF'
#!/bin/sh
count=0
[ -f "$NUINUI_HANDOFF_COUNTER" ] && count=$(cat "$NUINUI_HANDOFF_COUNTER")
count=$((count + 1))
printf '%s\n' "$count" >"$NUINUI_HANDOFF_COUNTER"
printf '%s\n' "$@" >"$NUINUI_HANDOFF_ARGS"
if [ "${NUINUI_HANDOFF_DRIFT_MAIN:-0}" = 1 ]; then
  printf '%s\n' drift >"$NUINUI_HANDOFF_DRIFT_SEED/drift.txt"
  git -C "$NUINUI_HANDOFF_DRIFT_SEED" add drift.txt
  git -C "$NUINUI_HANDOFF_DRIFT_SEED" commit -qm drift
  git -C "$NUINUI_HANDOFF_DRIFT_SEED" push -q origin main
fi
exec "$NUINUI_HANDOFF_REAL_HELPER" "$@"
EOF
chmod 755 "$CHECK_WRAPPER"

export NUINUI_SELFTEST=1
export NUINUI_SELFTEST_MANIFEST=$MANIFEST
export NUINUI_SELFTEST_RESULT_REPO=$CONTEXT
export NUINUI_DEV_CONTEXT_WT=$CONTEXT
export NUINUI_DEV_CONTEXT_DEV_WT=$CONTEXT
export NUINUI_HANDOFF_CHECK_HELPER=$CHECK_WRAPPER
export NUINUI_HANDOFF_REAL_HELPER=$HANDOFF_CHECK
export NUINUI_HANDOFF_COUNTER=$CHECK_COUNT
export NUINUI_HANDOFF_ARGS=$HANDOFF_ARGS
export NUINUI_HANDOFF_DRIFT_SEED=$SEED
NUINUI_HANDOFF_DRIFT_MAIN=0
export NUINUI_HANDOFF_DRIFT_MAIN

cd "$ROOT/cwd"
"$HELPER" lane-init alpha >/dev/null
"$HELPER" lane-init beta >/dev/null

BASE=$(git -C "$MAIN" rev-parse origin/main)
assert_no_mutation() {
  before_branch=$1
  before_head=$2
  before_status=$3
  before_refs=$4
  output=$5
  [ "$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" = "$before_branch" ] ||
    fail "$output changed the primary branch"
  [ "$(git -C "$MAIN" rev-parse HEAD)" = "$before_head" ] || fail "$output changed primary HEAD"
  [ "$(git -C "$MAIN" status --porcelain)" = "$before_status" ] || fail "$output changed the primary working tree"
  [ "$(git -C "$MAIN" for-each-ref --format='%(refname) %(objectname)' | sort)" = "$before_refs" ] ||
    fail "$output changed primary refs"
}

reset_generation() {
  git -C "$MAIN" switch -q --detach "$BASE" 2>/dev/null || true
  git -C "$OTHER" switch -q --detach "$BASE" 2>/dev/null || true
  for branch in sayosomi/say-181-alpha sayosomi/say-181-beta; do
    git -C "$MAIN" branch -D "$branch" >/dev/null 2>&1 || true
    git -C "$MAIN" push -q origin --delete "$branch" >/dev/null 2>&1 || true
  done
  for repo in "$MAIN" "$OTHER"; do
    gitdir=$(git -C "$repo" rev-parse --absolute-git-dir)
    rm -rf "$gitdir/nuinui-implementation-slot" \
      "$gitdir/nuinui-implementation-lock" \
      "$gitdir"/nuinui-implementation-slot.releasing.*
  done
  rm -f "$CHECK_COUNT" "$HANDOFF_ARGS" "$SECOND_DRIFT"
  NUINUI_HANDOFF_DRIFT_MAIN=0
  export NUINUI_HANDOFF_DRIFT_MAIN
}

start_alpha() {
  reset_generation
  git -C "$MAIN" fetch -q origin main
  BASE=$(git -C "$MAIN" rev-parse origin/main)
  git -C "$MAIN" switch -q --detach "$BASE"
  "$HELPER" start alpha SAY-181 "$BASE" sayosomi/say-181-alpha >/dev/null
}

expect_blocked() {
  name=$1
  expected=$2
  shift 2
  before_branch=$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  before_head=$(git -C "$MAIN" rev-parse HEAD)
  before_status=$(git -C "$MAIN" status --porcelain)
  before_refs=$(git -C "$MAIN" for-each-ref --format='%(refname) %(objectname)' | sort)
  if output=$("$HELPER" handoff "$@" 2>&1); then
    printf '%s\n' "$output"
    fail "$name unexpectedly succeeded"
  fi
  assert_contains "$output" 'BLOCKED:' "$name did not fail closed"
  assert_contains "$output" "$expected" "$name missed expected diagnostic"
  assert_not_contains "$output" 'IMPLEMENTATION RESUMED' "$name attempted automatic recovery"
  assert_no_mutation "$before_branch" "$before_head" "$before_status" "$before_refs" "$name"
  echo "PASS: $name"
}

[ "$("$HELPER" version)" = 1.13.0 ] || fail 'handoff façade did not use standalone 1.13.0'
HELP_OUTPUT=$($HELPER --help)
assert_contains "$HELP_OUTPUT" 'Usage: nuinui handoff <SAY-N> <expected-main-sha>' \
  'public help omitted Issue-oriented handoff usage'
assert_not_contains "$HELP_OUTPUT" 'h1-24-hex-ticket' \
  'public help still advertises ticket syntax'

start_alpha
EXPECTED_ARGS_OUTPUT=''
SUCCESS_OUTPUT=$($HELPER handoff SAY-181 "$BASE") || fail 'exactly one matching generation did not succeed'
assert_contains "$SUCCESS_OUTPUT" 'HANDOFF VERIFIED' 'successful handoff did not verify'
assert_contains "$(cat "$HANDOFF_ARGS")" 'alpha' 'proof did not receive resolved lane'
assert_contains "$(cat "$HANDOFF_ARGS")" 'SAY-181' 'proof did not receive resolved Issue'
assert_contains "$(cat "$HANDOFF_ARGS")" 'absent' 'proof did not receive derived absent topic mode'
echo 'PASS: exactly one matching durable generation succeeds'

expect_blocked 'no matching Issue' 'no active valid implementation generation matches Issue SAY-999' \
  SAY-999 "$BASE"

"$HELPER" start beta SAY-181 "$BASE" sayosomi/say-181-beta >/dev/null
expect_blocked 'duplicate matching Issue' 'multiple active implementation generations match Issue SAY-181' \
  SAY-181 "$BASE"

reset_generation
BASE=$(git -C "$MAIN" rev-parse origin/main)
git -C "$MAIN" switch -q --detach "$BASE"
"$HELPER" start alpha SAY-181 "$BASE" sayosomi/say-181-alpha >/dev/null
alpha_gitdir=$(git -C "$MAIN" rev-parse --absolute-git-dir)
printf '%s\n' 'version=1' 'issue=SAY-181' 'branch=bad branch' \
  "base=$BASE" 'claim=claim-invalid-12345678' \
  >"$alpha_gitdir/nuinui-implementation-slot/state"
expect_blocked 'malformed durable target identity' 'durable implementation slot is invalid for lane alpha' \
  SAY-181 "$BASE"

start_alpha
printf '%s\n' dirty >>"$MAIN/base.txt"
expect_blocked 'clean-tree safety' 'assigned lane is dirty' SAY-181 "$BASE"
git -C "$MAIN" checkout -q -- base.txt

git -C "$MAIN" switch -q --detach "$BASE"
expect_blocked 'claimed branch safety' 'handoff claimed branch mismatch' SAY-181 "$BASE"

start_alpha
printf '%s\n' local-change >>"$MAIN/local.txt"
git -C "$MAIN" add local.txt
git -C "$MAIN" commit -qm local-change
expect_blocked 'absent remote with HEAD different from Base' \
  'absent remote topic requires current HEAD to equal durable Base' SAY-181 "$BASE"

start_alpha
CHECKPOINT_FILE=$MAIN/continuation.txt
printf '%s\n' checkpoint >"$CHECKPOINT_FILE"
git -C "$MAIN" add continuation.txt
git -C "$MAIN" commit -qm continuation
CHECKPOINT=$(git -C "$MAIN" rev-parse HEAD)
git -C "$MAIN" push -q -u origin sayosomi/say-181-alpha
SUCCESS_OUTPUT=$($HELPER handoff SAY-181 "$BASE") || fail 'exact continuation did not succeed'
assert_contains "$SUCCESS_OUTPUT" 'HANDOFF VERIFIED' 'exact continuation did not verify'
assert_contains "$(cat "$HANDOFF_ARGS")" 'exact' 'proof did not receive derived exact topic mode'
echo 'PASS: exact remote continuation succeeds only at current HEAD'

printf '%s\n' unpushed >>"$MAIN/continuation.txt"
git -C "$MAIN" add continuation.txt
git -C "$MAIN" commit -qm unpushed
expect_blocked 'remote topic mismatch' 'authoritative remote topic does not equal current HEAD' \
  SAY-181 "$BASE"
git -C "$MAIN" switch -q --detach "$CHECKPOINT"

git -C "$SEED" fetch -q origin main
STALE_MAIN=$BASE
printf '%s\n' main-drift >"$SEED/main-drift.txt"
git -C "$SEED" add main-drift.txt
git -C "$SEED" commit -qm main-drift
git -C "$SEED" push -q origin main
start_alpha
expect_blocked 'expected authoritative main mismatch' 'handoff remote default mismatch' \
  SAY-181 "$STALE_MAIN"

start_alpha
NUINUI_HANDOFF_DRIFT_MAIN=1
export NUINUI_HANDOFF_DRIFT_MAIN
expect_blocked 'race-sensitive remote-main change' 'handoff remote default mismatch' SAY-181 "$BASE"

reset_generation
if output=$($HELPER handoff h1-0123456789abcdef01234567 2>&1); then
  printf '%s\n' "$output"
  fail 'h1 ticket syntax unexpectedly succeeded'
fi
assert_contains "$output" 'ERROR: handoff expects exactly an Issue and expected authoritative main SHA' \
  'h1 ticket syntax did not fail as an unsupported public contract'
echo 'PASS: h1 ticket syntax is no longer supported'

if output=$($HELPER handoff SAY-181 2>&1); then
  printf '%s\n' "$output"
  fail 'missing expected-main argument unexpectedly succeeded'
fi
assert_contains "$output" 'Usage: nuinui handoff <SAY-N> <expected-main-sha>' \
  'missing expected-main argument did not fail with new usage'

echo 'HANDOFF TEST PASS'
