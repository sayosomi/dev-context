#!/bin/zsh

VERSION="1.2.1"
SCRIPT_PATH="${ZSH_SCRIPT:-$0}"
E2E_WT="${NUINUI_E2E_PREPARE_WT-/Users/yosomi/Code/nuinuiCAD-e2e}"
VS_CODE_APP="${NUINUI_E2E_VSCODE_APP-/Applications/Visual Studio Code.app}"
DEFAULT_CDP_PORT="${NUINUI_E2E_CDP_PORT-9223}"
E2E_TEMP_PARENT="${NUINUI_E2E_TEMP_PARENT-/private/tmp}"

usage() {
  cat <<'EOF'
Usage:
  nuinui-e2e-prepare check <SAY-123> <tested-ref> <fixture-path>
  nuinui-e2e-prepare prepare <SAY-123> <tested-ref> <fixture-path> [cdp-port]
  nuinui-e2e-prepare status
  nuinui-e2e-prepare cleanup
  nuinui-e2e-prepare closure-check <SAY-123>  # post-release final gate only

Purpose:
  Prepare a deterministic Human Manual E2E environment in the dedicated e2e
  checkout, without mutating product source code or killing unrelated VS Code
  processes.

The tested ref and e2e marker must already be fixed by the E2E lane helper.

Successful Human E2E closure is:
  1. nuinui-e2e-prepare cleanup
  2. nuinui e2e-release
  3. nuinui-e2e-prepare closure-check <Issue>

cleanup removes the prepared session's owned process, temporary root, handoff,
and session metadata, but intentionally preserves the tested same-Issue marker.
The marker is removed by nuinui e2e-release; closure-check is a post-release
final read-only gate only.
EOF
}

block() {
  echo "BLOCKED: $*"
  return 1
}

resolve_existing_path() {
  local input_path="$1"

  command -v realpath >/dev/null 2>&1 || return 1
  realpath "$input_path" 2>/dev/null
}

session_path() {
  local git_dir=""
  git_dir="$(git -C "$E2E_WT" rev-parse --absolute-git-dir 2>/dev/null)" || return 1
  printf '%s/nuinui-e2e-session\n' "$git_dir"
}

marker_path() {
  local git_dir=""
  git_dir="$(git -C "$E2E_WT" rev-parse --absolute-git-dir 2>/dev/null)" || return 1
  printf '%s/nuinui-slot\n' "$git_dir"
}

metadata_value() {
  local metadata="$1"
  local key="$2"
  local -a values

  values=("${(@f)$(sed -n "s/^${key}=//p" "$metadata")}")
  (( ${#values} == 1 )) || return 1
  print -r -- "$values[1]"
}

assert_session_root() {
  local root="$1"
  local relative=""
  local parent_real=""
  local root_real=""

  relative="${root#"$E2E_TEMP_PARENT"/}"
  if [[ "$relative" == "$root" || "$relative" != nuinui-vscode-e2e.* || "$relative" == */* ]]; then
    echo "BLOCKED: session root is outside the dedicated E2E temporary area"
    echo "ROOT: $root"
    return 1
  fi

  parent_real="$(resolve_existing_path "$E2E_TEMP_PARENT")" || {
    echo "BLOCKED: dedicated E2E temporary area cannot be resolved"
    echo "TEMP_PARENT: $E2E_TEMP_PARENT"
    return 1
  }
  if [[ -e "$root" ]]; then
    root_real="$(resolve_existing_path "$root")" || {
      echo "BLOCKED: E2E session root cannot be resolved"
      echo "ROOT: $root"
      return 1
    }
    if [[ "$(dirname "$root_real")" != "$parent_real" ]]; then
      echo "BLOCKED: resolved E2E session root escaped its temporary area"
      echo "ROOT: $root_real"
      return 1
    fi
  fi
}

assert_session_handoff() {
  local issue="$1"
  local handoff="$2"
  local expected="$E2E_TEMP_PARENT/nuinui-${issue}-human-e2e.env"
  if [[ "$handoff" != "$expected" ]]; then
    echo "BLOCKED: unexpected E2E handoff path"
    echo "EXPECTED: $expected"
    echo "ACTUAL:   $handoff"
    return 1
  fi
}

stop_owned_processes() {
  local root="$1"
  local launch_pid="$2"
  local command_line=""
  local pid=""
  local -a pids
  local -a matching_pids

  assert_session_root "$root" || return 1
  matching_pids=()

  if [[ "$launch_pid" =~ '^[0-9]+$' ]] && kill -0 "$launch_pid" >/dev/null 2>&1; then
    command_line="$(ps -ww -p "$launch_pid" -o command= 2>/dev/null || true)"
    if [[ "$command_line" != *"$root"* ]]; then
      echo "BLOCKED: recorded launch PID does not belong to the E2E root"
      echo "PID: $launch_pid"
      return 1
    fi
    matching_pids+=("$launch_pid")
  fi

  pids=("${(@f)$(pgrep -f "user-data-dir=$root/user-data" 2>/dev/null || true)}")
  for pid in "${pids[@]}"; do
    [[ -z "$pid" ]] && continue
    command_line="$(ps -ww -p "$pid" -o command= 2>/dev/null || true)"
    if [[ "$command_line" == *"$root"* ]] && (( ${matching_pids[(Ie)$pid]} == 0 )); then
      matching_pids+=("$pid")
    fi
  done

  for pid in "${matching_pids[@]}"; do
    kill -TERM "$pid" >/dev/null 2>&1 || return 1
  done

  for _ in $(seq 1 10); do
    local remaining=0
    for pid in "${matching_pids[@]}"; do
      if kill -0 "$pid" >/dev/null 2>&1; then
        remaining=1
      fi
    done
    (( remaining == 0 )) && return 0
    sleep 0.2
  done

  for pid in "${matching_pids[@]}"; do
    if kill -0 "$pid" >/dev/null 2>&1; then
      kill -KILL "$pid" >/dev/null 2>&1 || return 1
    fi
  done
  return 0
}

assert_fixture_external() {
  local fixture="$1"
  local fixture_real=""
  local repo_real=""

  [[ -d "$E2E_WT" ]] || return 0

  fixture_real="$(resolve_existing_path "$fixture")" || {
    echo "ERROR: could not resolve fixture path"
    echo "FIXTURE: $fixture"
    return 1
  }
  repo_real="$(resolve_existing_path "$E2E_WT")" || {
    echo "ERROR: could not resolve e2e checkout path"
    echo "PATH: $E2E_WT"
    return 1
  }

  case "$fixture_real" in
    "$repo_real"|"$repo_real"/*)
      echo "BLOCKED: fixture resolves inside dedicated e2e checkout"
      echo "FIXTURE: $fixture_real"
      echo "CHECKOUT: $repo_real"
      return 1
      ;;
  esac
}

assert_inputs() {
  local issue="$1"
  local tested_ref="$2"
  local fixture="$3"

  [[ "$issue" =~ '^SAY-[0-9]+$' ]] || { echo "ERROR: Issue must look like SAY-123"; return 2; }
  [[ "$tested_ref" =~ '^[0-9a-fA-F]{40}$' ]] || { echo "ERROR: tested-ref must be a full commit SHA"; return 2; }
  [[ -f "$fixture" ]] || { echo "BLOCKED: fixture does not exist"; echo "FIXTURE: $fixture"; return 1; }
  assert_fixture_external "$fixture" || return $?
}

assert_checkout() {
  local issue="$1"
  local tested_ref="$2"
  local repo="$E2E_WT"
  local origin=""
  local dirty=""
  local branch=""
  local head=""
  local marker=""
  local marker_issue=""
  local marker_ref=""

  [[ -d "$repo" ]] || { echo "BLOCKED: e2e checkout does not exist"; echo "PATH: $repo"; return 1; }
  git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "BLOCKED: e2e checkout is not a Git worktree"
    echo "PATH: $repo"
    return 1
  }

  origin="$(git -C "$repo" remote get-url origin 2>/dev/null)" || {
    echo "BLOCKED: e2e origin remote is missing"
    return 1
  }
  [[ "$origin" == *"sayosomi/nuinuiCAD"* ]] || {
    echo "BLOCKED: unexpected e2e repository origin"
    echo "ACTUAL: $origin"
    return 1
  }

  dirty="$(git -C "$repo" status --porcelain)"
  [[ -z "$dirty" ]] || {
    echo "BLOCKED: e2e checkout is dirty"
    git -C "$repo" status --short
    return 1
  }

  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  [[ -z "$branch" ]] || {
    echo "BLOCKED: e2e checkout is not detached"
    echo "BRANCH: $branch"
    return 1
  }

  head="$(git -C "$repo" rev-parse HEAD)" || return 1
  [[ "$head" == "$tested_ref" ]] || {
    echo "BLOCKED: e2e HEAD does not match tested-ref"
    echo "HEAD:       $head"
    echo "TESTED_REF: $tested_ref"
    return 1
  }

  marker="$(marker_path)" || return 1
  [[ -f "$marker" ]] || {
    echo "BLOCKED: e2e marker is missing; run the lane e2e-start helper first"
    echo "MARKER: $marker"
    return 1
  }

  marker_issue="$(sed -n 's/^issue=//p' "$marker")"
  marker_ref="$(sed -n 's/^ref=//p' "$marker")"
  [[ "$marker_issue" == "$issue" ]] || {
    echo "BLOCKED: e2e marker Issue mismatch"
    echo "MARKER_ISSUE: $marker_issue"
    echo "REQUESTED:    $issue"
    return 1
  }
  [[ "$marker_ref" == "$tested_ref" ]] || {
    echo "BLOCKED: e2e marker ref mismatch"
    echo "MARKER_REF: $marker_ref"
    echo "TESTED_REF: $tested_ref"
    return 1
  }

  echo "E2E CHECKOUT VERIFIED"
  echo "  issue=$issue"
  echo "  tested_ref=$tested_ref"
  echo "  checkout=$repo"
  echo "  marker=$marker"
}

ensure_dependencies() {
  local repo="$E2E_WT"
  local e2e_root="$1"
  local npm_cache="$e2e_root/npm-cache"

  mkdir -p "$npm_cache" || {
    echo "ERROR: could not create isolated npm cache"
    return 1
  }

  echo "DEPENDENCIES: INSTALL LOCKED"
  NPM_CONFIG_CACHE="$npm_cache" npm -C "$repo" ci --include=dev || {
    echo "ERROR: dependency installation failed"
    return 1
  }

  [[ -x "$repo/node_modules/.bin/esbuild" ]] || {
    echo "ERROR: esbuild is unavailable after dependency installation"
    return 1
  }

  assert_no_tracked_mutations "dependency preparation" || return 1

  echo "DEPENDENCIES: READY"
}

write_session() {
  local issue="$1"
  local tested_ref="$2"
  local root="$3"
  local handoff="$4"
  local cdp_port="$5"
  local launch_pid="$6"
  local session=""
  local temporary=""

  session="$(session_path)" || return 1
  if [[ -e "$session" ]]; then
    echo "BLOCKED: E2E session metadata already exists"
    echo "SESSION: $session"
    return 1
  fi
  assert_session_root "$root" || return 1
  assert_session_handoff "$issue" "$handoff" || return 1

  temporary="$(mktemp "${session}.XXXXXX")" || {
    echo "ERROR: could not create E2E session metadata"
    return 1
  }
  if ! {
    printf 'issue=%s\n' "$issue"
    printf 'ref=%s\n' "$tested_ref"
    printf 'root=%s\n' "$root"
    printf 'handoff=%s\n' "$handoff"
    printf 'cdp_port=%s\n' "$cdp_port"
    printf 'launch_pid=%s\n' "$launch_pid"
  } > "$temporary"; then
    rm -f -- "$temporary"
    echo "ERROR: could not write E2E session metadata"
    return 1
  fi
  mv "$temporary" "$session" || {
    rm -f -- "$temporary"
    echo "ERROR: could not finalize E2E session metadata"
    return 1
  }
}

status() {
  setopt local_options null_glob

  local repo="$E2E_WT"
  local session=""
  local marker=""
  local head=""
  local branch=""
  local dirty=""
  local marker_issue=""
  local marker_ref=""
  local issue=""
  local tested_ref=""
  local root=""
  local handoff=""
  local cdp_port=""
  local launch_pid=""
  local command_line=""
  local result=0
  local session_valid=0
  local -a root_candidates
  local -a handoff_candidates
  local candidate=""

  [[ -d "$repo" ]] || { echo "BLOCKED: e2e checkout does not exist"; echo "PATH: $repo"; return 1; }
  git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "BLOCKED: e2e checkout is not a Git worktree"
    echo "PATH: $repo"
    return 1
  }
  session="$(session_path)" || { echo "BLOCKED: cannot resolve E2E session path"; return 1; }
  marker="$(marker_path)" || { echo "BLOCKED: cannot resolve E2E marker path"; return 1; }
  head="$(git -C "$repo" rev-parse HEAD)" || return 1
  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  dirty="$(git -C "$repo" status --porcelain)"

  echo "E2E STATUS"
  echo "  checkout=$repo"
  echo "  head=$head"
  echo "  branch=${branch:-DETACHED}"
  echo "  clean=$([[ -z "$dirty" ]] && echo yes || echo no)"

  if [[ -f "$marker" ]]; then
    marker_issue="$(metadata_value "$marker" issue 2>/dev/null || true)"
    marker_ref="$(metadata_value "$marker" ref 2>/dev/null || true)"
    echo "  marker=present"
    echo "  marker_issue=${marker_issue:-INVALID}"
    echo "  marker_ref=${marker_ref:-INVALID}"
  elif [[ -e "$marker" ]]; then
    echo "  marker=invalid-not-file"
    result=1
  else
    echo "  marker=none"
  fi

  if [[ ! -e "$session" ]]; then
    echo "  session=none"
  elif [[ ! -f "$session" ]]; then
    echo "  session=invalid-not-file"
    result=1
  else
    issue="$(metadata_value "$session" issue 2>/dev/null || true)"
    tested_ref="$(metadata_value "$session" ref 2>/dev/null || true)"
    root="$(metadata_value "$session" root 2>/dev/null || true)"
    handoff="$(metadata_value "$session" handoff 2>/dev/null || true)"
    cdp_port="$(metadata_value "$session" cdp_port 2>/dev/null || true)"
    launch_pid="$(metadata_value "$session" launch_pid 2>/dev/null || true)"

    if [[ "$issue" =~ '^SAY-[0-9]+$' && "$tested_ref" =~ '^[0-9a-fA-F]{40}$' && "$cdp_port" =~ '^[0-9]+$' && "$launch_pid" =~ '^[0-9]+$' ]] \
      && assert_session_root "$root" >/dev/null 2>&1 \
      && assert_session_handoff "$issue" "$handoff" >/dev/null 2>&1; then
      session_valid=1
      echo "  session=active"
      echo "  issue=$issue"
      echo "  ref=$tested_ref"
      echo "  root=$root ($([[ -e "$root" ]] && echo present || echo missing))"
      echo "  handoff=$handoff ($([[ -e "$handoff" ]] && echo present || echo missing))"
      echo "  cdp_port=$cdp_port"
      if kill -0 "$launch_pid" >/dev/null 2>&1; then
        command_line="$(ps -ww -p "$launch_pid" -o command= 2>/dev/null || true)"
        if [[ "$command_line" == *"$root"* ]]; then
          echo "  launch_pid=$launch_pid (owned-process-running)"
        else
          echo "  launch_pid=$launch_pid (process-ownership-mismatch)"
          result=1
        fi
      else
        echo "  launch_pid=$launch_pid (not-running)"
      fi
      if [[ "$marker_issue" != "$issue" || "$marker_ref" != "$tested_ref" ]]; then
        echo "  session_marker=INCONSISTENT"
        result=1
      else
        echo "  session_marker=consistent"
      fi
    else
      echo "  session=INVALID"
      result=1
    fi
  fi

  echo "  unmanaged_artifacts:"
  root_candidates=("$E2E_TEMP_PARENT"/nuinui-vscode-e2e.*(N))
  for candidate in "${root_candidates[@]}"; do
    [[ "$session_valid" == 1 && "$candidate" == "$root" ]] && continue
    echo "    root-candidate=$candidate"
  done
  handoff_candidates=("$E2E_TEMP_PARENT"/nuinui-*-human-e2e.env(N))
  for candidate in "${handoff_candidates[@]}"; do
    [[ "$session_valid" == 1 && "$candidate" == "$handoff" ]] && continue
    echo "    handoff-candidate=$candidate"
  done

  if (( result != 0 )); then
    echo "E2E STATUS BLOCKED: inspect the reported state; do not delete artifacts automatically."
    return 1
  fi

  echo "E2E STATUS COMPLETE"
}


closure_check() {
  setopt local_options null_glob

  local requested_issue="$1"
  local issue_number=""
  local session=""
  local marker=""
  local session_issue=""
  local marker_issue=""
  local temp_parent=""
  local candidate=""
  local processes=""
  local result=0
  local -a temp_parents
  local -a root_candidates

  [[ "$requested_issue" =~ '^SAY-[0-9]+$' ]] || {
    echo "ERROR: Issue must look like SAY-123"
    return 2
  }

  issue_number="${requested_issue#SAY-}"

  session="$(session_path)" || {
    echo "BLOCKED: cannot resolve E2E session path"
    return 1
  }
  marker="$(marker_path)" || {
    echo "BLOCKED: cannot resolve E2E marker path"
    return 1
  }

  echo "E2E CLOSURE CHECK"
  echo "  issue=$requested_issue"

  if [[ -f "$session" ]]; then
    session_issue="$(metadata_value "$session" issue 2>/dev/null || true)"
    if [[ -z "$session_issue" ]]; then
      echo "  session=INVALID"
      result=1
    elif [[ "$session_issue" == "$requested_issue" ]]; then
      echo "  session=BLOCKING-SAME-ISSUE"
      result=1
    else
      echo "  session=other-issue:$session_issue"
    fi
  elif [[ -e "$session" ]]; then
    echo "  session=INVALID-NOT-FILE"
    result=1
  else
    echo "  session=none-for-requested-issue"
  fi

  if [[ -f "$marker" ]]; then
    marker_issue="$(metadata_value "$marker" issue 2>/dev/null || true)"
    if [[ -z "$marker_issue" ]]; then
      echo "  marker=INVALID"
      result=1
    elif [[ "$marker_issue" == "$requested_issue" ]]; then
      echo "  marker=BLOCKING-SAME-ISSUE"
      result=1
    else
      echo "  marker=other-issue:$marker_issue"
    fi
  elif [[ -e "$marker" ]]; then
    echo "  marker=INVALID-NOT-FILE"
    result=1
  else
    echo "  marker=none-for-requested-issue"
  fi

  temp_parents=("$E2E_TEMP_PARENT")
  if [[ -n "${TMPDIR:-}" ]]; then
    temp_parent="${TMPDIR%/}"
    if [[ -n "$temp_parent" && "$temp_parent" != "$E2E_TEMP_PARENT" ]]; then
      temp_parents+=("$temp_parent")
    fi
  fi

  for temp_parent in "${temp_parents[@]}"; do
    [[ -d "$temp_parent" ]] || continue

    root_candidates=(
      "$temp_parent"/nuinui-say${issue_number}-e2e.*(N)
      "$temp_parent"/nuinui-SAY${issue_number}-e2e.*(N)
      "$temp_parent"/nuinui-SAY-${issue_number}-e2e.*(N)
    )

    for candidate in "${root_candidates[@]}"; do
      [[ -d "$candidate" ]] || continue
      echo "  fallback-root=BLOCKING:$candidate"
      result=1
    done

    candidate="$temp_parent/nuinui-${requested_issue}-human-e2e.env"
    if [[ -e "$candidate" ]]; then
      echo "  handoff=BLOCKING:$candidate"
      result=1
    fi

    candidate="$temp_parent/nuinui-say${issue_number}-human-e2e.env"
    if [[ -e "$candidate" ]]; then
      echo "  handoff=BLOCKING:$candidate"
      result=1
    fi
  done

  processes="$(
    {
      pgrep -fal "nuinui-say${issue_number}-e2e\\." 2>/dev/null || true
      pgrep -fal "nuinui-SAY${issue_number}-e2e\\." 2>/dev/null || true
      pgrep -fal "nuinui-SAY-${issue_number}-e2e\\." 2>/dev/null || true
    } | awk '!seen[$0]++'
  )"

  if [[ -n "$processes" ]]; then
    echo "  process=BLOCKING"
    printf '%s\n' "$processes"
    result=1
  else
    echo "  process=none-for-requested-issue"
  fi

  if (( result != 0 )); then
    echo "E2E CLOSURE BLOCKED"
    return 1
  fi

  echo "E2E CLOSURE CLEAN"
}

cleanup() {
  local session=""
  local issue=""
  local tested_ref=""
  local root=""
  local handoff=""
  local cdp_port=""
  local launch_pid=""
  local head=""
  local marker=""
  local marker_issue=""
  local marker_ref=""

  session="$(session_path)" || { echo "BLOCKED: cannot resolve E2E session path"; return 1; }
  if [[ ! -f "$session" ]]; then
    echo "BLOCKED: E2E session metadata does not exist"
    return 1
  fi

  issue="$(sed -n 's/^issue=//p' "$session")"
  tested_ref="$(sed -n 's/^ref=//p' "$session")"
  root="$(sed -n 's/^root=//p' "$session")"
  handoff="$(sed -n 's/^handoff=//p' "$session")"
  cdp_port="$(sed -n 's/^cdp_port=//p' "$session")"
  launch_pid="$(sed -n 's/^launch_pid=//p' "$session")"

  [[ "$issue" =~ '^SAY-[0-9]+$' ]] || { echo "BLOCKED: invalid E2E session Issue"; return 1; }
  [[ "$tested_ref" =~ '^[0-9a-fA-F]{40}$' ]] || { echo "BLOCKED: invalid E2E session ref"; return 1; }
  [[ "$cdp_port" =~ '^[0-9]+$' ]] || { echo "BLOCKED: invalid E2E session CDP port"; return 1; }
  [[ "$launch_pid" =~ '^[0-9]+$' ]] || { echo "BLOCKED: invalid E2E session launch PID"; return 1; }
  assert_session_root "$root" || return 1
  assert_session_handoff "$issue" "$handoff" || return 1

  assert_checkout "$issue" "$tested_ref" >/dev/null || return $?
  head="$(git -C "$E2E_WT" rev-parse HEAD)" || return 1
  [[ "$head" == "$tested_ref" ]] || { echo "BLOCKED: e2e HEAD changed before cleanup"; return 1; }
  marker="$(marker_path)" || return 1
  marker_issue="$(sed -n 's/^issue=//p' "$marker")"
  marker_ref="$(sed -n 's/^ref=//p' "$marker")"
  [[ "$marker_issue" == "$issue" && "$marker_ref" == "$tested_ref" ]] || {
    echo "BLOCKED: E2E marker changed before cleanup"
    return 1
  }

  stop_owned_processes "$root" "$launch_pid" || return 1
  [[ ! -e "$root" ]] || rm -rf -- "$root" || { echo "ERROR: could not remove E2E root"; return 1; }
  [[ ! -e "$handoff" ]] || rm -f -- "$handoff" || { echo "ERROR: could not remove E2E handoff"; return 1; }
  rm -f -- "$session" || { echo "ERROR: could not remove E2E session metadata"; return 1; }

  echo "E2E CLEANUP COMPLETE"
  echo "  issue=$issue"
  echo "  ref=$tested_ref"
}

assert_no_tracked_mutations() {
  local phase="$1"
  local repo="$E2E_WT"
  local dirty=""

  dirty="$(git -C "$repo" status --porcelain --untracked-files=no)" || {
    echo "ERROR: could not inspect tracked-file status after $phase"
    return 1
  }
  [[ -z "$dirty" ]] || {
    echo "ERROR: tracked-file mutation detected after $phase"
    git -C "$repo" status --short --untracked-files=no
    return 1
  }
}

build_artifacts() {
  local repo="$E2E_WT"

  npm -C "$repo" run build:vscode || {
    echo "ERROR: npm run build:vscode failed"
    return 1
  }
  assert_no_tracked_mutations "npm run build:vscode" || return 1

  cargo build --manifest-path "$repo/rust-evaluator/Cargo.toml" --bin evaluation_stdio || {
    echo "ERROR: evaluation_stdio build failed"
    return 1
  }
  assert_no_tracked_mutations "cargo build" || return 1

  [[ -f "$repo/vscode-extension/dist/extension.js" ]] || {
    echo "ERROR: VS Code extension build artifact missing"
    return 1
  }

  [[ -x "$repo/rust-evaluator/target/debug/evaluation_stdio" ]] || {
    echo "ERROR: evaluation_stdio binary missing"
    return 1
  }
}

resolve_code_bin() {
  local code_bin="$VS_CODE_APP/Contents/Resources/app/bin/code"
  if [[ -x "$code_bin" ]]; then
    echo "$code_bin"
    return 0
  fi
  code_bin="$(command -v code || true)"
  [[ -n "$code_bin" && -x "$code_bin" ]] || return 1
  echo "$code_bin"
}

prepare() {
  local issue="$1"
  local tested_ref="$2"
  local fixture="$3"
  local cdp_port="${4:-$DEFAULT_CDP_PORT}"
  local repo="$E2E_WT"
  local code_bin=""
  local e2e_root=""
  local fixture_name=""
  local prepared_fixture=""
  local rust_bin=""
  local handoff=""
  local session=""
  local ready=0
  local vscode_pid=""

  cleanup_failed_prepare() {
    local result="$1"
    if [[ -n "$vscode_pid" ]]; then
      stop_owned_processes "$e2e_root" "$vscode_pid" >/dev/null 2>&1 || true
    fi
    [[ -z "$handoff" || ! -e "$handoff" ]] || rm -f -- "$handoff"
    [[ -z "$e2e_root" || ! -e "$e2e_root" ]] || rm -rf -- "$e2e_root"
    return "$result"
  }

  assert_checkout "$issue" "$tested_ref" >/dev/null || return $?

  session="$(session_path)" || { echo "ERROR: cannot resolve E2E session path"; return 1; }
  if [[ -e "$session" ]]; then
    echo "BLOCKED: E2E session cleanup is still required"
    echo "SESSION: $session"
    return 1
  fi

  code_bin="$(resolve_code_bin)" || {
    echo "BLOCKED: VS Code CLI executable not found"
    return 1
  }

  if lsof -nP -iTCP:"$cdp_port" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "BLOCKED: CDP port already in use"
    echo "PORT: $cdp_port"
    return 1
  fi

  e2e_root="$(mktemp -d "$E2E_TEMP_PARENT/nuinui-vscode-e2e.XXXXXX")" || {
    echo "ERROR: could not create E2E root"
    return 1
  }
  mkdir -p "$e2e_root/user-data/User" "$e2e_root/extensions" "$e2e_root/evidence" || {
    cleanup_failed_prepare 1
    return 1
  }

  ensure_dependencies "$e2e_root" || { cleanup_failed_prepare 1; return 1; }
  build_artifacts || { cleanup_failed_prepare 1; return 1; }

  cat > "$e2e_root/user-data/User/settings.json" <<'EOF'
{
  "editor.wordBasedSuggestions": "off",
  "editor.inlineSuggest.enabled": false,
  "editor.quickSuggestions": false,
  "editor.snippetSuggestions": "none"
}
EOF

  [[ -f "$e2e_root/user-data/User/settings.json" ]] || { cleanup_failed_prepare 1; return 1; }

  fixture_name="$(basename "$fixture")"
  prepared_fixture="$e2e_root/$fixture_name"
  cp "$fixture" "$prepared_fixture" || {
    echo "ERROR: fixture copy failed"
    cleanup_failed_prepare 1
    return 1
  }

  rust_bin="$repo/rust-evaluator/target/debug/evaluation_stdio"

  NUINUICAD_RUST_EVALUATION_BINARY="$rust_bin" \
  NUINUICAD_MCP_OBSERVATION=1 \
  "$code_bin" --new-window \
    --user-data-dir="$e2e_root/user-data" \
    --extensions-dir="$e2e_root/extensions" \
    --extensionDevelopmentPath="$repo/vscode-extension" \
    --remote-debugging-port="$cdp_port" \
    '--remote-allow-origins=*' \
    --skip-welcome \
    --skip-sessions-welcome \
    --skip-release-notes \
    --disable-workspace-trust \
    "$prepared_fixture" >/dev/null 2>&1 &
  vscode_pid=$!

  for _ in $(seq 1 120); do
    if curl --max-time 1 -fsS \
      "http://127.0.0.1:${cdp_port}/json/version" \
      > "$e2e_root/evidence/cdp-version.json"; then
      ready=1
      break
    fi
    sleep 0.5
  done

  if [[ "$ready" != 1 ]]; then
    echo "ERROR: CDP readiness timeout"
    echo "E2E_ROOT: $e2e_root"
    cleanup_failed_prepare 1
    return 1
  fi

  handoff="$E2E_TEMP_PARENT/nuinui-${issue}-human-e2e.env"
  cat > "$handoff" <<EOF
ISSUE='$issue'
TESTED_REF='$tested_ref'
CHECKOUT='$repo'
E2E_ROOT='$e2e_root'
FIXTURE='$prepared_fixture'
CDP_PORT='$cdp_port'
RUST_BIN='$rust_bin'
EOF

  write_session "$issue" "$tested_ref" "$e2e_root" "$handoff" "$cdp_port" "$vscode_pid" || {
    cleanup_failed_prepare 1
    return 1
  }

  echo "E2E SETUP READY"
  echo "  issue=$issue"
  echo "  tested_ref=$tested_ref"
  echo "  checkout=$repo"
  echo "  e2e_root=$e2e_root"
  echo "  fixture=$prepared_fixture"
  echo "  cdp_port=$cdp_port"
  echo "  handoff=$handoff"
  echo "  session=$session"
  echo "READY FOR HUMAN E2E"
}

case "${1:-}" in
  version)
    echo "$VERSION"
    ;;
  check)
    [[ "$#" -eq 4 ]] || { usage; exit 2; }
    assert_inputs "$2" "$3" "$4" || exit $?
    assert_checkout "$2" "$3"
    ;;
  prepare)
    [[ "$#" -eq 4 || "$#" -eq 5 ]] || { usage; exit 2; }
    assert_inputs "$2" "$3" "$4" || exit $?
    prepare "$2" "$3" "$4" "${5:-$DEFAULT_CDP_PORT}"
    ;;
  status)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    status
    ;;
  closure-check)
    [[ "$#" -eq 2 ]] || { usage; exit 2; }
    closure_check "$2"
    ;;
  cleanup)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    cleanup
    ;;
  *)
    usage
    exit 2
    ;;
esac
