#!/bin/sh
set -eu

HELPER="${1:-$(cd "$(dirname "$0")" && pwd -P)/nuinui}"
ROOT="$(mktemp -d "${TMPDIR:-/tmp}/nuinui-lifecycle.XXXXXX")"
trap 'rm -rf "$ROOT"' EXIT HUP INT TERM

REMOTE="$ROOT/remote.git"
SEED="$ROOT/seed"
MAIN="$ROOT/main"
SUB="$ROOT/sub"
E2E="$ROOT/e2e"
E2E_PREPARE_HELPER="$(cd "$(dirname "$HELPER")" && pwd -P)/nuinui-e2e-prepare"
E2E_CLOSURE_TEMP="$ROOT/e2e-closure-temp"
E2E_CLOSURE_TMPDIR="$ROOT/e2e-closure-tmp"

fail() { echo "SELFTEST FAIL: $*"; exit 1; }
assert_line() { printf '%s\n' "$1" | grep -Eq "$2" || fail "$3"; }
gitdir() { git -C "$1" rev-parse --absolute-git-dir; }
slot_state() { printf '%s/nuinui-implementation-slot/state\n' "$(gitdir "$1")"; }
read_optional_file() { if [ -e "$1" ]; then cat "$1"; else echo absent; fi; }
tombstone_state() { find "$(gitdir "$1")" -maxdepth 1 -type d -name 'nuinui-implementation-slot.releasing.*' -print 2>/dev/null | sort; }
lane_refs() { git -C "$1" for-each-ref --format='%(refname) %(objectname)' | sort; }
local_lane_refs() { git -C "$1" for-each-ref refs/heads --format='%(refname) %(objectname)' | sort; }
begin_state() {
  begin_state_target=$1
  begin_state_peer=$2
  printf 'target-branch=%s\n' "$(git -C "$begin_state_target" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  printf 'target-head=%s\n' "$(git -C "$begin_state_target" rev-parse HEAD)"
  printf 'target-status=%s\n' "$(git -C "$begin_state_target" status --porcelain)"
  printf 'target-refs=%s\n' "$(lane_refs "$MAIN")"
  printf 'target-slot=%s\n' "$(read_optional_file "$(slot_state "$begin_state_target")")"
  printf 'target-lock=%s\n' "$(read_optional_file "$(gitdir "$begin_state_target")/nuinui-implementation-lock/state")"
  printf 'target-tombstones=%s\n' "$(tombstone_state "$begin_state_target")"
  printf 'peer-branch=%s\n' "$(git -C "$begin_state_peer" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  printf 'peer-head=%s\n' "$(git -C "$begin_state_peer" rev-parse HEAD)"
  printf 'peer-status=%s\n' "$(git -C "$begin_state_peer" status --porcelain)"
  printf 'peer-refs=%s\n' "$(lane_refs "$begin_state_peer")"
  printf 'peer-slot=%s\n' "$(read_optional_file "$(slot_state "$begin_state_peer")")"
  printf 'peer-lock=%s\n' "$(read_optional_file "$(gitdir "$begin_state_peer")/nuinui-implementation-lock/state")"
  printf 'peer-tombstones=%s\n' "$(tombstone_state "$begin_state_peer")"
}
expect_begin_duplicate() {
  begin_duplicate_name=$1
  begin_duplicate_target=$2
  begin_duplicate_peer=$3
  begin_duplicate_lane=$4
  begin_duplicate_issue=$5
  begin_duplicate_base=$6
  begin_duplicate_branch=$7
  begin_duplicate_expected_peer=$8
  begin_duplicate_claim=$9
  begin_duplicate_peer_state=${10}
  begin_duplicate_peer_issue=${11}
  begin_duplicate_peer_lane=${12}
  begin_duplicate_before=$(begin_state "$begin_duplicate_target" "$begin_duplicate_peer")
  if begin_duplicate_output=$("$HELPER" begin "$begin_duplicate_lane" "$begin_duplicate_issue" "$begin_duplicate_base" "$begin_duplicate_branch" "$begin_duplicate_expected_peer" 2>&1); then
    :
  else
    printf '%s\n' "$begin_duplicate_output"
    fail "$begin_duplicate_name unexpectedly failed"
  fi
  [ "$(printf '%s\n' "$begin_duplicate_output" | sed -n '1p')" = 'IMPLEMENTATION ALREADY STARTED' ] || {
    printf '%s\n' "$begin_duplicate_output"
    fail "$begin_duplicate_name missing duplicate marker"
  }
  assert_line "$begin_duplicate_output" "^lane=$begin_duplicate_lane$" "$begin_duplicate_name missing lane"
  assert_line "$begin_duplicate_output" "^issue=$begin_duplicate_issue$" "$begin_duplicate_name missing Issue"
  assert_line "$begin_duplicate_output" "^branch=$begin_duplicate_branch$" "$begin_duplicate_name missing branch"
  assert_line "$begin_duplicate_output" "^base=$begin_duplicate_base$" "$begin_duplicate_name missing base"
  assert_line "$begin_duplicate_output" "^checkpoint=$begin_duplicate_base$" "$begin_duplicate_name checkpoint is not Base"
  assert_line "$begin_duplicate_output" "^claim=$begin_duplicate_claim$" "$begin_duplicate_name changed claim"
  assert_line "$begin_duplicate_output" '^clean=yes$' "$begin_duplicate_name missing clean state"
  assert_line "$begin_duplicate_output" '^state=BUSY$' "$begin_duplicate_name missing BUSY state"
  assert_line "$begin_duplicate_output" "^peer_lane=$begin_duplicate_peer_lane$" "$begin_duplicate_name missing peer lane"
  assert_line "$begin_duplicate_output" "^peer_state=$begin_duplicate_peer_state$" "$begin_duplicate_name wrong peer state"
  assert_line "$begin_duplicate_output" "^peer_issue=$begin_duplicate_peer_issue$" "$begin_duplicate_name wrong peer Issue"
  assert_line "$begin_duplicate_output" '^mutation=no-op$' "$begin_duplicate_name missing no-op marker"
  assert_line "$begin_duplicate_output" '^preflight=PASS$' "$begin_duplicate_name missing preflight proof"
  begin_duplicate_after=$(begin_state "$begin_duplicate_target" "$begin_duplicate_peer")
  [ "$begin_duplicate_before" = "$begin_duplicate_after" ] || fail "$begin_duplicate_name changed lifecycle state"
  echo "PASS: $begin_duplicate_name"
}
expect_begin_conflict() {
  begin_conflict_name=$1
  begin_conflict_target=$2
  begin_conflict_peer=$3
  shift 3
  begin_conflict_before=$(begin_state "$begin_conflict_target" "$begin_conflict_peer")
  if begin_conflict_output=$("$HELPER" begin "$@" 2>&1); then
    printf '%s\n' "$begin_conflict_output"
    fail "$begin_conflict_name unexpectedly succeeded"
  else
    begin_conflict_rc=$?
  fi
  [ "$begin_conflict_rc" -ne 0 ] || fail "$begin_conflict_name returned zero"
  printf '%s\n' "$begin_conflict_output" | grep -q '^BLOCKED:' || {
    printf '%s\n' "$begin_conflict_output"
    fail "$begin_conflict_name did not fail closed"
  }
  if printf '%s\n' "$begin_conflict_output" | grep -q '^IMPLEMENTATION ALREADY STARTED$'; then
    fail "$begin_conflict_name was classified as a duplicate"
  fi
  begin_conflict_after=$(begin_state "$begin_conflict_target" "$begin_conflict_peer")
  [ "$begin_conflict_before" = "$begin_conflict_after" ] || fail "$begin_conflict_name changed lifecycle state"
  echo "PASS: $begin_conflict_name"
}
e2e_closure_check() {
  env \
    NUINUI_E2E_PREPARE_WT="$E2E" \
    NUINUI_E2E_TEMP_PARENT="$E2E_CLOSURE_TEMP" \
    TMPDIR="$E2E_CLOSURE_TMPDIR" \
    zsh "$E2E_PREPARE_HELPER" closure-check "$1"
}

expect_begin_blocked() {
  name="$1"
  lane="$2"
  shift 2
  before_branch="$(git -C "$lane" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  before_head="$(git -C "$lane" rev-parse HEAD)"
  before_status="$(git -C "$lane" status --porcelain)"
  before_refs="$(lane_refs "$MAIN")"
  before_slot="$(if [ -f "$(slot_state "$lane")" ]; then cat "$(slot_state "$lane")"; else echo absent; fi)"
  if "$HELPER" begin "$@" >"$ROOT/out" 2>&1; then
    cat "$ROOT/out"
    fail "$name unexpectedly succeeded"
  fi
  grep -q 'BLOCKED' "$ROOT/out" || { cat "$ROOT/out"; fail "$name did not fail closed"; }
  after_branch="$(git -C "$lane" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  after_head="$(git -C "$lane" rev-parse HEAD)"
  after_status="$(git -C "$lane" status --porcelain)"
  after_refs="$(lane_refs "$MAIN")"
  after_slot="$(if [ -f "$(slot_state "$lane")" ]; then cat "$(slot_state "$lane")"; else echo absent; fi)"
  [ "$before_branch" = "$after_branch" ] || fail "$name changed branch"
  [ "$before_head" = "$after_head" ] || fail "$name changed HEAD"
  [ "$before_status" = "$after_status" ] || fail "$name changed working tree"
  [ "$before_refs" = "$after_refs" ] || fail "$name changed local refs"
  [ "$before_slot" = "$after_slot" ] || fail "$name changed durable slot"
  echo "PASS: $name"
}

expect_resume_blocked() {
  name="$1"
  lane="$2"
  shift 2
  before_branch="$(git -C "$lane" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  before_head="$(git -C "$lane" rev-parse HEAD)"
  before_status="$(git -C "$lane" status --porcelain)"
  before_refs="$(lane_refs "$MAIN")"
  before_slot="$(if [ -f "$(slot_state "$lane")" ]; then cat "$(slot_state "$lane")"; else echo absent; fi)"
  before_lock="$(if [ -f "$(gitdir "$lane")/nuinui-implementation-lock/state" ]; then cat "$(gitdir "$lane")/nuinui-implementation-lock/state"; else echo absent; fi)"
  before_tombstones="$(find "$(gitdir "$lane")" -maxdepth 1 -type d -name 'nuinui-implementation-slot.releasing.*' -print 2>/dev/null | sort)"
  if "$HELPER" resume "$@" >"$ROOT/resume-blocked.out" 2>&1; then
    cat "$ROOT/resume-blocked.out"
    fail "$name unexpectedly succeeded"
  fi
  grep -q '^BLOCKED:' "$ROOT/resume-blocked.out" || {
    cat "$ROOT/resume-blocked.out"
    fail "$name did not fail closed"
  }
  after_branch="$(git -C "$lane" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  after_head="$(git -C "$lane" rev-parse HEAD)"
  after_status="$(git -C "$lane" status --porcelain)"
  after_refs="$(lane_refs "$MAIN")"
  after_slot="$(if [ -f "$(slot_state "$lane")" ]; then cat "$(slot_state "$lane")"; else echo absent; fi)"
  after_lock="$(if [ -f "$(gitdir "$lane")/nuinui-implementation-lock/state" ]; then cat "$(gitdir "$lane")/nuinui-implementation-lock/state"; else echo absent; fi)"
  after_tombstones="$(find "$(gitdir "$lane")" -maxdepth 1 -type d -name 'nuinui-implementation-slot.releasing.*' -print 2>/dev/null | sort)"
  [ "$before_branch" = "$after_branch" ] || fail "$name changed branch"
  [ "$before_head" = "$after_head" ] || fail "$name changed HEAD"
  [ "$before_status" = "$after_status" ] || fail "$name changed working tree"
  [ "$before_refs" = "$after_refs" ] || fail "$name changed local refs"
  [ "$before_slot" = "$after_slot" ] || fail "$name changed durable slot"
  [ "$before_lock" = "$after_lock" ] || fail "$name changed mutation lock"
  [ "$before_tombstones" = "$after_tombstones" ] || fail "$name changed release-pending state"
  echo "PASS: $name"
}

expect_old_signature_rejected() {
  name="$1"
  shift
  if "$HELPER" "$@" >"$ROOT/out" 2>&1; then
    cat "$ROOT/out"
    fail "$name unexpectedly succeeded"
  fi
  echo "PASS: $name"
}

expect_nonempty_failure() {
  name="$1"
  shift
  if output=$("$@" 2>&1); then
    printf '%s\n' "$output"
    fail "$name unexpectedly succeeded"
  else
    rc=$?
  fi
  [ "$rc" -ne 0 ] || fail "$name returned zero"
  [ -n "$output" ] || fail "$name produced no diagnostic"
  [ -n "$(printf '%s' "$output" | tr -d '[:space:]')" ] || fail "$name produced only whitespace"
  echo "PASS: $name"
}

expect_malformed_release() {
  name="$1"
  expected_slot="$2"
  expected_lock="$3"
  before_branch="$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  before_head="$(git -C "$MAIN" rev-parse HEAD)"
  before_status="$(git -C "$MAIN" status --porcelain)"
  before_refs="$(lane_refs "$MAIN")"
  if output=$("$HELPER" release main "$WRONG_CHECKPOINT" "$CLAIM1" 2>&1); then
    printf '%s\n' "$output"
    fail "$name unexpectedly succeeded"
  else
    rc=$?
  fi
  [ "$rc" -ne 0 ] || fail "$name returned zero"
  [ "$(printf '%s\n' "$output" | sed -n '1p')" = 'BLOCKED: malformed durable ownership state' ] || fail "$name was not classified first as malformed durable ownership state"
  assert_line "$output" '^BLOCKED: malformed durable ownership state$' "$name was not classified as malformed durable ownership state"
  if printf '%s\n' "$output" | grep -Eq '^BLOCKED: (checkpoint|claim) mismatch$'; then
    fail "$name reported a checkpoint or claim mismatch instead of malformed state"
  fi
  [ "$(cat "$SLOT_PATH")" = "$expected_slot" ] || fail "$name changed the durable slot"
  case "$expected_lock" in
    absent)
      [ ! -e "$LOCK_DIR" ] || fail "$name entered a mutation lock state"
      ;;
    *)
      [ "$(cat "$LOCK_DIR/state")" = "$expected_lock" ] || fail "$name changed the durable lock"
      ;;
  esac
  [ -z "$(find "$(gitdir "$MAIN")" -maxdepth 1 -type d -name 'nuinui-implementation-slot.releasing.*' -print 2>/dev/null)" ] || fail "$name created a release tombstone"
  after_branch="$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  after_head="$(git -C "$MAIN" rev-parse HEAD)"
  after_status="$(git -C "$MAIN" status --porcelain)"
  after_refs="$(lane_refs "$MAIN")"
  [ "$before_branch" = "$after_branch" ] || fail "$name changed branch"
  [ "$before_head" = "$after_head" ] || fail "$name changed HEAD"
  [ "$before_status" = "$after_status" ] || fail "$name changed working tree"
  [ "$before_refs" = "$after_refs" ] || fail "$name changed local refs"
  echo "PASS: $name"
}

expect_release_blocked() {
  name="$1"
  before_slot="$(cat "$SLOT_PATH")"
  before_dirs="$(find "$(gitdir "$MAIN")" -maxdepth 1 -type d -name 'nuinui-implementation-slot.releasing.*' -print 2>/dev/null | sort)"
  if "$HELPER" release main "$WRONG_CHECKPOINT" "$CLAIM1" >"$ROOT/release-conflict.out" 2>&1; then
    cat "$ROOT/release-conflict.out"
    fail "$name unexpectedly succeeded"
  fi
  grep -q '^BLOCKED:' "$ROOT/release-conflict.out" || { cat "$ROOT/release-conflict.out"; fail "$name did not fail closed"; }
  [ "$(cat "$SLOT_PATH")" = "$before_slot" ] || fail "$name changed the durable slot"
  after_dirs="$(find "$(gitdir "$MAIN")" -maxdepth 1 -type d -name 'nuinui-implementation-slot.releasing.*' -print 2>/dev/null | sort)"
  [ "$after_dirs" = "$before_dirs" ] || fail "$name changed release-pending state"
  echo "PASS: $name"
}

expect_invalid_releasing_state() {
  name="$1"
  tombstone="$2"
  if "$HELPER" preflight >"$ROOT/invalid-releasing.out" 2>&1; then
    cat "$ROOT/invalid-releasing.out"
    fail "$name unexpectedly succeeded"
  fi
  grep -q 'invalid-release-state' "$ROOT/invalid-releasing.out" || {
    cat "$ROOT/invalid-releasing.out"
    fail "$name was not classified as invalid release state"
  }
  [ -d "$tombstone" ] || fail "$name deleted the malformed release state"
  echo "PASS: $name"
}

merge_topic_into_main() {
  branch="$1"
  git -C "$MAIN" push -q -u origin "$branch"
  git -C "$SEED" fetch -q origin "$branch"
  git -C "$SEED" switch -q main
  git -C "$SEED" merge -q --ff-only "origin/$branch"
  git -C "$SEED" push -q origin main
}

sync_free_lanes() {
  git -C "$MAIN" fetch -q origin main
  git -C "$MAIN" switch -q main
  git -C "$MAIN" merge -q --ff-only origin/main
  git -C "$SUB" fetch -q origin main
  git -C "$SUB" switch -q --detach origin/main
}

release_main() {
  checkpoint="$1"
  claim="$2"
  branch="$3"
  merge_topic_into_main "$branch"
  "$HELPER" release main "$checkpoint" "$claim" >"$ROOT/release.out"
  assert_line "$(cat "$ROOT/release.out")" '^IMPLEMENTATION RELEASED$' 'release did not succeed'
  assert_line "$(cat "$ROOT/release.out")" '^lane=main$' 'release missing lane'
  assert_line "$(cat "$ROOT/release.out")" "^saved_checkpoint=$checkpoint$" 'release missing saved checkpoint'
  assert_line "$(cat "$ROOT/release.out")" "^released_claim=$claim$" 'release missing claim'
  assert_line "$(cat "$ROOT/release.out")" "^released_branch=$branch$" 'release missing branch'
  assert_line "$(cat "$ROOT/release.out")" '^idle_branch=main$' 'release missing idle branch'
  assert_line "$(cat "$ROOT/release.out")" '^idle_head=[0-9a-fA-F]{40}$' 'release missing idle HEAD'
  assert_line "$(cat "$ROOT/release.out")" '^origin_main=[0-9a-fA-F]{40}$' 'release missing origin main'
  assert_line "$(cat "$ROOT/release.out")" '^clean=yes$' 'release missing clean state'
  assert_line "$(cat "$ROOT/release.out")" '^state=FREE$' 'release missing FREE state'
}

assert_release_envelope() {
  output=$1
  lane=$2
  checkpoint=$3
  claim=$4
  branch=$5
  idle_branch=$6
  assert_line "$output" '^IMPLEMENTATION RELEASED$' 'drift release did not succeed'
  assert_line "$output" "^lane=$lane$" 'drift release missing lane'
  assert_line "$output" "^saved_checkpoint=$checkpoint$" 'drift release missing saved checkpoint'
  assert_line "$output" "^released_claim=$claim$" 'drift release missing claim'
  assert_line "$output" "^released_branch=$branch$" 'drift release missing branch'
  assert_line "$output" "^idle_branch=$idle_branch$" 'drift release missing idle branch'
  assert_line "$output" '^idle_head=[0-9a-fA-F]{40}$' 'drift release missing idle HEAD'
  assert_line "$output" '^origin_main=[0-9a-fA-F]{40}$' 'drift release missing origin main'
  assert_line "$output" '^clean=yes$' 'drift release missing clean state'
  assert_line "$output" '^state=FREE$' 'drift release missing FREE state'
}

setup_main_drift() {
  DRIFT_LANE=main
  DRIFT_ISSUE=$1
  DRIFT_BRANCH=$2
  DRIFT_BASE=$(git -C "$MAIN" rev-parse origin/main)
  DRIFT_BEGIN_OUTPUT=$({ "$HELPER" begin main "$DRIFT_ISSUE" "$DRIFT_BASE" "$DRIFT_BRANCH" FREE; })
  DRIFT_CLAIM=$(printf '%s\n' "$DRIFT_BEGIN_OUTPUT" | sed -n 's/^claim=//p')
  DRIFT_FILE="$MAIN/drift-$DRIFT_ISSUE"
  printf '%s\n' "$DRIFT_ISSUE" > "$DRIFT_FILE"
  git -C "$MAIN" add "$DRIFT_FILE"
  git -C "$MAIN" commit -qm "drift $DRIFT_ISSUE"
  DRIFT_CHECKPOINT=$(git -C "$MAIN" rev-parse HEAD)
  git -C "$MAIN" push -q -u origin "$DRIFT_BRANCH"
  merge_topic_into_main "$DRIFT_BRANCH"
  git -C "$SEED" push -q origin ":$DRIFT_BRANCH"
  git -C "$MAIN" switch -q main
}

setup_sub_drift() {
  DRIFT_LANE=sub
  DRIFT_ISSUE=$1
  DRIFT_BRANCH=$2
  sync_free_lanes
  DRIFT_BASE=$(git -C "$MAIN" rev-parse origin/main)
  DRIFT_BEGIN_OUTPUT=$({ "$HELPER" begin sub "$DRIFT_ISSUE" "$DRIFT_BASE" "$DRIFT_BRANCH" FREE; })
  DRIFT_CLAIM=$(printf '%s\n' "$DRIFT_BEGIN_OUTPUT" | sed -n 's/^claim=//p')
  DRIFT_FILE="$SUB/drift-$DRIFT_ISSUE"
  printf '%s\n' "$DRIFT_ISSUE" > "$DRIFT_FILE"
  git -C "$SUB" add "$DRIFT_FILE"
  git -C "$SUB" commit -qm "drift $DRIFT_ISSUE"
  DRIFT_CHECKPOINT=$(git -C "$SUB" rev-parse HEAD)
  git -C "$SUB" push -q -u origin "$DRIFT_BRANCH"
  merge_topic_into_main "$DRIFT_BRANCH"
  git -C "$SUB" switch -q --detach "$DRIFT_BASE"
}

setup_main_unmerged_drift() {
  DRIFT_LANE=main
  DRIFT_ISSUE=$1
  DRIFT_BRANCH=$2
  DRIFT_BASE=$(git -C "$MAIN" rev-parse origin/main)
  DRIFT_BEGIN_OUTPUT=$({ "$HELPER" begin main "$DRIFT_ISSUE" "$DRIFT_BASE" "$DRIFT_BRANCH" FREE; })
  DRIFT_CLAIM=$(printf '%s\n' "$DRIFT_BEGIN_OUTPUT" | sed -n 's/^claim=//p')
  DRIFT_FILE="$MAIN/drift-$DRIFT_ISSUE"
  printf '%s\n' "$DRIFT_ISSUE" > "$DRIFT_FILE"
  git -C "$MAIN" add "$DRIFT_FILE"
  git -C "$MAIN" commit -qm "unmerged drift $DRIFT_ISSUE"
  DRIFT_CHECKPOINT=$(git -C "$MAIN" rev-parse HEAD)
  git -C "$MAIN" push -q -u origin "$DRIFT_BRANCH"
  git -C "$MAIN" switch -q main
}

release_drift_main() {
  DRIFT_RELEASE_OUTPUT=$({ "$HELPER" release main "$DRIFT_CHECKPOINT" "$DRIFT_CLAIM"; })
  assert_release_envelope "$DRIFT_RELEASE_OUTPUT" main "$DRIFT_CHECKPOINT" "$DRIFT_CLAIM" "$DRIFT_BRANCH" main
}

release_drift_sub() {
  DRIFT_RELEASE_OUTPUT=$({ "$HELPER" release sub "$DRIFT_CHECKPOINT" "$DRIFT_CLAIM"; })
  assert_release_envelope "$DRIFT_RELEASE_OUTPUT" sub "$DRIFT_CHECKPOINT" "$DRIFT_CLAIM" "$DRIFT_BRANCH" DETACHED
}

expect_release_blocked_command() {
  name=$1
  lane=$2
  shift 2
  before_branch=$(git -C "$lane" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  before_head=$(git -C "$lane" rev-parse HEAD)
  before_status=$(git -C "$lane" status --porcelain)
  before_refs=$(local_lane_refs "$MAIN")
  before_slot=$(cat "$(slot_state "$lane")")
  before_lock=$(if [ -f "$(gitdir "$lane")/nuinui-implementation-lock/state" ]; then cat "$(gitdir "$lane")/nuinui-implementation-lock/state"; else echo absent; fi)
  before_tombstones=$(find "$(gitdir "$lane")" -maxdepth 1 -type d -name 'nuinui-implementation-slot.releasing.*' -print 2>/dev/null | sort)
  if output=$({ "$@"; } 2>&1); then
    printf '%s\n' "$output"
    fail "$name unexpectedly succeeded"
  else
    rc=$?
  fi
  [ "$rc" -ne 0 ] || fail "$name returned zero"
  printf '%s\n' "$output" | grep -q '^BLOCKED:' || {
    printf '%s\n' "$output"
    fail "$name did not fail closed"
  }
  [ "$before_branch" = "$(git -C "$lane" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" ] || fail "$name changed branch"
  [ "$before_head" = "$(git -C "$lane" rev-parse HEAD)" ] || fail "$name changed HEAD"
  [ "$before_status" = "$(git -C "$lane" status --porcelain)" ] || fail "$name changed working tree"
  [ "$before_refs" = "$(local_lane_refs "$MAIN")" ] || fail "$name changed local refs"
  [ "$before_slot" = "$(cat "$(slot_state "$lane")")" ] || fail "$name changed durable slot"
  after_lock=$(if [ -f "$(gitdir "$lane")/nuinui-implementation-lock/state" ]; then cat "$(gitdir "$lane")/nuinui-implementation-lock/state"; else echo absent; fi)
  after_tombstones=$(find "$(gitdir "$lane")" -maxdepth 1 -type d -name 'nuinui-implementation-slot.releasing.*' -print 2>/dev/null | sort)
  [ "$before_lock" = "$after_lock" ] || fail "$name changed mutation lock"
  [ "$before_tombstones" = "$after_tombstones" ] || fail "$name changed release tombstone state"
  echo "PASS: $name"
}

expect_release_blocked_drift() {
  case "$DRIFT_LANE" in
    main) drift_repo=$MAIN ;;
    sub) drift_repo=$SUB ;;
    *) fail "unknown drift lane: $DRIFT_LANE" ;;
  esac
  expect_release_blocked_command "$1" "$drift_repo" "$HELPER" release "$DRIFT_LANE" "$DRIFT_CHECKPOINT" "$DRIFT_CLAIM"
}

git init -q --bare "$REMOTE"
git -C "$REMOTE" symbolic-ref HEAD refs/heads/main
git init -q -b main "$SEED"
git -C "$SEED" config user.name test
git -C "$SEED" config user.email test@example.invalid
printf 'base\n' > "$SEED/a"
git -C "$SEED" add a
git -C "$SEED" commit -qm base
git -C "$SEED" remote add origin "$REMOTE"
git -C "$SEED" push -qu origin main
git clone -q "$REMOTE" "$MAIN"
git -C "$MAIN" config user.name test
git -C "$MAIN" config user.email test@example.invalid
git -C "$MAIN" worktree add -q --detach "$SUB" origin/main
git -C "$MAIN" worktree add -q --detach "$E2E" origin/main
mkdir -p "$E2E_CLOSURE_TEMP" "$E2E_CLOSURE_TMPDIR"

export NUINUI_SELFTEST=1
export NUINUI_MAIN_WT="$MAIN"
export NUINUI_SUB_WT="$SUB"
export NUINUI_E2E_WT="$E2E"

"$HELPER" lane-init main >/dev/null
"$HELPER" lane-init sub >/dev/null
BASE="$(git -C "$MAIN" rev-parse origin/main)"
ALTERNATE_BASE="$(git -C "$SEED" commit-tree "$(git -C "$SEED" rev-parse HEAD^{tree})" -p "$BASE" -m 'alternate begin base')"

E2E_MARKER="$(gitdir "$E2E")/nuinui-slot"
[ -z "$(git -C "$E2E" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" ] || fail 'E2E setup is not detached'
[ -z "$(git -C "$E2E" status --porcelain)" ] || fail 'E2E setup is not clean'
[ ! -e "$E2E_MARKER" ] || fail 'E2E setup has a marker'
E2E_TESTED_REF="$(git -C "$E2E" rev-parse origin/main)"
[ "$(git -C "$E2E" rev-parse HEAD)" = "$E2E_TESTED_REF" ] || fail 'E2E setup is not at origin/main'
E2E_START_OUTPUT=$("$HELPER" e2e-start SAY-299 "$E2E_TESTED_REF")
[ "$(printf '%s\n' "$E2E_START_OUTPUT" | tail -n 1)" = 'E2E STARTED' ] || { printf '%s\n' "$E2E_START_OUTPUT"; fail 'normal E2E start did not return exact success output'; }
[ -z "$(git -C "$E2E" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" ] || fail 'normal E2E start attached the checkout'
[ "$(git -C "$E2E" rev-parse HEAD)" = "$E2E_TESTED_REF" ] || fail 'normal E2E start changed the tested ref'
[ -z "$(git -C "$E2E" status --porcelain)" ] || fail 'normal E2E start dirtied the checkout'
[ -f "$E2E_MARKER" ] || fail 'normal E2E start did not create the marker'
[ ! -e "$(gitdir "$E2E")/nuinui-e2e-session" ] || fail 'release-ready E2E state has prep session metadata'
[ "$(cat "$E2E_MARKER")" = "$(printf 'issue=SAY-299\nref=%s\n' "$E2E_TESTED_REF")" ] || fail 'normal E2E start wrote the wrong marker'
echo 'PASS: release-ready E2E state preserves marker until e2e-release'
if E2E_CLOSURE_OUTPUT=$(e2e_closure_check SAY-299 2>&1); then
  printf '%s\n' "$E2E_CLOSURE_OUTPUT"
  fail 'release-ready same-Issue closure-check unexpectedly succeeded'
else
  E2E_CLOSURE_RC=$?
fi
[ "$E2E_CLOSURE_RC" -ne 0 ] || fail 'release-ready same-Issue closure-check returned zero'
assert_line "$E2E_CLOSURE_OUTPUT" '^  marker=BLOCKING-SAME-ISSUE$' 'release-ready closure-check did not block on the marker'
assert_line "$E2E_CLOSURE_OUTPUT" '^  session=none-for-requested-issue$' 'release-ready closure-check did not prove no prep session'
assert_line "$E2E_CLOSURE_OUTPUT" '^E2E CLOSURE BLOCKED$' 'release-ready closure-check did not report BLOCKED'
E2E_RELEASE_OUTPUT=$("$HELPER" e2e-release)
[ "$(printf '%s\n' "$E2E_RELEASE_OUTPUT" | tail -n 1)" = 'E2E RELEASED' ] || { printf '%s\n' "$E2E_RELEASE_OUTPUT"; fail 'normal E2E release did not return exact success output'; }
[ ! -e "$E2E_MARKER" ] || fail 'normal E2E release retained the marker'
[ -z "$(git -C "$E2E" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" ] || fail 'normal E2E release attached the checkout'
[ -z "$(git -C "$E2E" status --porcelain)" ] || fail 'normal E2E release dirtied the checkout'
E2E_RELEASE_REF="$(git -C "$E2E" rev-parse origin/main)"
[ "$(git -C "$E2E" rev-parse HEAD)" = "$E2E_RELEASE_REF" ] || fail 'normal E2E release did not return to origin/main'
E2E_CLOSURE_OUTPUT=$(e2e_closure_check SAY-299) || {
  printf '%s\n' "$E2E_CLOSURE_OUTPUT"
  fail 'post-release closure-check did not become clean'
}
assert_line "$E2E_CLOSURE_OUTPUT" '^E2E CLOSURE CLEAN$' 'post-release closure-check did not report clean'
echo 'PASS: normal E2E start/release regression'

expect_old_signature_rejected 'old claimless resume signature' resume main SAY-1 "$BASE" old-branch
expect_old_signature_rejected 'old claimless release signature' release main "$BASE"

BRANCH1=sayosomi/say-201-begin-free
OUT1=$("$HELPER" begin main SAY-201 "$BASE" "$BRANCH1" FREE)
assert_line "$OUT1" '^IMPLEMENTATION STARTED$' 'FREE peer begin missing header'
assert_line "$OUT1" '^lane=main$' 'FREE peer begin missing lane'
assert_line "$OUT1" '^issue=SAY-201$' 'FREE peer begin missing Issue'
assert_line "$OUT1" "^branch=$BRANCH1$" 'FREE peer begin missing branch'
assert_line "$OUT1" "^base=$BASE$" 'FREE peer begin missing base'
assert_line "$OUT1" '^checkpoint=[0-9a-fA-F]{40}$' 'FREE peer begin missing checkpoint'
assert_line "$OUT1" '^claim=[0-9A-Za-z][0-9A-Za-z._-]{7,127}$' 'FREE peer begin missing claim'
assert_line "$OUT1" '^clean=yes$' 'FREE peer begin missing clean state'
assert_line "$OUT1" '^state=BUSY$' 'FREE peer begin missing BUSY state'
assert_line "$OUT1" '^peer_lane=sub$' 'FREE peer begin missing peer lane'
assert_line "$OUT1" '^peer_state=FREE$' 'FREE peer begin wrong peer state'
assert_line "$OUT1" '^peer_issue=-$' 'FREE peer begin wrong peer Issue'
assert_line "$OUT1" '^preflight=PASS$' 'FREE peer begin missing preflight proof'
CLAIM1="$(printf '%s\n' "$OUT1" | sed -n 's/^claim=//p')"
CHECKPOINT1="$(printf '%s\n' "$OUT1" | sed -n 's/^checkpoint=//p')"

expect_begin_duplicate 'exact duplicate with FREE peer' "$MAIN" "$SUB" main SAY-201 "$BASE" "$BRANCH1" FREE "$CLAIM1" FREE - sub
expect_begin_conflict 'duplicate different Issue' "$MAIN" "$SUB" main SAY-999 "$BASE" "$BRANCH1" FREE
expect_begin_conflict 'duplicate different branch' "$MAIN" "$SUB" main SAY-201 "$BASE" sayosomi/say-201-other-branch FREE
expect_begin_conflict 'duplicate different Base' "$MAIN" "$SUB" main SAY-201 "$ALTERNATE_BASE" "$BRANCH1" FREE
expect_begin_conflict 'duplicate different peer expectation' "$MAIN" "$SUB" main SAY-201 "$BASE" "$BRANCH1" SAY-999
printf 'begin advanced checkpoint\n' > "$MAIN/begin-advanced"
git -C "$MAIN" add begin-advanced
git -C "$MAIN" commit -qm 'advance begin duplicate checkpoint'
ADVANCED_CHECKPOINT="$(git -C "$MAIN" rev-parse HEAD)"
expect_begin_conflict 'duplicate progressed beyond Base' "$MAIN" "$SUB" main SAY-201 "$BASE" "$BRANCH1" FREE

SLOT_BEFORE_RELEASE_FAILURE="$(cat "$(slot_state "$MAIN")")"
WRONG_CHECKPOINT=0000000000000000000000000000000000000000
if "$HELPER" release main "$WRONG_CHECKPOINT" "$CLAIM1" >"$ROOT/wrong-checkpoint-release.out" 2>&1; then
  cat "$ROOT/wrong-checkpoint-release.out"
  fail 'wrong checkpoint release unexpectedly succeeded'
