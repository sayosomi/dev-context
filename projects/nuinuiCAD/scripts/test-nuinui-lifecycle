assert_line "$(cat "$ROOT/wrong-checkpoint-release.out")" "^actual=$WRONG_CHECKPOINT$" 'wrong checkpoint release omitted actual checkpoint'
[ "$(cat "$(slot_state "$MAIN")")" = "$SLOT_BEFORE_RELEASE_FAILURE" ] || fail 'wrong checkpoint release changed durable ownership'
echo 'PASS: wrong checkpoint release retains BUSY ownership'

