RACE_BIN="$ROOT/race-bin"
mkdir "$RACE_BIN"
RACE_COUNTER="$ROOT/race-counter"
printf '0\n' > "$RACE_COUNTER"
RACE_REAL_GIT="$(command -v git)"
printf '%s\n' \
  '#!/bin/sh' \
  'case "$*" in' \
  '  *ls-remote*"refs/heads/$RACE_GIT_BRANCH"*)' \
  '    race_count=$(cat "$RACE_GIT_COUNTER")' \
  '    if [ "$race_count" = 1 ]; then' \
  '      printf "2\\n" > "$RACE_GIT_COUNTER"' \
  '      "$RACE_GIT_REAL" -C "$RACE_GIT_SEED" push -q origin "$RACE_GIT_SOURCE:$RACE_GIT_BRANCH"' \
  '    else' \
  '      printf "%s\\n" "$((race_count + 1))" > "$RACE_GIT_COUNTER"' \
  '    fi' \
  '    ;;' \
  'esac' \
  'exec "$RACE_GIT_REAL" "$@"' > "$RACE_BIN/git"
chmod 755 "$RACE_BIN/git"
RACE_BEFORE_BRANCH="$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
RACE_BEFORE_HEAD="$(git -C "$MAIN" rev-parse HEAD)"
RACE_BEFORE_STATUS="$(git -C "$MAIN" status --porcelain)"
RACE_BEFORE_REFS="$(lane_refs "$MAIN")"
RACE_BEFORE_SLOT="$(cat "$(slot_state "$MAIN")")"
if RACE_OUTPUT=$(PATH="$RACE_BIN:$PATH" \
  RACE_GIT_REAL="$RACE_REAL_GIT" \
  RACE_GIT_COUNTER="$RACE_COUNTER" \
  RACE_GIT_SEED="$SEED" \
  RACE_GIT_SOURCE="$RACE_SOURCE_BRANCH" \
  RACE_GIT_BRANCH="$PREPUSH_BRANCH" \
  "$HELPER" resume main SAY-216 "$PREPUSH_BASE" "$PREPUSH_BASE" "$PREPUSH_BRANCH" "$PREPUSH_CLAIM" 2>&1); then
  printf '%s\n' "$RACE_OUTPUT"
  fail 'pre-push remote race unexpectedly succeeded'
else
  RACE_RC=$?
fi
[ "$RACE_RC" -ne 0 ] || fail 'pre-push remote race returned zero'
printf '%s\n' "$RACE_OUTPUT" | grep -q '^BLOCKED:' || {
  printf '%s\n' "$RACE_OUTPUT"
  fail 'pre-push remote race did not fail closed'
}
[ "$RACE_BEFORE_BRANCH" = "$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" ] || fail 'pre-push remote race changed branch'
[ "$RACE_BEFORE_HEAD" = "$(git -C "$MAIN" rev-parse HEAD)" ] || fail 'pre-push remote race changed HEAD'
[ "$RACE_BEFORE_STATUS" = "$(git -C "$MAIN" status --porcelain)" ] || fail 'pre-push remote race changed working tree'
[ "$RACE_BEFORE_REFS" = "$(lane_refs "$MAIN")" ] || fail 'pre-push remote race changed local refs'
[ "$RACE_BEFORE_SLOT" = "$(cat "$(slot_state "$MAIN")")" ] || fail 'pre-push remote race changed durable ownership'
RACE_REMOTE="$(git -C "$MAIN" ls-remote --exit-code --heads origin "refs/heads/$PREPUSH_BRANCH")" || fail 'pre-push remote race did not create its test remote topic'
RACE_REMOTE_HEAD="$(printf '%s\n' "$RACE_REMOTE" | awk 'NR == 1 {print $1}')"
RACE_REMOTE_REF="$(printf '%s\n' "$RACE_REMOTE" | awk 'NR == 1 {print $2}')"
