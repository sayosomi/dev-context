setup_started() {
  sync_idle
  rm -rf "$(slot_dir)" "$(lock_dir)" "$(receipt_path)"
  clear_tombstones
  printf 'version=1\n' > "$(marker_path)"
  ACTIVE_ISSUE=$1
  ACTIVE_BRANCH=$2
  ACTIVE_START=$(
    "$HELPER" start impl "$ACTIVE_ISSUE" "$BASE" "$ACTIVE_BRANCH"
  ) || fail "could not start $ACTIVE_ISSUE"
  ACTIVE_CLAIM=$(printf '%s\n' "$ACTIVE_START" | sed -n 's/^claim=//p')
  [ -n "$ACTIVE_CLAIM" ] || fail "start $ACTIVE_ISSUE did not return a claim"
}

setup_active() {
  setup_started "$1" "$2"
  printf '%s\n' "$ACTIVE_ISSUE" > "$IMPL/lifecycle-$ACTIVE_ISSUE"
  git -C "$IMPL" add "lifecycle-$ACTIVE_ISSUE"
  git -C "$IMPL" commit -qm "lifecycle $ACTIVE_ISSUE"
  ACTIVE_CHECKPOINT=$(git -C "$IMPL" rev-parse HEAD)
  git -C "$IMPL" push -q -u origin "$ACTIVE_BRANCH"
  if [ "${3:-no}" = yes ]; then
    git -C "$SEED" fetch -q origin "$ACTIVE_BRANCH"
    git -C "$SEED" switch -q main
    git -C "$SEED" merge -q --ff-only "origin/$ACTIVE_BRANCH"
    git -C "$SEED" push -q origin main
  fi
}

expect_active_blocked() {
  expect_blocked "$1" "$ACTIVE_CHECKPOINT" "$ACTIVE_CLAIM"
}

setup_started SAY-219 codex/SAY-219-resume-pre-mutation
RESUME_BEFORE=$(lane_snapshot)
RESUME_REAL_GIT=$(command -v git)
RESUME_FAKE_GIT_BIN=$ROOT/fake-resume-git
mkdir -p "$RESUME_FAKE_GIT_BIN"
{
  printf '%s\n' '#!/bin/sh' 'case "$3:$4:$5:$6" in' \
    'ls-remote:--exit-code:--heads:origin)' '  exit 93;;' 'esac'
  printf 'exec %s "$@"\n' "$RESUME_REAL_GIT"
} > "$RESUME_FAKE_GIT_BIN/git"
chmod 755 "$RESUME_FAKE_GIT_BIN/git"
if RESUME_FAILURE_OUTPUT=$(PATH="$RESUME_FAKE_GIT_BIN:$ORIGINAL_PATH" "$HELPER" \
  resume impl "$ACTIVE_ISSUE" "$BASE" "$BASE" "$ACTIVE_BRANCH" "$ACTIVE_CLAIM" 2>&1); then
  printf '%s\n' "$RESUME_FAILURE_OUTPUT"
  fail 'resume pre-mutation failure unexpectedly succeeded'
fi
assert_contains "$RESUME_FAILURE_OUTPUT" 'command=resume' \
  'resume pre-mutation failure did not report the public resume command'
assert_contains "$RESUME_FAILURE_OUTPUT" 'result=ERROR' \
  'resume pre-mutation failure did not fail through the public error envelope'
RESUME_AFTER=$(lane_snapshot)
[ "$RESUME_BEFORE" = "$RESUME_AFTER" ] ||
  fail 'resume pre-mutation failure changed generation or durable state'
[ ! -e "$(lock_dir)" ] || fail 'resume pre-mutation failure retained mutation lock'
RESUME_SUCCESS_OUTPUT=$("$HELPER" resume impl "$ACTIVE_ISSUE" "$BASE" "$BASE" \
  "$ACTIVE_BRANCH" "$ACTIVE_CLAIM") || {
  printf '%s\n' "$RESUME_SUCCESS_OUTPUT"
  fail 'resume did not remain valid after pre-mutation failure'
}
assert_contains "$RESUME_SUCCESS_OUTPUT" 'IMPLEMENTATION RESUMED' \
  'resume after pre-mutation failure did not prove active generation'
echo 'PASS: resume pre-mutation failure releases lock without changing generation'

assert_release_success() {
  success_output=$("$HELPER" release impl "$ACTIVE_CHECKPOINT" "$ACTIVE_CLAIM") || {
    printf '%s\n' "$success_output"
    fail "$1 did not release"
  }
  assert_contains "$success_output" 'IMPLEMENTATION RELEASED' "$1 missing release result"
  [ ! -e "$(slot_dir)" ] || fail "$1 retained active slot"
  [ ! -e "$(lock_dir)" ] || fail "$1 retained mutation lock"
  [ -f "$(receipt_path)" ] || fail "$1 did not write receipt"
  echo "PASS: $1"
}

setup_active SAY-210 codex/SAY-210-elsewhere yes
git -C "$IMPL" switch -q --detach "$BASE"
git -C "$IMPL" worktree add -q "$OTHER" "$ACTIVE_BRANCH"
expect_active_blocked 'claimed branch checked out elsewhere blocks release'
git -C "$IMPL" worktree remove --force "$OTHER"

setup_active SAY-211 codex/SAY-211-missing-ref yes
