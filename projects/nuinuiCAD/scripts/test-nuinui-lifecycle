#!/bin/sh
set -eu

SOURCE_HELPER=${1:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/nuinui}
ROOT=$(CDPATH= cd -- "$(mktemp -d "${TMPDIR:-/tmp}/nuinui-lifecycle.XXXXXX")" && pwd -P)
trap 'rm -rf "$ROOT"' EXIT HUP INT TERM

fail() { echo "LIFECYCLE TEST FAIL: $*" >&2; exit 1; }
assert_contains() { printf '%s\n' "$1" | grep -Fq -- "$2" || fail "$3"; }
assert_not_contains() { if printf '%s\n' "$1" | grep -Fq -- "$2"; then fail "$3"; fi; }
assert_no_executable_begin_line() {
  assert_not_contains "$1" "'$HELPER' 'begin'" "$2"
}

PROJECT=$ROOT/project
HELPER=$PROJECT/scripts/nuinui
REMOTE=$ROOT/sayosomi/nuinuiCAD.git
SEED=$ROOT/seed
MAIN=$ROOT/main
IMPL=$ROOT/implementation
OTHER=$ROOT/other
HUMAN=$ROOT/human
RESULT=$ROOT/result
MANIFEST=$PROJECT/LANES.conf
ORIGINAL_PATH=$PATH

mkdir -p "$PROJECT/scripts" "$ROOT/unrelated" "$(dirname "$REMOTE")"
cp "$SOURCE_HELPER" "$HELPER"
chmod 755 "$HELPER"

git init -q --bare "$REMOTE"
git init -q -b main "$SEED"
git -C "$SEED" config user.name test
git -C "$SEED" config user.email test@example.invalid
printf '%s\n' base > "$SEED/base.txt"
git -C "$SEED" add base.txt
git -C "$SEED" commit -qm base
git -C "$SEED" remote add origin "$REMOTE"
git -C "$SEED" push -qu origin main
git clone -q "$REMOTE" "$MAIN"
git -C "$MAIN" config user.name test
git -C "$MAIN" worktree add -q --detach "$IMPL" origin/main
git -C "$MAIN" worktree add -q --detach "$HUMAN" origin/main
git -C "$IMPL" config user.name test
git -C "$IMPL" config user.email test@example.invalid
git -C "$HUMAN" config user.name test
git -C "$HUMAN" config user.email test@example.invalid
git init -q "$RESULT"

write_manifest() {
  printf '%s\n' \
    'version=1' \
    'repository=sayosomi/nuinuiCAD' \
    'default_branch=main' \
    '' \
    '[lane source]' \
    'role=implementation' \
    "path=$MAIN" \
    'idle=branch' \
    '' \
    '[lane impl]' \
    'role=implementation' \
    "path=$IMPL" \
    'idle=detached' \
    '' \
    '[lane human]' \
    'role=human-test' \
    "path=$HUMAN" \
    'idle=detached' > "$MANIFEST"
}

write_manifest
export NUINUI_SELFTEST=1
export NUINUI_SELFTEST_RESULT_REPO=$RESULT
unset NUINUI_SELFTEST_MANIFEST NUINUI_RUNTIME_MANIFEST
cd "$ROOT/unrelated"

"$HELPER" lane-init source >/dev/null

gitdir() { git -C "$IMPL" rev-parse --absolute-git-dir; }
slot_dir() { printf '%s/nuinui-implementation-slot\n' "$(gitdir)"; }
lock_dir() { printf '%s/nuinui-implementation-lock\n' "$(gitdir)"; }
marker_path() { printf '%s/nuinui-implementation-v1\n' "$(gitdir)"; }
receipt_path() { printf '%s/nuinui-implementation-release-receipt\n' "$(gitdir)"; }

metadata_snapshot() {
  snapshot_path=$1
  if [ -L "$snapshot_path" ]; then
    printf 'symlink:%s\n' "$(readlink "$snapshot_path")"
  elif [ -f "$snapshot_path" ]; then
    cat "$snapshot_path"
  elif [ -d "$snapshot_path" ]; then
    printf 'directory\n'
  else
    printf 'absent\n'
  fi
}

tombstone_snapshot() {
  for snapshot_path in "$(gitdir)"/nuinui-implementation-slot.releasing.*; do
    if [ -d "$snapshot_path" ]; then
      printf '%s\n' "$snapshot_path"
      metadata_snapshot "$snapshot_path/state"
      metadata_snapshot "$snapshot_path/checkpoint"
    fi
  done
}

lane_snapshot() {
  printf 'branch=%s\n' "$(git -C "$IMPL" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  printf 'head=%s\n' "$(git -C "$IMPL" rev-parse HEAD)"
  printf 'status=%s\n' "$(git -C "$IMPL" status --porcelain)"
  printf 'refs=%s\n' "$(git -C "$IMPL" for-each-ref refs/heads --format='%(refname) %(objectname)' | LC_ALL=C sort)"
  printf 'slot=%s\n' "$(metadata_snapshot "$(slot_dir)/state")"
  printf 'lock=%s\n' "$(metadata_snapshot "$(lock_dir)/state")"
  printf 'tombstones=%s\n' "$(tombstone_snapshot)"
  printf 'initialization=%s\n' "$(metadata_snapshot "$(marker_path)")"
  printf 'receipt=%s\n' "$(metadata_snapshot "$(receipt_path)")"
}

clear_tombstones() {
  for clear_path in "$(gitdir)"/nuinui-implementation-slot.releasing.*; do
    [ -d "$clear_path" ] || continue
    rm -rf "$clear_path"
  done
}

sync_idle() {
  git -C "$IMPL" fetch -q origin main
  BASE=$(git -C "$IMPL" rev-parse origin/main)
  git -C "$SEED" fetch -q origin main
  git -C "$SEED" switch -q main
  git -C "$SEED" merge -q --ff-only origin/main
  rm -f "$IMPL/lifecycle-duplicate-dirty" "$IMPL/lifecycle-named-dirty"
  git -C "$IMPL" switch -q --detach "$BASE"
}

HUMAN_GIT_DIR=$(git -C "$HUMAN" rev-parse --absolute-git-dir)
HUMAN_MARKER=$HUMAN_GIT_DIR/nuinui-slot
HUMAN_SESSION=$HUMAN_GIT_DIR/nuinui-e2e-session
HUMAN_FIXTURE=$ROOT/human-fixture.nui
HUMAN_SESSION_ROOT=$ROOT/nuinui-vscode-e2e-human
HUMAN_HANDOFF=$ROOT/nuinui-SAY-401-human-e2e.env
printf '%s\n' fixture > "$HUMAN_FIXTURE"

clear_human_state() {
  rm -f "$HUMAN_MARKER" "$HUMAN_SESSION" "$HUMAN/human-dirty-file"
  git -C "$HUMAN" switch --detach -q "$BASE"
}

write_human_marker() {
  printf 'issue=%s\nref=%s\n' "$1" "$2" > "$HUMAN_MARKER"
}

write_human_current_session() {
  printf 'lane=human\nissue=%s\nref=%s\nsource_fixture=%s\nroot=%s\nhandoff=%s\ncdp_port=9223\nlaunch_pid=1\nlocale=default\n' \
    "$1" "$2" "$HUMAN_FIXTURE" "$HUMAN_SESSION_ROOT" "$HUMAN_HANDOFF" > "$HUMAN_SESSION"
}

write_human_pre_locale_session() {
  printf 'lane=human\nissue=%s\nref=%s\nsource_fixture=%s\nroot=%s\nhandoff=%s\ncdp_port=9223\nlaunch_pid=1\n' \
    "$1" "$2" "$HUMAN_FIXTURE" "$HUMAN_SESSION_ROOT" "$HUMAN_HANDOFF" > "$HUMAN_SESSION"
}

write_human_preparing_session() {
  printf 'kind=preparing\nlane=human\nissue=%s\nref=%s\nroot=%s\nprepare_owner=nuinui-e2e-prepare\nprepare_pid=1\n' \
    "$1" "$2" "$HUMAN_SESSION_ROOT" > "$HUMAN_SESSION"
}

write_human_legacy_session() {
  printf 'issue=%s\nref=%s\nroot=%s\nhandoff=%s\ncdp_port=9223\nlaunch_pid=1\n' \
    "$1" "$2" "$HUMAN_SESSION_ROOT" "$HUMAN_HANDOFF" > "$HUMAN_SESSION"
}

run_human_preflight() {
  HUMAN_PREFLIGHT_RC=0
  HUMAN_PREFLIGHT_OUTPUT=$("$HELPER" preflight 2>&1) || HUMAN_PREFLIGHT_RC=$?
}

human_lane_block() {
  human_lane_name=$1
  printf '%s\n' "$HUMAN_PREFLIGHT_OUTPUT" | awk -v lane="$human_lane_name" '
    index($0, "lane name=" lane " role=human-test ") == 1 { found=1; print; next }
    found && /^lane name=/ { exit }
    found { print }
  '
}

assert_human_state() {
  human_expected_lane=$1
  human_expected_state=$2
  human_block=$(human_lane_block "$human_expected_lane") || true
  [ -n "$human_block" ] || fail "missing Human-test lane block for $human_expected_lane"
  assert_contains "$human_block" "state=$human_expected_state" \
    "Human-test lane $human_expected_lane state=$human_expected_state"
}

prepare_duplicate() {
  sync_idle
  rm -rf "$(slot_dir)" "$(lock_dir)" "$(receipt_path)"
  clear_tombstones
  printf 'version=1\n' > "$(marker_path)"
  DUPLICATE_ISSUE=SAY-200
  DUPLICATE_BRANCH=codex/SAY-200-lifecycle
  DUPLICATE_CLAIM=lifecycle-claim-200
  printf 'version=1\nlane=impl\nissue=%s\nbranch=%s\nbase=%s\ncheckpoint=%s\nclaim=%s\n' \
    "$DUPLICATE_ISSUE" "$DUPLICATE_BRANCH" "$BASE" "$BASE" \
    "$DUPLICATE_CLAIM" > "$(receipt_path)"
}

expect_blocked() {
  blocked_name=$1
  blocked_checkpoint=$2
  blocked_claim=$3
  blocked_before=$(lane_snapshot)
  if blocked_output=$("$HELPER" release impl "$blocked_checkpoint" "$blocked_claim" 2>&1); then
    printf '%s\n' "$blocked_output"
    fail "$blocked_name unexpectedly succeeded"
  fi
  assert_contains "$blocked_output" 'BLOCKED' "$blocked_name did not fail closed"
  assert_not_contains "$blocked_output" 'IMPLEMENTATION ALREADY RELEASED' \
    "$blocked_name was classified as a duplicate"
  blocked_after=$(lane_snapshot)
  [ "$blocked_before" = "$blocked_after" ] || fail "$blocked_name changed lifecycle state"
  echo "PASS: $blocked_name"
}

expect_blocked_with_path() {
  blocked_name=$1
  blocked_path=$2
  blocked_checkpoint=$3
  blocked_claim=$4
  blocked_before=$(lane_snapshot)
  if blocked_output=$(PATH="$blocked_path" "$HELPER" release impl \
    "$blocked_checkpoint" "$blocked_claim" 2>&1); then
    printf '%s\n' "$blocked_output"
    fail "$blocked_name unexpectedly succeeded"
  fi
  assert_contains "$blocked_output" 'BLOCKED' "$blocked_name did not fail closed"
  blocked_after=$(lane_snapshot)
  [ "$blocked_before" = "$blocked_after" ] || fail "$blocked_name changed lifecycle state"
  echo "PASS: $blocked_name"
}

expect_duplicate_success() {
  duplicate_before=$(lane_snapshot)
  duplicate_output=$("$HELPER" release impl "$DUPLICATE_CHECKPOINT" "$DUPLICATE_CLAIM") || {
    printf '%s\n' "$duplicate_output"
    fail 'exact duplicate release failed'
  }
  assert_contains "$duplicate_output" 'IMPLEMENTATION ALREADY RELEASED' \
    'exact duplicate release did not use the proven receipt path'
  duplicate_after=$(lane_snapshot)
  [ "$duplicate_before" = "$duplicate_after" ] || fail 'exact duplicate release changed lifecycle state'
  echo 'PASS: exact duplicate release succeeds read-only'
}

prepare_duplicate
DUPLICATE_CHECKPOINT=$BASE
expect_duplicate_success

echo 'TEST: preparing Human-test session is blocked in lane preflight'
HUMAN_GIT_DIR=$(git -C "$HUMAN" rev-parse --absolute-git-dir) || fail 'Human-test git directory lookup'
HUMAN_SESSION=$HUMAN_GIT_DIR/nuinui-e2e-session
HUMAN_PREPARING_ROOT=$ROOT/nuinui-vscode-e2e-preparing
printf 'kind=preparing\nlane=human\nissue=SAY-400\nref=%s\nroot=%s\nprepare_owner=nuinui-e2e-prepare\nprepare_pid=%s\n' \
  "$BASE" "$HUMAN_PREPARING_ROOT" "$$" > "$HUMAN_SESSION"
HUMAN_PREFLIGHT_OUTPUT=$(
  "$HELPER" preflight 2>&1
) || true
HUMAN_PREFLIGHT_LINE=$(printf '%s\n' "$HUMAN_PREFLIGHT_OUTPUT" | \
  grep -F 'lane name=human role=human-test ' | head -n 1) || \
  fail 'preflight did not report the Human-test lane'
assert_contains "$HUMAN_PREFLIGHT_LINE" 'lane name=human role=human-test' \
  'preflight Human-test lane identity missing'
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'session=present' \
  'preflight did not report the preparing Human-test session'
HUMAN_PREFLIGHT_STATE=$(printf '%s\n' "$HUMAN_PREFLIGHT_OUTPUT" | awk '
  /^lane name=human role=human-test / { found=1; next }
  found && /state=/ { print; exit }
')
assert_contains "$HUMAN_PREFLIGHT_STATE" 'state=BLOCKED' \
  'preflight projected a preparing Human-test session as available'
rm -f "$HUMAN_SESSION"
echo 'PASS: preparing Human-test session blocks FREE preflight projection'

echo 'TEST: Human-test occupancy classifier covers marker, session, and checkout authority'
clear_human_state
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" = 0 ] || fail 'clean detached Human-test lane was not FREE'
assert_human_state human FREE
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'marker=none' 'idle Human-test marker evidence'
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'session=none' 'idle Human-test session evidence'

write_human_marker SAY-401 "$BASE"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" = 0 ] || fail 'marker-only Human-test lane was not valid BUSY'
assert_human_state human BUSY
human_busy_block=$(human_lane_block human)
assert_contains "$human_busy_block" 'owner_issue=SAY-401' 'marker-only owner Issue evidence'
assert_contains "$human_busy_block" "owner_ref=$BASE" 'marker-only owner ref evidence'
assert_contains "$human_busy_block" 'session=none' 'marker-only session evidence'
echo 'PASS: marker-only active generation is BUSY with exact owner evidence'

write_human_current_session SAY-401 "$BASE"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" = 0 ] || fail 'current session was not valid BUSY'
assert_human_state human BUSY
assert_contains "$(human_lane_block human)" 'session_kind=current' 'current session kind evidence'
clear_human_state

write_human_marker SAY-402 "$BASE"
write_human_pre_locale_session SAY-402 "$BASE"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" = 0 ] || fail 'pre-locale session was not valid BUSY'
assert_human_state human BUSY
assert_contains "$(human_lane_block human)" 'session_kind=pre-locale' 'pre-locale session kind evidence'
clear_human_state

write_human_marker SAY-403 "$BASE"
write_human_preparing_session SAY-403 "$BASE"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" = 0 ] || fail 'preparing session was not valid BUSY'
assert_human_state human BUSY
assert_contains "$(human_lane_block human)" 'session_kind=preparing' 'preparing session kind evidence'
clear_human_state

write_human_marker SAY-404 "$BASE"
write_human_legacy_session SAY-404 "$BASE"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" = 0 ] || fail 'legacy session was not valid BUSY'
assert_human_state human BUSY
assert_contains "$(human_lane_block human)" 'session_kind=legacy' 'legacy session kind evidence'
clear_human_state

printf 'issue=SAY-405\n' > "$HUMAN_MARKER"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" != 0 ] || fail 'malformed Human-test marker was accepted'
assert_human_state human BLOCKED
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'reason=invalid-marker' 'malformed marker reason'
clear_human_state

write_human_current_session SAY-406 "$BASE"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" != 0 ] || fail 'orphan current session was accepted'
assert_human_state human BLOCKED
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'reason=orphan-session' 'orphan current session reason'
clear_human_state

write_human_preparing_session SAY-407 "$BASE"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" != 0 ] || fail 'orphan preparing session was accepted'
assert_human_state human BLOCKED
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'reason=orphan-session' 'orphan preparing session reason'
clear_human_state

write_human_marker SAY-408 "$BASE"
printf 'lane=human\nissue=SAY-408\n' > "$HUMAN_SESSION"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" != 0 ] || fail 'malformed Human-test session was accepted'
assert_human_state human BLOCKED
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'reason=invalid-session' 'malformed session reason'
clear_human_state

write_human_marker SAY-409 "$BASE"
write_human_current_session SAY-410 "$BASE"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" != 0 ] || fail 'marker/session Issue mismatch was accepted'
assert_human_state human BLOCKED
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'reason=marker-session-issue-mismatch' \
  'marker/session Issue mismatch reason'
clear_human_state

HUMAN_OTHER_REF=$(git -C "$HUMAN" commit --allow-empty -qm classifier-ref-mismatch &&
  git -C "$HUMAN" rev-parse HEAD)
git -C "$HUMAN" switch --detach -q "$BASE"
write_human_marker SAY-411 "$BASE"
write_human_current_session SAY-411 "$HUMAN_OTHER_REF"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" != 0 ] || fail 'marker/session ref mismatch was accepted'
assert_human_state human BLOCKED
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'reason=marker-session-ref-mismatch' \
  'marker/session ref mismatch reason'
clear_human_state

write_human_marker SAY-412 "$BASE"
printf 'lane=other-human\nissue=SAY-412\nref=%s\nsource_fixture=%s\nroot=%s\nhandoff=%s\ncdp_port=9223\nlaunch_pid=1\nlocale=default\n' \
  "$BASE" "$HUMAN_FIXTURE" "$HUMAN_SESSION_ROOT" "$HUMAN_HANDOFF" > "$HUMAN_SESSION"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" != 0 ] || fail 'session lane mismatch was accepted'
assert_human_state human BLOCKED
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'reason=session-lane-mismatch' 'session lane mismatch reason'
clear_human_state

write_human_marker SAY-413 "$HUMAN_OTHER_REF"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" != 0 ] || fail 'marker/checkout HEAD mismatch was accepted'
assert_human_state human BLOCKED
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'reason=checkout-head-mismatch' \
  'marker/checkout HEAD mismatch reason'
clear_human_state

write_human_marker SAY-414 "$BASE"
touch "$HUMAN/human-dirty-file"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" != 0 ] || fail 'dirty active Human-test checkout was accepted'
assert_human_state human BLOCKED
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'reason=dirty-checkout' 'dirty active checkout reason'
clear_human_state

write_human_marker SAY-415 "$BASE"
git -C "$HUMAN" switch -q -c classifier-named-checkout
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" != 0 ] || fail 'named active Human-test checkout was accepted'
assert_human_state human BLOCKED
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'reason=named-checkout' 'named active checkout reason'
clear_human_state

ln -s "$HUMAN_FIXTURE" "$HUMAN_MARKER"
run_human_preflight
[ "$HUMAN_PREFLIGHT_RC" != 0 ] || fail 'symlink Human-test marker was accepted'
assert_human_state human BLOCKED
assert_contains "$HUMAN_PREFLIGHT_OUTPUT" 'reason=invalid-marker-type' 'symlink marker reason'
clear_human_state
echo 'PASS: Human-test marker/session/checkout classification matrix'

echo 'TEST: e2e-start exact duplicate remains a read-only already-active generation'
e2e_start_output=$("$HELPER" e2e-start human SAY-416 "$BASE") || fail 'initial exact duplicate setup start'
assert_contains "$e2e_start_output" 'E2E STARTED' 'initial Human-test start'
e2e_duplicate_output=$("$HELPER" e2e-start human SAY-416 "$BASE") || fail 'exact duplicate Human-test start'
assert_contains "$e2e_duplicate_output" 'E2E ALREADY STARTED' 'exact duplicate Human-test start no-op'
"$HELPER" e2e-release human SAY-416 "$BASE" >/dev/null || fail 'exact duplicate cleanup release'
echo 'PASS: e2e-start exact duplicate remains read-only'

prepare_duplicate
if MISSING_NAMED_OUTPUT=$(
  "$HELPER" begin-command --lane impl --issue SAY-300 --base "$BASE" 2>&1
); then
  printf '%s\n' "$MISSING_NAMED_OUTPUT"
  fail 'missing required named option unexpectedly succeeded'
fi
assert_contains "$MISSING_NAMED_OUTPUT" \
  'ERROR: missing required named option --branch' \
  'missing required named option was not diagnosed'
assert_no_executable_begin_line "$MISSING_NAMED_OUTPUT" \
  'missing required named option emitted an executable begin line'
echo 'PASS: begin-command missing required named option'

prepare_duplicate
if DUPLICATE_NAMED_OUTPUT=$(
  "$HELPER" begin-command --lane impl --issue SAY-300 --base "$BASE" \
    --branch codex/SAY-300-duplicate --lane impl 2>&1
); then
  printf '%s\n' "$DUPLICATE_NAMED_OUTPUT"
  fail 'duplicate named option unexpectedly succeeded'
fi
assert_contains "$DUPLICATE_NAMED_OUTPUT" \
  'ERROR: duplicate named option --lane' \
  'duplicate named option was not diagnosed'
assert_no_executable_begin_line "$DUPLICATE_NAMED_OUTPUT" \
  'duplicate named option emitted an executable begin line'
echo 'PASS: begin-command duplicate named option'

prepare_duplicate
if UNKNOWN_NAMED_OUTPUT=$(
  "$HELPER" begin-command --lane impl --issue SAY-300 --base "$BASE" \
    --branch codex/SAY-300-unknown --unknown value 2>&1
); then
  printf '%s\n' "$UNKNOWN_NAMED_OUTPUT"
  fail 'unknown named option unexpectedly succeeded'
fi
assert_contains "$UNKNOWN_NAMED_OUTPUT" 'ERROR: unknown option --unknown' \
  'unknown named option was not diagnosed'
assert_no_executable_begin_line "$UNKNOWN_NAMED_OUTPUT" \
  'unknown named option emitted an executable begin line'
echo 'PASS: begin-command unknown named option'

prepare_duplicate
if WRONG_ROLE_NAMED_OUTPUT=$(
  "$HELPER" begin-command --lane human --issue SAY-300 --base "$BASE" \
    --branch codex/SAY-300-wrong-role 2>&1
); then
  printf '%s\n' "$WRONG_ROLE_NAMED_OUTPUT"
  fail 'wrong-role lane unexpectedly succeeded'
fi
assert_contains "$WRONG_ROLE_NAMED_OUTPUT" \
  'selected lane is not a declared implementation lane' \
  'wrong-role lane was not diagnosed'
assert_no_executable_begin_line "$WRONG_ROLE_NAMED_OUTPUT" \
  'wrong-role lane emitted an executable begin line'
echo 'PASS: begin-command invalid lane role'

prepare_duplicate
if INVALID_RELATION_OUTPUT=$(
  "$HELPER" begin-command --lane impl --issue SAY-300 --base "$BASE" \
    --branch codex/SAY-301-invalid-relation 2>&1
); then
  printf '%s\n' "$INVALID_RELATION_OUTPUT"
  fail 'invalid Issue/branch relation unexpectedly succeeded'
fi
assert_contains "$INVALID_RELATION_OUTPUT" \
  'branch issue identifier does not match requested Issue' \
  'invalid Issue/branch relation was not diagnosed'
assert_no_executable_begin_line "$INVALID_RELATION_OUTPUT" \
  'invalid Issue/branch relation emitted an executable begin line'
echo 'PASS: begin-command invalid Issue/branch relation'

prepare_duplicate
if INVALID_SHA_OUTPUT=$(
  "$HELPER" begin-command --lane impl --issue SAY-300 --base invalid-sha \
    --branch codex/SAY-300-invalid-sha 2>&1
); then
  printf '%s\n' "$INVALID_SHA_OUTPUT"
  fail 'invalid SHA unexpectedly succeeded'
fi
assert_contains "$INVALID_SHA_OUTPUT" 'ERROR: invalid --base' \
  'invalid SHA was not diagnosed'
assert_no_executable_begin_line "$INVALID_SHA_OUTPUT" \
  'invalid SHA emitted an executable begin line'
echo 'PASS: begin-command invalid SHA'

prepare_duplicate
STALE_BASE=$(printf '%s\n' stale | git -C "$IMPL" commit-tree \
  "${BASE}^{tree}" -m stale-base)
if STALE_BASE_OUTPUT=$(
  "$HELPER" begin-command --lane impl --issue SAY-300 --base "$STALE_BASE" \
    --branch codex/SAY-300-stale-base 2>&1
); then
  printf '%s\n' "$STALE_BASE_OUTPUT"
  fail 'stale Base unexpectedly succeeded'
fi
assert_contains "$STALE_BASE_OUTPUT" \
  'read-only verify failed' 'stale Base was not rejected by read-only verify'
assert_no_executable_begin_line "$STALE_BASE_OUTPUT" \
  'stale Base emitted an executable begin line'
echo 'PASS: begin-command stale Base'

prepare_duplicate
READ_ONLY_BEFORE=$(lane_snapshot)
if READ_ONLY_OUTPUT=$(
  "$HELPER" begin-command --branch codex/SAY-300-read-only --base "$BASE" \
    --issue SAY-300 --lane impl 2>&1
); then
  :
else
  printf '%s\n' "$READ_ONLY_OUTPUT"
  fail 'read-only begin-command unexpectedly failed'
fi
assert_contains "$READ_ONLY_OUTPUT" 'BEGIN COMMAND READY' \
  'successful begin-command omitted its readiness envelope'
READ_ONLY_LINE=$(printf '%s\n' "$READ_ONLY_OUTPUT" |
  sed -n '/^BEGIN COMMAND READY$/{n;p;}')
assert_contains "$READ_ONLY_LINE" "'source=FREE,impl=FREE'" \
  'successful begin-command did not emit canonical complete inventory'
READ_ONLY_AFTER=$(lane_snapshot)
[ "$READ_ONLY_BEFORE" = "$READ_ONLY_AFTER" ] ||
  fail 'successful begin-command changed lifecycle state'
echo 'PASS: begin-command success preserves read-only state'

