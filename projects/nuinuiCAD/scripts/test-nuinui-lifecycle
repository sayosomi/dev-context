setup_started SAY-218 codex/SAY-218-receipt-failure
RECEIPT_FAILURE=$(receipt_path)
mkdir "$RECEIPT_FAILURE"
if RECEIPT_FAILURE_OUTPUT=$("$HELPER" release impl "$BASE" "$ACTIVE_CLAIM" 2>&1); then
  printf '%s\n' "$RECEIPT_FAILURE_OUTPUT"
  fail 'receipt write failure unexpectedly succeeded'
fi
assert_contains "$RECEIPT_FAILURE_OUTPUT" 'BLOCKED' 'receipt write failure did not fail closed'
[ ! -e "$(slot_dir)" ] || fail 'receipt write failure dropped active slot incorrectly'
[ -d "$(lock_dir)" ] || fail 'receipt write failure dropped mutation lock'
RECEIPT_FAILURE_TOMBSTONE=$(tombstone_snapshot)
[ -n "$RECEIPT_FAILURE_TOMBSTONE" ] || fail 'receipt write failure dropped release tombstone'
[ -d "$RECEIPT_FAILURE" ] || fail 'receipt write failure did not retain its injected fault'
rm -rf "$RECEIPT_FAILURE"
RECOVER_OUTPUT=$($HELPER recover impl "$ACTIVE_CLAIM")
assert_contains "$RECOVER_OUTPUT" 'RECOVERED operation=release' \
  'recover did not complete interrupted release'
[ -f "$(receipt_path)" ] || fail 'recover did not restore release receipt'
[ ! -e "$(lock_dir)" ] || fail 'recover retained release lock'
[ -z "$(tombstone_snapshot)" ] || fail 'recover retained release tombstone'
echo 'PASS: release receipt write failure retains recoverable state and recover completes it'

echo 'NUINUI LIFECYCLE TEST PASS'
