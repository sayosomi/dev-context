mkdir "$DRIFT_RACE_BIN"
DRIFT_RACE_COUNTER="$ROOT/release-race-counter"
printf '0\n' > "$DRIFT_RACE_COUNTER"
DRIFT_RACE_REAL_GIT="$(command -v git)"
printf '%s\n' \
  '#!/bin/sh' \
  'case "$*" in' \
  '  *ls-remote*"refs/heads/$RACE_GIT_BRANCH"*)' \
  '    race_output=$("$RACE_GIT_REAL" "$@")' \
  '    race_rc=$?' \
  '    race_count=$(cat "$RACE_GIT_COUNTER")' \
  '    if [ "$race_count" = 0 ]; then' \
  '      printf "1\\n" > "$RACE_GIT_COUNTER"' \
  '      "$RACE_GIT_REAL" -C "$RACE_GIT_SEED" push -q origin "$RACE_GIT_SOURCE:$RACE_GIT_BRANCH"' \
  '    fi' \
  '    printf "%s" "$race_output"' \
  '    exit "$race_rc"' \
  '    ;;' \
  'esac' \
  'exec "$RACE_GIT_REAL" "$@"' > "$DRIFT_RACE_BIN/git"
chmod 755 "$DRIFT_RACE_BIN/git"
expect_release_blocked_command 'release drift remote topic race before switch' "$MAIN" \
  env PATH="$DRIFT_RACE_BIN:$PATH" \
  RACE_GIT_REAL="$DRIFT_RACE_REAL_GIT" \
  RACE_GIT_COUNTER="$DRIFT_RACE_COUNTER" \
  RACE_GIT_SEED="$SEED" \
  RACE_GIT_SOURCE="$DRIFT_RACE_SOURCE" \
  RACE_GIT_BRANCH="$DRIFT_BRANCH" \
