[ "$RACE_REMOTE_REF" = "refs/heads/$PREPUSH_BRANCH" ] || fail 'pre-push remote race returned the wrong remote ref'
git -C "$SEED" push -q origin ":$PREPUSH_BRANCH"
echo 'PASS: pre-push remote race is rejected before switch'

