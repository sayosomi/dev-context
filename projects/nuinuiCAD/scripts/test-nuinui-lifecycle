[ "$stale_release_rc" = 0 ] || { printf '%s\n' "$stale_release_output"; fail 'stale release result was not reconciled to success'; }
assert_line "$stale_release_output" '^IMPLEMENTATION RELEASED$' 'stale release result did not return released envelope'
assert_line "$stale_release_output" '^issue=SAY-215$' 'stale release result omitted captured Issue'
assert_line "$stale_release_output" "^released_claim=$STALE_RELEASE_CLAIM$" 'stale release result omitted captured claim'
assert_line "$stale_release_output" "^released_branch=$STALE_RELEASE_BRANCH$" 'stale release result omitted captured branch'
assert_line "$stale_release_output" '^state=FREE$' 'stale release result did not prove FREE state'
if printf '%s\n' "$stale_release_output" | grep -Eq '^BLOCKED: (invalid/missing active slot|release mutation completion could not be proven)$'; then
  printf '%s\n' "$stale_release_output"
  fail 'stale release result exposed a stale failure'
fi
echo 'PASS: completed release with stale result is reconciled to success'
sync_free_lanes

printf 'remote-newer\n' > "$SEED/newer"
git -C "$SEED" add newer
git -C "$SEED" commit -qm newer
git -C "$SEED" push -q origin main
expect_begin_blocked 'stale clean main is not FREE' "$MAIN" main SAY-210 "$STALE_BASE" sayosomi/say-210-stale-main FREE

expect_nonempty_failure 'preflight invalid arguments' "$HELPER" preflight extra
expect_nonempty_failure 'verify invalid arguments' "$HELPER" verify
expect_nonempty_failure 'lane-init invalid state' "$HELPER" lane-init invalid
expect_nonempty_failure 'begin invalid arguments' "$HELPER" begin
expect_nonempty_failure 'start invalid arguments' "$HELPER" start
expect_nonempty_failure 'resume invalid arguments' "$HELPER" resume
expect_nonempty_failure 'release invalid arguments' "$HELPER" release
expect_nonempty_failure 'recover invalid state' "$HELPER" recover invalid invalid-claim
expect_nonempty_failure 'e2e-start invalid arguments' "$HELPER" e2e-start invalid invalid-ref
expect_nonempty_failure 'e2e-start-local-main invalid arguments' "$HELPER" e2e-start-local-main invalid invalid-ref
expect_nonempty_failure 'e2e-release invalid state' "$HELPER" e2e-release

echo 'NUINUI LIFECYCLE SELFTEST PASS'
