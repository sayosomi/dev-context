#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd -P)
artifact=$script_dir/nuinui-e2e
manifest=$repo_root/shared/local-tools/lane-execution/manifest.sh
ownership=$repo_root/shared/local-tools/lane-execution/ownership.sh
runtime=$repo_root/shared/local-tools/lane-execution/runtime.sh
preflight=$repo_root/shared/local-tools/lane-execution/preflight.sh
identity=$script_dir/nuinui-e2e-src/identity.sh
lifecycle=$script_dir/nuinui-e2e-src/lifecycle.sh
host_fixture=$script_dir/nuinui-e2e-src/host-fixture.sh
host_vscode=$script_dir/nuinui-e2e-src/host-vscode.sh
host_session=$script_dir/nuinui-e2e-src/host-session.sh
host_closure=$script_dir/nuinui-e2e-src/host-closure.sh
cli=$script_dir/nuinui-e2e-src/cli.sh

for source in "$manifest" "$ownership" "$runtime" "$preflight" \
  "$identity" "$lifecycle" "$host_fixture" "$host_vscode" "$host_session" \
  "$host_closure" "$cli"; do
  [ -f "$source" ] && [ ! -L "$source" ] || {
    echo "generate-nuinui-e2e: unsafe or missing source: $source" >&2
    exit 1
  }
done

for source in "$manifest" "$ownership" "$runtime" "$preflight" \
  "$identity" "$lifecycle" "$host_fixture" "$host_vscode" "$host_session" \
  "$host_closure" "$cli"; do
  case "$artifact" in
    "$source") echo 'generate-nuinui-e2e: artifact aliases a source' >&2; exit 1 ;;
  esac
done
[ ! -d "$artifact" ] && [ ! -L "$artifact" ] || {
  echo "generate-nuinui-e2e: unsafe artifact destination: $artifact" >&2
  exit 1
}
if [ -e "$artifact" ]; then
  [ -f "$artifact" ] || {
    echo "generate-nuinui-e2e: artifact is not a regular file: $artifact" >&2
    exit 1
  }
fi

mode=${1-}
[ "$#" -le 1 ] || { echo 'Usage: generate-nuinui-e2e [--check]' >&2; exit 2; }
case "$mode" in
  ''|--check) ;;
  *) echo 'Usage: generate-nuinui-e2e [--check]' >&2; exit 2 ;;
esac

temporary=$(mktemp "$script_dir/.nuinui-e2e.XXXXXX") || exit 1
cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  rm -f "$temporary"
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

{
  printf '%s\n' '#!/bin/sh'
  cat "$manifest" "$ownership" "$runtime" "$preflight" \
    "$identity" "$lifecycle" "$host_fixture" "$host_vscode" "$host_session" \
    "$host_closure" "$cli"
} > "$temporary"
chmod 755 "$temporary"

if [ "$mode" = --check ]; then
  [ -f "$artifact" ] && [ ! -L "$artifact" ] && cmp -s "$temporary" "$artifact" || {
    echo 'generate-nuinui-e2e: checked-in candidate differs from declared sources' >&2
    exit 1
  }
  echo 'nuinui-e2e generation check PASS'
  exit 0
fi

mv "$temporary" "$artifact"
trap - EXIT HUP INT TERM
