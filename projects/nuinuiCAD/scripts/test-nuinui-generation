#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
repo_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd -P)
nuinui_project_policy_source=$script_dir/nuinui-src/lane-execution-profile.sh
nuinui_e2e_policy_source=$script_dir/nuinui-src/lane-execution-e2e-policy.sh
nuinui_ownership_source=$repo_root/shared/local-tools/lane-execution/ownership.sh
nuinui_manifest_source=$repo_root/shared/local-tools/lane-execution/manifest.sh
nuinui_standalone_context_source=$repo_root/shared/local-tools/lane-execution/standalone-context.sh
nuinui_runtime_source=$repo_root/shared/local-tools/lane-execution/runtime.sh
nuinui_preflight_source=$repo_root/shared/local-tools/lane-execution/preflight.sh
nuinui_inventory_source=$repo_root/shared/local-tools/lane-execution/inventory.sh
nuinui_lifecycle_source=$repo_root/shared/local-tools/lane-execution/lifecycle.sh
nuinui_human_test_source=$repo_root/shared/local-tools/lane-execution/human-test.sh
nuinui_cli_source=$repo_root/shared/local-tools/lane-execution/cli.sh
nuinui_render_source=$repo_root/shared/local-tools/lane-execution/render.sh
nuinui_implementation_operations_source=$repo_root/shared/local-tools/lane-execution/implementation-operations.sh
nuinui_release_safety_source=$repo_root/shared/local-tools/lane-execution/release-safety.sh
nuinui_body_source=$script_dir/nuinui-src/nuinui-body.sh
nuinui_github_pr_source=$script_dir/nuinui-src/github-pr.sh
nuinui_required_checks_source=$script_dir/nuinui-src/required-checks.sh
nuinui_pr_auto_merge_source=$script_dir/nuinui-src/pr-auto-merge.sh
nuinui_integration_clean_source=$script_dir/nuinui-src/integration-clean.sh
nuinui_e2e_source=$script_dir/nuinui-src/e2e.sh
nuinui_context_sync_source=$script_dir/nuinui-src/context-sync.sh
nuinui_diagnostics_source=$script_dir/nuinui-src/diagnostics.sh
nuinui_command_result_source=$script_dir/nuinui-src/command-result.sh
nuinui_self_test_source=$script_dir/nuinui-src/self-test.sh
nuinui_dispatch_source=$script_dir/nuinui-src/cli-dispatch.sh
handoff_body_source=$script_dir/nuinui-handoff-check-src/handoff-body.sh
e2e_prepare_generator=$script_dir/generate-nuinui-e2e-prepare
e2e_prepare_artifact=$script_dir/nuinui-e2e-prepare
e2e_prepare_runtime_source=$script_dir/nuinui-e2e-prepare-src/runtime.zsh
e2e_prepare_session_source=$script_dir/nuinui-e2e-prepare-src/session.zsh
e2e_prepare_commands_source=$script_dir/nuinui-e2e-prepare-src/commands.zsh

fail() {
  echo "GENERATION TEST FAIL: $*" >&2
  exit 1
}

root=$(mktemp -d "${TMPDIR:-/tmp}/nuinui-generation.XXXXXX") || exit 1
cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  rm -rf "$root"
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

[ -f "$nuinui_project_policy_source" ] || fail 'project lane policy source is missing'
[ -f "$nuinui_e2e_policy_source" ] || fail 'E2E lane policy source is missing'
for generic_source in "$nuinui_ownership_source" "$nuinui_manifest_source" \
  "$nuinui_standalone_context_source" "$nuinui_runtime_source" "$nuinui_preflight_source" "$nuinui_inventory_source" \
  "$nuinui_lifecycle_source" "$nuinui_human_test_source" "$nuinui_cli_source" \
  "$nuinui_render_source" "$nuinui_implementation_operations_source" "$nuinui_release_safety_source"; do
  [ -f "$generic_source" ] || fail "generic runtime source is missing: $generic_source"
done
[ -f "$nuinui_body_source" ] || fail 'nuinui body source is missing'
[ -f "$nuinui_github_pr_source" ] || fail 'nuinui GitHub PR source is missing'
[ -f "$nuinui_required_checks_source" ] || fail 'nuinui required-checks source is missing'
[ -f "$nuinui_pr_auto_merge_source" ] || fail 'nuinui pr-auto-merge source is missing'
[ -f "$nuinui_integration_clean_source" ] || fail 'nuinui integration-clean source is missing'
[ -f "$nuinui_e2e_source" ] || fail 'nuinui E2E source is missing'
[ -f "$nuinui_context_sync_source" ] || fail 'nuinui context-sync source is missing'
[ -f "$nuinui_diagnostics_source" ] || fail 'nuinui diagnostics source is missing'
[ -f "$nuinui_command_result_source" ] || fail 'nuinui command-result source is missing'
[ -f "$nuinui_self_test_source" ] || fail 'nuinui self-test source is missing'
[ -f "$nuinui_dispatch_source" ] || fail 'nuinui CLI dispatch source is missing'
[ -f "$handoff_body_source" ] || fail 'handoff body source is missing'
for e2e_source in "$e2e_prepare_runtime_source" "$e2e_prepare_session_source" "$e2e_prepare_commands_source"; do
  [ -f "$e2e_source" ] || fail "E2E preparation source is missing: $e2e_source"
done

test_generator() {
  name=$1
  generator=$2
  artifact_path=$3
  expected_version=$4
  candidate_a=$root/$name-candidate-a
  candidate_b=$root/$name-candidate-b

  [ -x "$generator" ] || fail "$name generator is missing or not executable"
  [ -f "$artifact_path" ] || fail "$name checked-in production artifact is missing"

  "$generator" "$candidate_a"
  "$generator" "$candidate_b"
  cmp -s "$candidate_a" "$candidate_b" || fail "$name independent candidates differ"
  cmp -s "$candidate_a" "$artifact_path" || fail "$name generated candidate differs from checked-in artifact"

  candidate_mode=$(stat -f '%Lp' "$candidate_a")
  artifact_mode=$(stat -f '%Lp' "$artifact_path")
  [ "$candidate_mode" = "$artifact_mode" ] || fail "$name generated mode $candidate_mode differs from production mode $artifact_mode"
  [ "$candidate_mode" = 755 ] || fail "$name generated candidate mode is $candidate_mode, expected 755"
  candidate_version=$("$candidate_a" version)
  [ "$candidate_version" = "$expected_version" ] || fail "$name generated candidate version is $candidate_version"

  if [ "$name" = nuinui ]; then
    for obsolete_marker in fixed_2plus1 fixed-2plus1 peer_lane expected_peer \
      '/Users/yosomi/Code/nuinuiCAD-sub'; do
      if grep -Fq -- "$obsolete_marker" "$candidate_a"; then
        fail "$name candidate contains obsolete production topology marker: $obsolete_marker"
      fi
    done
  fi
  if grep -Eq '^[[:space:]]*\.[[:space:]]+.*\.(sh|zsh)' "$candidate_a"; then
    fail "$name candidate contains runtime source loading"
  fi
  if [ "$name" = nuinui-e2e-prepare ]; then
    for obsolete_marker in '/Users/yosomi/Code/nuinuiCAD-e2e' NUINUI_E2E_PREPARE_WT; do
      if grep -Fq -- "$obsolete_marker" "$candidate_a"; then
        fail "$name candidate contains obsolete fixed topology marker: $obsolete_marker"
      fi
    done
  fi

  protected_paths="$artifact_path"
  if [ "$name" = nuinui ]; then
    protected_paths="$protected_paths $nuinui_project_policy_source $nuinui_e2e_policy_source $nuinui_ownership_source $nuinui_manifest_source $nuinui_standalone_context_source $nuinui_runtime_source $nuinui_preflight_source $nuinui_inventory_source $nuinui_lifecycle_source $nuinui_human_test_source $nuinui_cli_source $nuinui_render_source $nuinui_implementation_operations_source $nuinui_release_safety_source $nuinui_body_source $nuinui_github_pr_source $nuinui_required_checks_source $nuinui_pr_auto_merge_source $nuinui_integration_clean_source $nuinui_e2e_source $nuinui_context_sync_source $nuinui_diagnostics_source $nuinui_command_result_source $nuinui_self_test_source $nuinui_dispatch_source"
  elif [ "$name" = nuinui-handoff-check ]; then
    protected_paths="$protected_paths $nuinui_ownership_source $nuinui_manifest_source $nuinui_standalone_context_source $nuinui_runtime_source $nuinui_project_policy_source $handoff_body_source"
  else
    protected_paths="$protected_paths $nuinui_manifest_source $nuinui_standalone_context_source $nuinui_runtime_source $e2e_prepare_runtime_source $e2e_prepare_session_source $e2e_prepare_commands_source"
  fi
  for protected_path in $protected_paths; do
    protected_before=$(shasum -a 256 "$protected_path" | awk 'NR == 1 {print $1}')
    if "$generator" "$protected_path" >"$root/$name-protected-output.log" 2>&1; then
      fail "$name generator accepted protected output $protected_path"
    fi
    protected_after=$(shasum -a 256 "$protected_path" | awk 'NR == 1 {print $1}')
    [ "$protected_before" = "$protected_after" ] || fail "$name protected output changed: $protected_path"
  done

  manual_mismatch=$root/$name-manual-generated-artifact
  cp "$artifact_path" "$manual_mismatch"
  printf '\nmanual generated-artifact mismatch\n' >> "$manual_mismatch"
  if cmp -s "$candidate_a" "$manual_mismatch"; then
    fail "$name exact comparison did not detect a manual generated-artifact mismatch"
  fi

  candidate_sha256=$(shasum -a 256 "$candidate_a" | awk 'NR == 1 {print $1}')
  candidate_git_blob=$(git -C "$repo_root" hash-object "$candidate_a")
  echo "PASS: $name generation candidate_sha256=$candidate_sha256 candidate_git_blob=$candidate_git_blob"
}

test_generator nuinui "$script_dir/generate-nuinui" "$script_dir/nuinui" 1.8.0
test_generator nuinui-handoff-check "$script_dir/generate-nuinui-handoff-check" "$script_dir/nuinui-handoff-check" 1.1.0
test_generator nuinui-e2e-prepare "$e2e_prepare_generator" "$e2e_prepare_artifact" 1.4.0
echo 'GENERATION PASS'
