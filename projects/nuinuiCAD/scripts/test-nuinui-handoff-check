#!/bin/sh
set -eu

HELPER="${1:-$(cd "$(dirname "$0")" && pwd -P)/nuinui-handoff-check}"
ROOT="$(mktemp -d "${TMPDIR:-/tmp}/nuinui-handoff-check.XXXXXX")"
ROOT="$(CDPATH= cd -- "$ROOT" && pwd -P)"
trap 'rm -rf "$ROOT"' EXIT HUP INT TERM

REMOTE="$ROOT/remote.git"
SEED="$ROOT/seed"
MAIN="$ROOT/main"
SUB="$ROOT/sub"
THIRD="$ROOT/third"

fail() { echo "SELFTEST FAIL: $*"; exit 1; }
expect_blocked() {
  name="$1"; shift
  before_branch="$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  before_head="$(git -C "$MAIN" rev-parse HEAD)"
  before_status="$(git -C "$MAIN" status --porcelain)"
  before_refs="$(git -C "$MAIN" for-each-ref --format='%(refname) %(objectname)' | sort)"
  if "$@" >"$ROOT/out" 2>&1; then
    cat "$ROOT/out"
    fail "$name unexpectedly succeeded"
  fi
  grep -q '^BLOCKED:' "$ROOT/out" || { cat "$ROOT/out"; fail "$name did not fail closed"; }
  after_branch="$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  after_head="$(git -C "$MAIN" rev-parse HEAD)"
  after_status="$(git -C "$MAIN" status --porcelain)"
  after_refs="$(git -C "$MAIN" for-each-ref --format='%(refname) %(objectname)' | sort)"
  [ "$before_branch" = "$after_branch" ] || fail "$name changed branch"
  [ "$before_head" = "$after_head" ] || fail "$name changed HEAD"
  [ "$before_status" = "$after_status" ] || fail "$name changed working tree"
  [ "$before_refs" = "$after_refs" ] || fail "$name changed local refs"
  echo "PASS: $name"
}


git init -q --bare "$REMOTE"
git -C "$REMOTE" symbolic-ref HEAD refs/heads/main
git init -q -b main "$SEED"
git -C "$SEED" config user.name test
git -C "$SEED" config user.email test@example.invalid
echo base > "$SEED/a"
git -C "$SEED" add a
git -C "$SEED" commit -q -m base
git -C "$SEED" remote add origin "$REMOTE"
git -C "$SEED" push -q -u origin main

git clone -q "$REMOTE" "$MAIN"
git -C "$MAIN" config user.name test
git -C "$MAIN" config user.email test@example.invalid
git -C "$MAIN" worktree add -q --detach "$SUB" origin/main
git -C "$MAIN" worktree add -q --detach "$THIRD" origin/main

MANIFEST="$ROOT/LANES.conf"
cat > "$MANIFEST" <<MANIFEST
version=1
repository=sayosomi/nuinuiCAD
default_branch=main

[lane alpha]
role=implementation
path=$MAIN
idle=branch

[lane beta]
role=implementation
path=$SUB
idle=detached

[lane gamma]
role=implementation
path=$THIRD
idle=detached
MANIFEST

BASE="$(git -C "$MAIN" rev-parse origin/main)"
ISSUE="SAY-167"
BRANCH="sayosomi/say-167-inline-singular-geometry-substitution"
OLD_BRANCH="sayosomi/say-167-inline-planner-core"
CLAIM="claim-cp4-12345678"

git -C "$MAIN" switch -q -c "$BRANCH" "$BASE"
echo checkpoint >> "$MAIN/a"
git -C "$MAIN" add a
git -C "$MAIN" commit -q -m checkpoint
CHECKPOINT="$(git -C "$MAIN" rev-parse HEAD)"
git -C "$MAIN" push -q -u origin "$BRANCH"

git -C "$MAIN" branch "$OLD_BRANCH" "$BASE"
git -C "$MAIN" push -q origin "$OLD_BRANCH"

GITDIR="$(git -C "$MAIN" rev-parse --absolute-git-dir)"
SLOT="$GITDIR/nuinui-implementation-slot"
mkdir "$SLOT"
cat > "$SLOT/state" <<STATE
version=1
issue=$ISSUE
branch=$BRANCH
base=$BASE
claim=$CLAIM
STATE

export NUINUI_HANDOFF_SELFTEST=1
export NUINUI_HANDOFF_MANIFEST="$MANIFEST"

if ! "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact > "$ROOT/out" 2>&1; then
  cat "$ROOT/out"
  fail 'exact handoff failed'
fi
grep -q '^HANDOFF VERIFIED$' "$ROOT/out" || { cat "$ROOT/out"; fail "exact handoff did not verify"; }
grep -q "^  branch=$BRANCH$" "$ROOT/out" || fail "verified handoff did not use durable claimed branch"
if grep -q "$OLD_BRANCH" "$ROOT/out"; then fail "stale same-Issue branch leaked into verified identity"; fi
echo "PASS: exact claim ignores unrelated stale same-Issue branch"

echo "PASS: setup for final release-tombstone discovery failure regression"
FIND_COUNTER="$ROOT/release-tombstone-find-count"
REAL_FIND="$(command -v find)"
FAKE_FIND_DIR="$ROOT/fake-find-bin"
mkdir "$FAKE_FIND_DIR"
cat > "$FAKE_FIND_DIR/find" <<'EOF'
#!/bin/sh
count=0
[ -f "$NUINUI_HANDOFF_FIND_COUNTER" ] && count=$(cat "$NUINUI_HANDOFF_FIND_COUNTER")
case "$*" in
  *nuinui-implementation-slot.releasing.*)
    count=$((count + 1))
    printf '%s\n' "$count" > "$NUINUI_HANDOFF_FIND_COUNTER"
    [ "$count" -eq 2 ] && exit 1
    ;;
esac
exec "$NUINUI_HANDOFF_REAL_FIND" "$@"
EOF
chmod 755 "$FAKE_FIND_DIR/find"
before_handoff_branch="$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
before_handoff_head="$(git -C "$MAIN" rev-parse HEAD)"
before_handoff_status="$(git -C "$MAIN" status --porcelain)"
before_handoff_refs="$(git -C "$MAIN" for-each-ref --format='%(refname) %(objectname)' | sort)"
before_handoff_slot="$(cat "$SLOT/state")"
if env PATH="$FAKE_FIND_DIR:$PATH" NUINUI_HANDOFF_REAL_FIND="$REAL_FIND" \
  NUINUI_HANDOFF_FIND_COUNTER="$FIND_COUNTER" \
  "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact > "$ROOT/out" 2>&1; then
  cat "$ROOT/out"
  fail 'final release-tombstone discovery failure unexpectedly verified handoff'
fi
grep -Fx 'BLOCKED: unable to rediscover release-pending state during handoff verification' "$ROOT/out" >/dev/null || {
  cat "$ROOT/out"
  fail 'final release-tombstone discovery failure did not use stable BLOCKED diagnostic'
}
if grep -q '^HANDOFF VERIFIED$' "$ROOT/out"; then fail 'failed final tombstone discovery emitted HANDOFF VERIFIED'; fi
[ "$(cat "$FIND_COUNTER")" = 2 ] || fail 'release-tombstone discovery points were not distinguished'
[ "$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null || true)" = "$before_handoff_branch" ] || fail 'handoff discovery failure changed branch'
[ "$(git -C "$MAIN" rev-parse HEAD)" = "$before_handoff_head" ] || fail 'handoff discovery failure changed HEAD'
[ "$(git -C "$MAIN" status --porcelain)" = "$before_handoff_status" ] || fail 'handoff discovery failure changed working tree'
[ "$(git -C "$MAIN" for-each-ref --format='%(refname) %(objectname)' | sort)" = "$before_handoff_refs" ] || fail 'handoff discovery failure changed refs'
[ "$(cat "$SLOT/state")" = "$before_handoff_slot" ] || fail 'handoff discovery failure changed durable slot'
[ ! -e "$GITDIR/nuinui-implementation-lock" ] && [ ! -L "$GITDIR/nuinui-implementation-lock" ] || fail 'handoff discovery failure changed lock state'
echo "PASS: final release-tombstone discovery failure blocks read-only handoff"

cp "$SLOT/state" "$ROOT/valid-state"
sed 's/^version=1$/version=2/' "$ROOT/valid-state" > "$SLOT/state"
expect_blocked "active slot unsupported version" "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact

sed '/^claim=/d' "$ROOT/valid-state" > "$SLOT/state"
expect_blocked "active slot missing key" "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact

cp "$ROOT/valid-state" "$SLOT/state"
printf 'claim=duplicate-claim\n' >> "$SLOT/state"
expect_blocked "active slot duplicate key" "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact

cp "$ROOT/valid-state" "$SLOT/state"
printf 'unknown=value\n' >> "$SLOT/state"
expect_blocked "active slot unknown key" "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact

sed 's/^issue=SAY-167$/issue=NOT-167/' "$ROOT/valid-state" > "$SLOT/state"
expect_blocked "active slot invalid Issue" "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact

sed 's#^branch=.*#branch=not a branch#' "$ROOT/valid-state" > "$SLOT/state"
expect_blocked "active slot invalid branch" "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact

sed 's#^branch=.*#branch=sayosomi/say-999-other-branch#' "$ROOT/valid-state" > "$SLOT/state"
expect_blocked "active slot Issue branch mismatch" "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact

sed 's/^base=.*/base=not-a-sha/' "$ROOT/valid-state" > "$SLOT/state"
expect_blocked "active slot invalid Base" "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact

sed 's/^claim=.*/claim=bad/' "$ROOT/valid-state" > "$SLOT/state"
expect_blocked "active slot invalid claim" "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact

cp "$ROOT/valid-state" "$SLOT/state"

expect_blocked "wrong claim" "$HELPER" alpha "$ISSUE" claim-cp1-12345678 "$CHECKPOINT" "$BASE" exact
expect_blocked "wrong checkpoint" "$HELPER" alpha "$ISSUE" "$CLAIM" "$BASE" "$BASE" exact

git -C "$MAIN" switch -q "$OLD_BRANCH"
expect_blocked "stale same-Issue checkout" "$HELPER" alpha "$ISSUE" "$CLAIM" "$BASE" "$BASE" exact
[ "$(sed -n '1p' "$ROOT/out")" = "BLOCKED: handoff claimed branch mismatch" ] || {
  cat "$ROOT/out"
  fail "stale same-Issue checkout did not use exact claimed branch mismatch classification"
}

grep -Fx "CALLER_EXPECTED: $BRANCH" "$ROOT/out" >/dev/null || {
  cat "$ROOT/out"
  fail "stale same-Issue checkout did not report exact claimed branch"
}

grep -Fx "ACTUAL:          $OLD_BRANCH" "$ROOT/out" >/dev/null || {
  cat "$ROOT/out"
  fail "stale same-Issue checkout did not report actual checkout branch"
}
git -C "$MAIN" switch -q "$BRANCH"

echo dirty >> "$MAIN/a"
expect_blocked "dirty lane" "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact
git -C "$MAIN" checkout -q -- a

git -C "$SEED" fetch -q origin main
git -C "$SEED" reset -q --hard origin/main
echo newer > "$SEED/newer"
git -C "$SEED" add newer
git -C "$SEED" commit -q -m newer
git -C "$SEED" push -q origin main
NEW_MAIN="$(git -C "$SEED" rev-parse HEAD)"
expect_blocked "stale main" "$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$BASE" exact
"$HELPER" alpha "$ISSUE" "$CLAIM" "$CHECKPOINT" "$NEW_MAIN" exact > "$ROOT/out"
grep -q '^HANDOFF VERIFIED$' "$ROOT/out" || { cat "$ROOT/out"; fail "fresh main handoff did not verify"; }
echo "PASS: fresh main verification"

FRESH_BRANCH="sayosomi/say-168-fresh-slice"
FRESH_ISSUE="SAY-168"
FRESH_CLAIM="claim-fresh-12345678"
git -C "$MAIN" switch -q main
git -C "$MAIN" fetch -q origin main
git -C "$MAIN" reset -q --hard "$NEW_MAIN"
git -C "$MAIN" switch -q -c "$FRESH_BRANCH" "$NEW_MAIN"
cat > "$SLOT/state" <<STATE
version=1
issue=$FRESH_ISSUE
branch=$FRESH_BRANCH
base=$NEW_MAIN
claim=$FRESH_CLAIM
STATE
STALE_TRACKING_REF="refs/remotes/origin/$FRESH_BRANCH"
git -C "$MAIN" update-ref "$STALE_TRACKING_REF" "$CHECKPOINT"
STALE_TRACKING_SHA="$(git -C "$MAIN" rev-parse "$STALE_TRACKING_REF")"
if git -C "$REMOTE" show-ref --verify --quiet "refs/heads/$FRESH_BRANCH"; then
  fail "fresh absent-mode topic unexpectedly exists on remote before handoff"
fi
"$HELPER" alpha "$FRESH_ISSUE" "$FRESH_CLAIM" "$NEW_MAIN" "$NEW_MAIN" absent > "$ROOT/out"
grep -q '^HANDOFF VERIFIED$' "$ROOT/out" || { cat "$ROOT/out"; fail "fresh absent-mode handoff did not verify"; }
[ "$(git -C "$MAIN" rev-parse "$STALE_TRACKING_REF")" = "$STALE_TRACKING_SHA" ] || fail "absent-mode handoff changed stale local remote-tracking ref"
echo "PASS: fresh topic absent mode"
echo "PASS: absent mode ignores stale local remote-tracking topic"

ORIGIN_URL="$(git -C "$MAIN" remote get-url origin)"
git -C "$MAIN" remote set-url origin "$ROOT/missing-remote.git"
expect_blocked "unavailable remote does not satisfy absent mode" "$HELPER" alpha "$FRESH_ISSUE" "$FRESH_CLAIM" "$NEW_MAIN" "$NEW_MAIN" absent
git -C "$MAIN" remote set-url origin "$ORIGIN_URL"

git -C "$MAIN" push -q -u origin "$FRESH_BRANCH"
expect_blocked "fresh mode rejects pre-existing remote topic" "$HELPER" alpha "$FRESH_ISSUE" "$FRESH_CLAIM" "$NEW_MAIN" "$NEW_MAIN" absent

echo "NUINUI HANDOFF CHECK SELFTEST PASS"
