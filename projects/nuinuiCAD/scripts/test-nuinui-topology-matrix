#!/bin/sh
set -eu

SOURCE_HELPER=${1:-$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)/nuinui}
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
SOURCE_HANDOFF=${2:-$SCRIPT_DIR/nuinui-handoff-check}
SOURCE_HELPER_SHA256=$(shasum -a 256 "$SOURCE_HELPER" | awk 'NR == 1 {print $1}')
SOURCE_HELPER_BLOB=$(git hash-object "$SOURCE_HELPER")
ROOT=$(CDPATH= cd -- "$(mktemp -d "${TMPDIR:-/tmp}/nuinui-topology-matrix.XXXXXX")" && pwd -P)
trap 'rm -rf "$ROOT"' EXIT HUP INT TERM

fail() { echo "TOPOLOGY MATRIX FAIL: $*" >&2; exit 1; }
contains() { printf '%s\n' "$1" | grep -Fq -- "$2" || fail "$3"; }
expect_blocked() {
  matrix_label=$1; shift
  if "$@" >"$ROOT/out" 2>&1; then
    cat "$ROOT/out"
    fail "$matrix_label unexpectedly succeeded"
  fi
  contains "$(cat "$ROOT/out")" 'BLOCKED' "$matrix_label was not fail-closed"
  echo "PASS: $matrix_label"
}

run_topology() {
  matrix_name=$1
  matrix_impl_count=$2
  matrix_human_count=$3
  matrix_root=$ROOT/$matrix_name
  matrix_remote=$matrix_root/sayosomi/nuinuiCAD.git
  matrix_seed=$matrix_root/seed
  matrix_project=$matrix_root/project
  matrix_result=$matrix_root/result
  matrix_manifest=$matrix_project/LANES.conf
  matrix_helper=$matrix_project/scripts/nuinui
  matrix_handoff=$matrix_project/scripts/nuinui-handoff-check
  matrix_prepare=$matrix_project/scripts/nuinui-e2e-prepare
  matrix_prepare_args="$matrix_root/prepare-args"
  matrix_fixture="$matrix_root/fixture file's.nui"
  mkdir -p "$matrix_project/scripts" "$matrix_root/unrelated" "$(dirname "$matrix_remote")"
  cp "$SOURCE_HELPER" "$matrix_helper"
  cp "$SOURCE_HANDOFF" "$matrix_handoff"
  chmod 755 "$matrix_helper" "$matrix_handoff"
  printf '%s\n' \
    '#!/bin/sh' \
    'printf "%s\n" "$@" > "$NUINUI_TEST_PREPARE_ARGS"' \
    'printf "%s\n" "E2E SETUP READY"' > "$matrix_prepare"
  chmod 755 "$matrix_prepare"
  printf '%s\n' fixture > "$matrix_fixture"
  [ "$(shasum -a 256 "$matrix_helper" | awk 'NR == 1 {print $1}')" = "$SOURCE_HELPER_SHA256" ] || fail "$matrix_name changed helper bytes"
  [ "$(git hash-object "$matrix_helper")" = "$SOURCE_HELPER_BLOB" ] || fail "$matrix_name changed helper blob"
  git init -q --bare "$matrix_remote"
  git init -q -b main "$matrix_seed"
  git -C "$matrix_seed" config user.name test
  git -C "$matrix_seed" config user.email test@example.invalid
  printf '%s\n' base > "$matrix_seed/base.txt"
  git -C "$matrix_seed" add base.txt
  git -C "$matrix_seed" commit -qm base
  git -C "$matrix_seed" remote add origin "$matrix_remote"
  git -C "$matrix_seed" push -qu origin main
  git clone -q "$matrix_remote" "$matrix_project/main"
  git -C "$matrix_project/main" config user.name test
  git -C "$matrix_project/main" config user.email test@example.invalid

  impl_a=$matrix_project/main
  impl_b=$matrix_project/impl-b
  impl_c=$matrix_project/impl-c
  human_a=$matrix_project/human-a
  human_b=$matrix_project/human-b
  [ "$matrix_impl_count" -ge 2 ] && git -C "$matrix_project/main" worktree add -q --detach "$impl_b" origin/main
  [ "$matrix_impl_count" -ge 3 ] && git -C "$matrix_project/main" worktree add -q --detach "$impl_c" origin/main
  [ "$matrix_human_count" -ge 1 ] && git -C "$matrix_project/main" worktree add -q --detach "$human_a" origin/main
  [ "$matrix_human_count" -ge 2 ] && git -C "$matrix_project/main" worktree add -q --detach "$human_b" origin/main
  git init -q "$matrix_result"

  case "$matrix_name" in
    one-plus-zero)
      impl_names='build'; impl_paths="$impl_a"; impl_idles='branch'; human_names=''; selected=build; selected_path=$impl_a; begin_branch=codex/SAY-101-matrix; issue=SAY-101 ;;
    two-plus-one)
      impl_names='build compile'; impl_paths="$impl_a $impl_b"; impl_idles='branch detached'; human_names='manual'; selected=compile; selected_path=$impl_b; begin_branch=codex/SAY-102-matrix; issue=SAY-102 ;;
    three-plus-one)
      impl_names='build compile review'; impl_paths="$impl_a $impl_b $impl_c"; impl_idles='branch detached detached'; human_names='manual'; selected=review; selected_path=$impl_c; begin_branch=codex/SAY-103-matrix; issue=SAY-103 ;;
    two-plus-two)
      impl_names='build compile'; impl_paths="$impl_a $impl_b"; impl_idles='branch detached'; human_names='manual-a manual-b'; selected=compile; selected_path=$impl_b; begin_branch=codex/SAY-104-matrix; issue=SAY-104 ;;
    *) fail "unknown topology $matrix_name" ;;
  esac
  {
    printf '%s\n' version=1 repository=sayosomi/nuinuiCAD default_branch=main
    n=1
    for impl in $impl_names; do
      set -- $impl_paths; impl_path=$1; shift; impl_paths="$*"
      set -- $impl_idles; impl_idle=$1; shift; impl_idles="$*"
      printf '\n[lane %s]\nrole=implementation\npath=%s\nidle=%s\n' "$impl" "$impl_path" "$impl_idle"
      n=$((n + 1))
    done
    if [ -n "$human_names" ]; then
      for human in $human_names; do
        case "$human" in manual|manual-a) human_path=$human_a ;; manual-b) human_path=$human_b ;; esac
        printf '\n[lane %s]\nrole=human-test\npath=%s\nidle=detached\n' "$human" "$human_path"
      done
    fi
  } > "$matrix_manifest"
  export NUINUI_SELFTEST=1 NUINUI_SELFTEST_RESULT_REPO="$matrix_result"
  export NUINUI_E2E_STATUS_HELPER="$matrix_prepare"
  export NUINUI_TEST_PREPARE_ARGS="$matrix_prepare_args"
  cd "$matrix_root/unrelated"

  expect_blocked "$matrix_name preflight rejects uninitialized lanes" "$matrix_helper" preflight
  for impl in $impl_names; do "$matrix_helper" lane-init "$impl" >/dev/null || fail "$matrix_name lane-init $impl"; done
  matrix_preflight=$("$matrix_helper" preflight) || fail "$matrix_name preflight after initialization"
  contains "$matrix_preflight" 'inventory_state=PASS' "$matrix_name registered inventory"
  first_name=$(printf '%s\n' "$impl_names" | awk '{print $1}')
  contains "$matrix_preflight" "lane name=$first_name role=implementation" "$matrix_name declaration-order lane"

  matrix_base=$(git -C "$matrix_project/main" rev-parse origin/main)
  case "$matrix_impl_count" in
    1) inventory="build=FREE"; expected_inventory="build=$issue" ;;
    2) inventory="build=FREE,compile=FREE"; expected_inventory="build=FREE,compile=$issue" ;;
    3) inventory="build=FREE,compile=FREE,review=FREE"; expected_inventory="build=FREE,compile=FREE,review=$issue" ;;
  esac

  if [ "$matrix_name" = two-plus-two ]; then
    busy_output=$("$matrix_helper" start build "$issue" "$matrix_base" \
      codex/SAY-104-busy) || fail "$matrix_name mixed inventory setup"
    busy_claim=$(printf '%s\n' "$busy_output" | sed -n 's/^claim=//p')
    [ -n "$busy_claim" ] || fail "$matrix_name mixed inventory claim"
    inventory="build=$issue,compile=FREE"
    expected_inventory="build=$issue,compile=$issue"
  fi

  begin_command_output=$("$matrix_helper" begin-command \
    --branch "$begin_branch" --base "$matrix_base" --lane "$selected" \
    --issue "$issue") || fail "$matrix_name begin-command generation"
  contains "$begin_command_output" 'BEGIN COMMAND READY' \
    "$matrix_name begin-command envelope"
  begin_command=$(printf '%s\n' "$begin_command_output" |
    sed -n '/^BEGIN COMMAND READY$/{n;p;}')
  [ -n "$begin_command" ] || fail "$matrix_name begin-command executable line"
  contains "$begin_command" "'$inventory'" \
    "$matrix_name begin-command canonical declaration-order inventory"
  begin_output=$(sh -c "$begin_command") || fail "$matrix_name generated begin execution"
  contains "$begin_output" 'IMPLEMENTATION STARTED' "$matrix_name begin routing"
  contains "$begin_output" "implementation_inventory=$expected_inventory" "$matrix_name complete inventory"
  claim=$(printf '%s\n' "$begin_output" | sed -n 's/^claim=//p')
  [ -n "$claim" ] || fail "$matrix_name begin claim"
  release_output=$("$matrix_helper" release "$selected" "$matrix_base" "$claim") || fail "$matrix_name begin release"
  contains "$release_output" 'IMPLEMENTATION RELEASED' "$matrix_name release routing"
  if [ "$matrix_name" = two-plus-two ]; then
    busy_release_output=$("$matrix_helper" release build "$matrix_base" "$busy_claim") ||
      fail "$matrix_name mixed inventory release"
    contains "$busy_release_output" 'IMPLEMENTATION RELEASED' \
      "$matrix_name mixed inventory release routing"
  fi

  start_output=$("$matrix_helper" start "$selected" "$issue" "$matrix_base" "$begin_branch") || fail "$matrix_name start"
  start_claim=$(printf '%s\n' "$start_output" | sed -n 's/^claim=//p')
  [ -n "$start_claim" ] || fail "$matrix_name start claim"
  resume_output=$("$matrix_helper" resume "$selected" "$issue" "$matrix_base" "$matrix_base" "$begin_branch" "$start_claim") || fail "$matrix_name resume"
  contains "$resume_output" 'IMPLEMENTATION RESUMED' "$matrix_name resume routing"
  handoff_output=$(NUINUI_HANDOFF_SELFTEST=1 NUINUI_HANDOFF_MANIFEST="$matrix_manifest" \
    "$matrix_handoff" "$selected" "$issue" "$start_claim" "$matrix_base" "$matrix_base" absent) || fail "$matrix_name handoff-check"
  contains "$handoff_output" 'HANDOFF VERIFIED' "$matrix_name renamed-lane handoff"
  "$matrix_helper" release "$selected" "$matrix_base" "$start_claim" >/dev/null || fail "$matrix_name resumed release"

  if [ "$matrix_human_count" = 0 ]; then
    expect_blocked "$matrix_name rejects Human-test short form with zero lanes" "$matrix_helper" e2e-start "$issue" "$matrix_base"
  elif [ "$matrix_human_count" = 1 ]; then
    human_output=$("$matrix_helper" e2e-start "$issue" "$matrix_base") || fail "$matrix_name singleton Human-test short form"
    contains "$human_output" 'E2E STARTED' "$matrix_name singleton Human-test start"
    "$matrix_helper" e2e-release "$issue" "$matrix_base" >/dev/null || fail "$matrix_name singleton Human-test release"
  else
    expect_blocked "$matrix_name rejects ambiguous Human-test short form" "$matrix_helper" e2e-start "$issue" "$matrix_base"
    human_output=$("$matrix_helper" e2e-start manual-b "$issue" "$matrix_base") || fail "$matrix_name explicit Human-test start"
    contains "$human_output" 'E2E STARTED' "$matrix_name explicit Human-test routing"
    matrix_preflight=$("$matrix_helper" preflight 2>&1) || fail "$matrix_name preflight with active Human-test lane"
    contains "$matrix_preflight" 'PREFLIGHT PASS' "$matrix_name active Human-test preflight"
    human_busy_block=$(printf '%s\n' "$matrix_preflight" | awk '
      index($0, "lane name=manual-b role=human-test ") == 1 { found=1; print; next }
      found && /^lane name=/ { exit }
      found { print }
    ')
    human_free_block=$(printf '%s\n' "$matrix_preflight" | awk '
      index($0, "lane name=manual-a role=human-test ") == 1 { found=1; print; next }
      found && /^lane name=/ { exit }
      found { print }
    ')
    contains "$human_busy_block" 'state=BUSY' "$matrix_name active Human-test is BUSY"
    contains "$human_busy_block" "owner_issue=$issue" "$matrix_name Human-test owner Issue"
    contains "$human_busy_block" "owner_ref=$matrix_base" "$matrix_name Human-test owner ref"
    contains "$human_free_block" 'state=FREE' "$matrix_name other Human-test remains FREE"
    human_free_count=$(printf '%s\n' "$matrix_preflight" | awk '
      /^lane name=.* role=human-test / { human=1; next }
      /^lane name=/ { human=0 }
      human && /state=FREE/ { count++ }
      END { print count + 0 }
    ')
    [ "$human_free_count" = 1 ] || fail "$matrix_name expected exactly one FREE Human-test lane"
    echo "PASS: $matrix_name Human-test occupancy has one FREE lane"
    "$matrix_helper" e2e-release manual-b "$issue" "$matrix_base" >/dev/null || fail "$matrix_name explicit Human-test release"
  fi

  if [ "$matrix_human_count" -gt 0 ]; then
    expect_blocked "$matrix_name rejects implementation lane for E2E handoff" \
      "$matrix_helper" e2e-start-command --lane "$selected" --issue "$issue" \
      --tested-ref "$matrix_base" --executor human --fixture "$matrix_fixture"
  fi

  if [ "$matrix_human_count" = 0 ]; then
    expect_blocked "$matrix_name rejects E2E handoff without a Human-test lane" \
      "$matrix_helper" e2e-start-command --issue "$issue" --tested-ref "$matrix_base" \
      --executor human --fixture "$matrix_fixture"
  elif [ "$matrix_human_count" = 1 ]; then
    if [ "$matrix_name" = two-plus-one ]; then
      e2e_command_output=$("$matrix_helper" e2e-start-command --issue "$issue" \
        --tested-ref "$matrix_base" --executor human --fixture "$matrix_fixture" \
        --locale ja --port 9555) || fail "$matrix_name E2E handoff generation"
      expected_prepare_args=$(printf '%s\n' prepare manual "$issue" "$matrix_base" \
        "$matrix_fixture" 9555 --locale ja)
    else
      e2e_command_output=$("$matrix_helper" e2e-start-command --issue "$issue" \
        --tested-ref "$matrix_base" --executor luna --fixture "$matrix_fixture") ||
        fail "$matrix_name E2E handoff generation"
      expected_prepare_args=$(printf '%s\n' prepare manual "$issue" "$matrix_base" \
        "$matrix_fixture")
    fi
    contains "$e2e_command_output" 'E2E START COMMAND READY' \
      "$matrix_name E2E handoff envelope"
    contains "$e2e_command_output" 'lane_state=FREE' \
      "$matrix_name E2E handoff FREE evidence"
    contains "$e2e_command_output" 'executor=' \
      "$matrix_name E2E handoff executor metadata"
    e2e_command=$(printf '%s\n' "$e2e_command_output" |
      sed -n '/^E2E START COMMAND READY$/{n;p;}')
    [ -n "$e2e_command" ] || fail "$matrix_name E2E handoff executable line"
    e2e_execution_output=$(sh -c "$e2e_command") || {
      printf '%s\n' "$e2e_execution_output"
      fail "$matrix_name generated E2E continuation execution"
    }
    contains "$e2e_execution_output" 'E2E STARTED' \
      "$matrix_name generated e2e-start stage"
    contains "$e2e_execution_output" 'E2E SETUP READY' \
      "$matrix_name generated prepare stage"
    [ "$(cat "$matrix_prepare_args")" = "$expected_prepare_args" ] ||
      fail "$matrix_name generated prepare arguments were not exact"

    e2e_duplicate_output=$("$matrix_helper" e2e-start-command --issue "$issue" \
      --tested-ref "$matrix_base" --executor human --fixture "$matrix_fixture") ||
      fail "$matrix_name exact BUSY E2E handoff candidate"
    contains "$e2e_duplicate_output" 'lane_state=BUSY' \
      "$matrix_name exact BUSY E2E handoff candidate evidence"
    expect_blocked "$matrix_name rejects BUSY E2E handoff for another Issue" \
      "$matrix_helper" e2e-start-command --issue SAY-999 --tested-ref "$matrix_base" \
      --executor human --fixture "$matrix_fixture"
    "$matrix_helper" e2e-release "$issue" "$matrix_base" >/dev/null ||
      fail "$matrix_name generated E2E continuation cleanup"
    echo "PASS: $matrix_name generated E2E handoff, parser parity, quoting, and duplicate guard"
  else
    "$matrix_helper" e2e-start manual-a SAY-900 "$matrix_base" >/dev/null ||
      fail "$matrix_name mixed Human-test BUSY setup"
    e2e_command_output=$("$matrix_helper" e2e-start-command --lane manual-b \
      --issue "$issue" --tested-ref "$matrix_base" --executor human \
      --fixture "$matrix_fixture") || fail "$matrix_name explicit E2E handoff generation"
    contains "$e2e_command_output" 'E2E START COMMAND READY' \
      "$matrix_name explicit E2E handoff envelope"
    contains "$e2e_command_output" 'lane=manual-b' \
      "$matrix_name explicit E2E handoff lane"
    contains "$e2e_command_output" 'lane_state=FREE' \
      "$matrix_name mixed FREE/BUSY evidence"
    e2e_command=$(printf '%s\n' "$e2e_command_output" |
      sed -n '/^E2E START COMMAND READY$/{n;p;}')
    e2e_execution_output=$(sh -c "$e2e_command") || {
      printf '%s\n' "$e2e_execution_output"
      fail "$matrix_name explicit generated E2E continuation execution"
    }
    contains "$e2e_execution_output" 'E2E STARTED' \
      "$matrix_name explicit generated e2e-start stage"
    contains "$e2e_execution_output" 'E2E SETUP READY' \
      "$matrix_name explicit generated prepare stage"
    e2e_duplicate_output=$("$matrix_helper" e2e-start-command --lane manual-b \
      --issue "$issue" --tested-ref "$matrix_base" --executor luna \
      --fixture "$matrix_fixture") || fail "$matrix_name exact BUSY E2E handoff candidate"
    contains "$e2e_duplicate_output" 'lane_state=BUSY' \
      "$matrix_name exact BUSY E2E handoff candidate evidence"
    expect_blocked "$matrix_name rejects BUSY E2E handoff for another Issue" \
      "$matrix_helper" e2e-start-command --lane manual-b --issue SAY-999 \
      --tested-ref "$matrix_base" --executor human --fixture "$matrix_fixture"
    "$matrix_helper" e2e-release manual-b "$issue" "$matrix_base" >/dev/null ||
      fail "$matrix_name explicit generated E2E cleanup"
    "$matrix_helper" e2e-release manual-a SAY-900 "$matrix_base" >/dev/null ||
      fail "$matrix_name mixed Human-test cleanup"
    echo "PASS: $matrix_name generated explicit E2E handoff and mixed occupancy guards"
  fi
  echo "PASS: topology $matrix_name (${matrix_impl_count} implementation + ${matrix_human_count} Human-test) helper_sha256=$SOURCE_HELPER_SHA256 helper_blob=$SOURCE_HELPER_BLOB"
}

run_topology one-plus-zero 1 0
run_topology two-plus-one 2 1
run_topology three-plus-one 3 1
run_topology two-plus-two 2 2
echo 'NUINUI TOPOLOGY MATRIX PASS'
